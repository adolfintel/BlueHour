+}
+
+/* Legacy name spaces per texture target.  Drivers of the NV legacy era kept a
+ * separate name space per target, so the same numeric name bound to two targets
+ * gave two distinct objects.  Nalu (the GeForce 6 demo) generates a name, binds
+ * it as GL_TEXTURE_2D and immediately after as GL_TEXTURE_3D; with the modern
+ * single name space the second bind fails (96696 GL_INVALID_OPERATION "target
+ * mismatch" in 2409 frames, ~40 per frame) and its 512x512x32 RGB8 noise volume
+ * is never created - the upload lands on the default texture (tex=0).  In the
+ * reference trace the same bind used a huge name that happened to be free, so
+ * the object was created there and the volume existed.  Reproduce the old
+ * behaviour: a stable substitute name per (share set, name, target), so the app
+ * gets its 3D object while its 2D object stays intact.  The key must be the
+ * shared name space, not the context: the demo uses several contexts that share
+ * lists, and keying by context produced one substitute per context (measured:
+ * name=3 got 130, 132 and 133), so the noise volume was uploaded to one object
+ * and sampled from another, empty one - and the sampler fell back to black.  Correct applications
+ * never reach this, because they only hit it on what is a GL error anyway.
+ * MESA_NV_LEGACY_TARGET=0 turns it off (A/B).
+ */
+bool
+_mesa_nv_legacy_target(void)
+{
+   static int cached = -1;
+   if (cached < 0) {
+      const char *v = getenv("MESA_NV_LEGACY_TARGET");
+      cached = (v != NULL && *v == '0') ? 0 : 1;
+   }
+   return cached;
+}
+
+#define NV_TARGET_ALT_MAP 1024
+struct nv_target_alt_entry {
+   /* The key must NOT be the context: Nalu uses several contexts that share the object
+       * lists, and with a per-context key the same name bound as 3D got different
+       * substitutes (measured: name=3 -> substitutes 130, 132 and 133 in different
+       * contexts). So the 512x512x32 noise volume was uploaded into one object and
+       * sampled from a different one that had no image at all (baseComplete=0), which
+       * left the sampler on the black fallback texture. Texture names live in a
+       * gl_shared_space: that is the right key, because it is identical for every
+       * context that shares the lists. */
+   const struct gl_shared_state *shared;
+   GLuint name;
+   GLenum target;
+   GLuint alt;
+};
+static struct nv_target_alt_entry nv_target_alt[NV_TARGET_ALT_MAP];
+static unsigned nv_target_alt_n;
+/* Substitute names come from a range above the ids the demos actually use, so
+ * they cannot collide with names the application asks for. */
+static unsigned nv_target_alt_next = 0x00f00000;
+
+GLuint
+_mesa_nv_target_alt_lookup(const struct gl_context *ctx, GLuint name, GLenum target)
+{
+   unsigned i;
+
+   for (i = 0; i < nv_target_alt_n; i++) {
+      if (nv_target_alt[i].shared == ctx->Shared && nv_target_alt[i].name == name &&
+          nv_target_alt[i].target == target)
+         return nv_target_alt[i].alt;
+   }
+   return 0;
+}
+
+void
+_mesa_nv_target_alt_add(const struct gl_context *ctx, GLuint name, GLenum target,
+                        GLuint alt)
+{
+   unsigned i;
+
+   for (i = 0; i < nv_target_alt_n; i++) {
+      if (nv_target_alt[i].shared == ctx->Shared && nv_target_alt[i].name == name &&
+          nv_target_alt[i].target == target) {
+         nv_target_alt[i].alt = alt;
+         return;
+      }
+   }
+   if (nv_target_alt_n >= NV_TARGET_ALT_MAP)
+      return;
+   nv_target_alt[nv_target_alt_n].shared = ctx->Shared;
+   nv_target_alt[nv_target_alt_n].name = name;
+   nv_target_alt[nv_target_alt_n].target = target;
+   nv_target_alt[nv_target_alt_n].alt = alt;
+   nv_target_alt_n++;
+}
+
+/* Candidate substitute name; the caller probes the texture hash and bumps this
+ * until it finds a free one. */
+
+/* Trace lines only for the draws that use one of the fragment programs listed in
+ * MESA_NV_TRACE_DRAW: shows how the game draws certain passes (UI, screen passes)
+ * without flooding the log with the tens of thousands of draw calls per frame.  */
+
+/* Returns true if the currently bound fragment program is one we want to trace;
+ * its name is written into *fp_name.
+ */
+/* Per-frame count of draws grouped by the (fragment program, vertex program) pair
+ * in use, with a hash of the vertex programs local parameters: the view/proj
+ * matrices of vp20/vp30 programs travel there, so the hash changes when the game's
+ * parameters do not arrive.
+ */
+#define NV_COMB_PTR_MAP 512
+static struct { const void *prog; unsigned long long hash; } nv_comb_ptr[NV_COMB_PTR_MAP];
+static unsigned nv_comb_ptr_n;
+
+/* Maps program pointer -> hash of the generated text (the Ids are shared by all
+ * register-combiner generated programs, so the pointer is what identifies which one
+ * was bound to a draw).
+ */
+void
+_mesa_nv_comb_note_program(const void *prog, unsigned long long text_hash)
+{
+   for (unsigned i = 0; i < nv_comb_ptr_n; i++) {
+      if (nv_comb_ptr[i].prog == prog) {
+         nv_comb_ptr[i].hash = text_hash;
+         return;
+      }
+   }
+   if (nv_comb_ptr_n < NV_COMB_PTR_MAP) {
+      nv_comb_ptr[nv_comb_ptr_n].prog = prog;
+      nv_comb_ptr[nv_comb_ptr_n].hash = text_hash;
+      nv_comb_ptr_n++;
+   }
+}
+
+
+
+
+
+
+
+struct nv_prog_slot {
+   GLuint id;
+   GLuint vp;
+   unsigned fbw, fbh;   /* render buffer for this combination */
+   GLuint fbname;
+   uint32_t csig;       /* hash of the generated combiner program text */
+   uint32_t fpvh;       /* hash of the fragment program parameter values */
+   uint32_t fpsm;       /* SamplersUsed of the bound fragment program */
+   uint32_t t0tgt;      /* target of the actual texture on unit 0 */
+   uint32_t t0env, t0rect, t0cube, t0_2d;
+   uint32_t t0comp;     /* completeness of the texture bound on unit 0 */
+   uint32_t t0bind;     /* mask of targets with a user texture on unit 0 */
+   uint32_t t0min, t0max;  /* min/max levels of the bound texture */
+   unsigned fpar;       /* number of parameters of the fragment program */
+   GLuint t0name;       /* texture name on unit 0 (0 = default) */
+   uintptr_t drawb;     /* nvdbg: drawable instance used by this draw */
+   GLuint aliastex;     /* nvdbg: obj_name of the texture declared as the drawable archive */
+   unsigned draws;
+   unsigned count;      /* sum of the "counts" passed to the draws */
+   uint32_t vphash;
+   float vpmax;
+   unsigned npar;
+   char prim[8];
+};
+/* nvdbg: counters for the shadow artefact mechanism.
+ *  fbk  = draws that WRITE into a drawable whose depth texture is also sampled by
+ *         the program in use at that draw (sampling feedback: undefined behaviour;
+ *         with aliasing the sampler would read the map while it is being written -
+ *         Wine's copy used to give a snapshot instead).
+ *  stn  = draws with stencil active on an aliased drawable (my zs alignment goes
+ *         from Z24_UNORM_S8_UINT to Z24X8_UNORM and loses the stencil).
+ *  ali  = draws that end up inside an aliased texture. */
+/* nvlegacy (fork): COLOUR render textures, served at SAMPLING time. See the field
+ * nv_rt_color_alias in main/mtypes.h for why the mechanism exists.
+ *
+ * The key is the DRAWABLE, not a framebuffer name: measured on Luna, Wine hands over 0 as the
+ * framebuffer of the pbuffer (at bind time it has the default buffer of that drawable current, and
+ * GL name 0 means "the winsys buffer of whichever context asks"), so a name captured once at bind
+ * time is worthless. The drawable POINTER is identical in every context that binds the same
+ * surface, which is exactly what the depth table in main/fbobject.c relies on, and the front end
+ * resolves the pipe resources from it (dri_drawable::textures[]).
+ *
+ * Pairing happens where Mesa really sees Wine's delivery read: glReadPixels with the pbuffer as
+ * read framebuffer, while the application's render texture is the one bound on the target (Wine
+ * rebinds it right before the copy, measured). From then on: a draw whose current framebuffer
+ * belongs to that drawable bumps the generation; a sampler about to use the texture triggers one
+ * copy if the generations differ, so a frame costs one blit per render texture. */
+struct nv_rt_color_slot {
+   struct gl_texture_object *tex;
+   uintptr_t drawable;
+   unsigned draw_gen;
+   unsigned copied_gen;
+};
+
+
+/* Registered by the DRI front end: core and state_tracker cannot resolve a symbol of that
+ * library at link time, hence the function pointer (the depth path uses the same trick). */
+static void (*nv_rt_color_hook)(struct gl_context *ctx, struct gl_texture_object *dst,
+                                uintptr_t drawable);
+
+void
+_mesa_nv_rt_color_copy_hook_set(void (*fn)(struct gl_context *, struct gl_texture_object *,
+                                           uintptr_t))
+{
+   nv_rt_color_hook = fn;
+}
+
+static struct nv_rt_color_slot nv_rt_color[24];
+static unsigned nv_rt_color_n;
+
+/* MESA_NV_RT_COLOR_ALIAS=0 switches the mechanism off even where Wine opted the texture in: it
+ * exists so that the A/B can be done without rebuilding. Default: on, but inert without the
+ * Wine opt-in, which is the real gate. */
+static int
+nv_rt_color_off(void)
+{
+   static int cached = -1;
+
+   if (cached < 0) {
+      const char *v = getenv("MESA_NV_RT_COLOR_ALIAS");
+      cached = (v && !atoi(v)) ? 1 : 0;
+   }
+   return cached;
+}
+
+/* The opt-in, from the hidden pname: it marks the texture. The drawable is still unknown here
+ * (Wine knows it, Mesa of that context does not), and that is fine: the pairing below fills it. */
+void
+_mesa_nv_rt_color_optin(struct gl_context *ctx, struct gl_texture_object *texObj, GLuint src_fbo)
+{
+   unsigned i;
+
+   (void) src_fbo;   /* kept in the channel for diagnostics: measured to be 0 in practice */
+   if (nv_rt_color_off() || texObj == NULL)
+      return;
+   texObj->nv_rt_color_alias = true;
+   if (ctx == NULL)
+      return;
+   for (i = 0; i < nv_rt_color_n; i++) {
+      if (nv_rt_color[i].tex == texObj)
+         return;
+   }
+   if (nv_rt_color_n >= ARRAY_SIZE(nv_rt_color))
+      return;
+   nv_rt_color[nv_rt_color_n].tex = NULL;
+   _mesa_reference_texobj(&nv_rt_color[nv_rt_color_n].tex, texObj);
+   nv_rt_color[nv_rt_color_n].drawable = 0;
+   nv_rt_color[nv_rt_color_n].draw_gen = 0;
+   nv_rt_color[nv_rt_color_n].copied_gen = 0;
+   nv_rt_color_n++;
+}
+
+/* Called from the read path: "Wine is reading pixels out of THIS drawable, in a context where
+ * that flagged texture is bound" -> that is precisely the delivery of a render texture, so the
+ * pair is recorded. Doing it here (and not at bind time) is what the measurement asked for: at
+ * bind time the framebuffer name handed over was 0 in all ten opt-ins of a Luna run. */
+void
+_mesa_nv_rt_color_note_read(struct gl_context *ctx)
+{
+   unsigned u, i;
+   uintptr_t drawable;
+
+   if (nv_rt_color_n == 0 || ctx == NULL)
+      return;
+   drawable = (uintptr_t) ctx->ReadBuffer->drawable;
+   if (drawable == 0)
+      return;                       /* a user framebuffer: not a pbuffer store */
+   for (u = 0; u < ctx->Const.MaxTextureUnits; u++) {
+      struct gl_texture_object *t = ctx->Texture.Unit[u]._Current;
+
+      if (t == NULL || !t->nv_rt_color_alias)
+         continue;
+      for (i = 0; i < nv_rt_color_n; i++) {
+         if (nv_rt_color[i].tex == t && nv_rt_color[i].drawable == 0) {
+            nv_rt_color[i].drawable = drawable;
+            return;
+         }
+      }
+   }
+}
+
+/* Pairing from the copy path: Wine delivers a colour pbuffer with a blit (measured: the delivery
+ * in wglBindTexImageARB is bind + blit, and the log of a Luna run is full of BLIT-BRANCH lines
+ * from that very path), so the pair is recorded where a colour blit lands INSIDE a flagged
+ * texture. The source of that blit is the drawable we want: its pointer is the key, and the front
+ * end resolves the surface from it, exactly like the depth path does at blit.c:855. */
+void
+_mesa_nv_rt_color_note_blit(struct gl_context *ctx, const void *read_drawable,
+                            const struct gl_texture_object *dst_tex)
+{
+   unsigned i;
+
+   if (nv_rt_color_n == 0 || ctx == NULL || read_drawable == NULL || dst_tex == NULL)
+      return;
+   for (i = 0; i < nv_rt_color_n; i++) {
+      if (nv_rt_color[i].tex != dst_tex)
+         continue;
+      if (nv_rt_color[i].drawable != 0)
+         return;                        /* already paired: the first delivery wins the key */
+      nv_rt_color[i].drawable = (uintptr_t) read_drawable;
+      return;
+   }
+}
+
+/* Pairing from the upload path: this is the one that really fires. Measured on Luna with
+ * MESA_NV_TRACE_WGL and MESA_NV_TEXUPLOAD, the colour delivery of Wine does NOT appear as a blit
+ * into the application texture, and glReadPixels does not carry it either: what reaches Mesa is a
+ * plain texture definition/upload on the target where the render texture is bound (the census of a
+ * real run prints TEXUPLOAD TexImage2D / CompTexImage2D lines for those textures, and the blit
+ * branch of Wine is used for the depth stores only). So the pair "texture <- drawable it was
+ * delivered from" is recorded here, using the framebuffer that is read or drawn at that moment:
+ * for a pbuffer copy that is the pbuffer surface itself. */
+void
+_mesa_nv_rt_color_note_upload(struct gl_context *ctx, struct gl_texture_object *tex)
+{
+   uintptr_t drawable = 0;
+   unsigned i;
+
+   if (nv_rt_color_n == 0 || ctx == NULL || tex == NULL || !tex->nv_rt_color_alias)
+      return;
+   if (ctx->ReadBuffer != NULL && ctx->ReadBuffer->drawable != NULL)
+      drawable = (uintptr_t) ctx->ReadBuffer->drawable;
+   else if (ctx->DrawBuffer != NULL && ctx->DrawBuffer->drawable != NULL)
+      drawable = (uintptr_t) ctx->DrawBuffer->drawable;
+   if (drawable == 0)
+      return;                       /* a user framebuffer: carries no pbuffer store */
+   for (i = 0; i < nv_rt_color_n; i++) {
+      if (nv_rt_color[i].tex != tex)
+         continue;
+      if (nv_rt_color[i].drawable != 0)
+         return;                     /* already paired: the first delivery sets the key */
+      nv_rt_color[i].drawable = drawable;
+      return;
+   }
+}
+
+/* A draw happened on the framebuffer of that drawable: the store is dirty again. */
+void
+_mesa_nv_rt_color_note_draw(struct gl_context *ctx)
+{
+   const uintptr_t drawable = (uintptr_t) ctx->DrawBuffer->drawable;
+   unsigned i;
+
+   if (nv_rt_color_n == 0 || drawable == 0)
+      return;
+   /* MESA_NV_RT_COLOR_ANY=1: diagnostic mode. Measured, the drawable pointer recorded at pairing
+       * time never equals the one of the draw: the pairing happens inside Wine's internal context,
+       * and each context has its own wrapper object for the same surface, so the pointer key that
+       * works for the depth path (captured and compared in the SAME context) does not work across
+       * contexts. With this mode every flagged store is marked dirty on any draw, to find out
+       * whether the delivery itself is what the demo needs. */
+   {
+      static int any = -1;
+
+      if (any < 0) {
+         const char *v = getenv("MESA_NV_RT_COLOR_ANY");
+         any = (v && atoi(v)) ? 1 : 0;
+      }
+      for (i = 0; i < nv_rt_color_n; i++) {
+         if (!nv_rt_color[i].tex)
+            continue;
+         if (any || nv_rt_color[i].drawable == drawable)
+            nv_rt_color[i].draw_gen++;
+      }
+   }
+}
+
+void
+_mesa_nv_rt_color_note_sample(struct gl_context *ctx, struct gl_texture_object *tex)
+{
+   unsigned i;
+   static int busy;
+   static unsigned sonde, equal;
+
+   if (busy)
+      return;
+   for (i = 0; i < nv_rt_color_n; i++) {
+      if (nv_rt_color[i].tex != tex)
+         continue;
+      if (nv_rt_color[i].drawable == 0) {
+         if (sonde++ < 3)
+            fprintf(stderr, "MESA-NV RT-COLOUR: texture %u adopted but not yet matched"
+                            " a un drawable\n", tex->Name);
+         return;
+      }
+      if (nv_rt_color_hook == NULL) {
+         if (sonde++ < 8)
+            fprintf(stderr, "MESA-NV RT-COLOUR: the DRI front-end hook is missing for texture "
+                            "%u\n", tex->Name);
+         return;                    /* no front end: do nothing */
+      }
+      if (nv_rt_color[i].draw_gen == nv_rt_color[i].copied_gen) {
+         if (equal++ < 3)
+            fprintf(stderr, "MESA-NV RT-COLOUR: texture %u is sampled but the store is not "
+                            "state redrawn (generations %u against %u, drawable %p)\n",
+                    tex->Name, nv_rt_color[i].draw_gen, nv_rt_color[i].copied_gen,
+                    (void *) (uintptr_t) nv_rt_color[i].drawable);
+         return;                    /* the store was not drawn again: nothing to deliver */
+      }
+      busy = 1;
+      nv_rt_color_hook(ctx, tex, nv_rt_color[i].drawable);
+      busy = 0;
+      nv_rt_color[i].copied_gen = nv_rt_color[i].draw_gen;
+      return;
+   }
+}
+
+
+static struct nv_prog_slot nv_progs[32];
+static unsigned nv_progs_n;
+
+
+
+
+/**
+ * MESA_NV_TEXALPHA_COUNT=1
+ *   Counts the texels whose decoded alpha equals exactly 255 in level 0 of a
+ *   DXT5/DXT3 texture, without touching the data, and keeps them in a table keyed by
+ *   texture name. It exists to identify WHICH mask a draw is sampling: the correct
+ *   offline measurements (3 bits per texel) give EatFlower 4195, EatLeaf 1668,
+ *   BIGPlant 82548, Vine_01/HeroVine 1048576 (fully opaque). With the counter in the
+ *   sampler trace every draw reports its mask without having to trust names, which
+ *   change between runs.
+ */
+#define NV_A255_MAX 8192u
+static unsigned nv_a255[NV_A255_MAX];
+static unsigned nv_a255_tot[NV_A255_MAX];
+
+
+/**<
+ * MESA_NV_TEXALPHA255=<val>[:WxH]
+ *   val = the alpha value to force (255 = a "fully bitten" mask);
+ *   WxH = optional, limits the change to that size.
+ *
+ * Why here and not on the glClear path: injecting from clear HUNG the process
+ * (0 frames presented, UI alive, zero GL errors). This hook sits instead on the
+ * normal upload path (the storage helper), the one already used by
+ * nv_legacy_tex3d_fixup: there the driver can safely receive new data.
+ *
+ * Rewrites ONLY the alpha section of DXT5 blocks (bytes 0..7): a0 = a1 = val with
+ * the selectors zeroed -> alpha table {val,val,val,val} -> alpha = val for every
+ * texel. The colour (bytes 8..15) stays as the application wrote it: the test does
+ * not introduce a colour artefact, it only changes the mask.
+ */
+const void *
+_mesa_nv_texalpha_fixup(const struct gl_texture_object *t, GLint level,
+                        mesa_format fmt, GLsizei w, GLsizei h, GLsizei d,
+                        size_t imagesize, const void *data, void **out_tmp)
+{
+   static unsigned n_patch, n_skip;
+   static unsigned n_bump_upload, n_bump_blocks_tot;
+   unsigned n_blocks_bump = 0u;
+   const char *e = getenv("MESA_NV_TEXALPHA255");
+
+   if (out_tmp != NULL)
+      *out_tmp = NULL;
+
+   /* Counting only (changes nothing): see MESA_NV_TEXALPHA_COUNT above. */
+   {
+      const char *cc = getenv("MESA_NV_TEXALPHA_COUNT");
+      if (cc != NULL && *cc != '\0' && data != NULL && t != NULL && level == 0 && d == 1 &&
+          t->Name < NV_A255_MAX && util_format_is_compressed(fmt)) {
+         const char *nm = util_format_name(fmt);
+         const bool c5 = nm != NULL && (strstr(nm, "DXT5") != NULL || strstr(nm, "BC3") != NULL);
+         const bool c3 = nm != NULL && (strstr(nm, "DXT3") != NULL || strstr(nm, "BC2") != NULL);
+         if (c5 || c3) {
+            const unsigned bs = 8u;
+            const unsigned bw = ((unsigned) w + 3u) / 4u;
+            const unsigned bh = ((unsigned) h + 3u) / 4u;
+            const unsigned char *p = (const unsigned char *) data;
+            unsigned n255 = 0u, tot2 = 0u;
+            for (unsigned by = 0; by < bh; by++) {
+               for (unsigned bx = 0; bx < bw; bx++) {
+                  const size_t boff = (size_t) (by * bw + bx) * 16u;
+                  const unsigned a0 = p[boff], a1 = p[boff + 1];
+                  unsigned tab[8];
+                  if (c5) {
+                     if (a0 > a1) {
+                        tab[0]=a0; tab[1]=a1; tab[2]=(2*a0+a1)/3; tab[3]=(a0+2*a1)/3;
+                        tab[4]=0; tab[5]=0; tab[6]=0; tab[7]=0;
+                     } else {
+                        tab[0]=a0; tab[1]=a1; tab[2]=(a0*3+a1)/4; tab[3]=(a0+a1*3)/4;
+                        tab[4]=0; tab[5]=255; tab[6]=0; tab[7]=255;
+                     }
+                  }
+                  for (unsigned i = 0; i < 16u; i++) {
+                     unsigned v;
+                     if (c5) {
+                        const unsigned word = (unsigned) (boff + 2u + (i * 3u) / 8u);
+                        const unsigned shift = (i * 3u) % 8u;
+                        unsigned bits = p[word];
+                        if (shift > 5u && word + 1 < boff + 8u)
+                           bits |= (unsigned) p[word + 1] << 8;
+                        v = tab[(bits >> shift) & 7u];
+                     } else {
+                        const unsigned nib = p[boff + 2u + (i >> 1)];
+                        v = (unsigned) (((i & 1u) ? (nib >> 4) : (nib & 0xF)) * 17);
+                     }
+                     if ((unsigned) w < 4u * (bx + 1u)) {
+                        /* line shorter than the block: ignores texels outside the texture */
+                     }
+                     tot2++;
+                     if (v == 255u)
+                        n255++;
+                  }
+               }
+            }
+            nv_a255[t->Name] = n255;
+            nv_a255_tot[t->Name] = tot2;
+            if (nv_a255_tot[t->Name] != 0u)
+               fprintf(stderr, "MESA-NV A255: tex=%u %ux%u fmt=%s texel_a_255=%u/%u\n",
+                       t->Name, (unsigned) w, (unsigned) h, nm, n255, tot2);
+         }
+      }
+   }
+
+   /* The patch knob (MESA_NV_TEXALPHA255) is no longer the only way in: QUANT and
+       * KILL255 must be able to act without forcing alpha to the maximum, otherwise the
+       * A/B 'zero out the 255 texels' does not really happen (measured: a run with only
+       * KILL255 printed zero TEXALPHA lines, and the A/B was between two identities). */
+   const bool is_enabled = (e != NULL && *e != '\0');
+   const bool quant_enabled = getenv("MESA_NV_TEXALPHA_QUANT") != NULL;
+   const bool kill_enabled = getenv("MESA_NV_TEXALPHA_KILL255") != NULL;
+   const bool flipv_enabled = getenv("MESA_NV_TEXFLIPV") != NULL;
+   const char *bump_env = getenv("MESA_NV_TEXALPHA_BUMP");
+   const int bump_n = (bump_env != NULL && *bump_env != 0)
+                    ? (int) strtol(bump_env, NULL, 0) : 0;
+   const char *pat_env = getenv("MESA_NV_TEXALPHA_PATTERN");
+   const int pattern_n = (pat_env != NULL && *pat_env) ? (int) strtol(pat_env, NULL, 0) : 0;
+
+   if ((!is_enabled && !quant_enabled && !kill_enabled && pattern_n <= 0 && !flipv_enabled && bump_n == 0) || data == NULL || t == NULL)
+      return NULL;
+   if (w <= 0 || h <= 0 || d != 1)
+      return NULL;
+
+   int val = is_enabled ? (int) strtol(e, NULL, 0) : 0;
+   const char *sep = is_enabled ? strchr(e, ':') : NULL;
+   int dw = -1, dh = -1;
+   if (sep != NULL) {
+      const char *x = strchr(sep, 'x');
+      if (x != NULL) {
+         dw = (int) strtol(sep + 1, NULL, 0);
+         dh = (int) strtol(x + 1, NULL, 0);
+      }
+   }
+   if (val < 0)
+      val = 255;
+   if (val > 255)
+      val = 255;
+
+   /* A print cap on its own left an ambiguity: it was not possible to tell whether a
+       * texture of interest had been reached after the cap was exhausted.
+       * MESA_NV_TEXALPHA_WANTED=<n[,n...]> always prints those textures, whatever the
+       * count (it applies to both branches: DXT5 and RGBA8/SNORM). */
+   bool wanted = false;
+   {
+      const char *wl = getenv("MESA_NV_TEXALPHA_WANTED");
+      if (wl != NULL && *wl != '\0') {
+         const char *q = wl;
+         while (*q != '\0' && !wanted) {
+            char *end = NULL;
+            const long v = strtol(q, &end, 0);
+            if (end != NULL && end != q && (unsigned long) v == t->Name)
+               wanted = true;
+            if (end == NULL || *end != ',')
+               break;
+            q = end + 1;
+         }
+      }
+   }
+
+   /* Alpha BUMP (the 'add 1' workaround required for the bite): shifts the alpha
+       * TABLE of a DXT5 block by bump_n units, leaving the selectors alone, so the
+       * shape of the mask does not change while every decoded value goes up. It
+       * REQUIRES A FILTER (size or wanted name): without a filter we already measured
+       * that hundreds of textures get corrupted (MESA_NV_TEXALPHA_QUANT with no filter
+       * touched 507 uploads). */
+   bool bump_enabled = false;
+   if (bump_n != 0) {
+      bool filter_ok = wanted;
+      const char *bdim = getenv("MESA_NV_TEXALPHA_BUMP_DIM");
+      if (bdim != NULL && *bdim != 0) {
+         const char *x = strchr(bdim, 'x');
+         if (x != NULL) {
+            const int bw = (int) strtol(bdim, NULL, 0);
+            const int bh = (int) strtol(x + 1, NULL, 0);
+            if (bw > 0 && bh > 0 && w == bw && h == bh)
+               filter_ok = true;
+         }
+      }
+      if (filter_ok) {
+         bump_enabled = true;
+      } else if (n_patch + n_skip < 24u) {
+         fprintf(stderr, "MESA-NV TEXALPHA-BUMP: REJECTED tex=%u %dx%d (%+d): "
+                         "no matching filter (needs "
+                         "MESA_NV_TEXALPHA_BUMP_DIM=WxH o "
+                         "MESA_NV_TEXALPHA_WANTED=<obj_name>)\n",
+                 (unsigned) t->Name, (int) w, (int) h, bump_n);
+      }
+   }
+
+   if (dw <= 0) {
+      /* MESA_NV_TEXALPHA_DIM=WxH: size filter independent of the patch knob: without it
+             * the flip would hit EVERY DXT texture in the scene, not only the mask. */
+      const char *ad = getenv("MESA_NV_TEXALPHA_DIM");
+      if (ad != NULL && *ad) {
+         const char *xx = strchr(ad, 'x');
+         if (xx != NULL) {
+            dw = (int) strtol(ad, NULL, 0);
+            dh = (int) strtol(xx + 1, NULL, 0);
+         }
+      }
+   }
+   if (dw > 0 && (dw != (int) w || dh != (int) h)) {
+      if (n_skip < 6)
+         fprintf(stderr, "MESA-NV TEXALPHA: skipped tex=%u %dx%d (size not requested %dx%d)\n",
+                 t->Name, (int) w, (int) h, dw, dh);
+      n_skip++;
+      return NULL;
+   }
+   if (!util_format_is_compressed(fmt)) {
+      /* Uncompressed branch: this is where the hypothesis about SIGNED formats lives.
+             * MESA_NV_TEXALPHA255 also accepts RGBA8: for the SNORM variants the
+             * high-neutral value is not 0xFF but 0x7F (0xFF in SNORM is about -1.0, so if
+             * the mask arrives as SIGNED_RGBA8_NV and we treat it as SNORM, the shader
+             * threshold 256*(w - 255/256) never fires -> bite missing). */
+      const char *nm = util_format_name(fmt);
+      const bool snorm = nm != NULL && strstr(nm, "SNORM") != NULL;
+      const bool uint8 = nm != NULL && strstr(nm, "RGBA_UINT8") != NULL;
+      if (!snorm && !uint8) {
+         if (n_skip < 10)
+            fprintf(stderr, "MESA-NV TEXALPHA: skipped tex=%u fmt=%s (not RGBA8/SNORM)\n",
+                    t->Name, nm ? nm : "?");
+         n_skip++;
+         return NULL;
+      }
+      const size_t expected8 = (size_t) w * (size_t) h * 4;
+      if (imagesize != 0 && imagesize != expected8) {
+         if (n_skip < 10)
+            fprintf(stderr, "MESA-NV TEXALPHA: skipped tex=%u %dx%d fmt=%s imageSize=%u (expected %u)\n",
+                    t->Name, (int) w, (int) h, nm ? nm : "?",
+                    (unsigned) imagesize, (unsigned) expected8);
+         n_skip++;
+         return NULL;
+      }
+      unsigned char *tmp8 = (unsigned char *) malloc(expected8);
+      if (tmp8 == NULL)
+         return NULL;
+      memcpy(tmp8, data, expected8);
+      const int avalue = snorm ? 0x7F : (val > 127 ? 127 : val);
+      for (size_t q = 3; q < expected8; q += 4)
+         tmp8[q] = (unsigned char) (snorm ? 0x7F : 255);
+      if (n_patch < 500 || wanted)
+         fprintf(stderr, "MESA-NV TEXALPHA%s: tex=%u lvl=%d %dx%d fmt=%s -> alpha=%d%s\n",
+                 wanted ? " (WANTED)" : "", t->Name, level, (int) w, (int) h,
+                 nm ? nm : "?", snorm ? 0x7F : 255,
+                 snorm ? " (SNORM: 0x7F = +1.0)" : "");
+      n_patch++;
+      if ((n_patch % 100) == 0)
+         fprintf(stderr, "MESA-NV TEXALPHA: %u uploads with forced alpha\n", n_patch);
+      (void) avalue;
+      if (out_tmp != NULL)
+         *out_tmp = tmp8;
+      return tmp8;
+   }
+   if (util_format_get_blocksize(fmt) != 16) {
+      if (n_skip < 10)
+         fprintf(stderr, "MESA-NV TEXALPHA: skipped tex=%u fmt=#x%x (block not 16 bytes)\n",
+                 t->Name, (unsigned) fmt);
+      n_skip++;
+      return NULL;
+   }
+   /* The format has to be DXT5/BC3: its alpha section uses an interpolated table
+       * (a0, a1 plus 3-bit selectors). DXT3 has EXPLICIT alpha at 4 bits per texel: the
+       * same rewrite there would drive those nibbles to 0, not to 255 (measured: textures
+       * with fmt #xab, i.e. DXT3, had been 'fixed' too). */
+   /* DXT5/BC3: alpha with an interpolated table (a0, a1 + 3-bit selectors).
+       * DXT3/BC2: EXPLICIT alpha, 4 bits per texel (bytes 2..7): there the nibbles have
+       * to be set to 0xF, the TABLE must not be rewritten - the first version applied
+       * the DXT5 write to DXT3 as well and produced alpha 0, the opposite of what was
+       * needed (measured: the textures with fmt #xab were exactly DXT3).
+       * DXT1/BC1: no per-texel alpha, skip it. */
+   const char *name_fmt = util_format_name(fmt);
+   const bool e_dxt5 = name_fmt != NULL &&
+      (strstr(name_fmt, "DXT5") != NULL || strstr(name_fmt, "BC3") != NULL);
+   const bool e_dxt3 = name_fmt != NULL &&
+      (strstr(name_fmt, "DXT3") != NULL || strstr(name_fmt, "BC2") != NULL);
+   /* DXT1/BC1: 1-bit alpha (the 3-colour + transparent mode, or opaque with 4
+       * colours). To bring alpha to 1.0 on every texel one has to stay in the 4-colour
+       * mode: bit 15 cleared in both endpoints and c0 < c1, so no selector can land on
+       * the transparent case. The colour stays essentially the application's. */
+   const bool e_dxt1 = name_fmt != NULL &&
+      (strstr(name_fmt, "DXT1") != NULL || strstr(name_fmt, "BC1") != NULL);
+   if (!e_dxt5 && !e_dxt3 && !e_dxt1) {
+      if (n_skip < 10)
+         fprintf(stderr, "MESA-NV TEXALPHA: skipped tex=%u fmt=%s (alpha not per-texel)\n",
+                 t->Name, name_fmt ? name_fmt : "?");
+      n_skip++;
+      return NULL;
+   }
+
+   /* 2D level: 4x4 blocks of 16 bytes */
+   const size_t blkw = ((size_t) w + 3) / 4;
+   const size_t blkh = ((size_t) h + 3) / 4;
+   const size_t bytesperblocco = e_dxt1 ? 8u : 16u;
+   const size_t expected = blkw * blkh * bytesperblocco;
+   if (imagesize != expected) {
+      if (n_skip < 10)
+         fprintf(stderr, "MESA-NV TEXALPHA: skipped tex=%u %dx%d imageSize=%u (expected %u)\n",
+                 t->Name, (int) w, (int) h, (unsigned) imagesize, (unsigned) expected);
+      n_skip++;
+      return NULL;
+   }
+
+   const bool quantize = quant_enabled;
+   const bool kill255 = kill_enabled;
+   static unsigned n_killed;
+   static unsigned n_flip;
+   unsigned char *tmp = (unsigned char *) malloc(expected);
+   if (tmp == NULL)
+      return NULL;
+   memcpy(tmp, data, expected);
+   for (size_t b = 0; b + bytesperblocco <= expected; b += bytesperblocco) {
+      if (flipv_enabled && (e_dxt5 || e_dxt3 || e_dxt1)) {
+         /* MESA_NV_TEXFLIPV=1: flips the order of the texel ROWS of a compressed texture,
+                   * at every level. Why the knob exists: Timbury's mask (Color_Occ) holds both
+                   * colour and occlusion in the same DXT5 texture, and against the reference
+                   * video the disagreement streaks inside the leaf band are the typical
+                   * signature of an inverted row order (zink/Vulkan bottom-up against the DXT
+                   * block order). A wrong flip also moves the blobs of the mask: the bitten
+                   * area ends up on a non-visible part of the surface, which is the symptom of
+                   * the defect. A correct flip means inverting the rows of blocks AND inverting
+                   * the 4 rows inside each block (colour indices and alpha selectors). */
+         const unsigned bpl = e_dxt1 ? 8u : 16u;
+         const unsigned bwr = ((unsigned) w + 3u) / 4u;
+         const unsigned bhr = ((unsigned) h + 3u) / 4u;
+         unsigned char *src2 = (unsigned char *) malloc(expected);
+         static int n_flip_log;
+         if (n_flip_log < 24) {
+            n_flip_log++;
+            fprintf(stderr, "MESA-NV TEXFLIP: START tex=%u lvl=%d %ux%u bwr=%u bhr=%u bpl=%u expected=%u alloc=%p\n",
+                    t->Name, level, (unsigned) w, (unsigned) h, bwr, bhr, bpl,
+                    (unsigned) expected, (void *) src2);
+            fflush(stderr);
+         }
+         if (src2 != NULL) {
+            memcpy(src2, tmp, expected);
+            for (unsigned r = 0; r < bhr / 2u; r++) {
+               const size_t o1 = (size_t) r * bwr * bpl;
+               const size_t o2 = (size_t) (bhr - 1u - r) * bwr * bpl;
+               for (unsigned c = 0; c < bwr * bpl; c++) {
+                  const unsigned char sv = src2[o1 + c];
+                  tmp[o1 + c] = src2[o2 + c];
+                  tmp[o2 + c] = sv;
+               }
+            }
+            for (size_t bo = 0; bo + bpl <= expected; bo += bpl) {
+               unsigned char blk[16];
+               memcpy(blk, tmp + bo, bpl);
+               if (e_dxt1) {
+                  unsigned char idx[4];
+                  for (unsigned r = 0; r < 4; r++)
+                     idx[r] = blk[4 + r];
+                  for (unsigned r = 0; r < 4; r++)
+                     tmp[bo + 4 + r] = idx[3 - r];
+               }
+               else if (e_dxt3) {
+                  unsigned nib[16], col[16];
+                  for (unsigned i = 0; i < 16; i++) {
+                     nib[i] = (unsigned) ((blk[2 + (i >> 1)] >> ((i & 1u) * 4u)) & 0xFu);
+                     col[i] = (unsigned) ((blk[8 + (i >> 2)] >> ((i & 3u) * 2u)) & 3u);
+                  }
+                  for (unsigned i = 0; i < 8; i++)
+                     tmp[bo + 2 + i] = 0;
+                  for (unsigned y = 0; y < 4; y++) {
+                     for (unsigned x = 0; x < 4; x++) {
+                        const unsigned isrc = (3 - y) * 4 + x;
+                        const unsigned idst = y * 4 + x;
+                        tmp[bo + 2 + (idst >> 1)] |= (unsigned char) (nib[isrc] << ((idst & 1u) * 4u));
+                     }
+                  }
+                  for (unsigned y = 0; y < 4; y++) {
+                     unsigned byte = 0;
+                     for (unsigned x = 0; x < 4; x++)
+                        byte |= (col[(3 - y) * 4 + x] & 3u) << (2 * x);
+                     tmp[bo + 8 + y] = (unsigned char) byte;
+                  }
+               }
+               else {
+                  unsigned a_get[16], c_get[16];
+                  uint64_t abits = 0;
+                  for (unsigned k = 0; k < 6; k++)
+                     abits |= ((uint64_t) blk[2 + k]) << (8 * k);
+                  for (unsigned i = 0; i < 16; i++) {
+                     a_get[i] = (unsigned) ((abits >> (3 * i)) & 7u);
+                     c_get[i] = (unsigned) ((blk[8 + (i >> 2)] >> ((i & 3u) * 2u)) & 3u);
+                  }
+                  uint64_t abits2 = 0;
+                  for (unsigned y = 0; y < 4; y++) {
+                     for (unsigned x = 0; x < 4; x++) {
+                        const unsigned isrc = (3 - y) * 4 + x;
+                        const unsigned idst = y * 4 + x;
+                        abits2 |= ((uint64_t) a_get[isrc]) << (3 * idst);
+                     }
+                  }
+                  for (unsigned k = 0; k < 6; k++)
+                     tmp[bo + 2 + k] = (unsigned char) ((abits2 >> (8 * k)) & 0xFFu);
+                  for (unsigned y = 0; y < 4; y++) {
+                     unsigned byte = 0;
+                     for (unsigned x = 0; x < 4; x++)
+                        byte |= (c_get[(3 - y) * 4 + x] & 3u) << (2 * x);
+                     tmp[bo + 8 + y] = (unsigned char) byte;
+                  }
+               }
+            }
+            free(src2);
+            n_flip++;
+            if (n_flip_log <= 24) {
+               fprintf(stderr, "MESA-NV TEXFLIP: END tex=%u lvl=%d blocks=%u\n",
+                       t->Name, level, (unsigned) (expected / bpl));
+               fflush(stderr);
+            }
+         }
+      }
+      else if (pattern_n > 0 && e_dxt5) {
+         /* MESA_NV_TEXALPHA_PATTERN=<n>: a checkerboard of blocks (n blocks per cell) with
+                   * alpha 255 / 0. It exists to MEASURE the UV map: if the surface uses that
+                   * texture as a mask, the screen shows a checkerboard of discarded zones whose
+                   * period, compared with the size in texels, says how much of the texture the
+                   * object covers. It is also proof that the bite mechanism can produce a large
+                   * visible footprint: with the real mask (0.4 percent of texels at 255) the
+                   * effect is necessarily tiny. */
+         const unsigned bi = (unsigned) (b / 16u);
+         const unsigned bxi = bi % (unsigned) blkw;
+         const unsigned byi = bi / (unsigned) blkw;
+         const bool one = (((bxi / (unsigned) pattern_n) + (byi / (unsigned) pattern_n)) & 1u) != 0u;
+         tmp[b] = 255; tmp[b + 1] = 0;
+         if (one) {
+            memset(&tmp[b + 2], 0, 6);            /* selector 0 -> a0 = 255 everywhere */
+         } else {
+            uint64_t d = 0;
+            for (unsigned i = 0; i < 16; i++)
+               d |= ((uint64_t) 1u) << (3 * i);   /* selector 1 -> a1 = 0 everywhere */
+            for (unsigned k = 0; k < 6; k++)
+               tmp[b + 2 + k] = (unsigned char) ((d >> (8 * k)) & 0xFF);
+         }
+      }
+      else if (bump_enabled && e_dxt5) {
+         const int a0 = (int) tmp[b];
+         const int a1 = (int) tmp[b + 1];
+         int n0 = a0 + bump_n;
+         int n1 = a1 + bump_n;
+         if (n0 < 0)
+            n0 = 0;
+         if (n1 < 0)
+            n1 = 0;
+         if (n0 > 255)
+            n0 = 255;
+         if (n1 > 255)
+            n1 = 255;
+         if (n0 != a0 || n1 != a1) {
+            tmp[b] = (unsigned char) n0;
+            tmp[b + 1] = (unsigned char) n1;
+            n_blocks_bump++;
+         }
+      }
+      else if (kill255 && e_dxt5) {
+         /* MESA_NV_TEXALPHA_KILL255=1: zeroes ONLY the texels whose decoded alpha equals
+                   * exactly 255, leaving the others untouched. Falsification test: if the image
+                   * contains a bite, removing the 255 texels must make it disappear; if nothing
+                   * changes, those texels never reach the visible fragments and the hypothesised
+                   * mechanism (alpha 255 -> bite_area=1 -> alpha out 0 -> discard with
+                   * GL_NOTEQUAL ref=0) does not explain the defect. */
+         const unsigned a0o = tmp[b], a1o = tmp[b + 1];
+         unsigned tab[8];
+         if (a0o > a1o) {
+            tab[0]=a0o; tab[1]=a1o; tab[2]=(2*a0o+a1o)/3; tab[3]=(a0o+2*a1o)/3;
+            tab[4]=0; tab[5]=0; tab[6]=0; tab[7]=0;
+         } else {
+            tab[0]=a0o; tab[1]=a1o; tab[2]=(a0o*3+a1o)/4; tab[3]=(a0o+a1o*3)/4;
+            tab[4]=0; tab[5]=255; tab[6]=0; tab[7]=255;
+         }
+         uint64_t src = 0;
+         for (unsigned k = 0; k < 6; k++)
+            src |= ((uint64_t) tmp[b + 2 + k]) << (8 * k);
+         unsigned val[16];
+         unsigned mx = 0, mn = 255;
+         bool touched = false;
+         for (unsigned i = 0; i < 16; i++) {
+            unsigned v = tab[(unsigned) ((src >> (3 * i)) & 7)];
+            if (v == 255) { v = 0; touched = true; }
+            val[i] = v;
+            if (v > mx) mx = v;
+            if (v < mn) mn = v;
+         }
+         if (touched) {
+            const unsigned t0 = mx, t1 = mn;
+            unsigned nt[8];
+            if (t0 > t1) {
+               nt[0]=t0; nt[1]=t1; nt[2]=(2*t0+t1)/3; nt[3]=(t0+2*t1)/3;
+               nt[4]=0; nt[5]=0; nt[6]=0; nt[7]=0;
+            } else {
+               nt[0]=t0; nt[1]=t1; nt[2]=(t0*3+t1)/4; nt[3]=(t0+t1*3)/4;
+               nt[4]=0; nt[5]=255; nt[6]=0; nt[7]=255;
+            }
+            uint64_t dst = 0;
+            for (unsigned i = 0; i < 16; i++) {
+               unsigned best = 0, bestd = 0xFFFFFFFFu;
+               for (unsigned c = 0; c < 6; c++) {
+                  const unsigned dd = (nt[c] > val[i]) ? nt[c] - val[i] : val[i] - nt[c];
+                  if (dd < bestd) { bestd = dd; best = c; }
+               }
+               dst |= ((uint64_t) best) << (3 * i);
+            }
+            tmp[b] = (unsigned char) t0;
+            tmp[b + 1] = (unsigned char) t1;
+            for (unsigned k = 0; k < 6; k++)
+               tmp[b + 2 + k] = (unsigned char) ((dst >> (8 * k)) & 0xFF);
+            n_killed++;
+         }
+      }
+      else if (quantize && e_dxt3) {
+         /* DXT3: explicit 4-bit alpha per texel (byte 2..7, 16 texel) */
+         unsigned char nib[16];
+         for (unsigned i = 0; i < 16; i++) {
+            const unsigned src = (tmp[b + 2 + (i >> 1)] >> ((i & 1) * 4)) & 0xF;
+            nib[i] = (src >= 8) ? 0xF : 0x0;
+         }
+         for (unsigned i = 0; i < 8; i++)
+            tmp[b + 2 + i] = (unsigned char) (nib[2 * i] | (nib[2 * i + 1] << 4));
+      }
+      else if (quantize && e_dxt5) {
+         /* DXT5: sets the alpha table to {255, 0} and rewrites the selectors according to the
+                   * texel's original alpha (decoded with the starting block's table). It exists
+                   * to test the hypothesis that generated mipmaps soften alpha so the
+                   * byte-exact threshold 255/256 no longer fires: with pure extremes the
+                   * interpolation between adjacent texels stays on exact values. */
+         const unsigned a0 = tmp[b], a1 = tmp[b + 1];
+         unsigned tab[8];
+         if (a0 > a1) {
+            tab[0]=a0; tab[1]=a1; tab[2]=(2*a0+a1)/3; tab[3]=(a0+2*a1)/3;
+            tab[4]=0; tab[5]=0; tab[6]=0; tab[7]=0;
+         } else {
+            tab[0]=a0; tab[1]=a1; tab[2]=(a0*3+a1)/4; tab[3]=(a0+a1*3)/4;
+            tab[4]=0; tab[5]=255; tab[6]=0; tab[7]=255;
+         }
+         uint64_t src = 0;
+         for (unsigned i = 0; i < 6; i++)
+            src |= ((uint64_t) tmp[b + 2 + i]) << (8 * i);
+         uint64_t dst = 0;
+         for (unsigned i = 0; i < 16; i++) {
+            const unsigned code = (unsigned) ((src >> (3 * i)) & 7);
+            const unsigned v = tab[code];
+            dst |= ((uint64_t) ((v >= 128) ? 0u : 1u)) << (3 * i);  /* 0 -> a0=255, 1 -> a1=0 */
+         }
+         tmp[b] = 255; tmp[b + 1] = 0;
+         for (unsigned i = 0; i < 6; i++)
+            tmp[b + 2 + i] = (unsigned char) ((dst >> (8 * i)) & 0xFF);
+      }
+      else if (is_enabled && e_dxt3) {
+         /* every_n texel ha 4 bit di alpha: 0xF corresponds to 1.0 */
+         memset(&tmp[b + 2], 0xFF, 6);
+      }
+      else if (is_enabled && e_dxt1) {
+         unsigned c0 = (unsigned) tmp[b + 8] | ((unsigned) tmp[b + 9] << 8);
+         unsigned c1 = (unsigned) tmp[b + 10] | ((unsigned) tmp[b + 11] << 8);
+         c0 &= 0x7FFFu;  /* bit 15 = 0 -> 4-colour mode, nothing transparent */
+         c1 &= 0x7FFFu;
+         if (c0 > c1) {
+            unsigned s = c0; c0 = c1; c1 = s;   /* we need c0 < c1 */
+         }
+         if (c0 == c1)
+            c1 = (c1 + 1) & 0x7FFFu;
+         tmp[b + 8] = (unsigned char) (c0 & 0xFF);
+         tmp[b + 9] = (unsigned char) (c0 >> 8);
+         tmp[b + 10] = (unsigned char) (c1 & 0xFF);
+         tmp[b + 11] = (unsigned char) (c1 >> 8);
+      }
+      else if (is_enabled) {
+         tmp[b] = (unsigned char) val;
+         tmp[b + 1] = (unsigned char) val;
+         memset(&tmp[b + 2], 0, 6); /* selectors 0 -> table {val,val,val,val} */
+      }
+   }
+
+      if (bump_enabled) {
+         if (n_bump_upload < 40u || wanted) {
+            fprintf(stderr, "MESA-NV TEXALPHA-BUMP: tex=%u lvl=%d %dx%d +%d "
+                            "blocks_modified=%u (total=%u over %u uploads)\n",
+                    (unsigned) t->Name, level, (int) w, (int) h, bump_n,
+                    n_blocks_bump, n_bump_blocks_tot + n_blocks_bump,
+                    n_bump_upload + 1u);
+         }
+         n_bump_upload++;
+         n_bump_blocks_tot += n_blocks_bump;
+      }
+
+   if (n_patch < 500 || wanted)
+      fprintf(stderr, "MESA-NV TEXALPHA%s: tex=%u lvl=%d %dx%d fmt=%s -> upload touched (type=%s blocks_255_zeroed=%u flip=%u)\n",
+              wanted ? " (WANTED)" : "", t->Name, level, (int) w, (int) h,
+              name_fmt ? name_fmt : "?",
+              e_dxt3 ? "DXT3 explicit" : (e_dxt1 ? "DXT1 1-bit" : "DXT5 table"),
+              n_killed, n_flip);
+   n_patch++;
+   if ((n_patch % 100) == 0)
+      fprintf(stderr, "MESA-NV TEXALPHA: %u uploads with forced alpha\n", n_patch);
+   if (out_tmp != NULL)
+      *out_tmp = tmp;
+   return tmp;
+}
