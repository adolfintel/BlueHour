+/* Hash table keyed by CLIENT POINTER, not by binding index: the app reassigns the indices
+ * continuously, so a per-index cache misses at every draw (and recreating the GPU resource at
+ * every draw is disastrous: measured, fps 24 -> 19 with p90 at 52 ms). */
+#define NV_VB_BUCKETS 2048
+static struct nv_vb_entry nv_vb_tab[NV_VB_BUCKETS];
+
+static struct nv_vb_entry *
+nv_vb_find(const uint8_t *ptr, bool create)
+{
+   unsigned h = (((uintptr_t) ptr >> 6) * 2654435761u) & (NV_VB_BUCKETS - 1);
+
+   while (nv_vb_tab[h].user != NULL && nv_vb_tab[h].user != ptr)
+      h = (h + 1) & (NV_VB_BUCKETS - 1);
+   if (nv_vb_tab[h].user == NULL && !create)
+      return NULL;
+   if (nv_vb_tab[h].user == NULL)
+      nv_vb_tab[h].user = ptr;
+   return &nv_vb_tab[h];
