+#ifndef GL_RGBA8_SNORM
+#define GL_RGBA8_SNORM 0x8F97
+#endif
+#ifndef GL_UNSIGNED_IDENTITY_NV
+#define GL_UNSIGNED_IDENTITY_NV 0x8536
+#endif
+#ifndef GL_UNSIGNED_INVERT_NV
+#define GL_UNSIGNED_INVERT_NV 0x8537
+#endif
+#ifndef GL_EXPAND_NORMAL_NV
+#define GL_EXPAND_NORMAL_NV 0x8538
+#endif
+#ifndef GL_EXPAND_NEGATE_NV
+#define GL_EXPAND_NEGATE_NV 0x8539
+#endif
+#ifndef GL_SIGNED_NV
+#define GL_SIGNED_NV 0x8891
+#endif
+
+extern void GLAPIENTRY
+_mesa_TexImage2D(GLenum target, GLint level, GLint internalFormat,
+                 GLsizei width, GLsizei height, GLint border,
+                 GLenum format, GLenum type, const void *pixels);
+
+/* The unsigned->signed remap requested with GL_TEXTURE_UNSIGNED_REMAP_MODE_NV
+ * (clients of that era, such as the NVIDIA demo "Dusk", used it for bump maps:
+ * GL_EXPAND_NORMAL_NV = 2x-1) is a property of the *texture*: hardware applied it
+ * in the fetch.  Applying it to the sampling program does not work, because the
+ * same program samples different materials on the same unit.  Here the texels are
+ * rewritten into a texture holding signed values: the fetch then returns exactly
+ * the requested value, for that texture and only that one, with no
+ * re-translation.
+ *
+ * Known limit: the original unsigned data is not kept, so a later change of the
+ * mode on the same texture cannot be undone (never observed with the clients we
+ * looked at).
+ */
+void
+_mesa_nv_apply_tex_remap(struct gl_context *ctx, struct gl_texture_object *t)
+{
+   static bool busy;
+   GLfloat *buf[16][6];
+   GLsizei w[16], h[16];
+   unsigned mode;
+   int face, faces, level, levels, u, tgt_idx, unit_saved = -1, n_levels = 0;
+
+   if (busy || !t)
+      return;
+
+   /* A/B test: turns the texel conversion off */
+   if (getenv("MESA_NV_NO_TEX_REMAP"))
+      return;
+
+   mode = t->NvUnsignedRemap;
+   if (_mesa_nv_debug() && mode)
+      fprintf(stderr, "MESA-NV apply_remap tex %u: branch_name %#x, target %#x, "
+                      "last level %u\n", t->Name, mode, t->Target,
+              (unsigned) t->lastLevel);
+
+   if (!mode || t->NvRemapApplied == mode)
+      return;
+
+   /* Already signed formats have nothing to convert back;
+    * GL_UNSIGNED_INVERT_NV (1-x) does not produce negative values and can stay in
+    * the fetch.
+    */
+   if (mode != GL_EXPAND_NORMAL_NV && mode != GL_EXPAND_NEGATE_NV)
+      return;
+
+   tgt_idx = _mesa_tex_target_to_index(ctx, t->Target);
+   if (tgt_idx < 0 || tgt_idx == TEXTURE_3D_INDEX ||
+       tgt_idx == TEXTURE_2D_ARRAY_INDEX)
+      return;
+
+   faces = (tgt_idx == TEXTURE_CUBE_INDEX) ? 6 : 1;
+
+   levels = (int) t->lastLevel + 1;
+   if (levels <= 0 || levels > 16)
+      return;
+
+   /* glTexImage regenerates the images of the "current" texture of the current
+    * unit: we use a unit where the texture is already bound.
+    */
+   for (u = 0; unit_saved < 0 && u <= (int) ctx->Const.MaxTextureUnits; u++) {
+      if (ctx->Texture.Unit[u].CurrentTex[tgt_idx] == t) {
+         unit_saved = (int) ctx->Texture.CurrentUnit;
+         ctx->Texture.CurrentUnit = u;
+      }
+   }
+   if (unit_saved < 0) {
+      if (_mesa_nv_debug())
+         fprintf(stderr, "MESA-NV remap tex %u: bound to no unit, "
+                         "deferred\n", t->Name);
+      return;
+   }
+
+   memset(buf, 0, sizeof buf);
+   memset(w, 0, sizeof w);
+   memset(h, 0, sizeof h);
+   busy = true;
+
+   /* Read and convert all levels first: reloading level 0 may free the images of
+    * the others.
+    */
+   for (level = 0; level < levels; level++) {
+      for (face = 0; face < faces; face++) {
+         struct gl_texture_image *ti = t->Image[face][level];
+         GLubyte *src = NULL;
+         GLint stride = 0;
+         GLfloat *f;
+
+         if (!ti || ti->TexFormat == MESA_FORMAT_NONE) {
+            /* Clients of this era may set GL_TEXTURE_MAX_LEVEL and
+             * GL_GENERATE_MIPMAP before the lower levels actually exist.  The
+             * signed rewrite of the base level makes the generated levels signed
+             * too; missing levels must not abort the whole texture. */
+            if (level > 0)
+               continue;
+            goto out;
+         }
+         if (ti->Width <= 0 || ti->Height <= 0 ||
+             ti->Width > 2048 || ti->Height > 2048)
+            goto out;
+
+         f = buf[level][face] = malloc((size_t) ti->Width * ti->Height * 4 *
+                                       sizeof(GLfloat));
+         if (!f)
+            goto out;
+         w[level] = ti->Width;
+         h[level] = ti->Height;
+
+         st_MapTextureImage(ctx, ti, 0, 0, 0, ti->Width, ti->Height,
+                            GL_MAP_READ_BIT, &src, &stride);
+         if (!src) {
+            st_UnmapTextureImage(ctx, ti, 0);
+            goto out;
+         }
+         if (_mesa_is_format_compressed(ti->TexFormat))
+            _mesa_decompress_image(ti->TexFormat, ti->Width, ti->Height, src,
+                                   stride, f);
+         else
+            _mesa_format_convert(f, MESA_FORMAT_RGBA_FLOAT32,
+                                 ti->Width * 4 * sizeof(GLfloat),
+                                 src, ti->TexFormat, stride, ti->Width,
+                                 ti->Height, NULL);
+         st_UnmapTextureImage(ctx, ti, 0);
+
+         {
+            double sum[3] = { 0, 0, 0 };
+            double sum2[3] = { 0, 0, 0 };
+
+            for (int i = 0; i < ti->Width * ti->Height; i++)
+               for (int c = 0; c < 3; c++) {
+                  sum[c] += f[i * 4 + c];
+                  sum2[c] += f[i * 4 + c] * f[i * 4 + c];
+               }
+            if (_mesa_nv_debug() && level == 0)
+               fprintf(stderr, "MESA-NV apply_remap tex %u level 0 BEFORE: "
+                               "R %.4f G %.4f B %.4f (dev.std R %.4f)\n",
+                       t->Name, sum[0] / (ti->Width * ti->Height),
+                       sum[1] / (ti->Width * ti->Height),
+                       sum[2] / (ti->Width * ti->Height),
+                       sqrt(sum2[0] / (ti->Width * ti->Height) -
+                            pow(sum[0] / (ti->Width * ti->Height), 2)));
+         }
+
+         for (int i = 0; i < ti->Width * ti->Height; i++) {
+            GLfloat *px = f + i * 4;
+
+            /* the alpha channel stays as it is: the remap concerns the colour */
+            for (int c = 0; c < 3; c++)
+               px[c] = mode == GL_EXPAND_NEGATE_NV ? 1.0f - 2.0f * px[c]
+                                                   : 2.0f * px[c] - 1.0f;
+         }
+
+         if (_mesa_nv_debug() && level == 0) {
+            double sum = 0;
+
+            for (int i = 0; i < ti->Width * ti->Height; i++)
+               sum += f[i * 4];
+            fprintf(stderr, "MESA-NV apply_remap tex %u level 0 AFTER: "
+                            "R %.4f, first texel: %.4f %.4f %.4f %.4f "
+                            "(fmt before %s)\n", t->Name,
+                    sum / (ti->Width * ti->Height), f[0], f[4], f[8], f[12],
+                    _mesa_get_format_name(ti->TexFormat));
+         }
+      }
+   }
+
+   for (level = 0; level < levels; level++) {
+      for (face = 0; face < faces; face++) {
+         GLenum target = (tgt_idx == TEXTURE_CUBE_INDEX)
+            ? (GLenum) (GL_TEXTURE_CUBE_MAP_POSITIVE_X + face) : t->Target;
+
+         if (!buf[level][face])
+            continue;
+         _mesa_TexImage2D(target, level, GL_RGBA8_SNORM, w[level], h[level],
+                          0, GL_RGBA, GL_FLOAT, buf[level][face]);
+         n_levels++;
+      }
+   }
+
+   if (n_levels) {
+      t->NvRemapApplied = mode;
+      if (_mesa_nv_debug())
+         fprintf(stderr, "MESA-NV remap embedded in the texture buffer data "
+                         "%u: %d faces/levels, branch_name %#x\n", t->Name,
+                 n_levels, mode);
+   }
+
+out:
+   busy = false;
+   for (level = 0; level < 16; level++)
+      for (face = 0; face < 6; face++)
+         free(buf[level][face]);
+   ctx->Texture.CurrentUnit = unit_saved;
+}
+
+/* The signed remap requested with GL_TEXTURE_UNSIGNED_REMAP_MODE_NV has to be
+ * resolved at draw time: when an NV program is translated (at load/bind) the
+ * textures of its units are not bound yet, so reading the state at that point
+ * yields nothing.  Here we compute a signature of the units modes and, if it
+ * changes, the program gets re-translated.
+ */
+void
+_mesa_nv_update_remap(struct gl_context *ctx)
+{
+   struct gl_program *prog = ctx->FragmentProgram._Current;
+   uint16_t modes[32];
+   uint32_t sig = 0;
+   int u;
+
+   if (!prog || !ctx->Extensions.NV_fragment_program)
+      return;
+
+   /* By default the remap lives in the texture (_mesa_nv_apply_tex_remap): the
+    * per-program resolution is only a comparison tool.
+    */
+   if (!getenv("MESA_NV_PROGRAM_REMAP"))
+      return;
+
+   for (u = 0; u < 32; u++) {
+      uint16_t m = 0;
+
+      if (u <= (int) ctx->Texture._MaxEnabledTexImageUnit) {
+         for (int ti = 0; ti < NUM_TEXTURE_TARGETS; ti++) {
+            const struct gl_texture_object *t =
+               ctx->Texture.Unit[u].CurrentTex[ti];
+
+            if (t && t->NvUnsignedRemap) {
+               m = t->NvUnsignedRemap;
+               break;
+            }
+         }
+      }
+      modes[u] = m;
+      if (m)
+         sig |= (1u << u);
+   }
+
+   if (prog->NvRemapValid && prog->NvRemapSig == sig)
+      return;
+
+   if (!sig) {
+      prog->NvRemapValid = true;
+      return;
+   }
+
+   for (u = 0; u < 32; u++)
+      prog->NvRemapMode[u] = modes[u];
+   prog->NvRemapSig = sig;
+   prog->NvRemapValid = true;
+
+   NV_TRACE("remap resolved at draw time for program %u: signature %#x",
+            prog->Id, sig);
+   if (!st_program_string_notify(ctx, GL_FRAGMENT_PROGRAM_ARB, prog))
+      NV_TRACE("retranslation of program %u failed", prog->Id);
+}
+
+static int
+alpha_bits_of_unit(const struct gl_context *ctx, unsigned u)
+{
+   const struct gl_texture_object *t = ctx->Texture.Unit[u]._Current;
+   if (!t)
+      return -1;
+   const struct gl_texture_image *img = t->Image[0][CLAMP(t->Attrib.BaseLevel, 0, (GLint) t->lastLevel)];
+   if (!img)
+      return -2;
+   return util_format_has_alpha(img->TexFormat) ? 1 : 0;
+}
+
+
+static unsigned
+fmt_of_unit(const struct gl_context *ctx, unsigned u)
+{
+   const struct gl_texture_object *t = ctx->Texture.Unit[u]._Current;
+   if (!t)
+      return 0;
+   const struct gl_texture_image *img = t->Image[0][CLAMP(t->Attrib.BaseLevel, 0, (GLint) t->lastLevel)];
+   return img ? (unsigned) img->TexFormat : 0u;
+}
