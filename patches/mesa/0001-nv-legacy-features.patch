+/* ------------------------------------------------------------------ */
+/* vertex attributes                                                   */
+/* ------------------------------------------------------------------ */
+
+/* ---- FEATURE: resolve NV-era attribute offsets against the buffer bound at draw time ----
+ * Measured 2026-11-12 on Mad Mod Mike, against the reference trace of the same demo.
+ *
+ * Mike specifies the attributes of the pass that composes the frame with the NV entry point and
+ * a null pointer, which for that API means "offset 0, to be resolved later":
+ *   glVertexAttribPointerNV(index = 0, size = 3, type = GL_FLOAT, stride = 12, pointer = NULL)
+ * The same call shape reaches our chain: witness MESA-NV ATTRIBPTRNV counts 348514 calls of
+ * index=0 size=3 type=0x1406 stride=12 with ptr=(nil). The reference trace of the demo has
+ * 561506 of them over 640 frames, and the surrounding sequence is
+ *   glBindBufferARB(target = GL_ARRAY_BUFFER, buffer = 49)
+ *   glVertexAttribPointerNV(index = 0, ... pointer = NULL)
+ *   glEnableClientState(array = GL_VERTEX_ATTRIB_ARRAY0_NV)
+ *   glBindBufferARB(target = GL_ELEMENT_ARRAY_BUFFER, buffer = 50)
+ *   glDrawElements(mode = GL_TRIANGLE_STRIP, count = 4, type = GL_UNSIGNED_SHORT, indices = NULL)
+ *
+ * What the era driver did is resolve the null offset against the buffer bound WHEN THE DRAW
+ * RUNS. Our chain leaves the attribute without any data source instead: the census limited to
+ * the two programs of that pass reported, on 9000 sampled draws out of 9000, that the slot the
+ * program reads as v[0] has ptr=(nil) and buffer=0, in every frame and not only in the
+ * introduction. The four corners of a triangle strip then collapse onto one point, the pass
+ * paints nothing, and with the demo's own materials the frame came out 63 to 78 percent black.
+ * Slots specified with small offsets (0x10, 0x20, 0x30, 0x40, interleaved 80-byte vertex
+ * records) are the other face of the same thing: with no buffer those offsets are near-null
+ * client addresses, which is the wild read that shows up as a vertex explosion.
+ *
+ * So: at draw time, for the slots this context specified through the NV entry point, that are
+ * enabled and that have no buffer at all, point the binding at the buffer currently bound to
+ * GL_ARRAY_BUFFER and leave the offset the application asked for. Genuine client pointers are
+ * excluded by the address test, and slots never specified through the NV API are never touched.
+ *
+ * Knob: MESA_NV_NVATTRIB_DRAW_RESOLVE=0 disables it. Note the difference from
+ * MESA_NV_NVATTRIB_LATE_VBO (off by default), which replays the recorded requests when
+ * ARRAY_BUFFER is bound: measured here that is too late and it is the wrong buffer, because the
+ * application binds the buffer BEFORE specifying the attribute, so the replay fires on a later
+ * unrelated bind. This function runs at draw time, which is when the era driver resolved it.
+ */
+static bool
+nv_attrib_draw_resolve_active(struct gl_context *ctx)
+{
+   static int cached = -1;
+
+   if (cached < 0) {
+      const char *v = getenv("MESA_NV_NVATTRIB_DRAW_RESOLVE");
+      /* Measured 2026-11-13: once the nested-diamond predicate of nv_to_arb.c is
+       * corrected, this repair changes nothing on Mad Mod Mike (black area
+       * 1.5 1.5 4.1 2.4 percent with it on, the same four numbers with it off), and on
+       * GasStation, Dusk, Timbury and Nalu the difference stays inside the run-to-run
+       * noise measured with identical settings (gas 3.30 and 3.87 percent against 3.50
+       * and 3.83 percent for the control pair; dusk 12.57 and 12.11 against 12.43 and
+       * 11.70; timbury 0.19 and 0.20; nalu 3.47 against 7.30 and 7.31 for the control
+       * pairs). The "no vertex data at all" reading that motivated the repair came from
+       * MESA_NV_TRACE_VERTS6, which is not a neutral probe on Mike, so that hole was
+       * the probe's own. The code stays available but is off by default:
+       * MESA_NV_NVATTRIB_DRAW_RESOLVE=1 turns it back on for experiments. */
+      cached = (v != NULL && *v != 0 && *v != '0') ? 1 : 0;
+   }
+   if (!cached)
+      return false;
+   return ctx->Extensions.NV_vertex_program;
+}
+
+void
+_mesa_nv_resolve_nv_attribs_at_draw(struct gl_context *ctx)
+{
+   struct gl_vertex_array_object *vao = ctx->Array.VAO;
+   struct gl_buffer_object *bo;
+   unsigned i, touched = 0;
+
+   if (!nv_attrib_draw_resolve_active(ctx) || vao == NULL || vao->BufferBinding == NULL)
+      return;
+
+   bo = ctx->Array.ArrayBufferObj;
+
+
+   /* Repair the effective binding of attributes specified through the NV entry point.
+    *
+    * Measured 2026-11-12 on Mad Mod Mike, on the draws of the pass that composes the frame
+    * (vertex program 115 and 116 with fragment program 117, 5879 draws over the run): the
+    * binding the application specified is complete, "slot15buf=1312 slot15off=0", the buffer is
+    * the one that was bound at specify time ("reqbuf=1312") and is still bound at draw time
+    * ("ab=1312"). The binding Mesa derives for the same attribute, which is the one the
+    * renderer actually reads, is empty: "mode=2 effb=0 effbuf=0". mode 2 is
+    * ATTRIBUTE_MAP_MODE_GENERIC0, chosen by varray.c because the application enabled the generic
+    * attribute 0 through glEnableClientState(GL_VERTEX_ATTRIB_ARRAY0_NV) without ever enabling
+    * the conventional vertex array. The result is that the four corners of every triangle strip
+    * read a constant, the strip degenerates, the pass paints nothing, and with the demo's own
+    * materials the frame comes out 63 to 78 percent black.
+    *
+    * The era behaviour for NV vertex programs is a 1:1 attribute mapping: v[0] is the attribute
+    * the application pointed, nothing else. So when an NV-specified attribute is enabled, has a
+    * real buffer in its own binding, and its effective binding has none, the mapping is put back
+    * to identity and the derived state recomputed. This is guarded to contexts that actually use
+    * the NV attribute entry points and to VAOs where the conventional vertex array is not
+    * enabled, so modern paths are never touched. If the recomputation is not enough, the buffer
+    * and the offset of the specified binding are copied onto the effective one.
+    */
+   if (!(vao->Enabled & VERT_BIT_POS) && _mesa_nv_uses_nv_attrib_api()) {
+      for (i = 0; i < ARRAY_SIZE(ctx->NV.NvAttribPointerReq); i++) {
+         const struct gl_array_attributes *a = &vao->VertexAttrib[VERT_ATTRIB_GENERIC(i)];
+         const struct gl_vertex_buffer_binding *spec = &vao->BufferBinding[a->BufferBindingIndex];
+         struct gl_vertex_buffer_binding *eff = &vao->BufferBinding[a->_EffBufferBindingIndex];
+
+         if (!ctx->NV.NvAttribPointerReq[i].Valid)
+            continue;
+         if (!(vao->Enabled & BITFIELD64_BIT(VERT_ATTRIB_GENERIC(i))))
+            continue;
+         if (a->_EffBufferBindingIndex == a->BufferBindingIndex)
+            continue;
+         if ((eff->BufferObj != NULL && eff->BufferObj->Name != 0) ||
+             spec->BufferObj == NULL || spec->BufferObj->Name == 0)
+            continue;
+
+         if (vao->_AttributeMapMode != ATTRIBUTE_MAP_MODE_IDENTITY) {
+            vao->_AttributeMapMode = ATTRIBUTE_MAP_MODE_IDENTITY;
+            _mesa_update_vao_derived_arrays(ctx, vao, false);
+         }
+
+         eff = &vao->BufferBinding[a->_EffBufferBindingIndex];
+         if ((eff->BufferObj == NULL || eff->BufferObj->Name == 0) &&
+             a->_EffBufferBindingIndex != a->BufferBindingIndex) {
+            _mesa_reference_buffer_object(ctx, &eff->BufferObj, spec->BufferObj);
+            eff->Offset = spec->Offset;
+            eff->Stride = spec->Stride;
+         }
+
+         ctx->Array.NewVertexElements = true;
+         ST_SET_STATE(ctx->NewDriverState, ST_NEW_VERTEX_ARRAYS);
+         touched++;
+         break;
+      }
+   }
+
+
+   if (bo == NULL || bo->Name == 0)
+      return;
+
+   for (i = 0; i < ARRAY_SIZE(ctx->NV.NvAttribPointerReq); i++) {
+      struct gl_array_attributes *a = &vao->VertexAttrib[VERT_ATTRIB_GENERIC(i)];
+      struct gl_vertex_buffer_binding *b;
+
+      /* Only slots this context has specified through the NV entry point. The recording also
+          * accepts a null pointer, which is the case this feature is about. */
+      if (!ctx->NV.NvAttribPointerReq[i].Valid)
+         continue;
+      if (!(vao->Enabled & BITFIELD64_BIT(VERT_ATTRIB_GENERIC(i))))
+         continue;
+      b = &vao->BufferBinding[a->BufferBindingIndex];
+      if (b->BufferObj != NULL && b->BufferObj->Name != 0)
+         continue;
+      /* A large value here is a real client address, not an offset into a buffer. */
+      if ((uintptr_t) b->Offset >= 0x10000)
+         continue;
+
+      _mesa_reference_buffer_object(ctx, &b->BufferObj, bo);
+      touched++;
+
+   }
+
+   if (!touched)
+      return;
+
+   ST_SET_STATE(ctx->NewDriverState, ST_NEW_VERTEX_ARRAYS);
+   if (!ctx->Const.UseVAOFastPath)
+      ctx->Array.NewVertexElements = true;
+   _mesa_update_vao_derived_arrays(ctx, vao, false);
+}
+
+void GLAPIENTRY
+_mesa_VertexAttribPointerNV(GLuint index, GLint size, GLenum type,
+                            GLsizei stride, const void *pointer)
+{
+ 
+   GET_CURRENT_CONTEXT(ctx);
+
+   if (!nv_has_vp(ctx, "glVertexAttribPointerNV"))
+      return;
+
+   /* NV_vertex_program has no "normalized" flag: integer components are
+    * converted to floating point without any scaling.
+    */
+
+
+   _mesa_VertexAttribPointer(index, size, type, GL_FALSE, stride, pointer);
+
+
+   /* Records the request for the late resolution (struct gl_nv_state in mtypes.h). Only the
+       * pointers that look like buffer offsets: a real client pointer has a large address and must not
+       * be touched.
+       *
+       * Measured 2026-11-12 on Mad Mod Mike: the bloom/quadrant pass issues 561506
+       * glVertexAttribPointerNV(index = 0, size = 3, type = GL_FLOAT, stride = 12,
+       * pointer = NULL) and binds the vertex buffer only later, so NULL is exactly the
+       * era case of an offset resolved at draw time. Skipping NULL left the slot with no
+       * data source at draw time (the draw-time census reads ptr=0 buf=0 bsz=0 on the slot
+       * the program reads as v[0]), the four corners of every strip collapsed onto the
+       * current generic value, and the pass painted nothing: with the demo's own materials
+       * the frame came out 63 to 75 percent black. A NULL pointer is therefore recorded as
+       * offset 0; real client pointers are still excluded by the address test. */
+   if (index < 16 && (pointer == NULL || (uintptr_t) pointer < 0x10000)) {
+
+      ctx->NV.NvAttribPointerReq[index].Size = size;
+      ctx->NV.NvAttribPointerReq[index].Type = type;
+      ctx->NV.NvAttribPointerReq[index].Stride = stride;
+      ctx->NV.NvAttribPointerReq[index].Offset = (uintptr_t) pointer;
+      ctx->NV.NvAttribPointerReq[index].BufferName =
+         ctx->Array.ArrayBufferObj ? ctx->Array.ArrayBufferObj->Name : 0u;
+      ctx->NV.NvAttribPointerReq[index].Valid = true;
+   }
+}
+
+/* Map an NV attribute pname onto the core pname that reads the same thing. */
