+         1 : ctx->Const.QueryCounterBits.SamplesPassed;
+      return;
+   case GL_CURRENT_OCCLUSION_QUERY_ID_NV:
+      *params = q->Active ? (GLint) q->Id : 0;
+      return;
+   default:
