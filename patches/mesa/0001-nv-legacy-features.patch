+
+/* nvlegacy (fork): GPU snapshot of every pbuffer store's zs into the application's texture,
+ * done at END OF FRAME (at the windows swap).
+ *
+ * Why at end of frame and not at delivery: it is MEASURED that the deliveries
+ * (wglBindTexImageARB of depth) are 13 out of 717 frames, while the shadow pass draws the
+ * map in nearly every frame - so a copy at delivery time copies a store that is STILL EMPTY
+ * and the app's texture stayed empty forever (shadow missing).
+ *
+ * Why a copy and not sharing: sharing lets the sampler read the map mid-draw (shared memory
+ * without synchronisation), giving flicker and tearing, exactly the glitch the user
+ * described.
+ *
+ * The drawable's zs format is aligned to the textures (MESA-RT-FORMAT) so the blit is
+ * legal with identical formats (llvmpipe does not accept zs conversions in a blit). */
+void
+dri_rt_snapshot_depth(struct st_context *st)
+{
+   /* MEASUREMENT: all three pairs are copied (texture 64 about 35888, 65 about 35886, 12 about
+       * 35915 over about 1029 frames = about 35 copies per pair per frame), so the stores all reach the
+       * sampler. But the timing is wrong: the app changes light several times per frame (277 binds:
+       * light A -> copy -> sampling -> light B -> copy ->...) and we were suppressing those copies,
+       * filling the texture at arbitrary points, so the app sampled a DIFFERENT light's map = shadows
+       * "projected from the wrong point" (the user's report). The snapshot at flush_front therefore
+       * became experimental: MESA_NV_RT_SNAP=1. */
+   if (!nv_rt_snap_enabled())
+      return;
+   dri_rt_hook_registered();   /* the hook is needed even without the flush_front snapshot */
+
+   const unsigned n = _mesa_nv_rt_depth_alias_count();
+   struct pipe_context *pipe = st->pipe;
+   static unsigned done, skipped, calls, seen, no_tex, seen_entries;
+   static uint64_t pairs[16];
+   static unsigned pair_counts[16];
+   static unsigned n_pairs;
+   static uint64_t copy_keys[16];
+   static unsigned copy_frames[16];
+   static unsigned copy_count;
+   unsigned k;
+
+   calls++;
+   if (!n || !pipe || !pipe->blit) {
+      if (dri_rt_alias_verbose() && calls <= 30)
+         fprintf(stderr, "nvlegacy MESA-RT-SNAP-PASSED: calls=%u entries=%u pipe=%s blit=%s \n",
+                 calls, n, pipe ? "ok" : "nothing", (pipe && pipe->blit) ? "ok" : "nothing");
+      return;
+   }
+
+   for (k = 0; k < n; k++) {
+      uintptr_t key = 0;
+      struct gl_texture_object *texObj = NULL;
+      struct dri_drawable *d;
+      struct pipe_resource *pt, *zs, *pt_chk;
+      struct pipe_blit_info blit;
+
+      _mesa_nv_rt_depth_alias_at(k, &key, &texObj);
+      if (!key || !texObj) {
+         /* This branch used to be SILENT: a registered entry whose texture no longer exists is not
+                   * copied and nothing shows it - exactly the case of the two 1024^2 stores (texture 12
+                   * and 65) that never get updated. */
+         no_tex++;
+         if (dri_rt_alias_verbose() && seen_entries < 12) {
+            seen_entries++;
+            fprintf(stderr, "nvlegacy MESA-RT-DEAD-ENTRY: index=%u drawable=%p texture=%s  "
+                    "(entry recorded but the texture no longer exists : store not updated )\n",
+                    k, (void *) key, texObj ? "viva" : "DEAD ");
+         }
+         continue;
+      }
+      /* `base` is the first field of `struct dri_drawable` (dri_drawable.h:46): the key stored in
+             * the core is the pointer to pipe_frontend_drawable, so the conversion is correct
+             * (verified: the values at the two places coincide). */
+      d = (struct dri_drawable *) (void *) key;
+      zs = d->textures[ST_ATTACHMENT_DEPTH_STENCIL];
+      pt = st_get_texobj_resource(texObj);
+      if (dri_rt_alias_verbose() && seen_entries < 12)
+         fprintf(stderr, "nvlegacy MESA-RT-ENTRY[%u]: drawable=%p texture=%u zs=%s pt=%s "
+                 "%dx%d vs %dx%d format %s/%s \n", k, (void *) key, texObj->Name,
+                 zs ? "present" : "missing ", pt ? "present" : "missing ",
+                 zs ? zs->width0 : 0, zs ? zs->height0 : 0,
+                 pt ? pt->width0 : 0, pt ? pt->height0 : 0,
+                 zs ? util_format_name(zs->format) : "-",
+                 pt ? util_format_name(pt->format) : "-");
+      if (!zs || !pt) { skipped++; continue; }
+
+      /* The textures format is chosen already equal to the drawable's zs format
+             * (st_mesa_format_to_pipe_format + MESA_NV_DEPTH_Z24S8): that keeps the GPU blit legal and
+             * no conversion path is needed. If for some drawable the formats do not match we skip the
+             * copy and say so (an instrument, not silent behaviour). */
+      if (nv_rt_copy_gate()) {
+         unsigned gen = 0, cop = 0;
+
+         _mesa_nv_rt_entry_gens(k, &gen, &cop);
+         if (gen == cop)
+            continue;   /* no new draw since the last copy: copying again would be useless
+                                                 * (measured: 105 copies per frame over 3 stores, about 135 MB per
+                                                 * frame of wasted GPU traffic) */
+      }
+      if (zs->format != pt->format ||
+          zs->width0 != pt->width0 || zs->height0 != pt->height0 ||
+          zs->nr_samples != pt->nr_samples || zs->last_level != pt->last_level) {
+         if (dri_rt_alias_verbose() && skipped < 12)
+            fprintf(stderr, "nvlegacy MESA-RT-SNAP-SKIPPED: drawable=%p texture=%u zs=%s %dx%d x%u "
+                    "vs pt=%s %dx%d x%u bind=%#x \n", (void *) key, texObj->Name,
+                    util_format_name(zs->format), zs->width0, zs->height0, zs->nr_samples,
+                    util_format_name(pt->format), pt->width0, pt->height0, pt->nr_samples,
+                    (unsigned) pt->bind);
+         skipped++;
+         continue;
+      }
+
+      {
+         uint64_t pair = ((uint64_t) texObj->Name << 32) ^
+                           (uint64_t) (uintptr_t) key;
+         unsigned frame_no = _mesa_nv_frame();   /* real signature: no arguments (nv_extensions.h:308) */
+         unsigned q;
+         bool already_this_frame = false;
+
+         for (q = 0; q < copy_count; q++)
+            if (copy_keys[q] == pair && copy_frames[q] == frame_no)
+               already_this_frame = true;
+         if (already_this_frame)
+            continue;          /* already copied in this frame */
+         if (copy_count < 16) {
+            copy_keys[copy_count] = pair;
+            copy_frames[copy_count] = frame_no;
+            copy_count++;
+         }
+      }
+
+      {
+         struct pipe_blit_info blit;
+         memset(&blit, 0, sizeof blit);
+         blit.dst.resource = pt;
+         blit.dst.box.width = pt->width0;
+         blit.dst.box.height = pt->height0;
+         blit.dst.box.depth = 1;
+         blit.dst.format = pt->format;
+         blit.src.resource = zs;
+         blit.src.box.width = zs->width0;
+         blit.src.box.height = zs->height0;
+         blit.src.box.depth = 1;
+         blit.src.format = zs->format;
+         /* FLIP HYPOTHESIS (A/B knob, off by default): if the map is delivered upside down the app
+                   * samples it upside down and the shadows look "projected from the wrong point" - the
+                   * symptom the user reported. box.src with NEGATIVE height is legal (p_state.h:
+                   * "negative width, height only legal for src"). */
+         if (nv_rt_flip()) {
+            blit.src.box.y = (int) zs->height0 - 1;
+            blit.src.box.height = -((int) zs->height0);
+         }
+         blit.mask = PIPE_MASK_Z;
+         if (util_format_has_stencil(util_format_description(zs->format)) &&
+             util_format_has_stencil(util_format_description(pt->format)))
+            blit.mask |= PIPE_MASK_S;
+         blit.filter = PIPE_TEX_FILTER_NEAREST;
+         pipe->blit(pipe, &blit);
+      }
+      /* ONE COPY PER PAIR PER FRAME. Measured: without this limit dri_rt_snapshot_depth was
+             * called about 70 times per frame (flush_front is not per-frame) and did about 105 copies
+             * per frame, some WHILE the shadow pass was writing the zs, so the app sampled a half-built
+             * map and the shadows looked "projected from the wrong point" (the user's report). At the
+             * first flush_front of frame N the zs holds the COMPLETED map of frame N-1: that is exactly
+             * the coherent snapshot the sampler needs. */
+      if (pipe->flush_resource)
+         pipe->flush_resource(pipe, pt);
+      done++;                       /* global counter  */
+      {
+         /* COUNTER PER PAIR, NO CAP (the earlier caps ran out at the start, when only the 512^2
+                   * entry existed, and hid the fact that the other entries were never copied). Printing:
+                   * one line per pair when the pair is registered, then the totals in the summary. */
+         uint64_t pair = ((uint64_t) texObj->Name << 32) | (uint32_t) (uintptr_t) key;
+         unsigned q;
+         int slot = -1;
+
+         for (q = 0; q < n_pairs; q++)
+            if (pairs[q] == pair) { slot = (int) q; break; }
+         if (slot < 0 && n_pairs < 16) {
+            slot = (int) n_pairs++;
+            pairs[slot] = pair;
+            pair_counts[slot] = 0;
+            fprintf(stderr, "nvlegacy MESA-RT-PAIR[%d]: drawable=%p -> texture=%u %s %dx%d  "
+                    "(GPU copy at end of frame )\n", slot, (void *) key, texObj->Name,
+                    util_format_name(pt->format), (int) pt->width0, (int) pt->height0);
+         }
+         if (slot >= 0)
+            pair_counts[slot]++;
+      }
+      {
+         /* DECIDING MEASUREMENT: if two different drawables write into the SAME texture, the app's
+                   * store gets filled in turn by two different pbuffers (the last copy wins), so the
+                   * shadow map comes from a different light = shadows "projected from the wrong point",
+                   * as the user reported. */
+         unsigned q;
+         bool conflict = false;
+         for (q = 0; q < k; q++) {
+            uintptr_t kd = 0;
+            struct gl_texture_object *td = NULL;
+            _mesa_nv_rt_depth_alias_at(q, &kd, &td);
+            if (td && td == texObj && kd != key) {
+               fprintf(stderr, "nvlegacy MESA-RT-CONFLICT: texture=%u used da drawable=%p E %p  "
+                       "-> the same texture is filled by two different pbuffers  "
+                       "(the last copy wins : shadows from the wrong light )\n",
+                       texObj->Name, (void *) kd, (void *) key);
+               conflict = true;
+               break;
+            }
+         }
+         (void) conflict;
+      }
+   }
+   calls++;                        /* counted ALWAYS (before, an if without braces counted it only with tracing enabled and
+                                                                             * spammed the summary) */
+   if (dri_rt_alias_verbose() && (calls <= 3 || (calls % 240) == 0))
+      fprintf(stderr, "nvlegacy MESA-RT-SNAP-SUMMARY: calls=%u entries=%u done=%u skipped=%u "
+              "distinct_pairs=%u dead_entries=%u \n", calls, n, done, skipped, n_pairs, no_tex);
+   {
+      unsigned q;
+      for (q = 0; q < n_pairs; q++)
+         fprintf(stderr, "nvlegacy MESA-RT-COPIES[%u]: pair texture=%u drawable=%p copies=%u \n",
+                 q, (unsigned) (pairs[q] >> 32), (void *) (uintptr_t) (uint32_t) pairs[q], pair_counts[q]);
+   }
+}
