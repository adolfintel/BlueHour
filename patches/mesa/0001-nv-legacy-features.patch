+         period_us = (v && *v) ? atol(v) : 0;
+         if (period_us > 0)
+            clock_gettime(CLOCK_MONOTONIC, &next_t);
+      }
+      if (period_us > 0) {
+         struct timespec now;
+         long long wait_ns;
+
+         next_t.tv_sec += period_us / 1000000;
+         next_t.tv_nsec += (long) (period_us % 1000000) * 1000;
+         if (next_t.tv_nsec >= 1000000000) {
+            next_t.tv_nsec -= 1000000000;
+            next_t.tv_sec++;
+         }
+         clock_gettime(CLOCK_MONOTONIC, &now);
+         wait_ns = (long long) (next_t.tv_sec - now.tv_sec) * 1000000000LL +
+                   (long long) (next_t.tv_nsec - now.tv_nsec);
+         if (wait_ns > 1000000) {
+            struct timespec ts;
+
+            ts.tv_sec = (time_t) (wait_ns / 1000000000LL);
+            ts.tv_nsec = (long) (wait_ns % 1000000000LL);
+            nanosleep(&ts, NULL);
+         } else if (wait_ns < -500000000LL) {
+            /* we are behind schedule: the window restarts, so catch-up bursts do not
+             * pile up.
+             */
+            next_t = now;
+         }
+      }
+   }
