+      const unsigned long npix = (unsigned long) w * (unsigned long) h;
+      /* samples at most 4096 pixels for speed */
+      const unsigned long step = npix > 4096 ? npix / 4096 : 1;
+      unsigned long used = 0;
+      for (unsigned long i = 0; i < npix; i += step) {
+         const unsigned char *p = buf + (size_t) i * 4;
+         sr += p[0]; sg += p[1]; sb += p[2]; sa += p[3]; used++;
+      }
