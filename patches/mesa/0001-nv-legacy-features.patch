+/* nvlegacy (fork): drawable -> the texture OBJECT declared as its depth store. The key is the
+ * drawable's POINTER (global and identical both in core `fb->drawable` and in the front-end
+ * `pdrawable`), NOT a Gallium type: core Mesa must not include Gallium headers (a rule already
+ * learned in this fork). We store the OBJECT and not the NAME: GL names are only valid in the
+ * context where they were born, and the lookup by name with `st->ctx` returned NULL, which is
+ * why the first version never had any effect (self-correction). Tiny, refcounted table. */
+struct nv_rt_depth_entry {
+   uintptr_t drawable;
+   struct gl_texture_object *tex;
+   /* generation of the DRAWS on this drawable and generation copied. The app's sampler must see
+       * the content the pbuffer has at that moment, as the reference driver did where the texture WAS the
+       * pbuffer's store in zero-copy. Copying only when the draws changed removes the 105 copies per frame
+       * (measured: flush_front fires about 70 times per frame) and the risk of a half-built map. */
+   unsigned draw_gen;
+   unsigned copied_gen;
+};
+/* Hook registered by the DRI front end: core/state_tracker cannot call a front-end symbol
+ * (they are different libraries, the symbol is not resolvable at link time) -> function pointer. */
+static void (*nv_rt_copy_hook)(struct gl_context *ctx, struct gl_texture_object *tex);
+static struct nv_rt_depth_entry nv_rt_depth[8];
