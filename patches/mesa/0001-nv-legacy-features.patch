+void GLAPIENTRY
+_mesa_GetProgramivNV(GLuint id, GLenum pname, GLint *params)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_nv_program *info;
+
+   if (!nv_has_vp(ctx, "glGetProgramivNV"))
+      return;
+
+   if (!params)
+      return;
+
+   info = _mesa_nv_lookup_program(ctx, id);
+   if (!info) {
+      _mesa_error(ctx, GL_INVALID_OPERATION, "glGetProgramivNV(id)");
+      return;
+   }
+
+   switch (pname) {
+   case GL_PROGRAM_LENGTH_NV:
+      *params = info->SourceLength;
+      return;
+   case GL_PROGRAM_TARGET_NV:
+      *params = info->Target;
+      return;
+   case GL_PROGRAM_RESIDENT_NV:
+      *params = info->Resident;
+      return;
+   default:
+      _mesa_error(ctx, GL_INVALID_ENUM, "glGetProgramivNV(pname)");
+      return;
+   }
+}
+
+void GLAPIENTRY
+_mesa_GetProgramStringNV(GLuint id, GLenum pname, GLubyte *program)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_nv_program *info;
+
+   if (!nv_has_vp(ctx, "glGetProgramStringNV"))
+      return;
+
+   info = _mesa_nv_lookup_program(ctx, id);
+   if (!info) {
+      _mesa_error(ctx, GL_INVALID_OPERATION, "glGetProgramStringNV(id)");
+      return;
+   }
+
+   if (pname != GL_PROGRAM_STRING_NV) {
+      _mesa_error(ctx, GL_INVALID_ENUM, "glGetProgramStringNV(pname)");
+      return;
+   }
+
+   if (program)
+      memcpy(program, info->Source, info->SourceLength);
+}
+
+void GLAPIENTRY
+_mesa_GetProgramParameterfvNV(GLenum target, GLuint index, GLenum pname,
+                              GLfloat *params)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   const GLuint max = NV_MAX_PROGRAM_PARAMS(ctx);
+
+   if (!nv_has_vp(ctx, "glGetProgramParameterfvNV"))
+      return;
+
+   if (nvARB_target(target) == GL_NONE) {
+      _mesa_error(ctx, GL_INVALID_ENUM, "glGetProgramParameterfvNV(target)");
+      return;
+   }
+
+   switch (pname) {
+   case GL_PROGRAM_PARAMETER_NV: {
+      const GLfloat (*p)[4] = nv_env_params(ctx, target);
+
+      if (index >= max) {
+         _mesa_error(ctx, GL_INVALID_VALUE, "glGetProgramParameterfvNV(index)");
+         return;
+      }
+      if (params)
+         COPY_4V(params, p[index]);
+      return;
+   }
+   case GL_TRACK_MATRIX_NV:
+   case GL_TRACK_MATRIX_TRANSFORM_NV: {
+      struct gl_nv_track_matrix *t =
+         nv_find_track_matrix(ctx, target, index);
+
+      if (params)
+         params[0] = t ? (GLfloat) (pname == GL_TRACK_MATRIX_NV ? t->Matrix
+                                                                : t->Transform)
+                       : (GLfloat) GL_NONE;
+      return;
+   }
+   default:
+      _mesa_error(ctx, GL_INVALID_ENUM, "glGetProgramParameterfvNV(pname)");
+      return;
+   }
+}
+
+void GLAPIENTRY
+_mesa_GetProgramParameterdvNV(GLenum target, GLuint index, GLenum pname,
+                              GLdouble *params)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   GLfloat v[4];
+
+   _mesa_GetProgramParameterfvNV(target, index, pname, v);
+   (void) ctx;
+
+   for (int i = 0; i < 4; i++)
+      params[i] = (GLdouble) v[i];
+}
+
+void GLAPIENTRY
+_mesa_GetTrackMatrixivNV(GLenum target, GLuint address, GLenum pname,
+                         GLint *params)
+{
+ 
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_nv_track_matrix *t;
+
+   if (!nv_has_vp(ctx, "glGetTrackMatrixivNV"))
+      return;
+
+   if (nvARB_target(target) == GL_NONE) {
+      _mesa_error(ctx, GL_INVALID_ENUM, "glGetTrackMatrixivNV(target)");
+      return;
+   }
+
+   if (pname != GL_TRACK_MATRIX_NV && pname != GL_TRACK_MATRIX_TRANSFORM_NV) {
+      _mesa_error(ctx, GL_INVALID_ENUM, "glGetTrackMatrixivNV(pname)");
+      return;
+   }
+
+   t = nv_find_track_matrix(ctx, target, address);
+   if (params) {
+      GLint v;
+
+      if (t) {
+         v = (GLint) (pname == GL_TRACK_MATRIX_NV ? t->Matrix : t->Transform);
+      } else {
+         /* Nothing is tracked at this address.  The matrix is GL_NONE, but the
+          * transform is not: like other GL state its initial value is
+          * GL_IDENTITY_NV.  Answering GL_NONE for the transform made the Cg
+          * runtime decide that the driver would supply the parameter, and it
+          * stopped uploading the matrices altogether: Nalu (GeForce 6) never
+          * issued one single glProgramParameter4dNV for its
+          * modelView/modelViewProj blocks, so every program computing o[HPOS]
+          * from c[] multiplied zeros and the model collapsed to a slat.
+          * NVIDIA's driver answers GL_IDENTITY_NV - verified against a
+          * reference apitrace of the same demo (TRANSFORM -> 34346 = 0x862A),
+          * while it answers GL_NONE for GL_TRACK_MATRIX_NV as we do.
+          */
+         v = (pname == GL_TRACK_MATRIX_NV) ? (GLint) GL_NONE
+                                           : (GLint) GL_IDENTITY_NV;
+      }
+
+
+      params[0] = v;
+   }
+}
