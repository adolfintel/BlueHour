index 0000000..7ec13ec
--- /dev/null
+++ b/src/mesa/main/nv_program.c
@@ -0,0 +1,2507 @@
+/*
+ * The entry points of GL_NV_vertex_program (plus the NV_vertex_program2,
+ * NV_vertex_program2_option and NV_vertex_program3 add-ons) and of
+ * GL_NV_fragment_program, implemented in the Mesa core.
+ *
+ * The design is deliberately thin: an NV program string is transpiled into
+ * Mesa's ARB assembly dialect (src/mesa/program/nv_to_arb.c) and handed to
+ * Mesa's existing ARB_{vertex,fragment}_program parser, so every driver that
+ * supports the ARB assembly programs can run NV programs.  Only the state
+ * that the NV API needs on top of an ARB program object is kept here.
+ *
+ * Register-file mapping (this is what makes the whole thing work with the
+ * existing ARB machinery):
+ *
+ *    NV vertex program            ARB assembly
+ *    -------------------------    ---------------------------------------
+ *    v[n]                         vertex.attrib[n]
+ *    c[n]                         program.env[n]      (context wide!)
+ *    o[HPOS] and friends          result.position and friends
+ *
+ *    NV fragment program          ARB assembly
+ *    -------------------------    ---------------------------------------
+ *    f[TEXn]                      fragment.texcoord[n]
+ *    DECLARE name                 program.local[slot]  (per program)
+ *
+ * GL_NV_vertex_program has no local parameters at all: its program parameter
+ * registers are shared by every vertex program of the rendering context,
+ * which is exactly the behaviour of ARB program environment parameters.
+ *
+ * glTrackMatrixNV is emulated by writing the tracked matrix into the program
+ * parameter registers when the binding is installed and whenever a program
+ * using it is bound; the matrices are not tracked continuously.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the "Software"),
+ * to deal in the Software without restriction, including without limitation
+ * on the rights to use, copy, modify, merge, publish, distribute,
+ * sublicense, and/or sell copies of the Software, and to permit persons to
+ * whom the Software is furnished to do so, subject to the following
+ * conditions:
+ *
+ * The above copyright notice and this permission notice (including the next
+ * paragraph) shall be included in all copies or substantial portions of the
+ * Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+ * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+
+#include "main/nv_extensions.h"
+#include "main/nv_program.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <limits.h>
+#include <sys/stat.h>
+
+#include "api_exec_decl.h"
+#include "main/context.h"
+#include "main/draw_validate.h"
+#include "main/enums.h"
+#include "main/errors.h"
+#include "main/extensions.h"
+#include "main/hash.h"
+#include "main/macros.h"
+#include "main/matrix.h"
+#include "main/mtypes.h"
+#include "main/shaderapi.h"
+#include "main/state.h"
+#include "main/arrayobj.h"   /* nvlegacy: needed by FEATURE code (_mesa_update_vao_derived_arrays), so it is outside any marker region */
+#include "main/bufferobj.h"  /* nvlegacy: needed by FEATURE code (_mesa_reference_buffer_object), same reason */
+#include "main/varray.h"
+#include "math/m_matrix.h"
+#include "program/arbprogparse.h"
+#include "program/nv_to_arb.h"
+#include "program/program.h"
+#include "state_tracker/st_program.h"
+#include "util/ralloc.h"
+#include "util/u_memory.h"
+
+
+
+/* Index of the first generic vertex attribute. */
+#define NV_ATTRIB(index) VERT_ATTRIB_GENERIC(index)
+
+/* NV_vertex_program1_1 offers 96 program parameter registers; the VP2 add-ons
+ * extend the index range up to MAX_PROGRAM_ENV_PARAMS.
+ */
+#define NV_MAX_PROGRAM_PARAMS(ctx) \
+   (ctx->Const.Program[MESA_SHADER_VERTEX].MaxEnvParams)
+
+static GLboolean
+nv_has_vp(struct gl_context *ctx, const char *func)
+{
+   if (ctx->Extensions.NV_vertex_program)
+      return GL_TRUE;
+
+   _mesa_error(ctx, GL_INVALID_OPERATION, "%s(NV_vertex_program)", func);
+   return GL_FALSE;
+}
+
+static GLboolean
+nv_has_fp(struct gl_context *ctx, const char *func)
+{
+   if (ctx->Extensions.NV_fragment_program)
+      return GL_TRUE;
+
+   _mesa_error(ctx, GL_INVALID_OPERATION, "%s(NV_fragment_program)", func);
+   return GL_FALSE;
+}
+
+static struct gl_nv_track_matrix *
+nv_find_track_matrix(struct gl_context *ctx, GLenum target, GLuint address);
+
+/* ------------------------------------------------------------------ */
+/* per-context and per-program bookkeeping                             */
+/* ------------------------------------------------------------------ */
+
+static void
+free_nv_program(void *data, void *unused)
+{
+   struct gl_nv_program *p = (struct gl_nv_program *) data;
+
+   (void) unused;
+
+   if (!p)
+      return;
+
+   free(p->Source);
+   free(p->Env);
+   free(p->NamedParams);
+   free(p);
+}
+
+void
+_mesa_init_nv_shared(struct gl_shared_state *shared)
+{
+   _mesa_InitHashTable(&shared->NVPrograms);
+}
+
+void
+_mesa_destroy_nv_shared(struct gl_context *ctx, struct gl_shared_state *shared)
+{
+   (void) ctx;
+   _mesa_DeinitHashTable(&shared->NVPrograms, free_nv_program, NULL);
+}
+
+void
+_mesa_init_nv_program_state(struct gl_context *ctx)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(ctx->NV.TrackMatrices); i++) {
+      ctx->NV.TrackMatrices[i].Address = 0;
+      ctx->NV.TrackMatrices[i].Matrix = GL_NONE;
+      ctx->NV.TrackMatrices[i].Transform = GL_IDENTITY_NV;
+   }
+}
+
+struct gl_nv_program *
+_mesa_nv_lookup_program(struct gl_context *ctx, GLuint id)
+{
+   if (id == 0)
+      return NULL;
+
+   return (struct gl_nv_program *) _mesa_HashLookup(&ctx->Shared->NVPrograms, id);
+}
+
+void
+_mesa_nv_delete_program_data(struct gl_context *ctx, GLuint id)
+{
+   struct gl_nv_program *info = _mesa_nv_lookup_program(ctx, id);
+
+   if (info) {
+      _mesa_HashRemove(&ctx->Shared->NVPrograms, id);
+      free_nv_program(info, NULL);
+   }
+}
+
+static struct gl_nv_program *
+new_nv_program_data(struct gl_context *ctx, GLuint id, GLenum target,
+                    GLsizei len, const char *source,
+                    const struct nv_asm_result *res)
+{
+   struct gl_nv_program *info;
+
+   info = calloc(1, sizeof(*info));
+   if (!info)
+      return NULL;
+
+   info->Target = target;
+   info->Resident = GL_TRUE;
+   info->SourceLength = len;
+   info->Source = calloc(len + 1, sizeof(char));
+   if (!info->Source) {
+      free(info);
+      return NULL;
+   }
+   memcpy(info->Source, source, len);
+   info->Source[len] = 0;
+
+   info->Env = calloc(MAX_PROGRAM_ENV_PARAMS, 4 * sizeof(GLfloat));
+   if (!info->Env) {
+      free(info->Source);
+      free(info);
+      return NULL;
+   }
+
+   if (res->num_named > 0) {
+      info->NamedParams = calloc(res->num_named, sizeof(*info->NamedParams));
+      if (!info->NamedParams) {
+         free(info->Source);
+         free(info);
+         return NULL;
+      }
+      info->NumNamedParams = res->num_named;
+      for (unsigned i = 0; i < res->num_named; i++) {
+         info->NamedParams[i].Slot = res->named[i].slot;
+         info->NamedParams[i].HasDefault = res->named[i].has_default;
+         for (int c = 0; c < 4; c++)
+            info->NamedParams[i].Value[c] = res->named[i].value[c];
+         snprintf(info->NamedParams[i].Name, NV_PARAM_NAME_SIZE, "%s",
+                  res->named[i].name);
+      }
+   }
+
+   _mesa_HashInsert(&ctx->Shared->NVPrograms, id, info);
+   return info;
+}
+
+/* ------------------------------------------------------------------ */
+/* helpers                                                            */
+/* ------------------------------------------------------------------ */
+
+/* Map an NV program target onto the matching ARB target. */
+static GLenum
+nvARB_target(GLenum target)
+{
+   switch (target) {
+   case GL_VERTEX_PROGRAM_NV:
+      return GL_VERTEX_PROGRAM_ARB;
+   case GL_FRAGMENT_PROGRAM_NV:
+      return GL_FRAGMENT_PROGRAM_ARB;
+   default:
+      return GL_NONE;
+   }
+}
+
+static GLboolean
+is_nv_fragment_target(GLenum target)
+{
+   return target == GL_FRAGMENT_PROGRAM_NV;
+}
+
+/* Look up (or create) the ARB program object with the given name.  This
+ * mirrors the static helper in main/arbprogram.c.
+ */
+static struct gl_program *
+nv_lookup_or_create_program(struct gl_context *ctx, GLuint id, GLenum target,
+                            const char *caller)
+{
+   struct gl_program *prog;
+   mesa_shader_stage stage = 0;
+
+   if (id == 0) {
+      _mesa_error(ctx, GL_INVALID_OPERATION, "%s(id == 0)", caller);
+      return NULL;
+   }
+
+   if (target == GL_NONE) {
+      _mesa_error(ctx, GL_INVALID_ENUM, "%s(target)", caller);
+      return NULL;
+   }
+
+   stage = (mesa_shader_stage) _mesa_program_enum_to_shader_stage(nvARB_target(target));
+
+   prog = _mesa_lookup_program(ctx, id);
+   if (prog == &_mesa_DummyProgram || prog == NULL) {
+      prog = _mesa_new_program(ctx, stage, id, true);
+      if (!prog) {
+         _mesa_error(ctx, GL_OUT_OF_MEMORY, "%s", caller);
+         return NULL;
+      }
+      _mesa_HashInsert(&ctx->Shared->Programs, id, prog);
+      return prog;
+   }
+
+   if (prog->info.stage != stage) {
+      _mesa_error(ctx, GL_INVALID_OPERATION, "%s(target mismatch)", caller);
+      return NULL;
+   }
+
+   return prog;
+}
+
+/* Fetch a pointer to a programs local parameter, allocating the storage on
+ * first use.  This mirrors the static helper in main/arbprogram.c.
+ */
+static GLboolean
+nv_local_param_pointer(struct gl_context *ctx, struct gl_program *prog,
+                       GLuint index, GLuint count, GLfloat **param,
+                       const char *caller)
+{
+   unsigned max = ctx->Const.Program[prog->info.stage].MaxLocalParams;
+
+   if (index + count > max) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "%s(index)", caller);
+      return GL_FALSE;
+   }
+
+   if (!prog->arb.LocalParams) {
+      prog->arb.LocalParams =
+         rzalloc_array_size(prog, sizeof(float[4]), max);
+      if (!prog->arb.LocalParams) {
+         _mesa_error(ctx, GL_OUT_OF_MEMORY, "%s", caller);
+         return GL_FALSE;
+      }
+      prog->arb.MaxLocalParams = max;
+   }
+
+   if (index + count > prog->arb.MaxLocalParams) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "%s(index)", caller);
+      return GL_FALSE;
+   }
+
+   *param = prog->arb.LocalParams[index];
+   return GL_TRUE;
+}
+
+/* Which env-parameter array holds the NV program parameter registers. */
+/* Chooses the store for the environment-parameter registers of assembly programs (the
+ * programs c[] registers, to be clear).
+ *
+ * Normally they are per-context: ctx->{Vertex,Fragment}Program.Parameters, which is also
+ * what the translated ARB program reads through the program.env[] state variables. With
+ * MESA_NV_PARAM_SCOPE=shared they instead live in the share group's state, because the
+ * GeForce 6 era demos (Cg profiles vp30/fp30) set the parameters in one context and draw in
+ * another of the same group: on the drivers of the time those registers were in the shared
+ * space, while with the per-context store the draw starts with zeroed registers
+ * (o[HPOS] = (0,0,0,0) -> degenerate triangles).
+ *
+ * The store must change TOGETHER with read and write: the earlier attempt at sharing only
+ * the writes left the programs reading the per-context array, and the scene stayed empty.
+ * That is why this function is called at the three points where those registers are
+ * touched: the ARB API setters and getters (main/arbprogram.c), the state-var fetch
+ * (program/prog_statevars.c) and the NV API below.
+ */
+static int
+nv_param_scope(void)
+{
+   static int scope = -1;
+
+   if (scope < 0) {
+      const char *e = getenv("MESA_NV_PARAM_SCOPE");
+
+      scope = (e != NULL && !strcmp(e, "program")) ? 1
+              : (e != NULL && !strcmp(e, "shared")) ? 2 : 0;
+   }
+   return scope;
+}
+
+GLfloat (*
+_mesa_nv_env_array(struct gl_context *ctx, bool fragment))[4]
+{
+   const int scope = nv_param_scope();
+
+   if (scope == 1) {
+      /* MESA_NV_PARAM_SCOPE=program: the c[] registers follow the bound program. Measured: the
+             * demo sets the programs in one context and draws in another, and ALL programs that
+             * compute o[HPOS] from c[] drew with those registers zeroed (degenerate vertices:
+             * a vertical sliver). The NV program hash lives in the share group, so a register
+             * written in one context is readable in the other, but it stays attached to its own
+             * program: no program reads values meant for another. */
+      const struct gl_program *cur = fragment ? ctx->FragmentProgram.Current
+                                             : ctx->VertexProgram.Current;
+
+      if (cur != NULL && cur != &_mesa_DummyProgram) {
+         const struct gl_nv_program *info = _mesa_nv_lookup_program(ctx, cur->Id);
+
+         if (info != NULL && info->Env != NULL)
+            return info->Env;
+      }
+      return fragment ? ctx->FragmentProgram.Parameters
+                      : ctx->VertexProgram.Parameters;
+   }
+   if (scope == 2)
+      return ctx->Shared->NvEnvParams[fragment ? 1 : 0];
+
+   return fragment ? ctx->FragmentProgram.Parameters
+                   : ctx->VertexProgram.Parameters;
+}
+
+static GLfloat (*
+nv_env_params(struct gl_context *ctx, GLenum target))[4]
+{
+
+   return _mesa_nv_env_array(ctx, is_nv_fragment_target(target));
+}
+
+/* Find the local parameter slot of a named NV fragment program parameter. */
+static struct gl_nv_named_param *
+nv_find_named_param(struct gl_nv_program *info, GLsizei len,
+                    const GLubyte *name)
+{
+   for (GLuint i = 0; i < info->NumNamedParams; i++) {
+      struct gl_nv_named_param *p = &info->NamedParams[i];
+
+      if ((GLsizei) strlen(p->Name) == len &&
+          strncmp(p->Name, (const char *) name, len) == 0)
+         return p;
+   }
+   return NULL;
+}
+
+/* ------------------------------------------------------------------ */
+/* program creation, loading and binding                               */
+/* ------------------------------------------------------------------ */
+
+void GLAPIENTRY
+_mesa_GenProgramsNV(GLsizei n, GLuint *ids)
+{
+ 
+   GET_CURRENT_CONTEXT(ctx);
+
+   if (!nv_has_vp(ctx, "glGenProgramsNV"))
+      return;
+
+   /* NV program names come from the same namespace as the ARB assembly ones. */
+   _mesa_GenProgramsARB(n, ids);
+}
+
+GLboolean GLAPIENTRY
+_mesa_IsProgramNV(GLuint prog)
+{
+   GET_CURRENT_CONTEXT(ctx);
+
+   if (!nv_has_vp(ctx, "glIsProgramNV"))
+      return GL_FALSE;
+
+   return _mesa_IsProgramARB(prog);
+}
+
+void GLAPIENTRY
+_mesa_GetVertexAttribPointervNV(GLuint index, GLenum pname, GLvoid **pointer)
+{
+   GET_CURRENT_CONTEXT(ctx);
+
+   if (!nv_has_vp(ctx, "glGetVertexAttribPointervNV"))
+      return;
+
+   if (pname != GL_ATTRIB_ARRAY_POINTER_NV &&
+       pname != GL_VERTEX_ATTRIB_ARRAY_POINTER) {
+      _mesa_error(ctx, GL_INVALID_ENUM,
+                  "glGetVertexAttribPointervNV(pname)");
+      return;
+   }
+
+   _mesa_GetVertexAttribPointerv(index, GL_VERTEX_ATTRIB_ARRAY_POINTER,
+                                 pointer);
+}
+
+void GLAPIENTRY
+_mesa_BindProgramNV(GLenum target, GLuint id)
+{
+ 
+   GET_CURRENT_CONTEXT(ctx);
+   GLenum arb;
+
+   if (!nv_has_vp(ctx, "glBindProgramNV"))
+      return;
+
+   arb = nvARB_target(target);
+   if (arb == GL_NONE) {
+      _mesa_error(ctx, GL_INVALID_ENUM, "glBindProgramNV(target)");
+      return;
+   }
+
+
+   _mesa_BindProgramARB(arb, id);
+
+   /* GL_NV_vertex_program and GL_NV_fragment_program do NOT require an glEnable: the program
+    * runs as soon as it is bound. The gate Mesa uses to choose between fixed pipeline and
+    * assembly program, _mesa_arb_vertex_program_enabled() /
+    * _mesa_arb_fragment_program_enabled(), however asks for ctx->{Vertex,Fragment}Program.
+    * Enabled, which only comes from an glEnable. The GeForce FX era demos (Cg profiles
+    * vp20/fp40) did call it - the traces taken on the hardware of the time show tens of
+    * thousands of glEnable(GL_VERTEX_PROGRAM_ARB) - and their programs do run already; the
+    * vp30 profile of Nalu (GeForce 6) never calls it: without this, the vertex program is
+    * never executed and the geometry stays in the fixed pipeline with the identity matrix,
+    * because the application never touches the GL matrices (it passes them in parameter
+    * registers). On screen everything ends up flattened onto a vertical line.
+    *
+    * We write true only when the binding carries a non-null program: an application using the
+    * ARB API (with explicit enable/disable) does not change behaviour, and glBindProgramNV
+    * (target, 0) still means "no program", since program 0 has no instructions. */
+
+   if (id != 0) {
+      if (is_nv_fragment_target(target))
+         ctx->FragmentProgram.Enabled = true;
+      else
+         ctx->VertexProgram.Enabled = true;
+      FLUSH_VERTICES(ctx, _NEW_PROGRAM, 0);
+   }
+}
+
+void GLAPIENTRY
+_mesa_DeleteProgramsNV(GLsizei n, const GLuint *ids)
+{
+   GET_CURRENT_CONTEXT(ctx);
+
+   if (!nv_has_vp(ctx, "glDeleteProgramsNV"))
+      return;
+
+   if (n < 0) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glDeleteProgramsNV(n)");
+      return;
+   }
+
+   for (GLint i = 0; i < n; i++) {
+      if (ids[i] != 0)
+         _mesa_nv_delete_program_data(ctx, ids[i]);
+   }
+
+   _mesa_DeleteProgramsARB(n, ids);
+}
