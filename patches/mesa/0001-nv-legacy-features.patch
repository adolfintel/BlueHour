+/* See nv_extensions.h: only NV indices >= 2 go through the generic
+ * attributes, and only when that slot has no enabled array already. */
+
+
+
+
+/* ---- FEATURE: mirror of the NV current-value registers ----
+ * GL_NV_vertex_program has its own register space v[0..15], separate from the
+ * ARB generic attributes. Our translator maps v[n] onto vertex.attrib[n]
+ * (generic slot 15+n), but the NV setters write into the VBO layer (the ATTR*F
+ * macros), which is a no-op in a context with VBOs active. MEASURED on Nalu: at the
+ * draw of the composite (vp=93/fp=94) slot 17 held (0,1) with dim=2 and slot 18
+ * held (1,1,1) with dim=3, while the application writes
+ *     glVertexAttrib4dvNV(index = 2, v = {1, 1, 1, 1})   -> g_scale
+ *     glVertexAttrib4dvNV(index = 3, v = {0, 0, 0, 0})   -> g_translate
+ * immediately before glBindProgramNV(..., 93). Consequence: o[TEX1].xy =
+ * uv*(0,1)+(1,1) = a constant coordinate, so the composite reads ONE single texel
+ * of the god-ray texture, giving a uniform veil ("all or nothing").
+ * Here we keep a mirror written by the NV setters and restore it at the point where
+ * the state tracker feeds the current values (st_setup_current), because that is
+ * where the program takes its data. Verified with MESA_NV_FORCE_ATTRIB (same
+ * point, values written by hand): Nalu's god rays become correct.
+ * ON by default (see nv_reg_restore_enabled below): this is not a heuristic keyed
+ * on the executable name. It can be turned off with MESA_NV_NVREG_RESTORE=0 for A/B.
+ */
+/* The register mirror lives in ctx->NV (per context): see mtypes.h, gl_nv_state. */
+
+static int
+nv_reg_restore_enabled(void)
+{
+   static int cached = -1;
+   const char *e = getenv("MESA_NV_NVREG_RESTORE");
+
+   /* ON by default (user decision, 2026-10-28). This is not a heuristic keyed on
+       * the executable name: it is GL_NV_vertex_program semantics. The v[0..15]
+       * current-value registers belong to the context, while our translator reads
+       * vertex.attrib[n] (generic slot 15+n). Without the restore the program sees
+       * values left over from other passes or from other contexts.
+       * Checked with the full sweep at MESA_NV_NVREG_RESTORE=1: 10/10 demos with no
+       * failure signals (exceptions=0 null_gl=0 glErrors=0 asserts=0 skippedDepth=0)
+       * and no visual regression reported by the user; on Nalu the god rays become
+       * correct (user's visual confirmation). Turn off with MESA_NV_NVREG_RESTORE=0
+       * for A/B. */
+   if (cached < 0)
+      cached = (e != NULL && !strcmp(e, "0")) ? 0 : 1;
+   return cached;
+}
+/* Counts how many times the emission fired: without this number the measurement
+ * is not interpretable, because a silent probe looks like a success. */
+static unsigned nv_emitted = 0;
+
+static void
+nv_note_emitted_vertex(const struct gl_context *ctx)
+{
+   nv_emitted++;
+   if (nv_emitted <= 40u || (nv_emitted % 200u) == 0u) {
+      fprintf(stderr, "MESA-NV NVREG EMIT vertex %u: v0=(%.5g,%.5g,%.5g) fb=%ux%u\n",
+              nv_emitted,
+              (double) ctx->NV.NvCurrentValue[0][0],
+              (double) ctx->NV.NvCurrentValue[0][1],
+              (double) ctx->NV.NvCurrentValue[0][2],
+              (unsigned) ctx->DrawBuffer->Width, (unsigned) ctx->DrawBuffer->Height);
+      fflush(stderr);
+   } else if (nv_emitted == 41u) {
+      fprintf(stderr, "MESA-NV NVREG EMIT: shows only the first 40 lines, then una every_n 200\n");
+      fprintf(stderr, "MESA-NV NVREG EMIT: cap of 40 lines reached\n");
+   }
+}
+
+
+
+/* MESA_NV_NVREG_EMIT=1: emit the current vertex when the app writes NV register
+ * index 0 (position) inside glBegin/glEnd. Needed for NV-era reference apps such as
+ * Timbury, where the compositing/bloom passes are glBegin(GL_QUADS) plus ONLY
+ * glVertexAttrib{2,3}dvNV writes, with no glVertex at all: the reference NVIDIA
+ * driver emitted the vertex when v[0] was written; Mesa without glVertex emits no
+ * draw (measured: 0 unindexed draws out of 400000, and 0 draws with vp=102 /
+ * fp=103 / fp=104, which are the programs of that pass).
+ *
+ * OFF by default because it touches vertex emission, the part that can break
+ * everything. Two documented assumptions:
+ *  - the app writes the position last, after the other attributes of the vertex
+ *    (the reference dump is like that: texcoord {0,0} first, then the position);
+ *  - n >= 3 is required, because the position needs z.
+ */
+static int
+nv_reg_emit_enabled(void)
+{
+   static int cached = -1;
+
+   if (cached < 0) {
+      const char *e = getenv("MESA_NV_NVREG_EMIT");
+      cached = (e != NULL && strcmp(e, "0") != 0) ? 1 : 0;
+   }
+   return cached;
+}
+
+/* Are we inside glBegin/glEnd? In Mesa 26 the dispatch state is a _glapi_table:
+ * ctx->Dispatch.Current (see main/api_arrayelt.c: get_dispatch()) points at the
+ * BeginEnd table only between Begin and End. This also avoids display lists (which
+ * would re-record the call) and GL_INVALID_OPERATION from a nested begin. */
+static bool
+nv_in_beginend(const struct gl_context *ctx)
+{
+   return ctx->Dispatch.Current != NULL &&
+          (ctx->Dispatch.Current == ctx->Dispatch.BeginEnd ||
+           ctx->Dispatch.Current == ctx->Dispatch.HWSelectModeBeginEnd);
+}
+
+
+void
+_mesa_nv_note_nvreg(struct gl_context *ctx, unsigned nv_index, unsigned n,
+                    GLenum type, const void *v)
+{
+   unsigned i;
+
+   if (!nv_reg_restore_enabled() || nv_index >= ARRAY_SIZE(ctx->NV.NvCurrentValue) || v == NULL)
+      return;
+   if (n == 0 || n > 4)
+      n = 4;
+   for (i = 0; i < n; i++) {
+      float f = 0.0f;
+      switch (type) {
+      case GL_FLOAT:
+         f = ((const GLfloat *) v)[i];
+         break;
+      case GL_DOUBLE:
+         f = (float) ((const GLdouble *) v)[i];
+         break;
+      case GL_INT:
+         f = (float) ((const GLint *) v)[i];
+         break;
+      case GL_UNSIGNED_INT:
+         f = (float) ((const GLuint *) v)[i];
+         break;
+      default:
+         /* Unrecognised type: do not invent numbers, just invalidate. */
+         ctx->NV.NvCurrentValueValid[nv_index] = 0;
+         return;
+      }
+      ctx->NV.NvCurrentValue[nv_index][i] = f;
+   }
+   ctx->NV.NvCurrentValueN[nv_index] = (unsigned char) n;
+   ctx->NV.NvCurrentValueValid[nv_index] = 1;
+
+     /* Vertex emission (see nv_reg_emit_enabled): the values were already converted
+           * to float in the mirror, so reuse them (do not reinterpret the original
+           * payload). */
+     if (nv_reg_emit_enabled() && nv_index == 0 && n >= 3 && nv_in_beginend(ctx)) {
+        CALL_Vertex3f(ctx->Dispatch.Current,
+                      (ctx->NV.NvCurrentValue[0][0],
+                       ctx->NV.NvCurrentValue[0][1],
+                       ctx->NV.NvCurrentValue[0][2]));
+     }
+     /* DIAGNOSTICS: what ends up in the mirror. The suspicion was that apply wrote to
+           * a different slot from the one the setter wrote to (the setter uses
+           * _mesa_nv_attrib_slot). */
+}
+
+
+
+/* MESA_NV_NVREG_SLOT: choose WHERE the mirror writes the NV current values.
+ *   generic (DEFAULT): VERT_ATTRIB_GENERIC0 + idx. Historic behaviour, the one the
+ *      Nalu god rays were validated with: as long as the variable is unset nothing
+ *      that has already been seen changes.
+ *   map: the slot where the translated program really reads v[idx], i.e. the same
+ *      slot the NV setter uses (_mesa_nv_attrib_slot). With MESA_NV_ATTR_MAP off
+ *      (default) that coincides with the raw index: the VBO_ATTRIB_* and
+ *      VERT_ATTRIB_* enums are numerically identical in Mesa (POS 0, NORMAL 1,
+ *      COLOR0 2, COLOR1 3, FOG 4, COLOR_INDEX 5, TEX0 6..TEX7 13, POINT_SIZE 14,
+ *      GENERIC0 15). So the "generic" behaviour writes to a different slot from
+ *      the one the setter used, which is exactly why APPLIES never fired for
+ *      Timbury.
+ */
+static int
+nv_reg_slot_mode(void)
+{
+   static int cached = -1;
+
+   if (cached < 0) {
+      const char *e = getenv("MESA_NV_NVREG_SLOT");
+      cached = (e != NULL && (strcmp(e, "map") == 0 || strcmp(e, "resolved") == 0 ||
+                              strcmp(e, "1") == 0)) ? 1 : 0;
+   }
+   return cached;
+}
+
+/* The register mirror is written by _mesa_nv_note_nvreg and consumed here: the ARB
+ * program that replaces an NV program needs the NV CONTEXT registers (v0..v15) re-applied
+ * in the NEW program parameter store.  This is diagnostics-only plumbing: the only caller
+ * is st_atom_array.cpp, inside a traced branch.
+ */
+void
+_mesa_nv_apply_nvregs(struct gl_context *ctx, uint64_t curmask)
+{
+   if (!nv_reg_restore_enabled())
+      return;
+   for (unsigned idx = 0; idx < ARRAY_SIZE(ctx->NV.NvCurrentValue); idx++) {
+      unsigned slot = nv_reg_slot_mode() ? _mesa_nv_attrib_slot(ctx, idx)
+                                        : (VERT_ATTRIB_GENERIC0 + idx);
+      if (slot == ~0u || slot >= VERT_ATTRIB_MAX)
+         continue;   /* outside the range: _mesa_nv_attrib_slot returns ~0u */
+      struct gl_array_attributes *a;
+      unsigned j, n;
+
+      if (!(curmask & BITFIELD64_BIT(slot)) || !ctx->NV.NvCurrentValueValid[idx])
+         continue;
+      a = (struct gl_array_attributes *) _mesa_draw_current_attrib(ctx, (gl_vert_attrib) slot);
+      if (a == NULL || a->Ptr == NULL || a->Format.User.Type != GL_FLOAT)
+         continue;
+
+      /* Guard: NEVER write into the data of an attribute whose array is enabled. The
+             * pointer may be caller memory: on the glRasterPos path with a vertex program
+             * active, Mesa points the record at the application's real coordinates (stack
+             * frame) and writing into them corrupts them. Measured in BugLooker: the
+             * coordinates -0.92,-0.83 came out replaced by the NV register value
+             * -0.6038,-0.80, so the text was drawn somewhere else.
+             */
+      {
+         const struct gl_vertex_array_object *vao =
+            ctx->Array._DrawVAO != NULL ? ctx->Array._DrawVAO : ctx->Array.VAO;
+         if (vao != NULL && (vao->Enabled & BITFIELD64_BIT(slot)))
+            continue;
+      }
+      n = a->Format.User.Size ? (unsigned) a->Format.User.Size : ctx->NV.NvCurrentValueN[idx];
+      if (n > 4)
+         n = 4;
+      for (j = 0; j < n; j++)
+         ((float *) a->Ptr)[j] = ctx->NV.NvCurrentValue[idx][j];
+   }
+}
+/* Restores, into the space the draw is about to use, the NV register values that
+ * the program reads but that have no enabled array (curmask, see st_setup_current).
+ * Writes ONLY as many components as the record declares, so it never writes past the
+ * storage Mesa allocated. */
+
+
+unsigned
+_mesa_nv_attrib_slot(struct gl_context *ctx, unsigned nv_index)
+{
+   static int cached = -1;
+   unsigned slot;
+
+   if (cached < 0) {
+      const char *e = getenv("MESA_NV_NVATTRIB_GENERIC");
+      /* OFF by default: the generic mapping is new and touches attribute state, so it is
+             * enabled only where it is needed. */
+      cached = e != NULL ? atoi(e) : 0;
+   }
+   if (!cached || nv_index < 2)
+      return nv_index;                    /* legacy aliasing: the behaviour of that era */
+
+   slot = VERT_ATTRIB_GENERIC0 + nv_index;
+   if (slot >= VBO_ATTRIB_MAX)
+      return ~0u;
+
+   return slot;
+
+   /* NOTE (measurement of 2026-10-28, Nalu): there used to be a guard here that skipped
+       * the write when the slot already had an enabled array:
+       *    if (ctx->Array.VAO->Enabled & BITFIELD64_BIT(slot)) return ~0u;
+       * It looked necessary to avoid 'reclassifying' real arrays, but in practice it
+       * DISCARDED the current-value writes: in Nalu's composite cgGL writes
+       *    glVertexAttrib4dvNV(index = 2, v = {1, 1, 1, 1})
+       *    glVertexAttrib4dvNV(index = 3, v = {0, 0, 0, 0})
+       * immediately before glBindProgramNV(..., 93) (our own trace, lines 2118707-8),
+       * yet in the same frames other passes have NV arrays 2/3 enabled, and the guard
+       * made those writes disappear. Measured with the MESA-NV MASK probe: at slot 17
+       * the program received (0,1,0,0) with dim=2, i.e. the trace of an ARRAY rather
+       * than the value we wrote (one of our writes would have dim=4), and at slot 18
+       * (1,1,1,0) with dim=3. Result: o[TEX1] = uv*(0,1)+(1,1), so the composite always
+       * samples the same band of the god-ray texture -> a uniform veil, which is exactly
+       * the 'all or nothing' symptom. In GL an attribute's current value is independent
+       * of the array state, so the guard was simply wrong. The regression we feared
+       * (Nalu hair/geometry) came from mapping indices 0/1, which the `nv_index < 2'
+       * check above still excludes. */
+}
+
+/* ---- FEATURE: late resolution of glVertexAttribPointerNV pointers ----
+ * Measured: the app (Timbury/BugLooker) sets the attributes of the biting pass with
+ * glVertexAttribPointerNV(index, size, type, stride, ptr = 0x18/0xc/0x20) with NO
+ * VBO bound; the VBO (name 690, 576000 bytes) appears only later, and at draw time
+ * GL_ARRAY_BUFFER is bound. The NV driver of that era resolved the offset at draw
+ * time; Mesa resolves it at set time. Without a VBO those values become invalid
+ * client pointers and the geometry collapses (measured: the index data of the biting
+ * pass is correct, max index 16 with count 892, but the attributes stay
+ * Ptr=0x18/0xc/0x20 with bo=0, i.e. invalid addresses).
+ * Here we replay the recorded requests when ARRAY_BUFFER gets bound.
+ * Knob: MESA_NV_NVATTRIB_LATE_VBO=0 to disable it. */
+static bool
+nv_late_vbo_active(struct gl_context *ctx)
+{
+   static int cached = -1;
+
+   if (cached < 0) {
+      const char *v = getenv("MESA_NV_NVATTRIB_LATE_VBO");
+      /* OFF by default. The A/B run with the validated tool (natural run ON versus OFF)
+             * shows that this replay does not recover the bite: it changes about 580000
+             * pixels per frame, i.e. it destroys the scene (already observed as a 'vertex
+             * explosion'). Honest note: the first 'falsified' claim was invalid because the
+             * reason was a bug of mine - an orphaned 'return false;' left behind by an
+             * edit by line number - which made the guard always false. The guard works now
+             * (probes: knob_active=1 and valid_requests=3) and the negative result is real. */
+      cached = (v != NULL && *v != '0') ? 1 : 0;
+   }
+   if (!cached)
+      return false;
+   /* Same predicate used by the NV setter (nv_has_vp in nv_program.c).
+       * Note: the MESA-NV NVREPLAY-CHK probe measured that _mesa_has_NV_vertex_program
+       * is 1 in those contexts; the knob_active=0 I had read earlier came from the
+       * orphaned 'return false;', NOT from the choice of predicate. */
+   return ctx->Extensions.NV_vertex_program;
+}
+
+void
+_mesa_nv_replay_nv_attrib_ptrs(struct gl_context *ctx)
+{
+   unsigned i;
+
+
+   if (!nv_late_vbo_active(ctx))
+      return;
+
+   for (i = 0; i < 16; i++) {
+      if (!ctx->NV.NvAttribPointerReq[i].Valid)
+         continue;
+      /* Conservative guard, measured: the unguarded replay destroyed other
+      * (Timbury: about 580000 pixels per frame changed, with a vertex explosion on
+      * screen). Replay only a slot the application enabled AND that has no data source
+      * at all right now, which is the only case the era driver resolved at draw time.
+      */
+      {
+        GLint en = 0, buf = 0;
+        
+        _mesa_GetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_ENABLED, &en);
+        _mesa_GetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_BUFFER_BINDING, &buf);
+        if (!en || buf != 0 ||
+            ctx->Array.VAO->VertexAttrib[VERT_ATTRIB_GENERIC(i)].Ptr != NULL)
+           continue;
+      }
+      /* Re-issues the same request: now a VBO is bound, so Mesa interprets it as an
+             * offset into the buffer (the behaviour of the original NV driver of that era). */
+      _mesa_VertexAttribPointer(i,
+                                ctx->NV.NvAttribPointerReq[i].Size,
+                                ctx->NV.NvAttribPointerReq[i].Type,
+                                GL_FALSE,
+                                ctx->NV.NvAttribPointerReq[i].Stride,
+                                (const void *) ctx->NV.NvAttribPointerReq[i].Offset);
+   }
+}
+
+ 
+
+/* Traces the immediate per-vertex attribute calls of GL_NV_vertex_program: demos
+ * of that era record them in display lists and replay them with glArrayElement, so
+ * the NV index (table X.2: v[6]..v[13] = texture coordinates 0..7) has to reach the
+ * matching Mesa slot.
+ */
+void
+_mesa_nv_trace_attrib(const char *tag, unsigned index, int n,
+                      float x, float y, float z, float w)
+{
+   static unsigned shown = 0;
+
+
+   shown++;
+   fprintf(stderr, "MESA-NV ATTRIB %s index=%u n=%d val=(%.4f %.4f %.4f %.4f)%s\n",
+           tag, index, n, x, y, z, w, shown == 4000 ? " (line_cap)" : "");
+   fflush(stderr);
+}
+
+
+
+
+
+
+int
+_mesa_nv_legacy_texcomplete(void)
+{
+   static int cached = -1;
+
+   if (cached < 0) {
+      const char *v = getenv("MESA_NV_LEGACY_TEXCOMPLETE");
+      cached = v != NULL ? atoi(v) : 2;
+   }
+   return cached;
+}
+
+
+bool
+_mesa_nv_legacy_texenable(void)
+{
+   static int cached = -1;
+
+   if (cached < 0) {
+      const char *v = getenv("MESA_NV_LEGACY_TEXENABLE");
+      cached = (v != NULL && atoi(v) == 0) ? 0 : 1;
+   }
