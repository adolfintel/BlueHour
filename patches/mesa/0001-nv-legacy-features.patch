+                      "var=%.1f\n",
+              _mesa_nv_frame(), n - 1,
+              (double) sr / (double) used, (double) sg / (double) used,
+              (double) sb / (double) used, (double) sa / (double) used,
+              used ? var / (double) used : 0.0);
+   }
+
+   char path[512];
+   snprintf(path, sizeof path, "%s/copy_%02u_f%u_%dx%d.ppm",
+            dir, (unsigned) shots, _mesa_nv_frame(), w, h);
+   FILE *f = fopen(path, "wb");
+   if (f) {
+      fprintf(f, "P6\n%d %d\n255\n", w, h);
+      for (GLsizei row = 0; row < h; row++) {
+         const unsigned char *p = buf + (size_t) (h - 1 - row) * (size_t) w * 4;
+         for (GLsizei c = 0; c < w; c++)
+            fputc(p[c * 4 + 0], f), fputc(p[c * 4 + 1], f), fputc(p[c * 4 + 2], f);
+      }
+      fclose(f);
+      shots++;
+      fprintf(stderr, "MESA_NVCOPY_SHOT %s frame=%u %dx%d a (%d,%d) -> %s\n",
+              what, _mesa_nv_frame(), w, h, x, y, path);
+   }
+   free(buf);
+}
