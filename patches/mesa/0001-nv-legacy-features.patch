+static const struct nv_opcode *
+find_opcode(const char *name)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(opcodes); i++)
+      if (!strcmp(opcodes[i].name, name))
+         return &opcodes[i];
+   return NULL;
+}
+
+/* Mesa's ARB assembler has no SGT: "a > b" is the same comparison as "b < a", and SLT is
+ * accepted by both ARB dialects. The rewrite has to happen where every emission path passes,
+ * because the condition-code emulation in emit_instruction_body prints inst->op->name verbatim:
+ * without it an NV "SGT" reaches the parser as a keyword it does not know, and the parser
+ * refuses the whole program. Measured on Mad Mod Mike: three of its 122 NV programs (ids 105,
+ * 106 and 132) were refused for exactly this, silently - the only trace was a
+ * GL_INVALID_OPERATION that nothing printed. Program 106 (semantics main.mytex, take_max,
+ * g_alpha_blur) is the ten-tap blur of the projected shadow: refused, that surface falls back
+ * to the fixed-function combine, which projects correctly and gives the striped pattern.
+ */
+static GLboolean
+sgt_needs_swap(const struct nv_inst *in)
+{
+   return (strcmp(in->op->name, "SGT") == 0 && in->nsrc == 2) ? GL_TRUE : GL_FALSE;
+}
+
+static void
+sgt_as_slt(struct nv_inst *in)
+{
+   const struct nv_opcode *slt = find_opcode("SLT");
+   struct nv_operand t;
+
+   if (!sgt_needs_swap(in) || slt == NULL)
+      return;
+   in->op = slt;
+   t = in->src[0];
+   in->src[0] = in->src[1];
+   in->src[1] = t;
+}
+
+static int
+alias_index(const char *name)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(aliases); i++)
+      if (!strcmp(aliases[i].nv, name))
+         return (int) i;
+   return -1;
+}
