+static bool
+nv_vb_upload_span(struct u_vbuf *mgr, const struct nv_vb_entry *e, const uint8_t *ptr)
+{
+   struct pipe_box box = { 0 };
+   struct pipe_transfer *transfer = NULL;
+   void *map;
