+/*
+ * Entry points of the legacy NVIDIA program extensions GL_NV_vertex_program
+ * (and its VP2 add-ons) and GL_NV_fragment_program, implemented in the Mesa
+ * core on top of Mesa's ARB assembly programs.  See src/mesa/program/nv_to_arb.c
+ * for the assembly translation and src/mesa/main/nv_program.c for the rest.
+ */
+
+#ifndef NV_PROGRAM_H
+#include <stdbool.h>
+#define NV_PROGRAM_H
+
+#include "util/glheader.h"
+
+struct gl_context;
+struct gl_shared_state;
+
+/** Allocate and destroy the per-context NV program state. */
+extern void
+_mesa_init_nv_program_state(struct gl_context *ctx);
+
+/* Create/destroy the NV program table of a share group (see
+ * _mesa_GenProgramsNV: NV programs are as shareable as the ARB objects they
+ * are built on).
+ */
+extern void
+_mesa_init_nv_shared(struct gl_shared_state *shared);
+
+extern void
+_mesa_destroy_nv_shared(struct gl_context *ctx, struct gl_shared_state *shared);
+
+/** Look up the extra NV state attached to a program object, NULL if none. */
+extern struct gl_nv_program *
+_mesa_nv_lookup_program(struct gl_context *ctx, GLuint id);
+
+/** Drop the extra NV state of a program object (used on delete). */
+extern void
+_mesa_nv_delete_program_data(struct gl_context *ctx, GLuint id);
+
+/** Re-apply every active glTrackMatrixNV after the GL matrix state changed. */
+extern void
+_mesa_nv_refresh_track_matrices(struct gl_context *ctx);
+
+
+/* Store of the environment-parameter registers in use for this ctx_state:
+ * Mesa's per-ctx_state one or the shared-group one, depending on
+ * MESA_NV_PARAM_SCOPE.  fragment = true picks the store for the programs
+ * fragment.  See main/nv_program.c. */
+extern GLfloat (*_mesa_nv_env_array(struct gl_context *ctx, bool fragment))[4];
+/* nv-legacy (FEATURE): the generic MESA_NV_REPLACE text engine applied to a
+ * program the application handed us already in ARB form. Returns a new allocated
+ * text, or NULL when no rule matched; the caller keeps the returned pointer as the
+ * text to parse and does not free it (see the note in the implementation).
+ */
+extern char *
+_mesa_nv_replace_arb_text(GLenum target, GLuint id, const void *text, GLsizei len);
+
+#endif /* NV_PROGRAM_H */
