+/*
+ * MESA_NV_FB_ALPHA_ZERO=<w>x<h>[,<w>x<h>...] : legacy-driver workaround for Mad Mod
+ * Mike, measured 2026-11-14.
+ *
+ * The demo packs its own per-pixel effect codes into the alpha channel of the small
+ * render targets it uses as the bright copy (428x240, and 428x268 once the frame is
+ * resized).  Its heat pass reads that alpha back and uses it in three places at once:
+ * as the threshold of the heat blend, as the blend weight of the hot colour, and as
+ * the scale of the displacement applied to its sampling coordinates.  With the alpha
+ * of that one fetch forced to zero the bright rectangle over the character disappears:
+ * measured twice by accident and once on purpose, every run that shaded the store with
+ * a zeroed alpha read clean, and every run that used the channel as written showed the
+ * rectangle, same arguments, same scene, same display.  The pass also writes that
+ * alpha back into the presented frame, and the codes left there select the next frame's
+ * heat bands, so the pattern feeds itself and grows while the run goes on.
+ *
+ * Refusing alpha writes on render targets of exactly those sizes keeps the codes out of
+ * the store in the first place: the demo clears those surfaces with a clear colour whose
+ * alpha is zero, so once the draws cannot touch the channel it stays zero for the whole
+ * frame, which is the state the reference hardware effectively showed.  Off unless a
+ * size list is given.
+ */
+static unsigned
+nv_fb_alpha_zero_mask(const struct gl_context *ctx)
+{
+   static int parsed = -1;
+   static unsigned want_w[8], want_h[8];
+   static unsigned want_n = 0;
+   unsigned i;
+
+   static unsigned fp_want[24];
+   static unsigned fp_n;
+   static bool fp_all;
+
+   if (parsed < 0) {
+      const char *p = getenv("MESA_NV_FB_ALPHA_ZERO");
+      const char *q = getenv("MESA_NV_FB_ALPHA_ZERO_FP");
+      parsed = 1;
+      /* MESA_NV_FB_ALPHA_ZERO_FP=<id[,id...]|all>: refuse the alpha write for draws that
+       * use one of these fragment program ids, whatever the framebuffer size. Needed to
+       * find which pass of Mad Mod Mike's bloom chain lifts the store alpha from the
+       * legitimate 0.057 up to 0.66 while the scene runs: measured on the store the
+       * composite itself samples, with the readback drained at the context switch. */
+      if (q != NULL) {
+         while (*q != '\0' && fp_n < 24u) {
+            if (*q == '*' || strncmp(q, "all", 3) == 0) { fp_all = true; break; }
+            unsigned id = 0;
+            while (*q >= '0' && *q <= '9') { id = id * 10u + (unsigned)(*q - '0'); q++; }
+            if (id != 0u) { fp_want[fp_n++] = id; }
+            while (*q == ',' || *q == ' ') q++;
+         }
+      }
+      while (p != NULL && *p != '\0' && want_n < 8u) {
+         unsigned w = 0, h = 0;
+         while (*p >= '0' && *p <= '9') { w = w * 10u + (unsigned)(*p - '0'); p++; }
+         if (*p != 'x' && *p != 'X')
+            break;
+         p++;
+         while (*p >= '0' && *p <= '9') { h = h * 10u + (unsigned)(*p - '0'); p++; }
+         if (w == 0u || h == 0u)
+            break;
+         want_w[want_n] = w;
+         want_h[want_n] = h;
+         want_n++;
+         if (*p != ',')
+            break;
+         p++;
+      }
+   }
+
+   if ((want_n == 0u && fp_n == 0u && !fp_all) || ctx->DrawBuffer == NULL)
+      return 0xfu;   /* nothing requested: leave the application's mask alone */
+
+   for (i = 0; i < want_n; i++) {
+      if ((unsigned) ctx->DrawBuffer->Width == want_w[i] &&
+          (unsigned) ctx->DrawBuffer->Height == want_h[i]) {
+         return 0x7u;   /* red, green and blue writable, alpha pinned to the store */
+      }
+   }
+
+   for (i = 0; i < fp_n; i++) {
+      const struct gl_program *fp_cur = ctx->FragmentProgram._Current;
+
+      if (fp_cur != NULL && fp_want[i] == fp_cur->Id) {
+         return 0x7u;
+      }
+   }
+
+   return 0xfu;
+}
