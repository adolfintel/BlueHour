+/* Read the ARB parser's verdict: it stores a negative position on success. */
+static GLboolean
+arb_parse_failed(struct gl_context *ctx)
+{
+   return ctx->Program.ErrorPos != -1;
+}
+
+/* MESA_NV_SHOW_VAR="id:channel" / MESA_NV_SHOW_TEX="id:unit":
+ * replaces fragment program "id" with one that writes the interpolant
+ * f[TEX<channel>] or the texel of texture unit <unit> to the screen: it shows
+ * whether the data reaching a program (normals, tangents, binormals, bump maps,
+ * LUTs) is correct.
+ */
+static int
+nv_show_parse(const char *envname, unsigned id, int *num)
+{
+   const char *s = getenv(envname);
+   char *end;
+
+   if (!s)
+      return 0;
+   while (*s) {
+      long a = strtol(s, &end, 10);
+      long b;
+
+      if (end == s)
+         break;
+      b = (*end == ':') ? strtol(end + 1, &end, 10) : -1;
+      if ((unsigned) a == id && b >= 0) {
+         *num = (int) b;
+         return 1;
+      }
+      s = (*end == ',') ? end + 1 : end;
+   }
+   return 0;
+}
+
+
+/* MESA_NV_FORCE_REMAP="id:unit,id:unit" - forces GL_EXPAND_NORMAL_NV on the
+ * initial translation of program id for the given unit, bypassing the per-draw
+ * resolution (this separates the effect of the maths from that of the
+ * re-translation).
+ */
+static void
+nv_force_remap(struct gl_program *prog)
+{
+   const char *p = getenv("MESA_NV_FORCE_REMAP");
+
+   if (!p)
+      return;
+
+   while (*p) {
+      int id, unit;
+
+      if (sscanf(p, "%d:%d", &id, &unit) == 2 &&
+          id == (int) prog->Id && unit >= 0 &&
+          unit < (int) ARRAY_SIZE(prog->NvRemapMode)) {
+         prog->NvRemapMode[unit] = GL_EXPAND_NORMAL_NV;
+         prog->NvRemapSig |= (1u << unit);
+         prog->NvRemapValid = true;
+         fprintf(stderr, "MESA-NV forced remap: program %u unit %d -> "
+                         "EXPAND_NORMAL\n", prog->Id, unit);
+      }
+      while (*p && *p != ',')
+         p++;
+      if (*p == ',')
+         p++;
+   }
+}
