+/*****************************************************************************
+ * GL_NV_register_combiners / GL_NV_register_combiners2
+ *
+ * The state lives in ctx->NV.Combiner (see main/nv_combiners.h) and rendering
+ * with it is implemented by generating an equivalent fragment program, also in
+ * main/nv_combiners.c.  These entry points are storage plus the validation the
+ * extension documents.
+ */
+
+
+
+void GLAPIENTRY
+_mesa_CombinerParameterfvNV(GLenum pname, const GLfloat *params)
+{
+   GET_CURRENT_CONTEXT(ctx);
+
+   if (params == NULL) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glCombinerParameterfvNV(params == NULL)");
+      return;
+   }
+
+
+   if (!_mesa_nv_combiner_parameter(ctx, pname, params)) {
+      /* GL_COMBINER_BUFFER_NV and friends from NV_register_combiners2 are
+       * accepted: there is a single combiner block, which is what a client
+       * that never calls glGenCombinerInputParameterListNV asks for.
+       */
+      return;
+   }
+}
+
+
+void GLAPIENTRY
+_mesa_CombinerParameterfNV(GLenum pname, GLfloat param)
+{
+   _mesa_CombinerParameterfvNV(pname, &param);
+}
+
+
+void GLAPIENTRY
+_mesa_CombinerParameterivNV(GLenum pname, const GLint *params)
+{
+   GET_CURRENT_CONTEXT(ctx);
+
+   if (params == NULL) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glCombinerParameterivNV(params == NULL)");
+      return;
+   }
+
+   GLfloat f[4];
+
+   for (int i = 0; i < 4; i++)
+      f[i] = (GLfloat) params[i];
+
+   if (!_mesa_nv_combiner_parameter(ctx, pname, f))
+      return;
+}
