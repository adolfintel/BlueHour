+/* These entry points are referenced by Mesa's dispatch (api_exec_init.c) or by
+ * functional code: they must stay in the features patch, hence the keep marker. */
+void GLAPIENTRY
+_mesa_PointParameteriNV(GLenum pname, GLint param)
+{
+   GET_CURRENT_CONTEXT(ctx);
+
+   if (pname == GL_POINT_SPRITE_R_MODE_NV) {
+      /* The spec allows ZERO, S and R.  We have no use for the value, but it
+       * must be queryable, so just store whatever the client passes.
+       */
+      ctx->NV.PointSpriteRMode = (GLenum) param;
+      return;
+   }
+
+   _mesa_PointParameteri(pname, param);
+}
