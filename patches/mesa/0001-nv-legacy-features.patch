+/* ------------------------------------------------------------------ */
+/* frame dumps (MESA_NV_SHOT)                                        */
+
+/* Number of glClear calls seen: used as the frame counter by the debug tools
+ * (MESA_NV_FLIP, MESA_NV_SHOT).
+ */
+static unsigned nv_frame_count;
+unsigned
+_mesa_nv_frame(void)
+{
+   return nv_frame_count;
+}
+
+/* Float-precision shading of the GLX drawables (pbuffers) that Wine hands over as RGBA8.
+ * See the generator script's docstring. */
+struct nv_fbshadow {
+   struct gl_context *ctx;
+   struct gl_framebuffer *winsys;
+   GLuint fbo, tex, rbo;
+   unsigned w, h;
+};
+
+static struct nv_fbshadow nv_shadow[32];
+static unsigned nv_shadow_n;
+
+static bool
+nv_shadow_wanted(struct gl_context *ctx, const struct gl_framebuffer *fb)
+{
+   static int init = -1;
+   static unsigned size_pairs[24][2];
+   static unsigned nsizes;
+   static unsigned maxw;
+   const char *q;
+   unsigned i;
+
+   (void) ctx;
+   if (!fb || !_mesa_is_winsys_fbo(fb))
+      return false;
+   if (fb->Visual.redBits != 8)
+      return false;   /* RGBA8 only: the "float" pbuffers Wine declares */
+
+   if (init < 0) {
+      init = 0;
+      q = getenv("MESA_NV_FB_FLOAT");
+      if (q != NULL && *q) {
+         const char *p = q;
+         while (*p && nsizes < 24) {
+            char *endptr2;
+            unsigned a = strtoul(p, &endptr2, 0);
+            if (endptr2 == p || *endptr2 != 'x') break;
+            p = endptr2 + 1;
+            unsigned b = strtoul(p, &endptr2, 0);
+            if (endptr2 == p) break;
+            p = endptr2;
+            size_pairs[nsizes][0] = a;
+            size_pairs[nsizes][1] = b;
+            nsizes++;
+            if (*p == ',')
+               p++;
+         }
+         init = 1;
+      }
+      maxw = getenv("MESA_NV_FB_FLOAT_MAXW") ?
+             (unsigned) strtoul(getenv("MESA_NV_FB_FLOAT_MAXW"), NULL, 0) : 0u;
+   }
+   if (!init && !maxw)
+      return false;
+
+   for (i = 0; i < nsizes; i++)
+      if (size_pairs[i][0] == fb->Width && size_pairs[i][1] == fb->Height)
+         return true;
+   if (maxw && fb->Width > 0 && fb->Width <= maxw && fb->Height <= maxw)
+      return true;
+   return false;
+}
+
+/* Returns the FBO that shades fb, creating it if it does not exist yet. */
+static struct gl_framebuffer *
+nv_shadow_creates(struct gl_context *ctx, struct gl_framebuffer *fb)
+{
+   unsigned i, maxn = 32;
+   struct nv_fbshadow *s;
+   struct gl_framebuffer *inner;
+   GLenum nv_nv_state;
+   GLint old_tex = 0;
+
+   if (getenv("MESA_NV_FB_FLOAT_MAX")) {
+      maxn = (unsigned) strtoul(getenv("MESA_NV_FB_FLOAT_MAX"), NULL, 0);
+      if (maxn > 32) maxn = 32;
+   }
+
+   for (i = 0; i < nv_shadow_n; i++)
+      if (nv_shadow[i].ctx == ctx && nv_shadow[i].winsys == fb)
+         return _mesa_lookup_framebuffer(ctx, nv_shadow[i].fbo);
+
+   if (nv_shadow_n >= maxn)
+      return NULL;
+
+   s = &nv_shadow[nv_shadow_n];
+   s->ctx = ctx;
+   s->winsys = fb;
+   s->w = fb->Width;
+   s->h = fb->Height;
+   s->fbo = s->tex = s->rbo = 0;
+
+   /* Destination texture: bound temporarily to allocate it, then the texture the application
+       * had current is restored. */
+   _mesa_CreateTextures(GL_TEXTURE_2D, 1, &s->tex);
+   _mesa_GetIntegerv(GL_TEXTURE_BINDING_2D, &old_tex);
+   _mesa_BindTexture(GL_TEXTURE_2D, s->tex);
+   _mesa_TexImage2D(GL_TEXTURE_2D, 0, GL_RGBA16F, (GLint) s->w, (GLint) s->h, 0,
+                    GL_RGBA, GL_FLOAT, NULL);
+   _mesa_BindTexture(GL_TEXTURE_2D, (GLuint) old_tex);
+
+   _mesa_CreateFramebuffers(1, &s->fbo);
+   _mesa_BindFramebuffer(GL_FRAMEBUFFER, s->fbo);
+   _mesa_FramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                              s->tex, 0);
+   if (fb->Visual.depthBits > 0) {
+      _mesa_CreateRenderbuffers(1, &s->rbo);
+      _mesa_BindRenderbuffer(GL_RENDERBUFFER, s->rbo);
+      _mesa_RenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT24,
+                                (GLsizei) s->w, (GLsizei) s->h);
+      _mesa_FramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT,
+                                    GL_RENDERBUFFER, s->rbo);
+   }
+   nv_nv_state = _mesa_CheckFramebufferStatus(GL_FRAMEBUFFER);
+   _mesa_BindFramebuffer(GL_FRAMEBUFFER, 0);
+
+   if (nv_nv_state != GL_FRAMEBUFFER_COMPLETE) {
+      static unsigned nwarn;
+      if (nwarn++ < 8)
+         fprintf(stderr, "MESA-NV SHADOW: nv_binding NOT complete nv_nv_state=#x%x %ux%u\n",
+                 (unsigned) nv_nv_state, s->w, s->h);
+      return NULL;
+   }
+
+   static unsigned nprint;
+   if (nprint++ < 40)
+      fprintf(stderr, "MESA-NV SHADOW frame=%u ctx=%p winsys=[fb=%p %ux%u rgb=%u%u%u%u "
+                      "depth=%u] -> fbo=%u tex=%u rbo=%u\n",
+              _mesa_nv_frame(), ctx, (void *) fb, fb->Width, fb->Height,
+              (unsigned) fb->Visual.redBits, (unsigned) fb->Visual.greenBits,
+              (unsigned) fb->Visual.blueBits, (unsigned) fb->Visual.alphaBits,
+              (unsigned) fb->Visual.depthBits, s->fbo, s->tex, s->rbo);
+
+   inner = _mesa_lookup_framebuffer(ctx, s->fbo);
+   nv_shadow_n++;
+   return inner;
+}
+
+/* To be called after make-current: if the drawable just made current is an RGBA8 pbuffer
+ * the application chose with a format declared float, we replace it with an RGBA16F FBO of
+ * the same size, for the draw AND for the read (needed for the glCopyTexSubImage2D the app
+ * uses to bring values into its own textures). */
+
+
+void
+_mesa_nv_shadow_read_enable(struct gl_context *ctx)
+{
+   struct gl_framebuffer *s;
+
+   if (ctx == NULL || ctx->ReadBuffer == NULL)
+      return;
+   if (!_mesa_is_winsys_fbo(ctx->ReadBuffer))
+      return;
+   if (!nv_shadow_wanted(ctx, ctx->ReadBuffer))
+      return;
+   s = nv_shadow_creates(ctx, ctx->ReadBuffer);
+   if (s == NULL)
+      return;
+   _mesa_bind_framebuffers(ctx, ctx->DrawBuffer, s);
+   _mesa_ReadBuffer(GL_COLOR_ATTACHMENT0);
+}
