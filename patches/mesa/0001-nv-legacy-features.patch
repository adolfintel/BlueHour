+bool
+_mesa_nv_skip_draw(struct gl_context *ctx, GLenum mode)
+{
+   static int n = -1;
+   static struct { int fp, vp, mode, st; } ent[16];
+   const unsigned fp = ctx->FragmentProgram._Current ?
+                          ctx->FragmentProgram._Current->Id : 0;
+   const unsigned vp = ctx->VertexProgram._Current ?
+                          ctx->VertexProgram._Current->Id : 0;
+
+   /* MESA_NV_KEEP_DRAW_AT=notequal|less|always|on|off: makes EVERY draw whose
+       * alpha-test state does not match the requested function be skipped. It exists
+       * to isolate on screen the pass that bites in Timbury: the app uses
+       * glAlphaFunc(GL_NOTEQUAL, 0) once per frame (557 times out of 557 swaps in the
+       * reference capture; on our side 353 out of 6000 samples with fp=49, the same
+       * 5.9 percent fraction). */
+   {
+      static int mod = -1;
+      static GLenum func_wanted = 0;
+      static int fp_required = -1;
+      if (mod < 0) {
+         const char *k = getenv("MESA_NV_KEEP_DRAW_AT");
+         const char *fr = (k != NULL) ? strstr(k, "fp=") : NULL;
+         mod = 0;
+         if (fr != NULL)
+            fp_required = atoi(fr + 3);
+         if (k != NULL) {
+            if (strstr(k, "notequal") != NULL) { mod = 1; func_wanted = GL_NOTEQUAL; }
+            else if (strstr(k, "less")   != NULL) { mod = 1; func_wanted = GL_LESS; }
+            else if (strstr(k, "always") != NULL) { mod = 1; func_wanted = GL_ALWAYS; }
+            else if (strstr(k, "on")     != NULL) { mod = 2; }
+            else if (strstr(k, "off")    != NULL) { mod = 3; }
+         }
+      }
+      /* Filter by fragment-program id: without this, the filter by STATE also
+             * includes draws from other programs that happen to have GL_NOTEQUAL active
+             * (the HUD): measured, the 241 pixels/frame counted with KEEP_DRAW_AT=notequal
+             * were not from the biting pass. */
+      if (mod && fp_required >= 0) {
+         const unsigned fid = ctx->FragmentProgram._Current ?
+                              ctx->FragmentProgram._Current->Id : 0;
+         if ((int) fid != fp_required)
+            return true;
+      }
+      if (mod == 1 && !(ctx->Color.AlphaEnabled && ctx->Color.AlphaFunc == func_wanted))
+         return true;
+      if (mod == 2 && !ctx->Color.AlphaEnabled)
+         return true;
+      if (mod == 3 && ctx->Color.AlphaEnabled)
+         return true;
+   }
+
+   if (n < 0) {
+      const char *p = getenv("MESA_NV_SKIP_DRAW");
+
+      n = 0;
+      while (p != NULL && *p != '\0' && n < 16) {
+         int f = -1, v = -1, m = -1, st = -1;
+         const char *q;
+
+         if (sscanf(p, "%d:%d:%d:%d", &f, &v, &m, &st) == 4) {
+            /* all specified */
+         } else if (sscanf(p, "%d:%d:%d", &f, &v, &m) == 3) {
+            st = -1;
+         } else if (sscanf(p, "%d:%d", &f, &v) == 2) {
+            m = -1; st = -1;
+         } else {
+            break;
+         }
+         ent[n].fp = f; ent[n].vp = v; ent[n].mode = m; ent[n].st = st;
+         n++;
+         q = strchr(p, ',');
+         if (q == NULL)
+            break;
+         p = q + 1;
+      }
+   }
+
+   for (int i = 0; i < n; i++) {
+      if ((ent[i].fp < 0 || ent[i].fp == (int) fp) &&
+          (ent[i].vp < 0 || ent[i].vp == (int) vp) &&
+          (ent[i].mode < 0 || ent[i].mode == (int) mode) &&
+          (ent[i].st < 0 || ent[i].st == (ctx->Stencil.Enabled ? 1 : 0)))
+         return true;
+   }
+
+   return false;
+}
