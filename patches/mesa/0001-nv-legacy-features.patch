+         const char *v = getenv("MESA_NV_SWAP_DELAY");
+         delay = (v && *v) ? atoi(v) : 0;
+      }
+      if (delay > 0)
+         usleep((unsigned) delay * 1000u);
+   }
+
+   /* MESA_NV_SWAP_DELAY=<milliseconds>: fixed delay added to every swap.
+    * MESA_NV_SWAP_PERIOD_US=<microseconds>: ABSOLUTE cadence, i.e. it sleeps as much
+    * as needed to keep the interval between two swaps exactly equal to the requested
+    * period, regardless of the driver's rendering time.  This is what comparing two
+    * drivers on the very same scene state requires: demos of that era have a
+    * real-time animated scene plus frame-tied feedback, so both frame and time have
+    * to be aligned.
