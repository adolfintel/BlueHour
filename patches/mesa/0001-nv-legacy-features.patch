+/* --------------------------------------------------------------
+ * nvlegacy: "one copy per client buffer" - MESA_NV_ARRAY_ONCE
+ *
+ * The old NV demos (Vulcan first) do not use VBOs: they draw with client arrays that stay the
+ * same. u_vbuf - which exists because zink cannot fetch from user memory - re-copies the vertex
+ * range touched by the draw at EVERY draw: measured on Vulcan, 1.5 million uploads for only 459
+ * distinct client pointers, 634 GB of copies of which 99.975 percent redundant, while the whole
+ * vertex set is 38 MB.
+ *
+ * Here we remember the association (client pointer, interval, our dedicated resource) and the
+ * copy is skipped when the bytes are already on the GPU. We use a resource we create, not the
+ * upload manager's buffer: holding on to ring buffers prevents recycling and makes every draw
+ * reallocate BOs (p90 at 40 ms, measured). The risk - the app may write in-place in the same
+ * arrays - is mitigated like this:
+ *   - CPU copy of the range ("shadow", only ranges <= 96 KB, 24 MB budget);
+ *   - every 32 hits we compare 128 bytes at a rotating offset: if they differ the entry is
+ *     dropped and we go back to copying (self-invalidation);
+ *   - cstart is aligned to 4 so the offset handed to the driver stays consistent as in the
+ *     normal path (there upload_off was a multiple of 4).
+ * Gate: ONLY explicit, MESA_NV_ARRAY_ONCE=1 (or any non-"0" value).
+ * No automation by process name: the guarantee is statistical, not formal.
+ * -------------------------------------------------------------- */
+#define NV_ARRAY_UNION_MAX (48u << 20)   /* beyond this: the binding is not cached */
+#define NV_ARRAY_SHADOW_MAX (96u << 10)  /* shadow only for small ranges */
+#define NV_ARRAY_SHADOW_BUDGET (24u << 20)
+
+static unsigned nv_shadow_bytes;
