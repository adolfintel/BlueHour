+ * documentation for any purpose is hereby granted without fee, provided that
+ * the above copyright notice appear in all copies and that both that copyright
+ * notice and this permission notice appear in supporting documentation, and
+ * that the name of the copyright holders not be used in endorsing or
+ * advertising products derived from this software without specific prior
+ * written permission.  The software is provided "as is", without warranty of
+ * any kind.
+ */
+
+#ifndef NV_ARRAY_RANGE_H
+#define NV_ARRAY_RANGE_H
+
+#include "GL/gl.h"
+
+/*
+ * Client-side entry points of GLX_NV_vertex_array_range, the GLX interface of
+ * GL_NV_vertex_array_range.  They are also what Wine's WGL layer resolves in
+ * order to implement wglAllocateMemoryNV()/wglFreeMemoryNV()
+ * (WGL_NV_vertex_array_range), so legacy Windows applications that set up a
+ * vertex array range find them through glXGetProcAddress[ARB]().
+ */
+
+extern void *
+glXAllocateMemoryNV(GLsizei size, GLfloat readfreq, GLfloat writefreq,
+                    GLfloat priority);
+
+extern void
+glXFreeMemoryNV(void *pointer);
+
+/*
+ * Variants with a "gl" prefix that some clients (chiefly cgGL.dll and its front end) look up with
+ * wglGetProcAddress()/glXGetProcAddress(): on Windows GLX does not exist, so the name with the GLX binding
+ * prefix is not there. They do exactly the same thing.
+ */
+
+extern void *
+glAllocateMemoryNV(GLsizei size, GLfloat readfreq, GLfloat writefreq,
+                   GLfloat priority);
+
+extern void
+glFreeMemoryNV(void *pointer);
+
+extern void *
+wglAllocateMemoryNV(GLsizei size, GLfloat readfreq, GLfloat writefreq,
+                    GLfloat priority);
+
+extern void
+wglFreeMemoryNV(void *pointer);
+
+#endif /* NV_ARRAY_RANGE_H */
