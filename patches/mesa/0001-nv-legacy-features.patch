+struct nv_vb_entry {
+   const uint8_t *user;          /* client pointer of the binding */
+   struct pipe_resource *res;    /* our OWN dedicated buffer: it holds [cstart,cend) */
+   unsigned res_size;            /* allocated capacity of res */
+   unsigned cstart, cend;        /* covered interval, cstart aligned to 4 */
+   uint8_t *shadow;              /* CPU copy (probe_small ranges only) for the verification */
+   unsigned since_check, ncheck, nbad;
+   bool dead;                    /* contents change too often: do not cache */
+   unsigned long hits;
+};
