+}
+
+
+bool
+_mesa_nv_legacy_attrs(void)
+{
+   static int cached = -1;
+   if (cached < 0) {
+      const char *v = getenv("MESA_NV_LEGACY_ATTRS");
+      cached = (v != NULL && *v == '0') ? 0 : 1;
+   }
