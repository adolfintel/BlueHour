+/*****************************************************************************
+ * GL_NV_occlusion_query
+ */
+
+/**
+ * Pick the core query target used to back NV occlusion queries.  NV's
+ * semantics are "count the samples that pass", which is GL_SAMPLES_PASSED.
+ */
+static GLenum
+nv_occlusion_target(struct gl_context *ctx)
+{
+   if (_mesa_has_occlusion_query(ctx))
+      return GL_SAMPLES_PASSED;
+
+   if (_mesa_has_ARB_occlusion_query2(ctx))
+      return GL_ANY_SAMPLES_PASSED;
+
+   return GL_NONE;
+}
