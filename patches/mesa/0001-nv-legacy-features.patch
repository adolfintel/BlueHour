+/* ------------------------------------------------------------------ */
+/* tracked matrices                                                    */
+/* ------------------------------------------------------------------ */
+
+static struct gl_nv_track_matrix *
+nv_find_track_matrix(struct gl_context *ctx, GLenum target, GLuint address)
+{
+   if (is_nv_fragment_target(target))
+      return NULL;
+
+   for (unsigned i = 0; i < ARRAY_SIZE(ctx->NV.TrackMatrices); i++) {
+      struct gl_nv_track_matrix *t = &ctx->NV.TrackMatrices[i];
+
+      if (t->Matrix != GL_NONE && t->Address == address)
+         return t;
+   }
+   return NULL;
+}
+
+/* Mesa stores matrices column-major (m[col*4+row]); this reads their content in
+ * logical row-major form (L[row*4+col]).
+ */
+static void
+nv_matrix_to_logical(GLfloat *out, const GLfloat *cm)
+{
+   for (int r = 0; r < 4; r++)
+      for (int c = 0; c < 4; c++)
+         out[r * 4 + c] = cm[c * 4 + r];
+}
+
+
+/* Multiply two logical matrices (row-major): dst = a * b. */
+static void
+matrix_mul_4x4(GLfloat *dst, const GLfloat *a, const GLfloat *b)
+{
+   GLfloat tmp[16];
+
+   for (int r = 0; r < 4; r++) {
+      for (int c = 0; c < 4; c++) {
+         GLfloat sum = 0.0f;
+
+         for (int k = 0; k < 4; k++)
+            sum += a[r * 4 + k] * b[k * 4 + c];
+         tmp[r * 4 + c] = sum;
+      }
+   }
+   memcpy(dst, tmp, sizeof(tmp));
+}
+
+static void
+fetch_tracked_matrix(struct gl_context *ctx, GLenum matrix, GLenum transform,
+                     GLfloat *rows)
+{
+   const GLmatrix *m = NULL;
+   GLfloat logical[16];
+   bool have = false;
+
+   /* GL_NV_vertex_program: "Matrices are tracked row-wise meaning that the
+    * top row of the transformed matrix is loaded into the program parameter
+    * address", and so on.  Mesa stores matrices column-major, so they have to be
+    * transposed: the four registers c[addr..addr+3] hold the rows of the
+    * transformed matrix.
+    */
+   if (matrix == GL_MODELVIEW_PROJECTION_NV) {
+      /* C = P * M, as the spec says. */
+      GLfloat p[16], mv[16];
+
+      nv_matrix_to_logical(p, ctx->ProjectionMatrixStack.Top->m);
+      nv_matrix_to_logical(mv, ctx->ModelviewMatrixStack.Top->m);
+      matrix_mul_4x4(logical, p, mv);
+      have = true;
+   } else {
+      switch (matrix) {
+      case GL_MODELVIEW_MATRIX:
+         m = ctx->ModelviewMatrixStack.Top;
+         break;
+      case GL_PROJECTION_MATRIX:
+         m = ctx->ProjectionMatrixStack.Top;
+         break;
+      case GL_TEXTURE_MATRIX:
+         assert(ctx->Texture.CurrentUnit <
+                ARRAY_SIZE(ctx->TextureMatrixStack));
+         m = ctx->TextureMatrixStack[ctx->Texture.CurrentUnit].Top;
+         break;
+      default:
+         if (matrix >= GL_MATRIX0_NV && matrix <= GL_MATRIX7_NV) {
+            GLuint i = matrix - GL_MATRIX0_NV;
+
+            if (i < ARRAY_SIZE(ctx->ProgramMatrixStack))
+               m = ctx->ProgramMatrixStack[i].Top;
+         } else if (matrix >= GL_TEXTURE0_ARB && matrix <= GL_TEXTURE0_ARB + 31) {
+            GLuint i = matrix - GL_TEXTURE0_ARB;
+
+            if (i < ARRAY_SIZE(ctx->TextureMatrixStack))
+               m = ctx->TextureMatrixStack[i].Top;
+         }
+         break;
+      }
+   }
+
+   if (!have) {
+      if (!m) {
+         for (int r = 0; r < 4; r++)
+            for (int c = 0; c < 4; c++)
+               rows[r * 4 + c] = (r == c) ? 1.0f : 0.0f;
+         return;
+      }
+
+      /* Mesa keeps the inverse matrix up to date on request. */
+      _math_matrix_analyse((GLmatrix *) m);
+
+      const GLfloat *src = (transform == GL_INVERSE_NV ||
+                            transform == GL_INVERSE_TRANSPOSE_NV) ? m->inv : m->m;
+      nv_matrix_to_logical(logical, src);
+   }
+
+   if (transform == GL_TRANSPOSE_NV || transform == GL_INVERSE_TRANSPOSE_NV) {
+      for (int r = 0; r < 4; r++)
+         for (int c = 0; c < 4; c++)
+            rows[r * 4 + c] = logical[c * 4 + r];
+   } else {
+      memcpy(rows, logical, sizeof(logical));
+   }
+
+}
+
+static void
+apply_track_matrix(struct gl_context *ctx,
+                   const struct gl_nv_track_matrix *t)
+{
+   GLfloat rows[16];
+
+   fetch_tracked_matrix(ctx, t->Matrix, t->Transform, rows);
+
+   for (int i = 0; i < 4; i++) {
+      GLuint index = t->Address + i;
+
+      if (index < MAX_PROGRAM_ENV_PARAMS)
+         memcpy(&ctx->VertexProgram.Parameters[index][0], &rows[i * 4],
+                4 * sizeof(GLfloat));
+   }
+
+}
+
+/** Re-runs every active glTrackMatrixNV: GL matrices may change after the
+ * program was loaded, and the parameter registers have to follow (spec:
+ * "Whenever the matrix changes, the transformed version of the matrix is updated
+ * in the specified range of program parameter
+ * registers").
+ */
+void
+_mesa_nv_refresh_track_matrices(struct gl_context *ctx)
+{
+   bool any = false;
+
+   for (unsigned i = 0; i < ARRAY_SIZE(ctx->NV.TrackMatrices); i++) {
+      if (ctx->NV.TrackMatrices[i].Matrix != GL_NONE) {
+         apply_track_matrix(ctx, &ctx->NV.TrackMatrices[i]);
+         any = true;
+      }
+   }
+
+   if (!any)
+      return;
+
+   /* The parameter registers changed: the constant buffer must be reloaded. */
+   ctx->NewState |= _NEW_PROGRAM_CONSTANTS;
+   ST_SET_STATES(ctx->NewDriverState,
+                 ctx->DriverFlags.NewShaderConstants[MESA_SHADER_VERTEX]);
+}
+
+
+void GLAPIENTRY
+_mesa_TrackMatrixNV(GLenum target, GLuint address, GLenum matrix,
+                    GLenum transform)
+{
+ 
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_nv_track_matrix *t = NULL;
+
+   if (!nv_has_vp(ctx, "glTrackMatrixNV"))
+      return;
+
+   if (is_nv_fragment_target(target)) {
+      _mesa_error(ctx, GL_INVALID_ENUM, "glTrackMatrixNV(target)");
+      return;
+   }
+
+   if (address % 4 != 0) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glTrackMatrixNV(address)");
+      return;
+   }
+
+   for (unsigned i = 0; i < ARRAY_SIZE(ctx->NV.TrackMatrices); i++) {
+      if (ctx->NV.TrackMatrices[i].Address == address ||
+          ctx->NV.TrackMatrices[i].Matrix == GL_NONE) {
+         t = &ctx->NV.TrackMatrices[i];
+         break;
+      }
+      t = NULL;
+   }
+
+   if (!t) {
+      _mesa_error(ctx, GL_OUT_OF_MEMORY, "glTrackMatrixNV");
+      return;
+   }
+
+   t->Address = address;
+   t->Matrix = matrix;
+   t->Transform = transform;
+
+   nv_flush_program_constants(ctx, GL_VERTEX_PROGRAM_NV);
+
+   if (matrix != GL_NONE)
+      apply_track_matrix(ctx, t);
+}
+
+
+/* A bound program is a latch candidate if it was created through the NV path and
+ * matches the chosen filters (explicit id, or substring of its assembly).
+ */
+static bool
+nv_latch_match(struct gl_context *ctx, GLuint id, int want_id, const char *sub)
+{
+   struct gl_nv_program *info = _mesa_nv_lookup_program(ctx, id);
+
+   if (info == NULL)
+      return false;
+   if (want_id >= 0 && (int) id != want_id)
+      return false;
+   if (sub != NULL && sub[0] != '\0') {
+      if (info->Source == NULL || strstr(info->Source, sub) == NULL)
+         return false;
+   }
+   return true;
+}
+
+
+/*
+ * MESA_NV_PROG_LATCH=1 -- "the bound program wins over the enable".
+ *
+ * Some NV-era demos (Blobby Dancer: the background/trail pass with VP24/FP23)
+ * bind their NV programs and then turn the enable token off BEFORE the draws,
+ * because of the order in which they restore state.  On NV hardware of that era
+ * the bound program stayed effective; Mesa falls back to fixed-function
+ * instead, and the pass that copies the trail buffer (RECT x fade_rate) is
+ * painted as a flat dark fill: the bokeh trails get erased instead of feeding
+ * the feedback loop.
+ *
+ * If a bound program was created through the NV path (glProgramStringNV) and its
+ * target is not enabled, we re-enable it here: this is the last point where
+ * validation has not happened yet.
+ */
+void
+_mesa_nv_prog_latch(struct gl_context *ctx)
+{
+   static int cached = -1;
+   static int latch_fp = -1, latch_vp = -1;
+   static char latch_sub[128];
+   static unsigned latch_n;
+
+   if (cached < 0) {
+      const char *v = getenv("MESA_NV_PROG_LATCH");
+
+      cached = (v != NULL && *v != '\0') ? atoi(v) : 0;
+      v = getenv("MESA_NV_PROG_LATCH_FP");
+      latch_fp = (v != NULL && *v != '\0') ? atoi(v) : -1;
+      v = getenv("MESA_NV_PROG_LATCH_VP");
+      latch_vp = (v != NULL && *v != '\0') ? atoi(v) : -1;
+      /* MESA_NV_PROG_LATCH_SUB=<text>: re-enables only the programs whose NV
+       * assembly contains <text>.  Fragment program ids change between runs, the
+       * text does not: this is the stable way to name "the background pass" in a
+       * given demo.
+       */
+      v = getenv("MESA_NV_PROG_LATCH_SUB");
+      snprintf(latch_sub, sizeof(latch_sub), "%s", (v != NULL) ? v : "");
+   }
+   if (!cached)
+      return;
+
+   if ((cached & 1) && ctx->VertexProgram.Current != NULL && !ctx->VertexProgram.Enabled &&
+       nv_latch_match(ctx, ctx->VertexProgram.Current->Id, latch_vp, latch_sub)) {
+      ctx->VertexProgram.Enabled = true;
+      ctx->NewState |= _NEW_PROGRAM;
+      _mesa_update_vertex_processing_mode(ctx);
+      if (latch_n++ < 40)
+         fprintf(stderr, "MESA_NV_LATCH vp=%u re-enabled (NV binding)\n",
+                 ctx->VertexProgram.Current->Id);
+   }
+
+   if ((cached & 2) && ctx->FragmentProgram.Current != NULL && !ctx->FragmentProgram.Enabled &&
+       nv_latch_match(ctx, ctx->FragmentProgram.Current->Id, latch_fp, latch_sub)) {
+      ctx->FragmentProgram.Enabled = true;
+      ctx->NewState |= _NEW_PROGRAM;
+      if (latch_n++ < 40)
+         fprintf(stderr, "MESA_NV_LATCH fp=%u re-enabled (NV binding)\n",
+                 ctx->FragmentProgram.Current->Id);
+   }
+}
