+      return GL_CURRENT_VERTEX_ATTRIB;
+   case GL_ATTRIB_ARRAY_SIZE_NV:
+      return GL_VERTEX_ATTRIB_ARRAY_SIZE;
+   case GL_ATTRIB_ARRAY_STRIDE_NV:
+      return GL_VERTEX_ATTRIB_ARRAY_STRIDE;
