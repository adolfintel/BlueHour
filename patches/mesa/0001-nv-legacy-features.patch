+/**
+ * Maps register v[n] of an NV vertex program into the corresponding Mesa
+ * attribute slot (GL_NV_vertex_program table X.2).  ~(unsigned)0 when that
+ * register has no equivalent conventional per-vertex attribute.
+ */
+unsigned
+_mesa_nv_alias_slot(unsigned nv_index)
+{
+   switch (nv_index) {
+   case 0:
+      return VERT_ATTRIB_POS;
+   case 2:
+      return VERT_ATTRIB_NORMAL;
+   case 3:
+      return VERT_ATTRIB_COLOR0;
+   case 4:
+      return VERT_ATTRIB_COLOR1;
+   case 5:
+      return VERT_ATTRIB_FOG;
+   case 8: case 9: case 10: case 11:
+   case 12: case 13: case 14: case 15:
+      return VERT_ATTRIB_TEX0 + (nv_index - 8);
+   default:
+      /* 1 (VertexWeightEXT), 6 and 7 have no counterpart in Mesa. */
+      return ~0u;
+   }
+}
