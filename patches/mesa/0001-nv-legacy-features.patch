+             mb = (double) sb / used;
+      double var = 0.0;
+      for (unsigned long i = 0; i < npix; i += step) {
+         const unsigned char *p = buf + (size_t) i * 4;
+         double l = 0.299 * p[0] + 0.587 * p[1] + 0.114 * p[2];
+         var += (l - (0.299 * mr + 0.587 * mg + 0.114 * mb)) *
+                (l - (0.299 * mr + 0.587 * mg + 0.114 * mb));
+      }
