+/* MESA_NV_RT_COLOR_TRACE=1: prints the few lines that show the colour delivery happening (or
+ * being refused because sizes or sample counts differ). Off by default: the mechanism itself is
+ * silent, and the release build must not add noise to the demos' stderr. */
+static int
+nv_rt_color_trace_on(void)
+{
+   static int cached = -1;
+
+   if (cached < 0) {
+      const char *v = getenv("MESA_NV_RT_COLOR_TRACE");
+      cached = (v && atoi(v)) ? 1 : 0;
+   }
+   return cached;
+}
+
+/* The two trace helpers of the colour delivery, kept as separate functions on purpose: the split
+ * between the features series and the diagnostics one excises whole declarations, and an inline
+ * block inside a function body was measured NOT to move (the prints stayed in 0001). */
+static void
+nv_rt_color_trace_skip(const struct gl_texture_object *texDst, const struct gl_texture_object *texSrc,
+                       uintptr_t drawable, const struct pipe_resource *dst,
+                       const struct pipe_resource *src)
+{
+   static unsigned complaints;
+
+   if (!nv_rt_color_trace_on() || complaints >= 6)
+      return;
+   complaints++;
+   fprintf(stderr, "nvlegacy MESA-RT-COLOUR: copy skipped for texture %u, drawable=%p,"
+                   " destination %ux%ux%d, origin %s\n",
+           texDst ? texDst->Name : 0u, (void *) drawable,
+           dst ? dst->width0 : 0u, dst ? dst->height0 : 0u, dst ? dst->nr_samples : 0,
+           src ? "surface present but different size or samples" : "no colour surface on the drawable");
+   (void) texSrc;
+}
+
+static void
+nv_rt_color_trace_copy(const struct gl_texture_object *texDst, const struct gl_texture_object *texSrc,
+                       unsigned src_level, const struct pipe_resource *dst,
+                       const struct pipe_resource *src)
+{
+   static unsigned copies;
+
+   if (!nv_rt_color_trace_on() || copies >= 6)
+      return;
+   copies++;
+   fprintf(stderr, "nvlegacy MESA-RT-COLOUR: copy at sampling of %ux%u into texture "
+                   "%u (origin texture %u, level %u)\n", src->width0, src->height0,
+           texDst->Name, texSrc->Name, src_level);
+}
+
+/* Colour render textures: the copy of the CURRENT content of the pbuffer surface into the
+ * application's texture, asked for by the core right before the draw that samples it
+ * (main/nv_extensions.c). The source is resolved exactly like the depth copy does it, from the
+ * pipe resources of the drawable (dri_drawable::textures[]): the core hands over the DRAWABLE
+ * pointer, which is the same in every context that binds that surface, while a GL framebuffer
+ * name is not (measured: Wine answers 0 in all ten colour opt-ins of a Luna run, because for a
+ * pbuffer the buffer it reads is the winsys one, and name 0 means "the winsys buffer of
+ * whichever context asks"). Pbuffers are single buffered, so both BACK_LEFT and FRONT_LEFT are
+ * tried, in that order. */
+static void
+dri_rt_color_copy_at_sample(struct gl_context *ctx, struct gl_texture_object *texDst,
+                            uintptr_t drawable_key)
+{
+   struct st_context *st = ctx ? ctx->st : NULL;
+   struct dri_drawable *d = (struct dri_drawable *) (void *) drawable_key;
+   struct pipe_resource *dst, *src = NULL;
+
+   if (!st || !st->pipe || texDst == NULL || d == NULL)
+      return;
+   dst = st_get_texobj_resource(texDst);
+   if (dst == NULL)
+      return;
+   src = d->textures[ST_ATTACHMENT_BACK_LEFT];
+   if (src == NULL)
+      src = d->textures[ST_ATTACHMENT_FRONT_LEFT];
+   if (src == NULL) {
+      nv_rt_color_trace_skip(texDst, NULL, drawable_key, dst, NULL);
+      return;
+   }
+   if (dst->width0 != src->width0 || dst->height0 != src->height0 ||
+       dst->nr_samples != src->nr_samples) {
+      nv_rt_color_trace_skip(texDst, NULL, drawable_key, dst, src);
+      return;
+   }
+   {
+      struct pipe_blit_info blit;
+
+      memset(&blit, 0, sizeof blit);
+      blit.dst.resource = dst;
+      blit.dst.level = 0;
+      blit.dst.box.x = 0; blit.dst.box.y = 0; blit.dst.box.z = 0;
+      blit.dst.box.width = dst->width0;
+      blit.dst.box.height = dst->height0;
+      blit.dst.box.depth = 1;
+      blit.dst.format = dst->format;
+      blit.src.resource = src;
+      blit.src.level = 0;
+      blit.src.box.x = 0; blit.src.box.y = 0; blit.src.box.z = 0;
+      blit.src.box.width = src->width0;
+      blit.src.box.height = src->height0;
+      blit.src.box.depth = 1;
+      blit.src.format = src->format;
+      blit.mask = PIPE_MASK_RGBA;
+      blit.filter = PIPE_TEX_FILTER_NEAREST;
+      st->pipe->blit(st->pipe, &blit);
+   }
+   if (st->pipe->flush_resource)
+      st->pipe->flush_resource(st->pipe, dst);
+   nv_rt_color_trace_copy(texDst, NULL, 0, dst, src);
+}
+
+static void
+dri_rt_copy_at_sample(struct gl_context *ctx, struct gl_texture_object *texObj)
+{
+   struct st_context *st = ctx ? ctx->st : NULL;
+   unsigned i, n;
+
+   /* MEASUREMENT (not intuition): leaving this copy off, in replay the g_softshadows toggle
+       * moves 97119 pixels (12.35 percent) concentrated in one precise area (rows 67-75 percent,
+       * x 448-768), i.e. the shadow appears/disappears where it should. Turning it on drops the toggle
+       * to 374 pixels: the copy at sampling time fills the store with content that does not depend on
+       * the shadow pass in progress, so it BREAKS the visual answer. Still available as an
+       * experiment: MESA_NV_RT_COPY_ON_SAMPLE=1. */
+   if (!nv_rt_copy_when_depth_readback())
+      return;
+
+   if (!st || !st->pipe || !texObj)
+      return;
+   n = _mesa_nv_rt_depth_alias_count();
+   for (i = 0; i < n; i++) {
+      uintptr_t key = 0;
+      struct gl_texture_object *t = NULL;
+
+      _mesa_nv_rt_depth_alias_at(i, &key, &t);
+      if (!key || t != texObj)
+         continue;
+      if (dri_rt_copy(st->pipe, key, texObj, i, "at-sampling") &&
+          dri_rt_alias_verbose())
+         fprintf(stderr, "nvlegacy MESA-RT-COPY-SAMPLE: texture=%u drawable=%p index=%u "
+                  "(copy: the sampler is about to use it)\n",
+                  texObj->Name, (void *) key, i);
+      return;
+   }
+}
