+/* MESA_NV_SHADOW_MARK=1: marks the colour attachments of a draw whose fragment program text
+ * contains a SHADOW lookup. Why the text and not the instruction array: in this Mesa a gl_program
+ * keeps String, Format and NIR, there is no prog_instruction array to walk (walking Instructions
+ * does not even compile), and the census of the bindings already identifies the programs that do
+ * the shadow test by their text (the two with OPTION ARB_fragment_program_shadow: the shadow-buffer
+ * pass, 851 bytes, and the pass that multiplies the result into result.color.xyz).
+ * The result is a single bit on the texture object, asked for by Wine through the private pname
+ * 0x8FFF0004: it lets Wine alias in zero-copy exactly the store the shadow pass writes, which the
+ * GL name cannot do (names differ between runs and between the binding context and the sampling
+ * one, measured: the same store was 56 for Mesa and one of 11/26/27/28/29 for Wine). */
+static int
+nv_shadow_mark_on(void)
+{
+   static int cached = -1;
+
+   if (cached < 0) {
+      const char *v = getenv("MESA_NV_SHADOW_MARK");
+      cached = (v != NULL && *v != '0' && *v != 0) ? 1 : 0;
+   }
+   return cached;
+}
+
+void
+_mesa_nv_mark_shadow_store(struct gl_context *ctx)
+{
+   const struct gl_program *fp;
+   static const struct gl_program *last_program;
+   static int last_had_shadow;
+
+   if (!nv_shadow_mark_on())
+      return;
+
+   fp = ctx->FragmentProgram._Current;
+   if (fp == NULL || fp->String == NULL)
+      return;
+
+   if (fp != last_program) {
+      const char *prog_text = fp->String;
+      int found = 0;
+
+      if (strstr(prog_text, "SHADOW1D") != NULL || strstr(prog_text, "SHADOW2D") != NULL ||
+          strstr(prog_text, "SHADOWCUBE") != NULL || strstr(prog_text, "SHADOW2DARRAY") != NULL)
+         found = 1;
+      last_program = fp;
+      last_had_shadow = found;
+   }
+   if (!last_had_shadow)
+      return;
+
+   /* The store is whatever this draw writes as colour. Luna uses single-attachment framebuffers,
+    * the extra slots are listed because a few demos attach two, and a missing attachment simply
+    * has Texture == NULL. */
+   {
+      static const int slots_list[] = { BUFFER_COLOR0, BUFFER_COLOR1, BUFFER_COLOR2, BUFFER_COLOR3 };
+      unsigned k;
+
+      for (k = 0; k < sizeof(slots_list) / sizeof(slots_list[0]); k++) {
+         struct gl_texture_object *t = ctx->DrawBuffer->Attachment[slots_list[k]].Texture;
+
+         if (t != NULL && !t->nv_shadow_written) {
+            t->nv_shadow_written = true;
+         }
+      }
+   }
+}
+
+
+/* nv-legacy: MESA_NV_ARB_TXP_SHADOW=1 marks the texture units that a projected read (TXP)
+ * touches in ARB assembly as shadow units, so the fetch performs the comparison the
+ * hardware of the period performed. The reference is the third coordinate divided by the
+ * projective factor, which is what nv_to_arb.c already emits for the NV assembly of the
+ * same demos. The mask itself is applied in arbprogparse.c and prog_to_nir.c does the
+ * divide; this helper only carries the switch. */
+
+
+
+bool
+_mesa_nv_arb_txp_shadow(void)
+{
