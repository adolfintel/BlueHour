diff --git a/src/mesa/main/nv_combiners.c b/src/mesa/main/nv_combiners.c
new file mode 100644
index 0000000..b339021
--- /dev/null
+++ b/src/mesa/main/nv_combiners.c
@@ -0,0 +1,2199 @@
+/*
+ * GL_NV_register_combiners: implementation by generating a fragment program.
+ *
+ * The register combiners (section 3.8.12 of the OpenGL 1.2 specification as
+ * amended by GL_NV_register_combiners) replace the whole fixed function
+ * texture environment, color sum and fog stages with a small fixed pipeline:
+ * <ngc> general stages that each multiply two pairs of registers and add the
+ * results, followed by one hardwired "final combiner":
+ *
+ *      ab   = A*B
+ *      iac  = (1-A)*C
+ *      fcoc = [min(ab + iac + D, 1.0), G]
+ *
+ * No modern GPU has that hardware, and no modern driver emulates it, yet it
+ * is the only shading language that the 2002-2004 Cg "fp20" profile produces
+ * (cgGL compiles fp20 programs into register combiner setup calls).  This
+ * file implements the extension by translating the combiner state into an
+ * equivalent ARB assembly fragment program, which then goes through the very
+ * same Mesa path (parser -> prog_to_nir -> driver) as any other assembly
+ * program.  That keeps the semantics in one place: the state below is a
+ * literal transcription of the spec tables, and the generated program is a
+ * literal transcription of the spec equations.
+ *
+ * Notes on fidelity:
+ *
+ *  - The register set of a stage is copied to the next stage; here the
+ *    registers are temps that are updated in place, which is the same thing
+ *    because every stage computes all of its results before writing any of
+ *    them (as the spec requires).
+ *
+ *  - The texture registers are initialized with the texels produced by the
+ *    texture fetch stage; the generated program samples the same unit with
+ *    fragment.texcoord[unit], i.e. with the coordinates the fixed function
+ *    vertex program produces for that unit.
+ *
+ *  - The FOG register is emitted as (fog color, fog coordinate).  For
+ *    fog modes whose coordinate is a distance rather than a factor the fog
+ *    factor itself is computed later by the fixed function fog lowering, so
+ *    a combiner program that actually reads the FOG register with GL_EXP or
+ *    GL_EXP2 fog gets an approximation; fp20 content in practice disables
+ *    fog or ignores the FOG register (the default final combiner that does
+ *    use it is reproduced faithfully otherwise).
+ *
+ *  - Undefined initial values (SPARE1, the RGB portion of SPARE0, texture
+ *    registers of disabled units) are initialized to zero, so rendering is at
+ *    least deterministic where the spec leaves it undefined.
+ */
+
+#include "main/nv_combiners.h"
+#include "main/nv_extensions.h"
+
+#include <limits.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "main/context.h"
+#include "main/formats.h"
+#include "main/enums.h"
+#include "main/errors.h"
+#include "main/macros.h"
+#include "main/mtypes.h"
+#include "main/texobj.h"
+#include "program/arbprogparse.h"
+#include "program/program.h"
+#include "state_tracker/st_atom.h"
+#include "state_tracker/st_program.h"
+#include "util/u_memory.h"
+
+#define COMB_MAX_TEMPS 64
+
+ /** Local parameters of the generated program: 0 and 1 = global
+  * CONSTANT_COLOR0/1, 2+2*stage and 3+2*stage = the stage's CONSTANT_COLOR0/1
+  * (NV_register_combiners2).
+  */
+#define NV_COMB_MAX_PARAMS (2 + 2 * NV_MAX_GENERAL_COMBINERS)
+
+ /** The constant colours travel in the fragment programs environment
+  * parameters (program.env[]): that is the mechanism by which Mesa really reloads
+  * the values into the driver's constant buffer (STATE_FRAGMENT_PROGRAM_ENV is
+  * resolved from ctx->FragmentProgram.Parameters[], always valid).  The high base
+  * leaves the indices an application might use on its own free.
+  */
+#define NV_COMB_ENV_BASE 224
+
+static_assert(NV_COMB_ENV_BASE + NV_COMB_MAX_PARAMS <= MAX_PROGRAM_ENV_PARAMS,
+              "combiner constants do not fit in the env parameters");
+
+struct comb_reg {
+   char name[10];
+};
+
+struct comb_gen {
+   struct gl_context *ctx;
+   const struct gl_nv_combiner *c;
+   int stages;
+
+   char *body;
+   size_t blen, bcap;
+   bool failed;
+
+   bool temp_in_use[COMB_MAX_TEMPS];
+   unsigned temp_count;
+
+   /** Permanent register temps. */
+   struct comb_reg prim, sec, spare0, spare1, fog;
+   struct comb_reg tex[MAX_TEXTURE_UNITS];
+
+   /** Combiner constants passed as program.local[] instead of as literals in the
+    * text (changing a constant then recompiles nothing).
+    */
+   bool param_used[NV_COMB_MAX_PARAMS];
+
+   bool need_fog;
+};
+
+static void comb_trace_state(struct gl_context *ctx, unsigned bind_count);
+static void
+comb_emit_mapped(struct comb_gen *g, const char *base, GLenum mapping,
+                 const char *swz, char *op, size_t oplen, struct comb_reg *tmp);
+
+/**
+ * True when no combiner input register (general stage or final combiner) has a
+ * source assigned: the application enabled GL_REGISTER_COMBINERS_NV without
+ * configuring it.  Evaluating the equations then yields a constant colour, while NV
+ * hardware routed the primary colour instead.
+ */
+static GLboolean
+comb_state_unused(const struct gl_nv_combiner *c)
+{
+   for (unsigned i = 0; i < NV_COMB_FINAL_VARS; i++) {
+      if (c->Final[i].Source != 0)
+         return GL_FALSE;
+   }
+   for (unsigned s = 0; s < NV_MAX_GENERAL_COMBINERS; s++) {
+      for (unsigned p = 0; p < 2; p++) {
+         for (unsigned v = 0; v < 4; v++) {
+            if (c->Stage[s].In[p][v].Source != 0)
+               return GL_FALSE;
+         }
+         if (c->Stage[s].ConstantSet[p])
+            return GL_FALSE;
+      }
+   }
+   return GL_TRUE;
+}
+
+
+/** The constant colours become local parameters of the generated program;
+ * MESA_NV_COMB_LITERALS=1 puts them back in the text as literals (for comparison).
+ */
+/* By default the constant colours end up **in the text** of the generated program
+ * (that is the behaviour verified visually on Dusk).  With MESA_NV_COMB_PARAMS=1
+ * they travel as program.env[] instead: changing a constant then recompiles nothing
+ * (on Dusk: 5 programs instead of ~1190 in 10 s), but at the moment the fade
+ * compositing comes out different (black screen), so this path is behind a switch.
+ */
+static bool
+comb_param_constants(void)
+{
+   return getenv("MESA_NV_COMB_PARAMS") != NULL &&
+          !getenv("MESA_NV_COMB_LITERALS");
+}
+
+/** "Literals" path: a new program for every constant change. */
+static bool
+comb_old_path(void)
+{
+   return !comb_param_constants();
+}
+
+/** program.local[] slot of a constant colour: the global ones sit at 0 and 1, the
+ * per-stage constants of NV_register_combiners2 above them.
+ */
+static int
+comb_const_slot(const struct comb_gen *g, GLenum source, int stage)
+{
+   const int which = source == GL_CONSTANT_COLOR1_NV ? 1 : 0;
+
+   if (source != GL_CONSTANT_COLOR0_NV && source != GL_CONSTANT_COLOR1_NV)
+      return -1;
+
+   if (stage >= 0 && stage < g->stages &&
+       (g->c->PerStageConstants || g->c->Stage[stage].ConstantSet[which]))
+      return 2 + stage * 2 + which;
+
+   return which;
+}
+
+/** Current value of the constant colour of a slot. */
+static const GLfloat *
+comb_param_value(const struct gl_nv_combiner *c, int stages, unsigned slot)
+{
+   /* Only diagnostics: MESA_NV_COMB_FORCEWHITE=1 forces (1,1,1,1). */
+   static GLfloat forced[4] = { 1.0f, 1.0f, 1.0f, 1.0f };
+   if (getenv("MESA_NV_COMB_FORCEWHITE"))
+      return forced;
+
+   if (slot < 2)
+      return c->ConstantColor[slot];
+
+   const unsigned s = (slot - 2) / 2;
+   const unsigned i = (slot - 2) % 2;
+
+   if ((int) s >= stages)
+      return c->ConstantColor[i];
+
+   return c->Stage[s].Constant[i];
+}
+
+/** Like nv_flush_program_constants(): the generated programs constants changed, so
+ * they must be reloaded into the driver's constant buffer.
+ */
+/* MESA_NV_TRACE_COMB=1: reports combiner calls dropped because of invalid
+ * parameters (if cgGL passes something the spec does not cover, the stage keeps its
+ * old configuration: intermittent effect).
+ */
+static void
+comb_reject(const char *fn)
+{
+}
+
+static void
+comb_flush_constants(struct gl_context *ctx)
+{
+   const GLbitfield new_state =
+      BITSET_IS_EMPTY(ctx->DriverFlags.NewShaderConstants[MESA_SHADER_FRAGMENT])
+      ? _NEW_PROGRAM_CONSTANTS : 0;
+
+   FLUSH_VERTICES(ctx, new_state, 0);
+   ST_SET_STATES(ctx->NewDriverState,
+                 ctx->DriverFlags.NewShaderConstants[MESA_SHADER_FRAGMENT]);
+}
+
+/** Writes the current constant-colour values into the local parameters of the
+ * already generated program.  Returns true if something changed: then the driver
+ * constants must be reloaded, but nothing has to be recompiled.
+ */
+static bool
+comb_set_param_values(struct gl_context *ctx, struct gl_program *prog,
+                      const struct gl_nv_combiner *c, int stages)
+{
+   struct gl_program_parameter_list *plist = prog->Parameters;
+   bool changed = false;
+
+   if (getenv("MESA_NV_COMB_NOWRITE"))
+      return false;   /* diagnostics only: does not write the values */
+
+   for (unsigned j = 0; j < plist->NumParameters; j++) {
+      unsigned slot;
+
+      /* The ARB parser names a state variable after the state it references:
+       * "state.env[E]" for program.env[E] (and "state.local[N]" for
+       * program.local[N], a form that stays accepted).
+       */
+      if (!plist->Parameters[j].Name)
+         continue;
+
+      unsigned idx;
+
+      if (sscanf(plist->Parameters[j].Name, "state.env[%u]", &idx) == 1) {
+         if (idx < NV_COMB_ENV_BASE || idx >= NV_COMB_ENV_BASE + NV_COMB_MAX_PARAMS)
+            continue;
+         slot = idx - NV_COMB_ENV_BASE;
+      } else if (sscanf(plist->Parameters[j].Name, "state.local[%u]", &idx) == 1 ||
+                 sscanf(plist->Parameters[j].Name, "program.local[%u]", &idx) == 1) {
+         slot = idx;
+         if (slot >= NV_COMB_MAX_PARAMS)
+            continue;
+      } else {
+         continue;
+      }
+
+      const GLfloat *v = comb_param_value(c, stages, slot);
+      gl_constant_value *dst =
+         plist->ParameterValues + plist->Parameters[j].ValueOffset;
+      GLfloat *env = idx >= NV_COMB_ENV_BASE &&
+                     plist->Parameters[j].Name &&
+                     !strncmp(plist->Parameters[j].Name, "state.env", 9)
+                     ? ctx->FragmentProgram.Parameters[idx] : NULL;
+      bool this_changed = false;
+
+      for (int i = 0; i < 4; i++) {
+         if (dst[i].f != v[i] || (env && env[i] != v[i])) {
+            this_changed = true;
+            break;
+         }
+      }
+
+      if (this_changed) {
+         for (int i = 0; i < 4; i++) {
+            dst[i].f = v[i];
+            if (env)
+               env[i] = v[i];
+         }
+         changed = true;
+      }
+   }
+
+   /* StateFlags is not cleared: the values live in the contexts env parameters,
+    * which is where the driver constant upload picks them up.
+    */
+
+   /* UniformBytes normally covers only the "real" uniforms; here every parameter is
+    * a state variable, so it would be 0 and the gallium path
+    * (prefer_real_buffer_in_constbuf0) would copy nothing into the constant buffer:
+    * the values would stay the dirty ones in the buffer.
+    */
+   plist->UniformBytes = plist->NumParameterValues * sizeof(GLfloat);
+
+   return changed;
+}
+
+/* ------------------------------------------------------------------ */
+/* text emission                                                       */
+/* ------------------------------------------------------------------ */
+
+static void
+comb_emit(struct comb_gen *g, const char *fmt, ...)
+{
+   va_list ap;
+   char buf[512];
+   int n;
+
+   if (g->failed)
+      return;
+
+   va_start(ap, fmt);
+   n = vsnprintf(buf, sizeof(buf), fmt, ap);
+   va_end(ap);
+
+   if (n < 0 || (size_t) n >= sizeof(buf)) {
+      g->failed = true;
+      return;
+   }
+
+   if (g->blen + (size_t) n + 1 > g->bcap) {
+      size_t cap = MAX2(g->bcap * 2, (size_t) 4096);
+      char *p = realloc(g->body, cap);
+
+      if (!p) {
+         g->failed = true;
+         return;
+      }
+      g->body = p;
+      g->bcap = cap;
+   }
+
+   memcpy(g->body + g->blen, buf, (size_t) n + 1);
+   g->blen += (size_t) n;
+}
+
+/* ------------------------------------------------------------------ */
+/* temps                                                               */
+/* ------------------------------------------------------------------ */
+
+static bool
+comb_temp_alloc(struct comb_gen *g, struct comb_reg *r)
+{
+   if (g->failed) {
+      r->name[0] = 0;
+      return false;
+   }
+
+   for (unsigned i = 0; i < COMB_MAX_TEMPS; i++) {
+      if (!g->temp_in_use[i]) {
+         g->temp_in_use[i] = true;
+         g->temp_count = MAX2(g->temp_count, i + 1);
+         snprintf(r->name, sizeof(r->name), "t%u", i);
+         return true;
+      }
+   }
+
+   g->failed = true;
+   r->name[0] = 0;
+   return false;
+}
+
+static void
+comb_temp_free(struct comb_gen *g, const struct comb_reg *r)
+{
+   unsigned i;
+
+   if (sscanf(r->name, "t%u", &i) == 1 && i < COMB_MAX_TEMPS)
+      g->temp_in_use[i] = false;
+}
+
+/* ------------------------------------------------------------------ */
+/* state helpers                                                       */
+/* ------------------------------------------------------------------ */
+
+static int
+comb_portion(GLenum portion)
+{
+   return portion == GL_ALPHA ? NV_COMB_ALPHA : NV_COMB_RGB;
+}
+
+static int
+comb_variable(GLenum variable)
+{
+   return (int) (variable - GL_VARIABLE_A_NV);
+}
+
+/**
+ * Swizzle that selects the components a variable reads from its register.
+ *
+ * Only forms the ARB assembly parser accepts in a source operand are used:
+ * masks like ".xyz" are write masks (the lexer hands back a MASK3 token the
+ * grammar does not take in a source), while a short swizzle broadcasts its
+ * last component, so ".w" yields (w,w,w,w).
+ */
+static const char *
+comb_swizzle(int portion, GLenum usage)
+{
+   if (portion == NV_COMB_RGB)
+      return usage == GL_ALPHA ? "w" : "xyzw";
+
+   return usage == GL_BLUE ? "z" : "w";
+}
+
+/** Name of the temp holding a combiner register, or NULL for constants. */
+static const struct comb_reg *
+comb_reg_of(struct comb_gen *g, GLenum source)
+{
+   switch (source) {
+   case GL_PRIMARY_COLOR_NV:
+      return &g->prim;
+   case GL_SECONDARY_COLOR_NV:
+      return &g->sec;
+   case GL_SPARE0_NV:
+      return &g->spare0;
+   case GL_SPARE1_NV:
+      return &g->spare1;
+   case GL_FOG:
+      return &g->fog;
+   default:
+      if (source >= GL_TEXTURE0 && source < GL_TEXTURE0 + MAX_TEXTURE_UNITS)
+         return &g->tex[source - GL_TEXTURE0];
+      return NULL;
+   }
+}
+
+static bool
+comb_is_const_source(GLenum source)
+{
+   return source == GL_ZERO || source == GL_CONSTANT_COLOR0_NV ||
+          source == GL_CONSTANT_COLOR1_NV;
+}
+
+/** Index of a swizzle component character. */
+static int
+comb_swz_index(char c)
+{
+   switch (c) {
+   case 'x': case 'r': return 0;
+   case 'y': case 'g': return 1;
+   case 'z': case 'b': return 2;
+   default: return 3;
+   }
+}
+
+static float
+comb_map(float e, GLenum mapping)
+{
+   switch (mapping) {
+   case GL_UNSIGNED_IDENTITY_NV:
+      return MAX2(0.0f, e);
+   case GL_UNSIGNED_INVERT_NV:
+      return 1.0f - CLAMP(e, 0.0f, 1.0f);
+   case GL_EXPAND_NORMAL_NV:
+      return 2.0f * MAX2(0.0f, e) - 1.0f;
+   case GL_EXPAND_NEGATE_NV:
+      return -2.0f * MAX2(0.0f, e) + 1.0f;
+   case GL_HALF_BIAS_NORMAL_NV:
+      return MAX2(0.0f, e) - 0.5f;
+   case GL_HALF_BIAS_NEGATE_NV:
+      return -MAX2(0.0f, e) + 0.5f;
+   case GL_SIGNED_NEGATE_NV:
+      return -e;
+   case GL_SIGNED_IDENTITY_NV:
+   default:
+      return e;
+   }
+}
+
+/**
+ * Emit the read of one combiner input variable.
+ *
+ * On return \c op holds an ARB operand text (register plus swizzle, or a
+ * literal) that yields the mapped value of the variable for \c portion.  When
+ * a temporary was needed it is returned in \c tmp (and must be freed by the
+ * caller); otherwise \c tmp->name is empty.
+ */
+static void
+comb_src(struct comb_gen *g, const struct nv_combiner_input *in, int portion,
+         int stage, char *op, size_t oplen, struct comb_reg *tmp)
+{
+   const char *swz = comb_swizzle(portion, in->Usage);
+
+   tmp->name[0] = 0;
+
+   if (comb_is_const_source(in->Source)) {
+      const GLfloat *cc = NULL;
+      float v[4];
+
+      if (in->Source == GL_CONSTANT_COLOR0_NV)
+         cc = stage >= 0 && g->c->Stage[stage].ConstantSet[0]
+                 ? g->c->Stage[stage].Constant[0]
+                 : g->c->ConstantColor[0];
+      else if (in->Source == GL_CONSTANT_COLOR1_NV)
+         cc = stage >= 0 && g->c->Stage[stage].ConstantSet[1]
+                 ? g->c->Stage[stage].Constant[1]
+                 : g->c->ConstantColor[1];
+
+      if (cc) {
+         memcpy(v, cc, sizeof(v));
+      } else {
+         v[0] = v[1] = v[2] = v[3] = 0.0f;
+      }
+
+      if (portion == NV_COMB_RGB) {
+         if (in->Usage == GL_ALPHA) {
+            float a = comb_map(v[3], in->Mapping);
+            v[0] = v[1] = v[2] = a;
+         } else {
+            v[0] = comb_map(v[0], in->Mapping);
+            v[1] = comb_map(v[1], in->Mapping);
+            v[2] = comb_map(v[2], in->Mapping);
+         }
+         v[3] = comb_map(v[3], in->Mapping);
+      } else {
+         float s = comb_map(in->Usage == GL_BLUE ? v[2] : v[3], in->Mapping);
+         v[0] = v[1] = v[2] = v[3] = s;
+      }
+
+      /* The constant colours go into the program as program.local[]: they change
+       * from frame to frame (the UI fades), and as literals they would force a
+       * recompile of the program every frame.
+       */
+      if (in->Source != GL_ZERO && !comb_old_path() &&
+          comb_param_constants()) {
+         const int slot = comb_const_slot(g, in->Source, stage);
+
+         if (slot >= 0) {
+            char base[48];
+
+            g->param_used[slot] = true;
+            snprintf(base, sizeof(base), "nv_cc%u.%s", slot, swz);
+            comb_emit_mapped(g, base, in->Mapping, swz, op, oplen, tmp);
+            return;
+         }
+      }
+
+      float o[4];
+         const int n = (int) strlen(swz);
+
+         /* ARB literals do not like swizzles: the requested components are placed
+          * straight into the right position.
+          */
+         for (int i = 0; i < 4; i++)
+            o[i] = v[comb_swz_index(swz[i < n ? i : n - 1])];
+
+         /* By default the constants are written into the text **exactly**.
+          *
+          * They used to be quantised to 8 bits (1/255) so the same program could be
+          * reused when a value moved slightly: measured, that shortcut produces
+          * visible flicker.  Dusk lowers the alpha of GL_CONSTANT_COLOR0_NV by
+          * ~0.0017 per frame and redraws the same quad 4 times per frame, updating
+          * the constant in the middle of the frame: with a 1/255 grid the step
+          * between two draws is 2.3 times the real step and, composited over the 4
+          * draws, it makes luminance oscillate by ~5 levels out of 255 at ~40 Hz.
+          * Per-frame luminance probe (MESA_NV_PROBE) over the fade area:
+          *     1/255 grid: 64 60 59 59 64 59 64 64 59...  128 drops in 7 s
+          *     exact (1/4095): 64 59 59 59 59 59 59...          1 drop only
+          * and the frame pace does not get worse (p50 6.9 ms in both cases), so
+          * quantising does not pay off: it survives only as a diagnostic switch,
+          * MESA_NV_COMB_QUANT=<bits> (grid bits, e.g. 8).
+          */
+         if (!comb_param_constants() && getenv("MESA_NV_COMB_QUANT") &&
+             !getenv("MESA_NV_COMB_EXACT_CONSTS")) {
+            const int bits = CLAMP(atoi(getenv("MESA_NV_COMB_QUANT")), 1, 12);
+            const float scale = (float) ((1u << bits) - 1u);
+
+            for (int i = 0; i < 4; i++) {
+               const float q = o[i] * scale;
+               o[i] = (float) (int) (q >= 0.0f ? q + 0.5f : q - 0.5f) / scale;
+            }
+         }
+
+         snprintf(op, oplen, "{ %g, %g, %g, %g }", o[0], o[1], o[2], o[3]);
+      return;
+   }
+
+   const struct comb_reg *reg = comb_reg_of(g, in->Source);
+   char base[16];
+
+   /* Register of a texture that cannot be fetched (unit without texture): zero. */
+   if (reg != NULL && reg->name[0] == 0) {
+      snprintf(op, oplen, "{ 0, 0, 0, 0 }");
+      return;
+   }
+
+   if (!reg) {
+      /* Unknown/unsupported source: read it as zero rather than failing the
+       * whole program, and say so once.
+       */
+      static bool warned;
+
+      if (!warned) {
+         warned = true;
+         _mesa_problem(g->ctx, "register combiners: unsupported input source "
+                               "%#x, using zero", in->Source);
+      }
+      snprintf(op, oplen, "{ 0, 0, 0, 0 }");
+      return;
+   }
+
+   if (in->Source == GL_FOG)
+      g->need_fog = true;
+
+   snprintf(base, sizeof(base), "%s.%s", reg->name, swz);
+
+   comb_emit_mapped(g, base, in->Mapping, swz, op, oplen, tmp);
+}
+
+/** Applies the mapping of an input to its operand (a register, or a local
+ * parameter for the constant colours) and writes the resulting operand into op.
+ */
+static void
+comb_emit_mapped(struct comb_gen *g, const char *base, GLenum mapping,
+                 const char *swz, char *op, size_t oplen, struct comb_reg *tmp)
+{
+   if (mapping == GL_SIGNED_IDENTITY_NV) {
+      snprintf(op, oplen, "%s", base);
+      return;
+   }
+
+   if (mapping == GL_SIGNED_NEGATE_NV) {
+      snprintf(op, oplen, "-%s", base);
+      return;
+   }
+
+   if (!comb_temp_alloc(g, tmp)) {
+      snprintf(op, oplen, "%s", base);
+      return;
+   }
+
+   switch (mapping) {
+   case GL_UNSIGNED_IDENTITY_NV:
+      comb_emit(g, "MAX %s, %s, { 0, 0, 0, 0 }%s;\n", tmp->name, base, "");
+      break;
+   case GL_UNSIGNED_INVERT_NV:
+      comb_emit(g, "MIN %s, %s, { 1, 1, 1, 1 }%s;\n", tmp->name, base, "");
+      comb_emit(g, "SUB %s, { 1, 1, 1, 1 }%s, %s;\n", tmp->name, "", tmp->name);
+      break;
+   case GL_EXPAND_NORMAL_NV:
+      comb_emit(g, "MAX %s, %s, { 0, 0, 0, 0 }%s;\n", tmp->name, base, "");
+      comb_emit(g, "MAD %s, %s, { 2, 2, 2, 2 }%s, { -1, -1, -1, -1 }%s;\n",
+                tmp->name, tmp->name, "", "");
+      break;
+   case GL_EXPAND_NEGATE_NV:
+      comb_emit(g, "MAX %s, %s, { 0, 0, 0, 0 }%s;\n", tmp->name, base, "");
+      comb_emit(g, "MAD %s, %s, { -2, -2, -2, -2 }%s, { 1, 1, 1, 1 }%s;\n",
+                tmp->name, tmp->name, "", "");
+      break;
+   case GL_HALF_BIAS_NORMAL_NV:
+      comb_emit(g, "MAX %s, %s, { 0, 0, 0, 0 }%s;\n", tmp->name, base, "");
+      comb_emit(g, "ADD %s, %s, { -0.5, -0.5, -0.5, -0.5 }%s;\n",
+                tmp->name, tmp->name, "");
+      break;
+   case GL_HALF_BIAS_NEGATE_NV:
+      comb_emit(g, "MAX %s, %s, { 0, 0, 0, 0 }%s;\n", tmp->name, base, "");
+      comb_emit(g, "SUB %s, { 0.5, 0.5, 0.5, 0.5 }%s, %s;\n",
+                tmp->name, "", tmp->name);
+      break;
+   default:
+      comb_emit(g, "MOV %s, %s;\n", tmp->name, base);
+      break;
+   }
+
+   snprintf(op, oplen, "%s.%s", tmp->name, swz);
+}
+
+/** Scale and bias of one stage portion output, and the [-1,1] clamp. */
+static void
+comb_scale_bias_clamp(struct comb_gen *g, const struct comb_reg *v,
+                      const struct nv_combiner_output *o, const char *swz)
+{
+   if (o->Bias == GL_BIAS_BY_NEGATIVE_ONE_HALF_NV) {
+      comb_emit(g, "ADD %s, %s, { -0.5, -0.5, -0.5, -0.5 }%s;\n",
+                v->name, v->name, "");
+   }
+
+   switch (o->Scale) {
+   case GL_SCALE_BY_TWO_NV:
+      comb_emit(g, "MUL %s, %s, { 2, 2, 2, 2 }%s;\n", v->name, v->name, "");
+      break;
+   case GL_SCALE_BY_FOUR_NV:
+      comb_emit(g, "MUL %s, %s, { 4, 4, 4, 4 }%s;\n", v->name, v->name, "");
+      break;
+   case GL_SCALE_BY_ONE_HALF_NV:
+      comb_emit(g, "MUL %s, %s, { 0.5, 0.5, 0.5, 0.5 }%s;\n",
+                v->name, v->name, "");
+      break;
+   default:
+      break;
+   }
+
+   comb_emit(g, "MAX %s, %s, { -1, -1, -1, -1 }%s;\n", v->name, v->name, "");
+   comb_emit(g, "MIN %s, %s, { 1, 1, 1, 1 }%s;\n", v->name, v->name, "");
+}
+
+/* ------------------------------------------------------------------ */
+/* program generation                                                  */
+/* ------------------------------------------------------------------ */
+
+/** The texture object actually bound to the unit.
+ *
+ * \c _Current means "highest priority, complete and enabled": it stays NULL when
+ * the unit has no active texturing and no program uses it yet.  On fp20/register-
+ * combiner passes the application binds the texture (CurrentTex) but never enables
+ * GL_TEXTURE_2D: reading only _Current would give NULL forever, and a generated
+ * program without a fetch would never mark the unit as used (vicious circle).  So we
+ * fall back to the raw per-target binding.
+ */
+static struct gl_texture_object *
+comb_tex_object(struct comb_gen *g, unsigned unit)
+{
+   static const gl_texture_index order[] = {
+      TEXTURE_2D_INDEX,
+      TEXTURE_RECT_INDEX,
+      TEXTURE_EXTERNAL_INDEX,
+      TEXTURE_2D_ARRAY_INDEX,
+      TEXTURE_CUBE_INDEX,
+      TEXTURE_3D_INDEX,
+      TEXTURE_1D_INDEX,
+   };
+   const struct gl_texture_unit *u = &g->ctx->Texture.Unit[unit];
+
+   if (unit >= MAX_TEXTURE_UNITS)
+      return NULL;
+
+   /* Always look at the units raw binding (CurrentTex[]), not _Current:
+    * _Current is the result of the last state update, so it may still be the one
+    * from a previous draw (measured on Dusk: the generated program samples a
+    * texture that no longer exists at draw time, and the black/wrong result depends
+    * on the order of draws, i.e. it is intermittent).
+    *
+    * Mesa's default objects (Name == 0, 1x1 black) are not user textures: a legacy
+    * fetch from a unit without a user texture must render the primary colour, not
+    * the default black object.
+    */
+   for (unsigned i = 0; i < ARRAY_SIZE(order); i++) {
+      struct gl_texture_object *t = u->CurrentTex[order[i]];
+
+      if (t && t->Name != 0)
+         return t;
+   }
+
+   return NULL;
+}
+
+/** true if the texture unit holds a user texture (not Mesa's default 1x1 black
+ * object).
+ */
+static bool
+comb_tex_user_bound(struct comb_gen *g, unsigned unit)
+{
+   return comb_tex_object(g, unit) != NULL;
+}
+
+static const char *
+comb_tex_target(struct comb_gen *g, unsigned unit)
+{
+   struct gl_texture_object *t = comb_tex_object(g, unit);
+
+   if (t) {
+      switch (t->Target) {
+      case GL_TEXTURE_1D:
+         return "1D";
+      case GL_TEXTURE_2D:
+         return "2D";
+      case GL_TEXTURE_3D:
+         return "3D";
+      case GL_TEXTURE_CUBE_MAP:
+         return "CUBE";
+      case GL_TEXTURE_RECTANGLE:
+         return "RECT";
+      case GL_TEXTURE_2D_ARRAY:
+         return "2D_ARRAY";
+      default:
+         break;
+      }
+   }
+
+   return "2D";
+}
+
+/** Component fixups for the texture registers (table NV_register_combiners.2). */
+static void
+comb_tex_fixup(struct comb_gen *g, unsigned unit)
+{
+   struct gl_texture_object *t = comb_tex_object(g, unit);
+   mesa_format fmt;
+   GLenum base;
+
+   if (!t || !t->Image[0][0] || t->Image[0][0]->TexFormat == MESA_FORMAT_NONE)
+      return;
+
+   fmt = t->Image[0][0]->TexFormat;
+   base = _mesa_get_format_base_format(fmt);
+
+   switch (base) {
+   case GL_ALPHA:
+      /* (0,0,0,At), while a fetch yields (At,At,At,At). */
+      comb_emit(g, "MOV %s.xyz, { 0, 0, 0, 0 };\n", g->tex[unit].name);
+      break;
+   case GL_DEPTH_COMPONENT:
+      if (t->Sampler.Attrib.CompareMode != GL_COMPARE_REF_TO_TEXTURE) {
+         comb_emit(g, "MOV %s.w, %s.x;\n", g->tex[unit].name, g->tex[unit].name);
+         comb_emit(g, "MOV %s.xyz, { 0, 0, 0, 0 };\n", g->tex[unit].name);
+      }
+      break;
+   default:
+      break;
+   }
+}
+
+/** Coordinate swizzle a texture fetch needs for the textures target. */
+static const char *
+comb_tex_coord_swizzle(struct comb_gen *g, unsigned unit)
+{
+   /* Identity: the ARB fetch uses (s,t,r,q) = (x,y,z,w) and divides by q, as the
+    * fixed-function program does with the coordinate varying.  A swizzle that puts a
+    * component other than w in q's place (for example ".xyxx") starts a bogus
+    * projective division.
+    */
+   (void) g;
+   (void) unit;
+
+   return "xyzw";
+}
+
+/** Emit one general combiner stage portion; returns the three output temps. */
+static void
+comb_gen_stage_portion(struct comb_gen *g, int stage, int portion,
+                       struct comb_reg out[3], int *nout,
+                       const struct comb_reg *mux_mask)
+{
+   const struct nv_combiner_stage *st = &g->c->Stage[stage];
+   const char *swz = portion == NV_COMB_RGB ? "xyz" : "x";
+   char op[4][64];
+   struct comb_reg var[4], g1, g3, gsum;
+   bool dot_ab = portion == NV_COMB_RGB && st->Out[portion].AbDot;
+   bool dot_cd = portion == NV_COMB_RGB && st->Out[portion].CdDot;
+
+   *nout = 0;
+
+   for (int i = 0; i < 4; i++) {
+      comb_src(g, &st->In[portion][i], portion, stage, op[i], sizeof(op[i]),
+               &var[i]);
+   }
+
+   if (!comb_temp_alloc(g, &g1))
+      return;
+
+   if (dot_ab)
+      comb_emit(g, "DP3 %s.%s, %s, %s;\n", g1.name, swz, op[0], op[1]);
+   else
+      comb_emit(g, "MUL %s.%s, %s, %s;\n", g1.name, swz, op[0], op[1]);
+
+   if (!comb_temp_alloc(g, &g3))
+      return;
+
+   if (dot_cd)
+      comb_emit(g, "DP3 %s.%s, %s, %s;\n", g3.name, swz, op[2], op[3]);
+   else
+      comb_emit(g, "MUL %s.%s, %s, %s;\n", g3.name, swz, op[2], op[3]);
+
+   for (int i = 0; i < 4; i++)
+      comb_temp_free(g, &var[i]);
+
+   if (st->Out[portion].MuxSum && mux_mask) {
+      /* gcc6/gcc4: SPARE0 alpha < 0.5 selects the AB result, else CD. */
+      if (!comb_temp_alloc(g, &gsum))
+         return;
+      comb_emit(g, "CMP %s.%s, %s, %s, %s;\n", gsum.name, swz, mux_mask->name,
+                g1.name, g3.name);
+   } else {
+      if (!comb_temp_alloc(g, &gsum))
+         return;
+      comb_emit(g, "ADD %s.%s, %s, %s;\n", gsum.name, swz, g1.name, g3.name);
+   }
+
+   /* The three results, scaled/biased and clamped in place. */
+   comb_scale_bias_clamp(g, &g1, &st->Out[portion], swz);
+   comb_scale_bias_clamp(g, &g3, &st->Out[portion], swz);
+   comb_scale_bias_clamp(g, &gsum, &st->Out[portion], swz);
+
+   out[0] = g1;
+   out[1] = g3;
+   out[2] = gsum;
+   *nout = 3;
+}
+
+static bool
+comb_stage_writes(const struct gl_nv_combiner *c, int stage)
+{
+   for (int p = 0; p < 2; p++) {
+      const struct nv_combiner_output *o = &c->Stage[stage].Out[p];
+
+      if (o->AbOutput != GL_DISCARD_NV || o->CdOutput != GL_DISCARD_NV ||
+          o->SumOutput != GL_DISCARD_NV)
+         return true;
+   }
+   return false;
+}
+
+/** Which register a stage output writes to (NULL = discarded). */
+static const struct comb_reg *
+comb_out_reg(struct comb_gen *g, GLenum target)
+{
+   if (target == GL_DISCARD_NV)
+      return NULL;
+
+   return comb_reg_of(g, target);
+}
+
+/** Is a combiner register read or written anywhere in the state? */
+static bool
+comb_reg_used(struct comb_gen *g, GLenum reg)
+{
+   const struct gl_nv_combiner *c = g->c;
+
+   for (int s = 0; s < g->stages; s++) {
+      for (int p = 0; p < 2; p++) {
+         for (int v = 0; v < 4; v++) {
+            if (c->Stage[s].In[p][v].Source == reg)
+               return true;
+         }
+
+         const struct nv_combiner_output *o = &c->Stage[s].Out[p];
+         const GLenum outs[3] = { o->AbOutput, o->CdOutput, o->SumOutput };
+
+         for (int k = 0; k < 3; k++) {
+            if (outs[k] == reg)
+               return true;
+         }
+
+         if (o->MuxSum && reg == GL_SPARE0_NV)
+            return true;
+      }
+   }
+
+   for (int v = 0; v < NV_COMB_FINAL_VARS; v++) {
+      if (c->Final[v].Source == reg)
+         return true;
+   }
+
+   /* The pseudo registers read SPARE0 and SECONDARY_COLOR. */
+   for (int v = 0; v < 3; v++) {
+      if (c->Final[v].Source == GL_SPARE0_PLUS_SECONDARY_COLOR_NV) {
+         if (reg == GL_SPARE0_NV || reg == GL_SECONDARY_COLOR_NV)
+            return true;
+      }
+   }
+
+   return false;
+}
+
+static bool
+comb_stage_needs_mux(struct comb_gen *g, int stage)
+{
+   return g->c->Stage[stage].Out[NV_COMB_RGB].MuxSum ||
+          g->c->Stage[stage].Out[NV_COMB_ALPHA].MuxSum;
+}
+
+static void
+comb_gen_program_body(struct comb_gen *g)
+{
+   const struct gl_nv_combiner *c = g->c;
+
+   /* Temps for the combiner registers that the state actually touches. */
+   if (comb_reg_used(g, GL_PRIMARY_COLOR_NV))
+      comb_temp_alloc(g, &g->prim);
+   if (comb_reg_used(g, GL_SECONDARY_COLOR_NV))
+      comb_temp_alloc(g, &g->sec);
+   if (comb_reg_used(g, GL_SPARE0_NV))
+      comb_temp_alloc(g, &g->spare0);
+   if (comb_reg_used(g, GL_SPARE1_NV))
+      comb_temp_alloc(g, &g->spare1);
+   if (comb_reg_used(g, GL_FOG))
+      comb_temp_alloc(g, &g->fog);
+
+   for (unsigned u = 0; u < MAX_TEXTURE_UNITS; u++) {
+      bool used = false;
+
+      for (int s = 0; s < g->stages && !used; s++) {
+         for (int p = 0; p < 2 && !used; p++) {
+            for (int v = 0; v < 4; v++) {
+               if (c->Stage[s].In[p][v].Source == GL_TEXTURE0 + u)
+                  used = true;
+            }
+         }
+         if (comb_out_reg(g, c->Stage[s].Out[NV_COMB_RGB].AbOutput) ==
+                 &g->tex[u] ||
+             comb_out_reg(g, c->Stage[s].Out[NV_COMB_RGB].CdOutput) == &g->tex[u] ||
+             comb_out_reg(g, c->Stage[s].Out[NV_COMB_RGB].SumOutput) == &g->tex[u] ||
+             comb_out_reg(g, c->Stage[s].Out[NV_COMB_ALPHA].AbOutput) == &g->tex[u] ||
+             comb_out_reg(g, c->Stage[s].Out[NV_COMB_ALPHA].CdOutput) == &g->tex[u] ||
+             comb_out_reg(g, c->Stage[s].Out[NV_COMB_ALPHA].SumOutput) == &g->tex[u])
+            used = true;
+      }
+
+      for (int v = 0; v < NV_COMB_FINAL_VARS && !used; v++) {
+         if (c->Final[v].Source == GL_TEXTURE0 + u)
+            used = true;
+      }
+
+      /* Only if the unit has a texture: a fetch towards an empty unit would be
+       * rejected by the driver (and the combiner register has no defined value
+       * anyway).
+       *
+       * Measured on Dusk (2003): in wireframe mode the 3D pass uses a GL_TEXTURE0
+       * input without any texture bound.  NV hardware of that era, on the legacy
+       * path, returned the primary colour (the rasterised one) from a fetch on a
+       * unit without texture; Mesa would otherwise use the default 1x1 black object,
+       * which turns every draw of the pass black (invisible mesh, intact UI).  With
+       * the proxy the same pass uses a fragment program that samples nothing and it
+       * looks right: that confirms the expected value is the colour.
+       */
+      if (used) {
+         comb_temp_alloc(g, &g->tex[u]);
+         if (comb_tex_user_bound(g, u)) {
+            comb_emit(g, "MOV %s, fragment.texcoord[%u].%s;\n",
+                      g->tex[u].name, u, comb_tex_coord_swizzle(g, u));
+            comb_emit(g, "TEX %s, %s, texture[%u], %s;\n", g->tex[u].name,
+                      g->tex[u].name, u, comb_tex_target(g, u));
+            comb_tex_fixup(g, u);
+         } else {
+            comb_emit(g, "MOV %s, fragment.color;\n", g->tex[u].name);
+         }
+      }
+   }
+
+   if (g->fog.name[0]) {
+      const GLfloat *fz = g->ctx->Fog.Color;
+
+      comb_emit(g, "MOV %s, { %g, %g, %g, 1 };\n", g->fog.name,
+                (double) fz[0], (double) fz[1], (double) fz[2]);
+      if (g->ctx->Fog.Enabled)
+         comb_emit(g, "MOV %s.w, fragment.fogcoord.x;\n", g->fog.name);
+   }
+
+   /* Register set of COMBINER0_NV: table NV_register_combiners.1. */
+   if (g->prim.name[0])
+      comb_emit(g, "MOV %s, fragment.color;\n", g->prim.name);
+   if (g->sec.name[0]) {
+      /* ARB assembly fragment programs have no secondary color input, so the
+       * SECONDARY_COLOR_NV register cannot be fed from the vertex's specular
+       * color here.  Zero is the least surprising stand-in: it drops specular
+       * contributions routed through the combiners rather than inventing them.
+       */
+      static bool warned;
+
+      if (!warned) {
+         warned = true;
+         _mesa_problem(g->ctx, "register combiners: SECONDARY_COLOR_NV is not "
+                               "available to an assembly fragment program, "
+                               "using zero");
+      }
+      comb_emit(g, "MOV %s, { 0, 0, 0, 1 };\n", g->sec.name);
+   }
+   if (g->spare0.name[0]) {
+      comb_emit(g, "MOV %s, { 0, 0, 0, 0 };\n", g->spare0.name);
+      if ((g->ctx->Texture._EnabledCoordUnits & (1u << 0)) &&
+          !g->tex[0].name[0]) {
+         /* SPARE0 starts with the alpha of texture unit 0. */
+         comb_temp_alloc(g, &g->tex[0]);
+         if (comb_tex_user_bound(g, 0)) {
+            comb_emit(g, "MOV %s, fragment.texcoord[0].%s;\n", g->tex[0].name,
+                      comb_tex_coord_swizzle(g, 0));
+            comb_emit(g, "TEX %s, %s, texture[0], %s;\n", g->tex[0].name,
+                      g->tex[0].name, comb_tex_target(g, 0));
+         } else {
+            comb_emit(g, "MOV %s, fragment.color;\n", g->tex[0].name);
+         }
+      }
+      if (g->tex[0].name[0] && (g->ctx->Texture._EnabledCoordUnits & (1u << 0)))
+         comb_emit(g, "MOV %s.w, %s.w;\n", g->spare0.name, g->tex[0].name);
+   }
+   if (g->spare1.name[0])
+      comb_emit(g, "MOV %s, { 0, 0, 0, 0 };\n", g->spare1.name);
+
+   for (int s = 0; s < g->stages; s++) {
+      struct comb_reg out_rgb[3], out_a[3];
+      struct comb_reg mask;
+      int nrgb = 0, na = 0;
+
+      mask.name[0] = 0;
+
+      if (comb_stage_needs_mux(g, s)) {
+         comb_temp_alloc(g, &mask);
+         comb_emit(g, "SLT %s, %s.w, { 0.5, 0.5, 0.5, 0.5 };\n",
+                   mask.name, g->spare0.name);
+      }
+
+      if (comb_stage_writes(g->c, s)) {
+         comb_gen_stage_portion(g, s, NV_COMB_RGB, out_rgb, &nrgb,
+                                mask.name[0] ? &mask : NULL);
+         comb_gen_stage_portion(g, s, NV_COMB_ALPHA, out_a, &na,
+                                mask.name[0] ? &mask : NULL);
+      }
+
+      if (mask.name[0])
+         comb_temp_free(g, &mask);
+
+      /* Copy the updated register set to the next stage: the RGB portion
+       * writes the.xyz of its target register, the alpha portion its.w.
+       */
+      for (int k = 0; k < 3 && k < nrgb; k++) {
+         const struct nv_combiner_output *o = &c->Stage[s].Out[NV_COMB_RGB];
+         const GLenum tgt[3] = { o->AbOutput, o->CdOutput, o->SumOutput };
+         const struct comb_reg *r = comb_out_reg(g, tgt[k]);
+
+         if (r)
+            comb_emit(g, "MOV %s.xyz, %s;\n", r->name, out_rgb[k].name);
+      }
+
+      for (int k = 0; k < 3 && k < na; k++) {
+         const struct nv_combiner_output *o = &c->Stage[s].Out[NV_COMB_ALPHA];
+         const GLenum tgt[3] = { o->AbOutput, o->CdOutput, o->SumOutput };
+         const struct comb_reg *r = comb_out_reg(g, tgt[k]);
+
+         if (r)
+            comb_emit(g, "MOV %s.w, %s.x;\n", r->name, out_a[k].name);
+      }
+
+      for (int i = 0; i < nrgb; i++)
+         comb_temp_free(g, &out_rgb[i]);
+      for (int i = 0; i < na; i++)
+         comb_temp_free(g, &out_a[i]);
+   }
+
+   /* Final combiner: fcoc = [min(A*B + (1-A)*C + D, 1), G]. */
+   {
+      char op[NV_COMB_FINAL_VARS][64];
+      struct comb_reg var[NV_COMB_FINAL_VARS], tmp[3];
+      const char *swz3 = "xyz";
+
+      memset(var, 0, sizeof(var));
+      memset(tmp, 0, sizeof(tmp));
+
+      /* The two pseudo registers are only readable by A, B and C. */
+      struct comb_reg etf, s0ps;
+
+      etf.name[0] = s0ps.name[0] = 0;
+
+      for (int v = 0; v < NV_COMB_FINAL_VARS; v++) {
+         const struct nv_combiner_input *in = &c->Final[v];
+
+         if (in->Source == GL_E_TIMES_F_NV) {
+            if (!etf.name[0]) {
+               char opE[64], opF[64];
+               struct comb_reg tE, tF;
+
+               /* E and F cannot themselves use the pseudo registers. */
+               comb_src(g, &c->Final[4], NV_COMB_RGB, -1, opE, sizeof(opE), &tE);
+               comb_src(g, &c->Final[5], NV_COMB_RGB, -1, opF, sizeof(opF), &tF);
+               comb_temp_alloc(g, &etf);
+               comb_emit(g, "MUL %s.xyz, %s, %s;\n", etf.name, opE, opF);
+               comb_temp_free(g, &tE);
+               comb_temp_free(g, &tF);
+            }
+            snprintf(op[v], sizeof(op[v]), "%s.%s", etf.name,
+                     comb_swizzle(NV_COMB_RGB, in->Usage));
+            continue;
+         }
+
+         if (in->Source == GL_SPARE0_PLUS_SECONDARY_COLOR_NV) {
+            if (!s0ps.name[0]) {
+               struct comb_reg a, b;
+
+               comb_temp_alloc(g, &a);
+               comb_temp_alloc(g, &b);
+               comb_emit(g, "MAX %s, %s, { 0, 0, 0, 0 };\n", a.name,
+                         g->spare0.name);
+               comb_emit(g, "MAX %s, %s, { 0, 0, 0, 0 };\n", b.name,
+                         g->sec.name);
+               comb_temp_alloc(g, &s0ps);
+               comb_emit(g, "ADD %s, %s, %s;\n", s0ps.name, a.name, b.name);
+               if (g->ctx->NV.ColorSumClamp) {
+                  comb_emit(g, "MAX %s, %s, { 0, 0, 0, 0 };\n", s0ps.name,
+                            s0ps.name);
+                  comb_emit(g, "MIN %s, %s, { 1, 1, 1, 1 };\n", s0ps.name,
+                            s0ps.name);
+               }
+               comb_temp_free(g, &a);
+               comb_temp_free(g, &b);
+            }
+            snprintf(op[v], sizeof(op[v]), "%s.%s", s0ps.name,
+                     comb_swizzle(NV_COMB_RGB, in->Usage));
+            continue;
+         }
+
+         comb_src(g, in, v == 6 ? NV_COMB_ALPHA : NV_COMB_RGB, -1, op[v],
+                  sizeof(op[v]), &var[v]);
+      }
+
+      comb_temp_alloc(g, &tmp[0]);
+      comb_emit(g, "MUL %s.%s, %s, %s;\n", tmp[0].name, swz3, op[0], op[1]);
+      comb_temp_alloc(g, &tmp[1]);
+      comb_emit(g, "SUB %s.%s, { 1, 1, 1, 1 }, %s;\n", tmp[1].name, swz3,
+                op[0]);
+      comb_emit(g, "MUL %s.%s, %s, %s;\n", tmp[1].name, swz3, tmp[1].name, op[2]);
+      comb_emit(g, "ADD %s.%s, %s.xyzw, %s;\n", tmp[0].name, swz3,
+                tmp[0].name, op[3]);
+      comb_emit(g, "ADD %s.%s, %s.xyzw, %s;\n", tmp[0].name, swz3,
+                tmp[0].name, tmp[1].name);
+      comb_emit(g, "MIN %s.%s, %s.xyzw, { 1, 1, 1, 1 };\n", tmp[0].name, swz3,
+                tmp[0].name);
+
+      /* MESA_NV_COMB_ZEROSTATE=primary: when the application enables register
+       * combiners without configuring any register, NV hardware routed the primary
+       * colour; without this rule the generated program produces a constant colour.
+       */
+      if (comb_state_unused(c) && getenv("MESA_NV_COMB_ZEROSTATE") &&
+          !strcmp(getenv("MESA_NV_COMB_ZEROSTATE"), "primary")) {
+         comb_emit(g, "MOV result.color, fragment.color;\n");
+      } else if (getenv("MESA_NV_COMB_SHOWCONST")) {
+         /* Debug output: writes the colour of a constant colour, which shows
+          * whether the parameter values really reach the shader.
+          */
+         int k = -1;
+
+         for (unsigned i = 0; i < NV_COMB_MAX_PARAMS; i++) {
+            if (g->param_used[i]) {
+               k = (int) i;
+               break;
+            }
+         }
+         if (k >= 0)
+            comb_emit(g, "MOV result.color, nv_cc%d;\n", k);
+         else
+            comb_emit(g, "MOV result.color, { 0, 1, 0, 1 };\n");
+      } else if (getenv("MESA_NV_COMB_RED")) {
+         /* Debug output: makes visible whether the generated program really is the
+          * one bound to the draws in progress.
+          */
+         comb_emit(g, "MOV result.color, { 1, 0, 0, 1 };\n");
+      } else if (getenv("MESA_NV_COMB_TESTOUT")) {
+         /* A/B to isolate how result.color is written: a single 4-component write
+          * versus the two partial writes.xyz +.w that the normal path emits.  Tells
+          * whether the black wireframe comes from the partial output write.
+          */
+         const char *mode = getenv("MESA_NV_COMB_TESTOUT");
+
+         if (strcmp(mode, "white_single") == 0) {
+            comb_emit(g, "MOV result.color, { 1, 1, 1, 1 };\n");
+         } else if (strcmp(mode, "white_split") == 0) {
+            comb_emit(g, "MOV result.color.xyz, { 1, 1, 1, 1 };\n");
+            comb_emit(g, "MOV result.color.w, { 1, 1, 1, 1 };\n");
+         } else if (strcmp(mode, "t0_plus_one") == 0) {
+            /* If the chain above produced 0 (instead of 1) this ADD brings it to 1:
+             * white means the chain reads the constants badly, not that the output
+             * write is broken.
+             */
+            comb_emit(g, "ADD t0.xyz, t0.xyzw, { 1, 1, 1, 1 };\n");
+            comb_emit(g, "MOV result.color.xyz, %s.xyzw;\n", tmp[0].name);
+            comb_emit(g, "MOV result.color.w, { 1, 1, 1, 1 };\n");
+         } else if (strcmp(mode, "tex0") == 0) {
+            /* Only the fetch of unit 0 in the output: if the wireframe becomes bright
+             * the texture arrives, otherwise the program samples the default texture
+             * (1x1 black).
+             */
+            comb_emit(g, "MOV %s, fragment.texcoord[0].xyzw;\n", tmp[0].name);
+            comb_emit(g, "TEX %s, %s, texture[0], %s;\n", tmp[0].name,
+                      tmp[0].name, comb_tex_target(g, 0));
+            comb_emit(g, "MOV result.color, %s;\n", tmp[0].name);
+         } else if (strcmp(mode, "kill") == 0) {
+            /* Discards all fragments of the generated programs: if the scene becomes
+             * visible, the pass using the combiners is the one covering everything in
+             * black.
+             */
+            comb_emit(g, "MOV %s, { 0, 0, 0, 0 };\n", tmp[0].name);
+            comb_emit(g, "KIL %s.w;\n", tmp[0].name);
+            comb_emit(g, "MOV result.color, %s;\n", tmp[0].name);
+         } else if (strcmp(mode, "tex0c") == 0) {
+            /* Fetch at a fixed coordinate: this rules out the vertex programs
+             * texcoord problem and measures the content of the sampled texture.
+             */
+            comb_emit(g, "MOV %s, { 0.5, 0.5, 0, 1 };\n", tmp[0].name);
+            comb_emit(g, "TEX %s, %s, texture[0], %s;\n", tmp[0].name,
+                      tmp[0].name, comb_tex_target(g, 0));
+            comb_emit(g, "MOV result.color, %s;\n", tmp[0].name);
+         } else if (strcmp(mode, "primary") == 0) {
+            comb_emit(g, "MOV result.color, fragment.color;\n");
+         } else if (strcmp(mode, "split_src") == 0) {
+            comb_emit(g, "MOV result.color.xyz, %s.xyzw;\n", tmp[0].name);
+            comb_emit(g, "MOV result.color.w, %s;\n", op[6]);
+         } else {
+            comb_emit(g, "MOV result.color, { 0, 1, 0, 1 };\n");
+         }
+      } else {
+         comb_emit(g, "MOV result.color.xyz, %s.xyzw;\n", tmp[0].name);
+         comb_emit(g, "MOV result.color.w, %s;\n", op[6]);
+      }
+
+      for (int v = 0; v < NV_COMB_FINAL_VARS; v++)
+         comb_temp_free(g, &var[v]);
+      for (int v = 0; v < 3; v++)
+         comb_temp_free(g, &tmp[v]);
+      if (etf.name[0])
+         comb_temp_free(g, &etf);
+      if (s0ps.name[0])
+         comb_temp_free(g, &s0ps);
+   }
+}
+
+/** Mixes a value into an FNV-1a hash. */
+static uint64_t
+comb_sig_mix(uint64_t h, uint64_t v)
+{
+   h ^= v;
+   h *= 1099511628211ull;
+   h ^= h >> 31;
+
+   return h;
+}
+
+static uint64_t
+comb_sig_input(uint64_t h, struct comb_gen *g, const struct nv_combiner_input *in)
+{
+   h = comb_sig_mix(h, in->Source);
+   h = comb_sig_mix(h, in->Mapping);
+   h = comb_sig_mix(h, in->Usage);
+
+   if (in->Source == GL_FOG) {
+      h = comb_sig_mix(h, (unsigned) g->ctx->Fog.Enabled);
+      for (int i = 0; i < 4; i++)
+         h = comb_sig_mix(h, (uint64_t) (g->ctx->Fog.Color[i] * 65536.0f));
+   }
+
+   if (in->Source >= GL_TEXTURE0 && in->Source < GL_TEXTURE0 + MAX_TEXTURE_UNITS) {
+      const struct gl_texture_object *t = comb_tex_object(g,
+                                            in->Source - GL_TEXTURE0);
+
+      if (!t)
+         return comb_sig_mix(h, 0);
+
+      h = comb_sig_mix(h, t->Name);
+      h = comb_sig_mix(h, (unsigned) t->Target);
+      h = comb_sig_mix(h, (uint64_t) t->lastLevel);
+
+      if (t->Image[0][0]) {
+         h = comb_sig_mix(h, (uint64_t) t->Image[0][0]->TexFormat);
+         h = comb_sig_mix(h, (uint64_t)
+                          _mesa_get_format_base_format(t->Image[0][0]->TexFormat));
+      }
+
+      h = comb_sig_mix(h, (unsigned) t->Sampler.Attrib.CompareMode);
+   }
+
+   return h;
+}
+
+/** Fingerprint of everything the generated program reads from state, except the
+ * combiner constant values (which are already in the text and therefore change
+ * Version).
+ */
+static uint64_t
+comb_state_signature(struct comb_gen *g)
+{
+   uint64_t h = 1469598103934665603ull;
+
+   /* The state version is not included: the constant-colour values change every
+    * frame but do not change the program text (they travel as program.local[]).
+    * Only the structure matters.
+    */
+   if (comb_old_path())
+      h = comb_sig_mix(h, g->c->Version);
+   h = comb_sig_mix(h, (unsigned) g->stages);
+   h = comb_sig_mix(h, (unsigned) g->ctx->NV.ColorSumClamp);
+   h = comb_sig_mix(h, (unsigned) g->ctx->Texture._EnabledCoordUnits);
+
+   /* Whether a texture unit holds a user texture changes the generated program
+    * (fetch versus primary colour).
+    */
+   for (unsigned u = 0; u < MAX_TEXTURE_UNITS; u++) {
+      h = comb_sig_mix(h, comb_tex_user_bound(g, u) ? 0x5a1e5ull + u : 0x1e5ull + u);
+   }
+
+   for (int s = 0; s < g->stages; s++) {
+      for (int p = 0; p < 2; p++) {
+         for (int v = 0; v < 4; v++)
+            h = comb_sig_input(h, g, &g->c->Stage[s].In[p][v]);
+
+         h = comb_sig_mix(h, (uint64_t) g->c->Stage[s].Out[p].AbOutput);
+         h = comb_sig_mix(h, (uint64_t) g->c->Stage[s].Out[p].CdOutput);
+         h = comb_sig_mix(h, (uint64_t) g->c->Stage[s].Out[p].SumOutput);
+         h = comb_sig_mix(h, (uint64_t) g->c->Stage[s].Out[p].Scale);
+         h = comb_sig_mix(h, (uint64_t) g->c->Stage[s].Out[p].Bias);
+         h = comb_sig_mix(h, (uint64_t) g->c->Stage[s].Out[p].AbDot);
+         h = comb_sig_mix(h, (uint64_t) g->c->Stage[s].Out[p].CdDot);
+         h = comb_sig_mix(h, (uint64_t) g->c->Stage[s].Out[p].MuxSum);
+         /* Which constant colors of the stage exist in the text: */
+         h = comb_sig_mix(h, (uint64_t) g->c->Stage[s].ConstantSet[0]);
+         h = comb_sig_mix(h, (uint64_t) g->c->Stage[s].ConstantSet[1]);
+      }
+   }
+
+   for (int v = 0; v < NV_COMB_FINAL_VARS; v++)
+      h = comb_sig_input(h, g, &g->c->Final[v]);
+
+   return h;
+}
+
+static char *
+comb_build_text(struct comb_gen *g)
+{
+   size_t cap = g->blen + 512;
+   char *text = malloc(cap);
+   size_t off = 0;
+
+   if (!text)
+      return NULL;
+
+   off += snprintf(text + off, cap - off, "!!ARBfp1.0\n");
+
+   for (unsigned i = 0; i < NV_COMB_MAX_PARAMS; i++) {
+      if (g->param_used[i])
+         off += snprintf(text + off, cap - off,
+                         "PARAM nv_cc%u = program.env[%u];\n", i,
+                         NV_COMB_ENV_BASE + i);
+   }
+
+   off += snprintf(text + off, cap - off, "TEMP");
+   for (unsigned i = 0; i < g->temp_count; i++)
+      off += snprintf(text + off, cap - off, " t%u%s", i,
+                      i + 1 < g->temp_count ? "," : ";");
+   off += snprintf(text + off, cap - off, "\n");
+
+   if (off + g->blen + 8 >= cap) {
+      free(text);
+      return NULL;
+   }
+
+   memcpy(text + off, g->body, g->blen);
+   off += g->blen;
+   off += snprintf(text + off, cap - off, "END\n");
+
+   return text;
+}
+
+/** 64-bit FNV-1a over the generated program text. */
+static uint64_t
+comb_text_hash(const char *text)
+{
+   uint64_t h = 14695981039346656037ull;
+
+   while (*text) {
+      h ^= (unsigned char) *text++;
+      h *= 1099511628211ull;
+   }
+
+   return h;
+}
+
+static void
+comb_dump_text(struct gl_context *ctx, uint32_t version, const char *text)
+{
+   const char *dir = getenv("MESA_NV_DUMP");
+   char path[PATH_MAX];
+   FILE *f;
+
+   if (!dir || !*dir)
+      return;
+
+   snprintf(path, sizeof(path), "%s/combiner_v%u_h%08x.arb", dir, version,
+            (unsigned) comb_text_hash(text));
+   f = fopen(path, "wb");
+   if (!f)
+      return;
+
+   fputs(text, f);
+   fclose(f);
+}
+
+
+/** Compact dump of the combiner state actually held in Mesa.  It lets the generated
+ * program be compared with the glCombiner*NV calls received.
+ */
+static void
+comb_dump_state(struct gl_context *ctx, const struct gl_nv_combiner *c,
+                unsigned long long sig)
+{
+   static unsigned long long dumped[8];
+   static unsigned next;
+
+   for (unsigned i = 0; i < ARRAY_SIZE(dumped); i++)
+      if (dumped[i] == sig)
+         return;
+   dumped[next++ % ARRAY_SIZE(dumped)] = sig;
+
+   const int stages = CLAMP(ctx->NV.NumGeneralCombiners, 1, NV_MAX_GENERAL_COMBINERS);
+
+   fprintf(stderr, "MESA-NV COMBSTATE sig=%08x nst=%d clamp=%d psc=%d "
+                   "cc0=(%g %g %g %g) cc1=(%g %g %g %g)\n",
+           (unsigned) sig, stages, (int) ctx->NV.ColorSumClamp,
+           (int) c->PerStageConstants,
+           (double) c->ConstantColor[0][0], (double) c->ConstantColor[0][1],
+           (double) c->ConstantColor[0][2], (double) c->ConstantColor[0][3],
+           (double) c->ConstantColor[1][0], (double) c->ConstantColor[1][1],
+           (double) c->ConstantColor[1][2], (double) c->ConstantColor[1][3]);
+
+   for (int s = 0; s < stages; s++) {
+      for (int p = 0; p < 2; p++) {
+         const struct nv_combiner_output *o = &c->Stage[s].Out[p];
+
+         fprintf(stderr, "  s%d %s: A(%#x %#x %#x) B(%#x %#x %#x) "
+                         "C(%#x %#x %#x) D(%#x %#x %#x) -> ab=%#x cd=%#x sum=%#x "
+                         "sc=%#x bi=%#x abdot=%d cddot=%d mux=%d\n",
+                 s, p ? "A" : "R",
+                 c->Stage[s].In[p][0].Source, c->Stage[s].In[p][0].Mapping,
+                 c->Stage[s].In[p][0].Usage,
+                 c->Stage[s].In[p][1].Source, c->Stage[s].In[p][1].Mapping,
+                 c->Stage[s].In[p][1].Usage,
+                 c->Stage[s].In[p][2].Source, c->Stage[s].In[p][2].Mapping,
+                 c->Stage[s].In[p][2].Usage,
+                 c->Stage[s].In[p][3].Source, c->Stage[s].In[p][3].Mapping,
+                 c->Stage[s].In[p][3].Usage,
+                 o->AbOutput, o->CdOutput, o->SumOutput, o->Scale, o->Bias,
+                 (int) o->AbDot, (int) o->CdDot, (int) o->MuxSum);
+      }
+      for (int k = 0; k < 2; k++) {
+         if (c->Stage[s].ConstantSet[k])
+            fprintf(stderr, "  s%d cc%d=(%g %g %g %g)\n", s, k,
+                    (double) c->Stage[s].Constant[k][0],
+                    (double) c->Stage[s].Constant[k][1],
+                    (double) c->Stage[s].Constant[k][2],
+                    (double) c->Stage[s].Constant[k][3]);
+      }
+   }
+   for (int v = 0; v < NV_COMB_FINAL_VARS; v++)
+      fprintf(stderr, "  fin %c: in=%#x map=%#x use=%#x\n", 'A' + v,
+              c->Final[v].Source, c->Final[v].Mapping, c->Final[v].Usage);
+}
+
+
+/** Built from the combiner state; see _mesa_nv_combiner_program() below. */
+static struct gl_program *
+comb_program_build(struct gl_context *ctx)
+{
+   struct gl_nv_combiner *c = &ctx->NV.Combiner;
+   struct comb_gen g;
+   struct gl_program *prog;
+   char *text;
+   uint64_t sig;
+   int stages;
+
+   /* The cache is keyed on the generated text: the text says exactly what the
+    * program will do, so any state that does not change it (an unread texture, an
+    * unused constant colour) causes no recompile, and two different states that
+    * produce the same text share the compiled program.
+    */
+   if (c->GenerationFailed)
+      return NULL;
+
+
+   /* Note: it used to be thought that a never-configured combiner state should fall
+    * back to fixed-function (comb_state_unused).  Measured on Dusk (back-buffer
+    * captures, same scene): with the generated program the wireframe is as bright as
+    * with the proxy (mean 110-126); with the fixed-function fallback it is black
+    * (3.2).  The generated program is correct; the visible defect is intermittent,
+    * not a path problem.
+    */
+
+   stages = CLAMP(ctx->NV.NumGeneralCombiners, 1, NV_MAX_GENERAL_COMBINERS);
+
+   memset(&g, 0, sizeof(g));
+   g.ctx = ctx;
+   g.c = c;
+   g.stages = stages;
+
+   /* If nothing the program reads has changed, the program in use is already the
+    * right one: the text is not even rewritten, and only the constant-colour values
+    * flow into the local parameters.
+    *
+    * On the literals path (the default one) however the constant-colour values live
+    * IN THE TEXT of the program, not in parameters: the structural signature alone is
+    * not enough, because the same structure with different values would need a
+    * different text.  Reusing the old program kept rendering with the literals of an
+    * earlier configuration (wrong colours, and on Dusk's wireframe geometrically
+    * correct but black: it depended on which configuration happened to be in cache,
+    * hence intermittent).  Here the text is regenerated; the cache keyed on the text
+    * hash takes care of deduplication, so there is no recompile when the text is the
+    * same.
+    */
+   sig = comb_state_signature(&g);
+   if (c->Program && c->StateSignature == sig && !comb_old_path()) {
+      if (comb_set_param_values(ctx, c->Program, c, stages) ||
+          getenv("MESA_NV_COMB_ALWAYSFLUSH"))
+         comb_flush_constants(ctx);
+      return c->Program;
+   }
+
+   comb_gen_program_body(&g);
+
+   if (g.failed || !g.body) {
+      c->GenerationFailed = GL_TRUE;
+      fprintf(stderr, "MESA-NV COMBGEN FAIL: body (frame %u)\n",
+              _mesa_nv_frame());
+      _mesa_problem(ctx, "register combiners: out of space building the "
+                         "equivalent fragment program");
+      free(g.body);
+      return NULL;
+   }
+
+   text = comb_build_text(&g);
+   free(g.body);
+   if (!text) {
+      c->GenerationFailed = GL_TRUE;
+      fprintf(stderr, "MESA-NV COMBGEN FAIL: text (frame %u)\n",
+              _mesa_nv_frame());
+      return NULL;
+   }
+
+   sig = comb_text_hash(text);
+
+   if (c->Program && c->ProgramSignature == sig) {
+      c->StateSignature = comb_state_signature(&g);
+      if (comb_set_param_values(ctx, c->Program, c, stages))
+         comb_flush_constants(ctx);
+      free(text);
+      return c->Program;
+   }
+
+   for (unsigned i = 0; i < NV_COMB_PROGRAM_CACHE; i++) {
+      if (c->Cache[i].Program && c->Cache[i].Signature == sig) {
+         _mesa_reference_program(ctx, &c->Program, c->Cache[i].Program);
+         _mesa_nv_comb_note_program(c->Program, sig);
+         /* The signature of the program in use must be updated too: without it, the
+          * comparison "hash of the freshly generated text == ProgramSignature" above
+          * can match the hash of another program and return the wrong one (a text
+          * different from the one requested).  On Dusk (2003, Wine) this was the cause
+          * of the black wireframe (key W) in the no-proxy mode: the program that drew
+          * the white lines was replaced by one copying the texture, which is black
+          * there; hence also the intermittence and the "it fixes itself when the
+          * camera moves".
+          */
+         c->ProgramSignature = sig;
+         c->ProgramVersion = c->Version;
+         c->StateSignature = comb_state_signature(&g);
+         if (comb_set_param_values(ctx, c->Program, c, stages))
+            comb_flush_constants(ctx);
+         free(text);
+         return c->Program;
+      }
+   }
+
+   _mesa_reference_program(ctx, &c->Program, NULL);
+
+
+   comb_dump_text(ctx, c->Version, text);
+
+   /* Its own id, not system id 0: it makes the generated program recognisable in the
+    * traces (cur=...) as opposed to the fixed-function one.
+    */
+   prog = _mesa_new_program(ctx, MESA_SHADER_FRAGMENT, NV_COMB_PROGRAM_ID,
+                            true);
+   if (!prog) {
+      free(text);
+      return NULL;
+   }
+
+   ctx->Program.ErrorPos = -1;
+   _mesa_parse_arb_fragment_program(ctx, GL_FRAGMENT_PROGRAM_ARB, text,
+                                    (GLsizei) strlen(text), prog);
+
+   if (ctx->Program.ErrorPos != -1) {
+      struct gl_program *p = prog;
+
+      free(text);
+      _mesa_reference_program(ctx, &p, NULL);
+      c->GenerationFailed = GL_TRUE;
+      fprintf(stderr, "MESA-NV COMBGEN FAIL: parsing (frame %u): %s\n",
+              _mesa_nv_frame(), ctx->Program.ErrorString);
+      _mesa_problem(ctx, "register combiners: the generated fragment program "
+                         "was rejected (%s)", ctx->Program.ErrorString);
+      return NULL;
+   }
+
+   free(text);
+
+   if (!st_program_string_notify(ctx, GL_FRAGMENT_PROGRAM_ARB, prog)) {
+      struct gl_program *p = prog;
+
+      _mesa_reference_program(ctx, &p, NULL);
+      c->GenerationFailed = GL_TRUE;
+      fprintf(stderr, "MESA-NV COMBGEN FAIL: driver (frame %u)\n",
+              _mesa_nv_frame());
+      _mesa_problem(ctx, "register combiners: the generated fragment program "
+                         "was rejected by the driver");
+      return NULL;
+   }
+
+
+
+   if (comb_set_param_values(ctx, prog, c, stages))
+      comb_flush_constants(ctx);
+
+   c->ProgramVersion = c->Version;
+   c->ProgramSignature = sig;
+   c->StateSignature = comb_state_signature(&g);
+   _mesa_reference_program(ctx, &c->Program, prog);
+   _mesa_nv_comb_note_program(prog, sig);
+
+   {
+      struct gl_nv_combiner_cache_slot *slot = &c->Cache[c->CacheNext];
+
+      c->CacheNext = (c->CacheNext + 1) % NV_COMB_PROGRAM_CACHE;
+      _mesa_reference_program(ctx, &slot->Program, prog);
+      slot->Signature = sig;
+   }
+
+
+   return c->Program;
+}
+
+/** Debug line describing the current combiner state. */
+/** Any write to the combiner state changes the program to be generated: the program
+ * has to be redone and the state driving that choice updated.
+ */
+static void
+comb_state_changed(struct gl_context *ctx)
+{
+   ctx->NV.Combiner.Version++;
+   FLUSH_VERTICES(ctx, _NEW_PROGRAM | _NEW_TEXTURE_STATE, 0);
+}
+
+static void
+comb_trace_state(struct gl_context *ctx, unsigned bind_count)
+{
+   const struct gl_nv_combiner *c = &ctx->NV.Combiner;
+   const int stages = ctx->NV.NumGeneralCombiners;
+   static const char *const var[4] = { "A", "B", "C", "D" };
+
+   fprintf(stderr, "MESA-NV combiner: program in use (nv_binding %u, "
+                   "version %u, %d stage)\n", bind_count, c->Version,
+           stages);
+
+   for (int s = 0; s < stages; s++) {
+      for (int p = 0; p < 2; p++) {
+         fprintf(stderr, "  stage %d %s: ", s, p ? "ALPHA" : "RGB  ");
+         for (int v = 0; v < 4; v++) {
+            const struct nv_combiner_input *in = &c->Stage[s].In[p][v];
+
+            fprintf(stderr, "%s=%#x/%#x ", var[v], in->Source, in->Mapping);
+         }
+         fprintf(stderr, "out ab=%#x cd=%#x sum=%#x scale=%d bias=%d "
+                         "dot=%d/%d mux=%d\n",
+                 c->Stage[s].Out[p].AbOutput, c->Stage[s].Out[p].CdOutput,
+                 c->Stage[s].Out[p].SumOutput, c->Stage[s].Out[p].Scale,
+                 c->Stage[s].Out[p].Bias, c->Stage[s].Out[p].AbDot,
+                 c->Stage[s].Out[p].CdDot, c->Stage[s].Out[p].MuxSum);
+      }
+   }
+
+   for (int v = 0; v < NV_COMB_FINAL_VARS; v++)
+      fprintf(stderr, "  finale %c=%#x/%#x/%#x\n", 'A' + v,
+              c->Final[v].Source, c->Final[v].Mapping, c->Final[v].Usage);
+}
+
+/* ------------------------------------------------------------------ */
+/* state                                                               */
+/* ------------------------------------------------------------------ */
+
+void
+_mesa_nv_combiner_init(struct gl_context *ctx)
+{
+   struct gl_nv_combiner *c = &ctx->NV.Combiner;
+
+   memset(c, 0, sizeof(*c));
+
+   ctx->NV.NumGeneralCombiners = 1;
+   ctx->NV.ColorSumClamp = GL_TRUE;
+
+   /* Table NV_register_combiners.5: general stage input state. */
+   for (int s = 0; s < NV_MAX_GENERAL_COMBINERS; s++) {
+      for (int p = 0; p < 2; p++) {
+         for (int v = 0; v < 4; v++) {
+            c->Stage[s].In[p][v].Source = GL_ZERO;
+            c->Stage[s].In[p][v].Mapping = GL_UNSIGNED_IDENTITY_NV;
+            c->Stage[s].In[p][v].Usage = p == NV_COMB_RGB ? GL_RGB : GL_ALPHA;
+         }
+      }
+
+      c->Stage[s].In[NV_COMB_RGB][0].Source = GL_PRIMARY_COLOR_NV;
+      c->Stage[s].In[NV_COMB_RGB][1].Source = GL_ZERO;
+      c->Stage[s].In[NV_COMB_RGB][1].Mapping = GL_UNSIGNED_INVERT_NV;
+      c->Stage[s].In[NV_COMB_ALPHA][0].Source = GL_PRIMARY_COLOR_NV;
+      c->Stage[s].In[NV_COMB_ALPHA][1].Source = GL_ZERO;
+      c->Stage[s].In[NV_COMB_ALPHA][1].Mapping = GL_UNSIGNED_INVERT_NV;
+
+      for (int p = 0; p < 2; p++) {
+         c->Stage[s].Out[p].AbOutput = GL_DISCARD_NV;
+         c->Stage[s].Out[p].CdOutput = GL_DISCARD_NV;
+         c->Stage[s].Out[p].SumOutput = GL_DISCARD_NV;
+         c->Stage[s].Out[p].Scale = GL_NONE;
+         c->Stage[s].Out[p].Bias = GL_NONE;
+      }
+   }
+
+   /* Table NV_register_combiners.6: final combiner input state. */
+   c->Final[0].Source = GL_FOG;
+   c->Final[0].Usage = GL_ALPHA;
+   c->Final[0].Mapping = GL_UNSIGNED_IDENTITY_NV;
+   c->Final[1].Source = GL_SPARE0_PLUS_SECONDARY_COLOR_NV;
+   c->Final[1].Usage = GL_RGB;
+   c->Final[1].Mapping = GL_UNSIGNED_IDENTITY_NV;
+   c->Final[2].Source = GL_FOG;
+   c->Final[2].Usage = GL_RGB;
+   c->Final[2].Mapping = GL_UNSIGNED_IDENTITY_NV;
+   for (int v = 3; v < 6; v++) {
+      c->Final[v].Source = GL_ZERO;
+      c->Final[v].Usage = GL_RGB;
+      c->Final[v].Mapping = GL_UNSIGNED_IDENTITY_NV;
+   }
+   c->Final[6].Source = GL_SPARE0_NV;
+   c->Final[6].Usage = GL_ALPHA;
+   c->Final[6].Mapping = GL_UNSIGNED_IDENTITY_NV;
+
+   /* ccc0 and ccc1 start at (0,0,0,0). */
+   c->Version = 1;
+   for (unsigned i = 0; i < NV_COMB_PROGRAM_CACHE; i++)
+      _mesa_reference_program(ctx, &c->Cache[i].Program, NULL);
+   c->Program = NULL;
+   c->ProgramVersion = 0;
+   c->ProgramSignature = 0;
+   c->GenerationFailed = GL_FALSE;
+}
+
+void
+_mesa_nv_combiner_fini(struct gl_context *ctx)
+{
+   _mesa_reference_program(ctx, &ctx->NV.Combiner.Program, NULL);
+}
+
+void
+_mesa_nv_combiner_input(struct gl_context *ctx, GLenum stage, GLenum portion,
+                        GLenum variable, GLenum input, GLenum mapping,
+                        GLenum componentUsage)
+{
+   struct gl_nv_combiner *c = &ctx->NV.Combiner;
+   int s = (int) (stage - GL_COMBINER0_NV);
+   int p = comb_portion(portion);
+   int v = comb_variable(variable);
+
+   if (s < 0 || s >= NV_MAX_GENERAL_COMBINERS || v < 0 || v > 3) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_VALUE, "glCombinerInputNV(stage or variable)");
+      return;
+   }
+
+   if (portion != GL_RGB && portion != GL_ALPHA) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_VALUE, "glCombinerInputNV(portion)");
+      return;
+   }
+
+   if (componentUsage != GL_RGB && componentUsage != GL_ALPHA &&
+       componentUsage != GL_BLUE) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_VALUE, "glCombinerInputNV(componentUsage)");
+      return;
+   }
+
+   if (p == NV_COMB_ALPHA && componentUsage == GL_RGB) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glCombinerInputNV(componentUsage RGB with an ALPHA portion)");
+      return;
+   }
+
+   if (p == NV_COMB_RGB && componentUsage == GL_BLUE) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glCombinerInputNV(componentUsage BLUE with an RGB portion)");
+      return;
+   }
+
+   if (componentUsage == GL_ALPHA && input == GL_FOG) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glCombinerInputNV(ALPHA usage of the FOG register)");
+      return;
+   }
+
+   c->Stage[s].In[p][v].Source = input;
+   c->Stage[s].In[p][v].Mapping = mapping;
+   c->Stage[s].In[p][v].Usage = componentUsage;
+   comb_state_changed(ctx);
+}
+
+static bool
+comb_output_target_ok(GLenum target)
+{
+   if (target == GL_DISCARD_NV)
+      return true;
+
+   switch (target) {
+   case GL_PRIMARY_COLOR_NV:
+   case GL_SECONDARY_COLOR_NV:
+   case GL_SPARE0_NV:
+   case GL_SPARE1_NV:
+      return true;
+   default:
+      return target >= GL_TEXTURE0 && target < GL_TEXTURE0 + MAX_TEXTURE_UNITS;
+   }
+}
+
+void
+_mesa_nv_combiner_output(struct gl_context *ctx, GLenum stage, GLenum portion,
+                         GLenum abOutput, GLenum cdOutput, GLenum sumOutput,
+                         GLenum scale, GLenum bias, GLboolean abDotProduct,
+                         GLboolean cdDotProduct, GLboolean muxSum)
+{
+   struct gl_nv_combiner *c = &ctx->NV.Combiner;
+   int s = (int) (stage - GL_COMBINER0_NV);
+   int p = comb_portion(portion);
+
+   if (s < 0 || s >= NV_MAX_GENERAL_COMBINERS) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_VALUE, "glCombinerOutputNV(stage)");
+      return;
+   }
+
+   if (portion != GL_RGB && portion != GL_ALPHA) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_VALUE, "glCombinerOutputNV(portion)");
+      return;
+   }
+
+   if (p == NV_COMB_ALPHA && (abDotProduct || cdDotProduct)) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_VALUE,
+                  "glCombinerOutputNV(dot product in the ALPHA portion)");
+      return;
+   }
+
+   if (scale != GL_NONE && scale != GL_SCALE_BY_TWO_NV &&
+       scale != GL_SCALE_BY_FOUR_NV && scale != GL_SCALE_BY_ONE_HALF_NV) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_VALUE, "glCombinerOutputNV(scale)");
+      return;
+   }
+
+   if (bias != GL_NONE && bias != GL_BIAS_BY_NEGATIVE_ONE_HALF_NV) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_VALUE, "glCombinerOutputNV(bias)");
+      return;
+   }
+
+   if ((scale == GL_SCALE_BY_ONE_HALF_NV || scale == GL_SCALE_BY_FOUR_NV) &&
+       bias == GL_BIAS_BY_NEGATIVE_ONE_HALF_NV) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glCombinerOutputNV(scale and bias combination)");
+      return;
+   }
+
+   /* The three outputs must name unique read/write registers (GL_DISCARD_NV
+    * excepted).
+    */
+   if (!comb_output_target_ok(abOutput) || !comb_output_target_ok(cdOutput) ||
+       !comb_output_target_ok(sumOutput)) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_VALUE, "glCombinerOutputNV(output register)");
+      return;
+   }
+
+   if (abOutput != GL_DISCARD_NV &&
+       (abOutput == cdOutput || abOutput == sumOutput)) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glCombinerOutputNV(outputs are not unique)");
+      return;
+   }
+   if (cdOutput != GL_DISCARD_NV && cdOutput == sumOutput) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glCombinerOutputNV(outputs are not unique)");
+      return;
+   }
+
+   c->Stage[s].Out[p].AbOutput = abOutput;
+   c->Stage[s].Out[p].CdOutput = cdOutput;
+   c->Stage[s].Out[p].SumOutput = sumOutput;
+   c->Stage[s].Out[p].Scale = scale;
+   c->Stage[s].Out[p].Bias = bias;
+   c->Stage[s].Out[p].AbDot = abDotProduct;
+   c->Stage[s].Out[p].CdDot = cdDotProduct;
+   c->Stage[s].Out[p].MuxSum = muxSum;
+   comb_state_changed(ctx);
+}
+
+void
+_mesa_nv_combiner_final_input(struct gl_context *ctx, GLenum variable,
+                              GLenum input, GLenum mapping,
+                              GLenum componentUsage)
+{
+   struct gl_nv_combiner *c = &ctx->NV.Combiner;
+   int v = comb_variable(variable);
+   bool pseudo = input == GL_E_TIMES_F_NV ||
+                 input == GL_SPARE0_PLUS_SECONDARY_COLOR_NV;
+
+   if (v < 0 || v >= NV_COMB_FINAL_VARS) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_VALUE, "glFinalCombinerInputNV(variable)");
+      return;
+   }
+
+   if (pseudo && (v == 4 || v == 5 || v == 6)) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glFinalCombinerInputNV(pseudo register for E, F or G)");
+      return;
+   }
+
+   if (pseudo && v == 0) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glFinalCombinerInputNV(GL_SPARE0_PLUS_SECONDARY_COLOR_NV "
+                  "cannot feed variable A)");
+      return;
+   }
+
+   if (v == 6 && componentUsage == GL_RGB) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glFinalCombinerInputNV(componentUsage RGB for variable G)");
+      return;
+   }
+
+   if (v != 6 && componentUsage == GL_BLUE) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glFinalCombinerInputNV(componentUsage BLUE for a variable "
+                  "other than G)");
+      return;
+   }
+
+   if (pseudo && componentUsage != GL_RGB) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glFinalCombinerInputNV(pseudo register with an ALPHA or "
+                  "BLUE componentUsage)");
+      return;
+   }
+
+   c->Final[v].Source = input;
+   c->Final[v].Mapping = mapping;
+   c->Final[v].Usage = componentUsage;
+   comb_state_changed(ctx);
+}
+
+GLboolean
+_mesa_nv_combiner_parameter(struct gl_context *ctx, GLenum pname,
+                            const GLfloat *params)
+{
+   char tb[180];
+
+   {
+      /* How many components are read depends on the pname: always reading 4 floats
+       * would access data beyond what the application passed.
+       * GL_COMPONENT_RATE_NV=0x8548 -> 4, GL_EQUATION_RGB_NV=0x8549 and
+       * GL_EQUATION_ALPHA_NV=0x854a -> 2, otherwise 1. */
+      const unsigned ncomp =
+         pname == 0x8548 ? 4 : (pname == 0x8549 || pname == 0x854a) ? 2 : 1;
+      int off = snprintf(tb, sizeof(tb), "pname=%#x p=(", pname);
+
+      for (unsigned i = 0; i < ncomp && off > 0 && (size_t) off < sizeof(tb); i++)
+         off += snprintf(tb + off, sizeof(tb) - off, "%s%g",
+                         i ? " " : "", (double) params[i]);
+      if (off > 0 && (size_t) off < sizeof(tb))
+         snprintf(tb + off, sizeof(tb) - off, ")");
+   }
+
+   struct gl_nv_combiner *c = &ctx->NV.Combiner;
+
+   switch (pname) {
+   case GL_CONSTANT_COLOR0_NV:
+   case GL_CONSTANT_COLOR1_NV:
+      for (int i = 0; i < 4; i++)
+         c->ConstantColor[pname - GL_CONSTANT_COLOR0_NV][i] =
+            CLAMP(params[i], 0.0f, 1.0f);
+      comb_state_changed(ctx);
+      return GL_TRUE;
+   case GL_NUM_GENERAL_COMBINERS_NV:
+      if (params[0] < 1 || params[0] > NV_MAX_GENERAL_COMBINERS) {
+         comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_VALUE,
+                     "glCombinerParameteriNV(num general combiners)");
+         return GL_TRUE;
+      }
+      ctx->NV.NumGeneralCombiners = (GLint) params[0];
+      comb_state_changed(ctx);
+      return GL_TRUE;
+   case GL_COLOR_SUM_CLAMP_NV:
+      ctx->NV.ColorSumClamp = !!params[0];
+      comb_state_changed(ctx);
+      return GL_TRUE;
+   default:
+      return GL_FALSE;
+   }
+}
+
+void
+_mesa_nv_combiner_stage_parameter(struct gl_context *ctx, GLenum stage,
+                                  GLenum pname, const GLfloat *params)
+{
+   char tb[200];
+
+   snprintf(tb, sizeof(tb), "stage=%#x pname=%#x p=(%g %g %g %g)", stage, pname,
+            (double) params[0], (double) params[1], (double) params[2],
+            (double) params[3]);
+
+   struct gl_nv_combiner *c = &ctx->NV.Combiner;
+   int s = (int) (stage - GL_COMBINER0_NV);
+
+
+   if (s < 0 || s >= NV_MAX_GENERAL_COMBINERS) {
+      comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_VALUE, "glCombinerStageParameterfvNV(stage)");
+      return;
+   }
+
+   if (pname == GL_PER_STAGE_CONSTANTS_NV) {
+      c->PerStageConstants = params[0] != 0.0f;
+      comb_state_changed(ctx);
+      return;
+   }
+
+   if (pname == GL_CONSTANT_COLOR0_NV || pname == GL_CONSTANT_COLOR1_NV) {
+      int i2 = pname - GL_CONSTANT_COLOR0_NV;
+
+      for (int i = 0; i < 4; i++)
+         c->Stage[s].Constant[i2][i] = CLAMP(params[i], 0.0f, 1.0f);
+      c->Stage[s].ConstantSet[i2] = GL_TRUE;
+      comb_state_changed(ctx);
+      return;
+   }
+
+   comb_reject(__func__);
+   _mesa_error(ctx, GL_INVALID_VALUE, "glCombinerStageParameterfvNV(pname)");
+}
+
+
+/**
+ * Returns the fragment program generated from the register-combiner state.
+ *
+ * Besides building the program, this flags that the CB0 constants must be reloaded
+ * when a different generated program is about to be bound: the parameters of those
+ * programs are literals without StateFlags, so update_single_program_constants()
+ * (src/mesa/main/state.c) ignores them and CB0 would stay the one of the previously
+ * used generated program.  On Dusk (2003, Wine) that is exactly what happened: the
+ * generated program that draws the white wireframe ran with the constants of the
+ * previous program, and those values produce black; the result depended on the order
+ * of draws, hence intermittent.
+ */
+struct gl_program *
+_mesa_nv_combiner_program(struct gl_context *ctx)
+{
+   struct gl_nv_combiner *c = &ctx->NV.Combiner;
+   struct gl_program *p = comb_program_build(ctx);
+
+   if (p && (p != c->LastReturnedProgram ||
+             c->Version != c->LastReturnedVersion ||
+             ctx->FragmentProgram._Current != p)) {
+      c->LastReturnedProgram = p;
+      c->LastReturnedVersion = c->Version;
+
+      /* Forces the fragment-program constants atom (no FLUSH_VERTICES: we are
+       * already inside the state update).  The atom bit is used directly, as
+       * main/atifragshader.c does: the DriverFlags.NewShaderConstants[] bits for
+       * ARB/NV programs are empty, so OR-ing them would do nothing.
+       */
+      ST_SET_STATE(ctx->NewDriverState, ST_NEW_FS_CONSTANTS);
+      /* ctx->NewState |= _NEW_PROGRAM: not needed.  The real fix of the generated-
+       * program cache (ProgramSignature not updated on the cache-hit path) makes this
+       * forcing unnecessary.
+       */
+      ST_SET_STATES(ctx->NewDriverState,
+                    ctx->DriverFlags.NewShaderConstants[MESA_SHADER_FRAGMENT]);
+   }
+
+   return p;
+}
diff --git a/src/mesa/main/nv_combiners.h b/src/mesa/main/nv_combiners.h
new file mode 100644
index 0000000..8b6768d
--- /dev/null
+++ b/src/mesa/main/nv_combiners.h
@@ -0,0 +1,188 @@
+/*
+ * State model for GL_NV_register_combiners / GL_NV_register_combiners2.
+ *
+ * The numbers and names below follow section 3.8.12 of the OpenGL 1.2
+ * specification as amended by the GL_NV_register_combiners extension
+ * (registry document NV_register_combiners.txt).
+ */
+
+#ifndef NV_COMBINERS_H
+#define NV_COMBINERS_H
+
+#include "util/glheader.h"
+
+#include <stdint.h>
+
+struct gl_context;
+struct gl_program;
+
+/* GL_MAX_GENERAL_COMBINERS_NV is at least 2; the hardware exposed 8. */
+#define NV_MAX_GENERAL_COMBINERS 8
+
+/* Indexes for the two portions of a combiner stage. */
+#define NV_COMB_RGB   0
+#define NV_COMB_ALPHA 1
+
+/* Indexes for the seven final combiner variables A..G. */
+#define NV_COMB_FINAL_VARS 7
+
+/* Id of the combiner-generated program: outside the range of ids Mesa assigns
+ * (sequential from 1), so it does not collide with the game's programs.
+ */
+#define NV_COMB_PROGRAM_ID 0x7ffc00
+
+/**
+ * Assignment of one combiner input variable.
+ *
+ * \c Source is a combiner register name (GL_ZERO, GL_FOG, GL_PRIMARY_COLOR_NV,
+ * GL_SECONDARY_COLOR_NV, GL_SPARE0_NV, GL_SPARE1_NV, GL_CONSTANT_COLOR0_NV,
+ * GL_CONSTANT_COLOR1_NV, GL_TEXTURE0+i) or, for the final combiner only, one
+ * of the pseudo registers GL_E_TIMES_F_NV / GL_SPARE0_PLUS_SECONDARY_COLOR_NV.
+ */
+struct nv_combiner_input {
+   GLenum Source;
+   GLenum Mapping;   /* GL_UNSIGNED_IDENTITY_NV, GL_EXPAND_NORMAL_NV,... */
+   GLenum Usage;     /* GL_RGB, GL_ALPHA or GL_BLUE */
+};
+
+/** Where a general combiner stage writes its three results. */
+struct nv_combiner_output {
+   GLenum AbOutput;
+   GLenum CdOutput;
+   GLenum SumOutput;
+   GLenum Scale;     /* GL_NONE, GL_SCALE_BY_TWO_NV, GL_SCALE_BY_FOUR_NV, GL_SCALE_BY_ONE_HALF_NV */
+   GLenum Bias;      /* GL_NONE or GL_BIAS_BY_NEGATIVE_ONE_HALF_NV */
+   GLboolean AbDot;
+   GLboolean CdDot;
+   GLboolean MuxSum;
+};
+
+struct nv_combiner_stage {
+   /** [NV_COMB_RGB|NV_COMB_ALPHA][VARIABLE_A_NV.. VARIABLE_D_NV] */
+   struct nv_combiner_input In[2][4];
+   struct nv_combiner_output Out[2];
+
+   /** Per-stage CONSTANT_COLOR0_NV / CONSTANT_COLOR1_NV (combiners2). */
+   GLfloat Constant[2][4];
+   GLboolean ConstantSet[2];
+};
+
+/**
+ * Register combiner state of a context.  The number of active stages
+ * (NUM_GENERAL_COMBINERS_NV) and the color sum clamp live in
+ * ctx->NV.NumGeneralCombiners / ctx->NV.ColorSumClamp.
+ */
+/** One slot of the register-combiner generated-program cache. */
+struct gl_nv_combiner_cache_slot {
+   uint64_t Signature;
+   struct gl_program *Program;
+};
+
+#define NV_COMB_PROGRAM_CACHE 32
+
+struct gl_nv_combiner {
+   struct nv_combiner_stage Stage[NV_MAX_GENERAL_COMBINERS];
+
+   /** Final combiner variables A, B, C, D, E, F, G (index 0..6). */
+   struct nv_combiner_input Final[NV_COMB_FINAL_VARS];
+
+   /** ccc0 and ccc1, the global combiner constant colors. */
+   GLfloat ConstantColor[2][4];
+
+   /** GL_PER_STAGE_CONSTANTS_NV: when set, the general combiners' CONSTANT_COLOR0/1
+    * variables use the *per-stage* constants (set by
+    * glCombinerStageParameterfvNV) instead of the global ones.  cgGL also sets it with
+    * glEnable(GL_PER_STAGE_CONSTANTS_NV).
+    */
+   GLboolean PerStageConstants;
+
+   /** Bumped by every state change; the generated program is rebuilt when it
+    * differs from the version the program was built for.
+    */
+   uint32_t Version;
+
+   /** Fragment program generated from the state above (NULL = not built). */
+   struct gl_program *Program;
+
+   /** Combiner state version the generated program was built for. */
+   uint32_t ProgramVersion;
+
+   /** Last generated program handed to the state updater, with the combiner state
+    * version it corresponded to.  It is how we notice that the bound program is about
+    * to change: the generated programs' parameters are literals embedded in the text
+    * (StateFlags == 0), so update_single_program_constants() marks nothing and the
+    * driver's CB0 would stay the one of the previous program.
+    */
+   void *LastReturnedProgram;
+   uint32_t LastReturnedVersion;
+
+   /** Signature of everything the generated program depends on: the combiner
+    * state plus the texture units it reads and the fog.  Rebuilt when it
+    * changes.
+    */
+   uint64_t ProgramSignature;
+
+   /** Fingerprint of what the program reads from state besides the constant values
+    * (textures read, formats, fog).  If it does not change, the text does not even
+    * need regenerating.
+    */
+   uint64_t StateSignature;
+
+   /**
+    * Small cache of generated programs: a game alternating two fp20 shaders per frame
+    * would otherwise force a recompile at every switch, and a Dusk run generated
+    * thousands of programs.
+    */
+   struct gl_nv_combiner_cache_slot Cache[NV_COMB_PROGRAM_CACHE];
+
+   /** Next cache slot to replace (round-robin policy). */
+   unsigned CacheNext;
+
+   /** Set when generation failed, so the failure is reported once. */
+   GLboolean GenerationFailed;
+};
+
+void
+_mesa_nv_combiner_init(struct gl_context *ctx);
+
+void
+_mesa_nv_combiner_fini(struct gl_context *ctx);
+
+/** Storage + validation for glCombinerInputNV. */
+void
+_mesa_nv_combiner_input(struct gl_context *ctx, GLenum stage, GLenum portion,
+                        GLenum variable, GLenum input, GLenum mapping,
+                        GLenum componentUsage);
+
+/** Storage + validation for glCombinerOutputNV. */
+void
+_mesa_nv_combiner_output(struct gl_context *ctx, GLenum stage, GLenum portion,
+                         GLenum abOutput, GLenum cdOutput, GLenum sumOutput,
+                         GLenum scale, GLenum bias, GLboolean abDotProduct,
+                         GLboolean cdDotProduct, GLboolean muxSum);
+
+/** Storage + validation for glFinalCombinerInputNV. */
+void
+_mesa_nv_combiner_final_input(struct gl_context *ctx, GLenum variable,
+                              GLenum input, GLenum mapping,
+                              GLenum componentUsage);
+
+/** Returns GL_TRUE when pname is one of the combiner parameters. */
+GLboolean
+_mesa_nv_combiner_parameter(struct gl_context *ctx, GLenum pname,
+                            const GLfloat *params);
+
+/** Storage for glCombinerStageParameterfvNV. */
+void
+_mesa_nv_combiner_stage_parameter(struct gl_context *ctx, GLenum stage,
+                                  GLenum pname, const GLfloat *params);
+
+/**
+ * Return the fragment program that implements the current combiner state,
+ * building it on demand.  Returns NULL if the program could not be built, in
+ * which case the caller should fall back to the fixed-function program.
+ */
+struct gl_program *
+_mesa_nv_combiner_program(struct gl_context *ctx);
+
+#endif /* NV_COMBINERS_H */
