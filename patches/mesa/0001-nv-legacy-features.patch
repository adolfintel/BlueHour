+/*
+ * MESA_NV_FORCE_CULL=off|front|back|flipcw|flipccw: forces the face-culling state. It is
+ * applied at glClear (a safe point OUTSIDE the draw path: touching ctx->NewState during a
+ * draw violates st_prepare_draw's invariant ctx->NewState == 0x0 and makes Mesa abort).
+ *
+ * Needed when a pass produces NO fragment at all while having the right program, parameters,
+ * target and draw count: if the triangle winding does not add up (a matrix with negative
+ * determinant, or a front-face convention different from the era's), global culling silently
+ * erases everything and the buffer stays exactly as cleared. flip* inverts the declared
+ * winding instead of disabling culling: if flipping is enough to fill the buffer, the demo's
+ * real winding is opposite to what we assume.
+ */
+static void
+nv_apply_force_cull(struct gl_context *ctx)
+{
+   static int cached = -1;
+   static int mode_sel;
+
+   if (cached < 0) {
+      const char *e = getenv("MESA_NV_FORCE_CULL");
+
+      cached = 1;
+      if (e == NULL || e[0] == '0')
+         mode_sel = 0;
+      else if (e[0] == 'o' && e[1] == 'f' && e[2] == 'f')
+         mode_sel = 1;
+      else if (e[0] == 'f' && e[1] == 'r')
+         mode_sel = 2;
+      else if (e[0] == 'b')
+         mode_sel = 3;
+      else if (e[0] == 'f' && e[1] == 'l' && e[2] == 'i' && e[3] == 'p')
+         mode_sel = (e[4] == 'c' && e[5] == 'w') ? 4 : 5;
+      else
+         mode_sel = 0;
+   }
+
+   if (mode_sel == 0)
+      return;
+
+   if (mode_sel == 1 && ctx->Polygon.CullFlag) {
+      ctx->Polygon.CullFlag = GL_FALSE;
+      ctx->NewState |= _NEW_POLYGON;
+   } else if (mode_sel == 2 || mode_sel == 3) {
+      const GLenum m = (mode_sel == 2) ? GL_FRONT : GL_BACK;
+
+      if (!ctx->Polygon.CullFlag || ctx->Polygon.CullFaceMode != m) {
+         ctx->Polygon.CullFlag = GL_TRUE;
+         ctx->Polygon.CullFaceMode = m;
+         ctx->NewState |= _NEW_POLYGON;
+         }
+   } else if (mode_sel == 4 || mode_sel == 5) {
+      const GLenum wanted = (mode_sel == 4) ? GL_CW : GL_CCW;
+
+      if (ctx->Polygon.FrontFace != wanted) {
+         ctx->Polygon.FrontFace = wanted;
+         ctx->NewState |= _NEW_POLYGON;
+         }
+   }
+}
+
+/* These entry points are referenced by Mesa's dispatch (api_exec_init.c): the signature
+ * must NEVER sit inside a region, otherwise the marker cuts the declaration in half (seen:
+ * '_mesa_nv_note_clear(ctx)' was left without 'void'). */
+void
+_mesa_nv_note_clear(struct gl_context *ctx)
+{
+   /* Behaviour knob (MESA_NV_FORCE_CULL): definition and call site both live in the features
+      * series, otherwise the features-only build does not link. */
+   nv_apply_force_cull(ctx);
+
+
+   if (ctx->DrawBuffer == ctx->WinSysDrawBuffer &&
+       ctx->DrawBuffer->Visual.doubleBufferMode) {
+      nv_frame_count++;
+
+
+      nv_progs_n = 0;
+
+
+
+   }
+
+}
