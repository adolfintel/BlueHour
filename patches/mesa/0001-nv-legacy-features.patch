diff --git a/src/glx/nv_array_range.c b/src/glx/nv_array_range.c
new file mode 100644
index 0000000..a038b50
--- /dev/null
+++ b/src/glx/nv_array_range.c
@@ -0,0 +1,178 @@
+/*
+ * Copyright © 2024
+ *
+ * Permission to use, copy, modify, distribute, and sell this software and its
+ * documentation for any purpose is hereby granted without fee, provided that
+ * the above copyright notice appear in all copies and that both that copyright
+ * notice and this permission notice appear in supporting documentation, and
+ * that the name of the copyright holders not be used in endorsing or
+ * advertising products derived from this software without specific prior
+ * written permission.  The software is provided "as is", without warranty of
+ * any kind.
+ */
+
+/*
+ * GLX_NV_vertex_array_range: allocate the memory a client wants to use as its
+ * GL_NV_vertex_array_range.
+ *
+ * The intent of the original extension was to let the driver pin the pages of
+ * the range and hand back a mapping the hardware could read efficiently.  With
+ * direct rendering on Linux the client allocation is already mapped for the
+ * device, so page aligned anonymous memory is enough; the range ends up being
+ * ordinary memory and every driver can consume it without special handling.
+ *
+ * One thing does matter: the range has to be usable by the client itself.
+ * Clients are not necessarily 64 bit code - a 32 bit process on a 64 bit host,
+ * for instance one running through the WoW64 layer of Wine, can only reach the
+ * low 4 GiB of the address space - so the mappings are asked for in that range
+ * when the architecture can do it.
+ */
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <sys/mman.h>
+
+#include "glxclient.h"
+#include "nv_array_range.h"
+
+#define NV_RANGE_ALIGN 4096
+#define NV_RANGE_MAGIC 0x6e76617272616e67ull /* "nvarrang", put there by us only */
+
+/* Bookkeeping kept in the page just before the address handed to the client,
+ * so that a range can be released without keeping track of it anywhere else.
+ */
+struct nv_range_header
+{
+   uint64_t magic;
+   size_t length;
+   void *map;
+};
+
+static void *
+nv_map_range(size_t length, int with_32bit_hint)
+{
+   int flags = MAP_PRIVATE | MAP_ANONYMOUS;
+   void *map;
+
+#if defined(MAP_32BIT)
+   if (with_32bit_hint)
+      flags |= MAP_32BIT;
+#else
+   (void) with_32bit_hint;
+#endif
+
+   map = mmap(NULL, length, PROT_READ | PROT_WRITE, flags, -1, 0);
+   if (map != MAP_FAILED)
+      return map;
+
+#if defined(MAP_32BIT)
+   /* Running out of low address space is not an error: a plain mapping is
+    * still perfectly usable by a 64 bit client.
+    */
+   if (with_32bit_hint)
+      return mmap(NULL, length, PROT_READ | PROT_WRITE,
+                  MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+#endif
+
+   return NULL;
+}
+
+_GLX_PUBLIC void *
+glXAllocateMemoryNV(GLsizei size, GLfloat readfreq, GLfloat writefreq,
+                    GLfloat priority)
+{
+   struct nv_range_header *header;
+   size_t length;
+   void *map;
+
+   /* The access hints are advisory: Mesa has nothing to do with them. */
+   (void) readfreq;
+   (void) writefreq;
+   (void) priority;
+
+   if (size <= 0)
+      return NULL;
+
+   /* Page alignment satisfies any alignment a client may be looking for, and
+    * the extra page at the start is where the size of the mapping is kept.
+    */
+   length = (((size_t) size + NV_RANGE_ALIGN - 1) & ~(size_t) (NV_RANGE_ALIGN - 1))
+            + NV_RANGE_ALIGN;
+
+   map = nv_map_range(length, 1);
+   if (map == NULL) {
+      void *ptr = NULL;
+
+      /* Last resort, so that the extension never fails outright; such a range
+       * is of course only usable by a client that can reach it.
+       */
+      if (posix_memalign(&ptr, NV_RANGE_ALIGN, (size_t) size) != 0)
+         return NULL;
+      return ptr;
+   }
+
+   header = map;
+   header->magic = NV_RANGE_MAGIC;
+   header->length = length;
+   header->map = map;
+
+   return (char *) map + NV_RANGE_ALIGN;
+}
+
+_GLX_PUBLIC void
+glXFreeMemoryNV(void *pointer)
+{
+   struct nv_range_header *header;
+   char *p = pointer;
+
+   if (!pointer)
+      return;
+
+   header = (struct nv_range_header *) (p - NV_RANGE_ALIGN);
+   if (header->magic != NV_RANGE_MAGIC) {
+      /* Not one of our mappings; leave it to the C library, it is the only
+       * thing that could have produced this pointer.
+       */
+      free(pointer);
+      return;
+   }
+
+   munmap(header->map, header->length);
+}
+
+/*
+ * The "gl" names are a plain alias: see nv_array_range.h.
+ */
+
+_GLX_PUBLIC void *
+glAllocateMemoryNV(GLsizei size, GLfloat readfreq, GLfloat writefreq,
+                   GLfloat priority)
+{
+   return glXAllocateMemoryNV(size, readfreq, writefreq, priority);
+}
+
+_GLX_PUBLIC void
+glFreeMemoryNV(void *pointer)
+{
+   glXFreeMemoryNV(pointer);
+}
+
+/*
+ * Aliases with the wgl prefix: see above. They serve clients that ask for
+ * wglGetProcAddress("wglAllocateMemoryNV"), which Wine's WGL layer does not know, but that then look the
+ * name up in the GL library with dlsym().
+ */
+
+_GLX_PUBLIC void *
+wglAllocateMemoryNV(GLsizei size, GLfloat readfreq, GLfloat writefreq,
+                    GLfloat priority)
+{
+   return glXAllocateMemoryNV(size, readfreq, writefreq, priority);
+}
+
+_GLX_PUBLIC void
+wglFreeMemoryNV(void *pointer)
+{
+   glXFreeMemoryNV(pointer);
+}
