+/* ------------------------------------------------------------------------ */
+/* Frame shadow of the presented image (MESA_NV_COPY_SHADOW).                 */
+/*                                                                           */
+/* NV demos of that era were written on Windows, where WGL keeps the back     */
+/* buffer content across SwapBuffers: the next frame starts with what was     */
+/* shown before.  Blobby Dancer relies on this for its trails: it draws a     */
+/* background pass that resamples a RECT texture, then does                   */
+/* glCopyTexSubImage2D of the framebuffer into that texture, and the next     */
+/* frame multiplies everything by fade_rate ~1.0.  With a Vulkan swapchain    */
+/* (zink) the acquired back buffer is undefined, so the accumulation dies:    */
+/* the screen stays flat and the bokeh trails fade away.                      */
+/*                                                                           */
+/* Let us restore the semantics by keeping a shadow of the complete frame as  */
+/* soon as it is presented (captured on the GLX swapbuffers hook, where the   */
+/* frame is complete) and serving that to full-window framebuffer copies.     */
+/* ------------------------------------------------------------------------ */
+
+bool
+_mesa_nv_copy_shadow_enabled(void)
+{
+   static int cached = -1;
+
+   if (cached < 0) {
+      const char *v = getenv("MESA_NV_COPY_SHADOW");
+
+      cached = (v != NULL && *v != '\0' && *v != '0');
+   }
+   return cached;
+}
+
+
+static unsigned char *nv_shadow_buf;
+static int nv_shadow_w, nv_shadow_h;
+static unsigned nv_shadow_notes;
+
+
+void
+_mesa_nv_shadow_store(int w, int h, const unsigned char *rgba)
+{
+   if (w <= 0 || h <= 0 || w > 8192 || h > 8192 || rgba == NULL)
+      return;
+
+   const size_t sz = (size_t) w * (size_t) h * 4;
+
+   if (nv_shadow_buf == NULL ||
+       (size_t) nv_shadow_w * (size_t) nv_shadow_h * 4 < sz) {
+      free(nv_shadow_buf);
+      nv_shadow_buf = malloc(sz);
+      nv_shadow_w = nv_shadow_h = 0;
+      if (nv_shadow_buf == NULL)
+         return;
+   }
+   memcpy(nv_shadow_buf, rgba, sz);
+   nv_shadow_w = w;
+   nv_shadow_h = h;
+}
+
+
+/* Captures the complete frame from the back buffer of the current context.  To be
+ * called before the present (DRI/kopper front end): there the frame is finished and
+ * the back buffer is still the one that was drawn.
+ */
+
+
+
+
+/* ------------------------------------------------------------------------ */
+/* Preserved back buffer (MESA_NV_PRESERVE_BACK).                             */
+/*                                                                            */
+/* Under WGL on Windows the back buffer survives SwapBuffers: the next frame  */
+/* starts with the content of the one just shown.  NV demos of that era were  */
+/* built that way, and Blobby Dancer uses it for its trails: the background   */
+/* pass multiplies the framebuffer by fade_rate ~1.0, a glCopyTexSubImage2D   */
+/* saves a copy into a RECT texture that is resampled in the following frames,*/
+/* and characters/bokeh drawn afterwards leave traces because they stay in the*/
+/* back buffer of the next frame.  With a Vulkan swapchain the acquired back  */
+/* buffer is undefined: the accumulation dies and the screen becomes a flat   */
+/* fill.                                                                      */
+/*                                                                            */
+/* We restore the semantics with a copy-paste of the frame just presented into*/
+/* the new back buffer, done by the DRI front end right before the present    */
+/* (capture) and right after the attachments are swapped (restore).           */
+/* ------------------------------------------------------------------------ */
+
+bool
+_mesa_nv_preserve_back_enabled(void)
+{
+   static int cached = -1;
+
+   if (cached < 0) {
+      const char *v = getenv("MESA_NV_PRESERVE_BACK");
+
+      cached = (v != NULL && *v != '\0' && *v != '0');
+   }
+   return cached;
+}
