+/*****************************************************************************
+ * GL_NV_fence
+ */
+
+static struct gl_nv_fence *
+lookup_nv_fence(struct gl_context *ctx, GLuint fence)
+{
+   /* 0 is never a fence name; callers treat it as "no fence at all". */
+   if (fence == 0)
+      return NULL;
+
+   return (struct gl_nv_fence *) _mesa_HashLookup(&ctx->Shared->NVFences,
+                                                  fence);
+}
+
+
+void GLAPIENTRY
+_mesa_GenFencesNV(GLsizei n, GLuint *fences)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   GLuint *keys;
+
+   if (n < 0) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glGenFencesNV(n < 0)");
+      return;
+   }
+
+   if (fences == NULL) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glGenFencesNV(fences == NULL)");
+      return;
+   }
+
+   if (n == 0)
+      return;
+
+   keys = calloc(n, sizeof(*keys));
+   if (!keys) {
+      _mesa_error(ctx, GL_OUT_OF_MEMORY, "glGenFencesNV");
+      return;
+   }
+
+   _mesa_HashLockMutex(&ctx->Shared->NVFences);
+   _mesa_HashFindFreeKeys(&ctx->Shared->NVFences, keys, n);
+
+   for (GLsizei i = 0; i < n; i++) {
+      struct gl_nv_fence *f;
+
+      /* util_idalloc never hands out 0, but be careful anyway. */
+      if (keys[i] == 0)
+         continue;
+
+      f = calloc(1, sizeof(*f));
+      if (!f) {
+         _mesa_error(ctx, GL_OUT_OF_MEMORY, "glGenFencesNV");
+         break;
+      }
+
+      f->Name = keys[i];
+      f->Sync = NULL;
+      f->Condition = GL_NONE;
+      _mesa_HashInsertLocked(&ctx->Shared->NVFences, keys[i], f);
+      fences[i] = keys[i];
+      if (_mesa_nv_debug())
+         fprintf(stderr, "MESA_NV: glGenFencesNV ctx %p shared %p -> %u\n",
+                 (void *) ctx, (void *) ctx->Shared, keys[i]);
+   }
+
+   _mesa_HashUnlockMutex(&ctx->Shared->NVFences);
+
+   free(keys);
+}
+
+
+void GLAPIENTRY
+_mesa_DeleteFencesNV(GLsizei n, const GLuint *fences)
+{
+   GET_CURRENT_CONTEXT(ctx);
+
+   if (n < 0) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glDeleteFencesNV(n < 0)");
+      return;
+   }
+
+   if (fences == NULL) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glDeleteFencesNV(fences == NULL)");
+      return;
+   }
+
+   for (GLsizei i = 0; i < n; i++) {
+      struct gl_nv_fence *f;
+
+      if (fences[i] == 0)
+         continue;
+
+      f = lookup_nv_fence(ctx, fences[i]);
+      if (f == NULL)
+         continue;
+
+      if (_mesa_nv_debug())
+         fprintf(stderr, "MESA_NV: glDeleteFencesNV ctx %p shared %p -> %u\n",
+                 (void *) ctx, (void *) ctx->Shared, fences[i]);
+
+      _mesa_HashRemove(&ctx->Shared->NVFences, fences[i]);
+
+      if (f->Sync)
+         _mesa_DeleteSync(f->Sync);
+
+      free(f);
+   }
+}
+
+
+GLboolean GLAPIENTRY
+_mesa_IsFenceNV(GLuint fence)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_nv_fence *f = lookup_nv_fence(ctx, fence);
+
+   return f != NULL ? GL_TRUE : GL_FALSE;
+}
+
+
+void GLAPIENTRY
+_mesa_SetFenceNV(GLuint fence, GLenum condition)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_nv_fence *f;
+
+   if (fence == 0)
+      return;
+
+   f = lookup_nv_fence(ctx, fence);
+
+   if (condition != GL_ALL_COMPLETED_NV) {
+      _mesa_error(ctx, GL_INVALID_ENUM, "glSetFenceNV(condition)");
+      return;
+   }
+
+   if (f == NULL) {
+      _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glSetFenceNV(fence %u not generated)", fence);
+      return;
+   }
+
+   /* Drop the previous fence, if any, and insert a new one here. */
+   if (f->Sync) {
+      _mesa_DeleteSync(f->Sync);
+      f->Sync = NULL;
+   }
+
+   f->Condition = condition;
+   f->Sync = _mesa_fence_sync(ctx, GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+}
+
+
+/**
+ * Test whether the fence has been reached.
+ *
+ * GL_SYNC_FLUSH_COMMANDS_BIT is passed explicitly (Mesa's sync code assumes it
+ * anyway, see __client_wait_sync) because with a deferred flush the batch that
+ * carries the fence has not been submitted to hardware yet, so this also
+ * submits it.  The zero timeout keeps the call non-blocking.
+ */
+static bool
+nv_fence_test(struct gl_context *ctx, struct gl_nv_fence *f)
+{
+   (void) ctx;
+
+
+   const GLenum status =
+      _mesa_ClientWaitSync(f->Sync, GL_SYNC_FLUSH_COMMANDS_BIT, 0);
+
+   return status == GL_ALREADY_SIGNALED || status == GL_CONDITION_SATISFIED;
+}
+
+
+GLboolean GLAPIENTRY
+_mesa_TestFenceNV(GLuint fence)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_nv_fence *f;
+
+   if (fence == 0)
+      return GL_TRUE;
+
+   f = lookup_nv_fence(ctx, fence);
+
+   if (f == NULL || f->Sync == NULL) {
+      _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glTestFenceNV(fence %u not set)", fence);
+      /* The spec asks us to return TRUE in this case. */
+      return GL_TRUE;
+   }
+
+   return nv_fence_test(ctx, f) ? GL_TRUE : GL_FALSE;
+}
+
+
+void GLAPIENTRY
+_mesa_FinishFenceNV(GLuint fence)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_nv_fence *f;
+
+   if (fence == 0)
+      return;
+
+   f = lookup_nv_fence(ctx, fence);
+
+   if (f == NULL || f->Sync == NULL) {
+      _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glFinishFenceNV(fence %u not set)", fence);
+      return;
+   }
+
+   /* An unbounded wait: everything issued before the fence must be done when
+    * this returns.
+    */
+   const GLenum status =
+      _mesa_ClientWaitSync(f->Sync, GL_SYNC_FLUSH_COMMANDS_BIT,
+                           GL_TIMEOUT_IGNORED);
+
+   if (status == GL_WAIT_FAILED)
+      _mesa_error(ctx, GL_INVALID_OPERATION, "glFinishFenceNV(fence %u wait failed)", fence);
+}
+
+
+void GLAPIENTRY
+_mesa_GetFenceivNV(GLuint fence, GLenum pname, GLint *params)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_nv_fence *f = lookup_nv_fence(ctx, fence);
+
+   if (f == NULL || f->Sync == NULL) {
+      _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glGetFenceivNV(fence %u not set)", fence);
+      return;
+   }
+
+   if (params == NULL) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glGetFenceivNV(params == NULL)");
+      return;
+   }
+
+   switch (pname) {
+   case GL_FENCE_STATUS_NV:
+      *params = nv_fence_test(ctx, f) ? GL_TRUE : GL_FALSE;
+      return;
+   case GL_FENCE_CONDITION_NV:
+      *params = f->Condition;
+      return;
+   default:
+      _mesa_error(ctx, GL_INVALID_ENUM, "glGetFenceivNV(pname)");
+   }
+}
+
