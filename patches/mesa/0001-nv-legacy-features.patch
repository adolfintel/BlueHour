+/** Fetch one stored combiner value, mirroring the Get*Parameter*NV tables. */
+/** @param stage is a GL_COMBINER<i>_NV value, or NV_GET_FINAL_COMBINER. */
+#define NV_GET_FINAL_COMBINER (-1)
+
+static GLint
+combiner_get_enum(int stage, GLenum portion, int variable, GLenum pname)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_nv_combiner *c = &ctx->NV.Combiner;
+   int s = stage == NV_GET_FINAL_COMBINER ? -1
+                                          : (int) (stage - GL_COMBINER0_NV);
+   int p = portion == GL_ALPHA ? NV_COMB_ALPHA : NV_COMB_RGB;
+   int v = variable - (int) GL_VARIABLE_A_NV;
+
+   switch (pname) {
+   case GL_COMBINER_INPUT_NV:
+      if (s >= 0 && s < NV_MAX_GENERAL_COMBINERS && v >= 0 && v < 4)
+         return c->Stage[s].In[p][v].Source;
+      if (s < 0 && v >= 0 && v < NV_COMB_FINAL_VARS)
+         return c->Final[v].Source;
+      return GL_ZERO;
+   case GL_COMBINER_MAPPING_NV:
+      if (s >= 0 && s < NV_MAX_GENERAL_COMBINERS && v >= 0 && v < 4)
+         return c->Stage[s].In[p][v].Mapping;
+      if (s < 0 && v >= 0 && v < NV_COMB_FINAL_VARS)
+         return c->Final[v].Mapping;
+      return GL_UNSIGNED_IDENTITY_NV;
+   case GL_COMBINER_COMPONENT_USAGE_NV:
+      if (s >= 0 && s < NV_MAX_GENERAL_COMBINERS && v >= 0 && v < 4)
+         return c->Stage[s].In[p][v].Usage;
+      if (s < 0 && v >= 0 && v < NV_COMB_FINAL_VARS)
+         return c->Final[v].Usage;
+      return GL_RGB;
+   default:
+      break;
+   }
+
+   if (s < 0 || s >= NV_MAX_GENERAL_COMBINERS)
+      return 0;
+
+   switch (pname) {
+   case GL_COMBINER_AB_DOT_PRODUCT_NV:
+      return c->Stage[s].Out[p].AbDot;
+   case GL_COMBINER_CD_DOT_PRODUCT_NV:
+      return c->Stage[s].Out[p].CdDot;
+   case GL_COMBINER_MUX_SUM_NV:
+      return c->Stage[s].Out[p].MuxSum;
+   case GL_COMBINER_SCALE_NV:
+      return c->Stage[s].Out[p].Scale;
+   case GL_COMBINER_BIAS_NV:
+      return c->Stage[s].Out[p].Bias;
+   case GL_COMBINER_AB_OUTPUT_NV:
+      return c->Stage[s].Out[p].AbOutput;
+   case GL_COMBINER_CD_OUTPUT_NV:
+      return c->Stage[s].Out[p].CdOutput;
+   case GL_COMBINER_SUM_OUTPUT_NV:
+      return c->Stage[s].Out[p].SumOutput;
+   default:
+      return 0;
+   }
+}
