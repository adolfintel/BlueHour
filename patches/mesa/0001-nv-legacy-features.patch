+/* Applications written for the "historical" NV extensions feed v[] in two
+ * different, incompatible ways:
+ *
+ *  - through the NV entry points (glVertexAttribPointerNV / glVertexAttrib*NV, and
+ *    the GL_VERTEX_ATTRIB_ARRAYi_NV client states): the data lands in GENERIC
+ *    attribute i, so the program has to read vertex.attrib[i];
+ *  - through the core/legacy entry points (glVertexPointer, glNormalPointer,
+ *    glMultiTexCoord*, immediate mode): the data lands in the CONVENTIONAL slots,
+ *    so the program has to read vertex.position/normal/texcoord[n].
+ *
+ * The NV->ARB translator has to pick accordingly.  The flag is set by the first
+ * call to an NV attribute entry point: Dusk does that 980000+ times (and with the
+ * mapping on the elf's clothes turn khaki), Blobby Dancer never does (and without
+ * the mapping its body stays a white silhouette).
+ */
+static bool nv_uses_nv_attrib_api;
+
+void
+_mesa_nv_note_nv_attrib_api(void)
+{
+   nv_uses_nv_attrib_api = true;
+}
+
+bool
+_mesa_nv_uses_nv_attrib_api(void)
+{
+   return nv_uses_nv_attrib_api;
+}
