+   int max_r, max_h;        /* highest R/H temporary seen          */
+   int max_c;               /* highest absolute c[] index seen     */
+   int max_rel_off;         /* highest c[A0.x + N] offset seen     */
+   int max_ar;              /* highest A<n> address register seen  */
+   int max_rel_ops;         /* most relative accesses in one inst  */
