 /**
  * Print a single vertex/fragment program instruction.
  */
+/* nv-legacy: the fp40 condition-code fields.
+ *
+ * The rule name is what the parser writes back: printing "IF GT;" is re-readable,
+ * because the lexer turns GT into the same token the block header expects, and an
+ * omitted component list reparses to the same default the parse used. The
+ * per-instruction state is printed as a trailing comment, after the semicolon.
+ * That is deliberate: # starts a comment for the lexer, so a dump printed here
+ * still parses, while printing the C suffix on the mnemonic would not, because
+ * the accepted alias names are only the three the Luna corpus uses.
+ */
+static const char *
+nv_cc_rule_name(GLuint rule)
+{
+   switch (rule) {
+   case PROG_CC_EQ: return "EQ";
+   case PROG_CC_NE: return "NE";
+   case PROG_CC_LT: return "LT";
+   case PROG_CC_GE: return "GE";
+   case PROG_CC_LE: return "LE";
+   case PROG_CC_GT: return "GT";
+   case PROG_CC_TR: return "TR";
+   case PROG_CC_FL: return "FL";
+   default:         return "NONE";
+   }
+}
+
+static void
+nv_cc_print_comment(FILE *f, const struct prog_instruction *inst)
+{
+   if (inst->CcTest == PROG_CC_NONE && !inst->CcUpdate && !inst->CcHalf)
+      return;
+
+   fprintf(f, "  # cc");
+   if (inst->CcTest != PROG_CC_NONE) {
+      fprintf(f, " test %s", nv_cc_rule_name(inst->CcTest));
+      if (inst->CcTestComps) {
+         fputc('.', f);
+         if (inst->CcTestComps & WRITEMASK_X) fputc('x', f);
+         if (inst->CcTestComps & WRITEMASK_Y) fputc('y', f);
+         if (inst->CcTestComps & WRITEMASK_Z) fputc('z', f);
+         if (inst->CcTestComps & WRITEMASK_W) fputc('w', f);
+      }
+   }
+   if (inst->CcUpdate)
+      fprintf(f, "%s update%s", inst->CcTest == PROG_CC_NONE ? "" : ",",
+              inst->CcHalf ? " from half-rounded result" : "");
+   else if (inst->CcHalf)
+      fprintf(f, ", half-rounded mnemonic");
+   fprintf(f, "\n");
+}
