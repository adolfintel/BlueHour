+/* True if the bytes [start,start+size) of the binding are already on the GPU: fills real_vb
+ * (resource + offset) without copying anything. */
+static bool
+nv_vb_hit(struct u_vbuf *mgr, unsigned index, const uint8_t *ptr,
+          unsigned start, unsigned size, struct pipe_vertex_buffer *real_vb)
+{
+   struct nv_vb_entry *e;
+
+   if (index >= PIPE_MAX_ATTRIBS || !nv_array_once_enabled())
+      return false;
+
+   mgr->nv_up++;
+   e = nv_vb_find(ptr, false);
+   if (e == NULL || e->dead || e->res == NULL || start < e->cstart || start + size > e->cend) {
+      mgr->nv_miss++;
+      return false;
+   }
+
