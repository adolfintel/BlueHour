+static struct pipe_resource *
+nv_vb_alloc(struct u_vbuf *mgr, unsigned size)
+{
+   struct pipe_resource templat = { 0 };
+
+   templat.target = PIPE_BUFFER;
+   templat.format = PIPE_FORMAT_R8_UINT;
+   templat.bind = PIPE_BIND_VERTEX_BUFFER;
+   templat.usage = PIPE_USAGE_DEFAULT;
+   templat.width0 = size;
+   templat.height0 = 1;
+   templat.depth0 = 1;
+   templat.array_size = 1;
+   return mgr->pipe->screen->resource_create(mgr->pipe->screen, &templat);
