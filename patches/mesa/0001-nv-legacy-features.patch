+       * in-place: 575 invalidations detected in 30 s). A 128-byte memcmp every 4 hits costs about 270 MB
+       * over 8.5 million hits. */
+   if (e->shadow != NULL && ++e->since_check >= 4) {
+      unsigned span = e->cend - e->cstart;
+      unsigned off = (e->ncheck++ * 4096u) % (span ? span : 1u);
