+
+/* nvlegacy (FEATURE): generic text substitutions in the ARB program just translated. It
+ * lets us fix, without touching the demo's files, constants or text fragments that the
+ * demo's source writes in a way incompatible with our chain (so far: the threshold of
+ * Timbury's "bite", exact to the value 255/256).
+ *
+ *   MESA_NV_REPLACE=<id>:<old>:<new>[|<id>:<old>:<new>...]
+ *
+ * id: program number; "*" for any program; "f<num>" fragment only; "v<num>" vertex only.
+ * <old> and <new> are taken literally. <new> runs up to '|' or the end of the string, so it
+ * may contain commas and parentheses, useful for ARB literals like
+ * {-0.98, -0.98, -0.98, -0.98}. It cannot contain '|'. The first two ':' of each rule are
+ * separators, so a ':' inside <old> is not allowed (ARB/NV programs have no colons).
+ *
+ * The substitution runs once and does not rescan the text, nor the replacement: a rule
+ * cannot feed itself.
+ *
+ * The old MESA_NV_PATCH_BITE_FP/_TH/_FIND variables remain as aliases: they are equivalent
+ * to a rule f<id>:<find>:<th>, where find, when omitted, uses the real spelling of the ARB
+ * translation ("-0.9960938": Mesa formats 255/256 like that, while the Cg source writes
+ * 0.99609375).
+ */
+#define NV_REPLACE_MAX   32
+#define NV_REPLACE_TXT   256
+
+struct nv_replace_rule {
+   unsigned id;        /* 0 = any */
+   int kind;           /* 0 any, 1 fragment only, 2 vertex only */
+   char old_val[NV_REPLACE_TXT];
+   char new_val[NV_REPLACE_TXT];
+   unsigned hits;     /* substitutions done, total over all programs */
+};
+
+static struct nv_replace_rule nv_rpl[NV_REPLACE_MAX];
+static unsigned nv_rpl_n;
+static int nv_rpl_read;
+
+static void
+nv_replace_parse(void)
+{
+   const char *env = getenv("MESA_NV_REPLACE");
+   char tampon[NV_REPLACE_TXT * 3 + 64];
+
+   if (nv_rpl_read)
+      return;
+   nv_rpl_read = 1;
+
+   /* Deactivation sentinel. Needed because the value reaches Mesa anyway through
+    * inheritance from the environment: emptying the variable in the launcher is NOT enough if
+    * whoever launches it sets it by hand. Measured: with MESA_NV_REPLACE=off, before this guard
+    * the parser read it as a malformed rule ("rule NOT VALID 'off'"), i.e. a false error in a
+    * run that only wanted the natural behaviour. */
+   if (env != NULL && (strcmp(env, "off") == 0 || strcmp(env, "0") == 0 ||
+                       strcmp(env, "none") == 0)) {
+      return;
+   }
+
+   /* Backwards alias for the bite knob, already used in the launcher: the legacy rule goes
+    * first, so someone setting both does not expect behaviour different from before. */
+   {
+      const char *bf = getenv("MESA_NV_PATCH_BITE_FP");
+      const char *bt = getenv("MESA_NV_PATCH_BITE_TH");
+      static char blend[2048];
+
+      if (bf != NULL && *bf != 0 && bt != NULL && *bt != 0) {
+         const char *bd = getenv("MESA_NV_PATCH_BITE_FIND");
+         char rule_buf[512];
+
+         snprintf(rule_buf, sizeof(rule_buf), "f%u:%s:%s",
+                  (unsigned) strtoul(bf, NULL, 0),
+                  (bd != NULL && *bd != 0) ? bd : "-0.9960938", bt);
+         if (env != NULL && *env != 0)
+            snprintf(blend, sizeof(blend), "%s|%s", rule_buf, env);
+         else
+            snprintf(blend, sizeof(blend), "%s", rule_buf);
+         env = blend;
+      }
+   }
+
+   while (env != NULL && *env != 0 && nv_rpl_n < NV_REPLACE_MAX) {
+      const char *bar = strchr(env, '|');
+      size_t ll = bar ? (size_t) (bar - env) : strlen(env);
+      char *item = malloc(ll + 1);
+      const char *c1, *c2;
+
+      if (item == NULL)
+         break;
+      memcpy(item, env, ll);
+      item[ll] = 0;
+
+      c1 = strchr(item, ':');
+      c2 = (c1 != NULL) ? strchr(c1 + 1, ':') : NULL;
+      if (c1 == NULL || c2 == NULL || c2[1] == 0 || c1 + 1 == c2) {
+      } else {
+         struct nv_replace_rule *r = &nv_rpl[nv_rpl_n];
+         size_t lv = (size_t) (c2 - c1 - 1);
+         size_t ln = strlen(c2 + 1);
+
+         memset(r, 0, sizeof(*r));
+         if (item[0] == '*') {
+            r->id = 0;
+         } else if (item[0] == 'f' || item[0] == 'F') {
+            r->id = (unsigned) strtoul(item + 1, NULL, 0);
+            r->kind = 1;
+         } else if (item[0] == 'v' || item[0] == 'V') {
+            r->id = (unsigned) strtoul(item + 1, NULL, 0);
+            r->kind = 2;
+         } else {
+            r->id = (unsigned) strtoul(item, NULL, 0);
+         }
+         if (lv >= sizeof(r->old_val) || ln >= sizeof(r->new_val)) {
+         } else if (r->id == 0 && item[0] != '*') {
+         } else {
+            memcpy(r->old_val, c1 + 1, lv);
+            r->old_val[lv] = 0;
+            memcpy(r->new_val, c2 + 1, ln);
+            r->new_val[ln] = 0;
+            nv_rpl_n++;
+         }
+      }
+      free(item);
+      if (bar == NULL)
+         break;
+      env = bar + 1;
+   }
+
+}
+
+
+/* nv-legacy (FEATURE): the same MESA_NV_REPLACE engine, applied to programs the
+ * application hands us already in ARB form.
+ *
+ * Why this exists: the engine had exactly one call site, inside the NV load path
+ * after our translation, and it worked on the translator's result structure. A
+ * program uploaded through glProgramStringARB never went near it. The consequence
+ * was measured on Luna: a probe that froze nineteen power instructions in the
+ * three programs reading a 3D volume produced no change at all on screen, and the
+ * reason is not the program, it is that the rules were never applied to it. The
+ * logs confirmed it: rules read, rules printed, and not one line of ARB-uploaded
+ * text touched.
+ *
+ * The returned copy is deliberately not freed by this file. It is reached only
+ * when someone sets MESA_NV_REPLACE by hand, it is a few programs per run, and
+ * adding a free to every early return of set_program_string() (there are three)
+ * is a bigger risk of use-after-free than the leak it removes. The caller uses
+ * the returned text as the text to parse, so anything downstream that reads the
+ * program text sees the substituted one, which is what we want.
+ */
+char *
+_mesa_nv_replace_arb_text(GLenum target, GLuint id, const void *text, GLsizei len)
+{
+   char *work;
+   size_t lw;
+   unsigned k;
+   unsigned n_tot = 0;
+
+   nv_replace_parse();
+   if (nv_rpl_n == 0 || text == NULL)
+      return NULL;
+
+   lw = (len < 0) ? strlen((const char *) text) : (size_t) len;
+   work = malloc(lw + 1);
+   if (work == NULL)
+      return NULL;
+   memcpy(work, text, lw);
+   work[lw] = 0;
+
+   for (k = 0; k < nv_rpl_n; k++) {
+      struct nv_replace_rule *r = &nv_rpl[k];
+      size_t lv = strlen(r->old_val);
+      size_t ln = strlen(r->new_val);
+      size_t guess;
+      char *copy_buf;
+      const char *in;
+      char *out;
+      unsigned n = 0;
+
+      if (lv == 0)
+         continue;
+      if (r->id != 0 && r->id != id)
+         continue;
+      if (r->kind == 1 && target != GL_FRAGMENT_PROGRAM_ARB)
+         continue;
+      if (r->kind == 2 && target != GL_VERTEX_PROGRAM_ARB)
+         continue;
+
+      guess = lw + (lv > ln ? (size_t) 1 : (lv + ln + 1u)) + 16u;
+      if (guess > (1u << 20))
+         continue;
+      copy_buf = malloc(guess);
+      if (copy_buf == NULL)
+         break;
+
+      /* One pass, no rescan of what we wrote: a rule cannot feed itself. This is
+       * the same behaviour the translator-side application has. */
+      out = copy_buf;
+      in = work;
+      while (*in != 0) {
+         if (strncmp(in, r->old_val, lv) == 0) {
+            memcpy(out, r->new_val, ln);
+            out += ln;
+            in += lv;
+            n++;
+            if ((size_t) (out - copy_buf) + ln + 1u > guess) {
+               size_t grown = guess * 2u + ln + 16u;
+               copy_buf = realloc(copy_buf, grown);
+               if (copy_buf == NULL)
+                  return NULL;
+               guess = grown;
+            }
+         } else {
+            *out++ = *in++;
+            if ((size_t) (out - copy_buf) + 1u >= guess) {
+               size_t grown = guess * 2u + 16u;
+               copy_buf = realloc(copy_buf, grown);
+               if (copy_buf == NULL)
+                  return NULL;
+               guess = grown;
+            }
+         }
+      }
+      *out = 0;
+      free(work);
+      work = copy_buf;
+      lw = (size_t) (out - copy_buf);
+      r->hits += n;
+      n_tot += n;
+
+   }
+
+   if (n_tot == 0) {
+      free(work);
+      return NULL;
+   }
+   return work;
+}
+
+static void
+nv_apply_arb_replacements(struct nv_asm_result *res, GLenum target, GLuint id,
+                          const char **arb_text_io, size_t *arb_len_io)
+{
+   unsigned k;
+
+   nv_replace_parse();
+   if (res->arb == NULL)
+      return;
+
+
+   if (nv_rpl_n == 0)
+      return;
+
+   for (k = 0; k < nv_rpl_n; k++) {
+      struct nv_replace_rule *r = &nv_rpl[k];
+      size_t lv, ln, line_start, alloc_limit;
+      char *new_val, *out;
+      const char *in;
+      unsigned n_sost = 0;
+
+      if (r->id != 0 && r->id != id)
+         continue;
+      if (r->kind == 1 && !is_nv_fragment_target(target))
+         continue;
+      if (r->kind == 2 && is_nv_fragment_target(target))
+         continue;
+
+      lv = strlen(r->old_val);
+      ln = strlen(r->new_val);
+      line_start = strlen(res->arb);
+      if (lv == 0 || lv > line_start)
+         continue;
+
+      /* Pessimistic: every character of the source could open a substitution. If it grows too
+             * much we refuse: a loud no is better than an absurd allocation inside the loading of a
+             * program. */
+      alloc_limit = line_start + line_start * ln + 1;
+      if (alloc_limit > (1u << 20)) {
+         continue;
+      }
+
+      new_val = malloc(alloc_limit);
+      if (new_val == NULL)
+         return;
+
+      out = new_val;
+      in = res->arb;
+      while (*in != 0) {
+         if (strncmp(in, r->old_val, lv) == 0) {
+            memcpy(out, r->new_val, ln);
+            out += ln;
+            in += lv;
+            n_sost++;
+         } else {
+            *out++ = *in++;
+         }
+      }
+      *out = 0;
+
+      if (n_sost > 0) {
+         free(res->arb);
+         res->arb = new_val;
+         if (arb_text_io != NULL)
+            *arb_text_io = new_val;
+         if (arb_len_io != NULL)
+            *arb_len_io = (size_t) (out - new_val);
+         r->hits += n_sost;
+      } else {
+         free(new_val);
+      }
+
+   }
+}
+
+
+void GLAPIENTRY
+_mesa_LoadProgramNV(GLenum target, GLuint id, GLsizei len,
+                    const GLubyte *program)
+{
+ 
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_nv_program *info;
+   struct gl_program *prog;
+   struct nv_asm_result res;
+   char err[512];
+   GLenum arb;
+   const char *arb_text;
+   size_t arb_len;
+
+   if (!nv_has_vp(ctx, "glLoadProgramNV"))
+      return;
+
+
+   if (is_nv_fragment_target(target) && !ctx->Extensions.NV_fragment_program) {
+      _mesa_error(ctx, GL_INVALID_ENUM, "glLoadProgramNV(target)");
+      return;
+   }
+
+   arb = nvARB_target(target);
+   if (arb == GL_NONE) {
+      _mesa_error(ctx, GL_INVALID_ENUM, "glLoadProgramNV(target)");
+      return;
+   }
+
+   /* NV: program zero can never be loaded. */
+   if (id == 0) {
+      _mesa_error(ctx, GL_INVALID_OPERATION, "glLoadProgramNV(id)");
+      return;
+   }
+
+   if (len < 0 || program == NULL) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glLoadProgramNV(len)");
+      return;
+   }
+
+   int shown = -1;
+
+   /* Program substitution for debugging (MESA_NV_KILL_FP/VP).
+    * With MESA_NV_KILL_FP=all every fragment gets a colour derived from its id:
+    * a single screenshot then shows which program draws which part of the
+    * screen.
+    */
+   if (_mesa_nv_kill_id("MESA_NV_KILL_FP", id) && is_nv_fragment_target(target)) {
+      static char kill[128];
+      const float lvl[4] = { 0.0, 0.34, 0.67, 1.0 };
+      int n;
+
+      /* Syntax note: in NV_fragment_program temporaries are not declared
+       * (R0-R31 full precision, H0-H63 half precision) and the colour output is
+       * o[COLR]/o[COLH], not "result.color" (that is ARB syntax).
+       */
+      n = snprintf(kill, sizeof kill,
+                   "!!FP1.0\n"
+                   "MOV R0, {%0.2f, %0.2f, %0.2f, 1.0};\n"
+                   "MOV o[COLR], R0;\n"
+                   "END\n",
+                   lvl[id % 4], lvl[(id / 4) % 4], lvl[(id / 16) % 4]);
+
+      program = (const GLubyte *) kill;
+      len = (GLsizei) (n > 0 && n < (int) sizeof kill ? n : (int) strlen(kill)) - 1;
+   } else if (nv_show_parse("MESA_NV_SHOW_VAR", id, &shown)) {
+      static char show[128];
+      int n = snprintf(show, sizeof show,
+                       "!!FP1.0\n"
+                       "MOV R0.xyz, f[TEX%d].xyzx;\n"
+                       "MOV R0.w, {1}.x;\n"
+                       "MOV o[COLR], R0;\n"
+                       "END\n", shown);
+
+      program = (const GLubyte *) show;
+      len = (GLsizei) (n > 0 && n < (int) sizeof show ? n : (int) strlen(show));
+   } else if (nv_show_parse("MESA_NV_SHOW_TEX", id, &shown)) {
+      static char show[128];
+      int n = snprintf(show, sizeof show,
+                       "!!FP1.0\n"
+                       "MOV R0, f[TEX0].xyxx;\n"
+                       "TEX R0, R0, TEX%d, 2D;\n"
+                       "MOV o[COLR], R0;\n"
+                       "END\n", shown);
+
+      program = (const GLubyte *) show;
+      len = (GLsizei) (n > 0 && n < (int) sizeof show ? n : (int) strlen(show));
+   } else if (_mesa_nv_kill_id("MESA_NV_KILL_VP", id) && !is_nv_fragment_target(target)) {
+      static const char kill[] =
+         "!!VP1.0\n"
+         "MOV o[HPOS], v[0];\n"
+         "MOV o[COL0], {1.0, 0.0, 0.0, 1.0};\n"
+         "END\n";
+
+      program = (const GLubyte *) kill;
+      len = (GLsizei) strlen(kill) - 1;
+   }
+
+   /* MESA_NV_FP_PATCH=<id>:<file>: replaces the source of the NV program with
+    * id <id> by the contents of <file>.  Useful for diagnosing shaders of that
+    * era: outputting a varying instead of a sampler read tells an interpolation
+    * problem from a sampler problem.
+    */
+   {
+      const char *pp = getenv("MESA_NV_FP_PATCH");
+
+      if (pp != NULL && *pp != 0) {
+         static char patch[16384];
+         const char *ent = pp;
+
+         /* list of "id:file,id:file,..." */
+         while (ent != NULL && *ent != 0) {
+            const int pid = atoi(ent);
+            const char *colon = strchr(ent, ':');
+
+            if (colon != NULL && pid == (int) id) {
+               char path[512];
+               size_t plen = strcspn(colon + 1, ",");
+               FILE *f;
+
+               snprintf(path, sizeof(path), "%.*s", (int) plen, colon + 1);
+               f = fopen(path, "rb");
+               if (f != NULL) {
+                  size_t n = fread(patch, 1, sizeof(patch) - 1, f);
+
+                  fclose(f);
+                  while (n > 0 && (patch[n - 1] == '\n' || patch[n - 1] == '\r'))
+                     patch[--n] = 0;
+                  patch[n] = 0;
+                  program = (const GLubyte *) patch;
+                  len = (GLsizei) n;
+                  fprintf(stderr, "MESA_NV_FP_PATCH: id=%u <- %s (%zu byte)\n",
+                          id, path, n);
+                  fflush(stderr);
+               }
+               break;
+            }
+
+            {
+               const char *comma = strchr(colon != NULL ? colon : ent, ',');
+
+               ent = comma != NULL ? comma + 1 : NULL;
+            }
+         }
+      }
+   }
+
+   /* MESA_NV_FP_PATCH_SUB=<text>:<file>: like MESA_NV_FP_PATCH, but it replaces
+    * the source of every NV program whose text contains <text>.  Needed by
+    * demos that assign different ids on each run.
+    */
+   {
+      const char *pp = getenv("MESA_NV_FP_PATCH_SUB");
+
+      if (pp != NULL && *pp != 0) {
+         static char patch[16384];
+         char text[16384];
+         const char *ent = pp;
+         GLsizei cpy = len < (GLsizei) sizeof(text) - 1 ? len : (GLsizei) sizeof(text) - 1;
+
+         memcpy(text, program, (size_t) cpy);
+         text[cpy] = 0;
+
+         while (ent != NULL && *ent != 0) {
+            const char *colon = strchr(ent, ':');
+
+            if (colon != NULL) {
+               char sub[128];
+               char path[512];
+               size_t slen = (size_t) (colon - ent);
+               size_t plen = strcspn(colon + 1, ",");
+               FILE *f;
+
+               snprintf(sub, sizeof(sub), "%.*s", (int) slen, ent);
+               snprintf(path, sizeof(path), "%.*s", (int) plen, colon + 1);
+
+               if (strstr(text, sub) != NULL && (f = fopen(path, "rb")) != NULL) {
+                  size_t n = fread(patch, 1, sizeof(patch) - 1, f);
+
+                  fclose(f);
+                  while (n > 0 && (patch[n - 1] == '\n' || patch[n - 1] == '\r'))
+                     patch[--n] = 0;
+                  patch[n] = 0;
+                  program = (const GLubyte *) patch;
+                  len = (GLsizei) n;
+                  fprintf(stderr, "MESA_NV_FP_PATCH_SUB: id=%u text ~ '%s' <- %s\n",
+                          id, sub, path);
+                  fflush(stderr);
+                  break;
+               }
+            }
+
+            {
+               const char *comma = strchr(colon != NULL ? colon : ent, ',');
+
+               ent = comma != NULL ? comma + 1 : NULL;
+            }
+         }
+      }
+   }
+
+   FLUSH_VERTICES(ctx, 0, 0);
+
+   prog = nv_lookup_or_create_program(ctx, id, target, "glLoadProgramNV");
+
+   nv_force_remap(prog);
+   if (!prog)
+      return;
+
+   /* Programs must keep the target they were created with. */
+   info = _mesa_nv_lookup_program(ctx, id);
+   if (info && info->Target != target) {
+      _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glLoadProgramNV(target differs from the one the program "
+                  "was loaded with)");
+      return;
+   }
+
+   _mesa_init_nv_asm_result(&res);
+   if (!_mesa_transpile_nv_program((const char *) program, len,
+                                   is_nv_fragment_target(target),
+                                   &res, err, sizeof(err))) {
+      /* From NV_vertex_program: when the failure can only be seen after the
+       * whole program was scanned the error position is len.
+       */
+      _mesa_set_program_error(ctx, len, err);
+      _mesa_error(ctx, GL_INVALID_OPERATION, "glLoadProgramNV(%s)", err);
+      _mesa_free_nv_asm_result(&res);
+      _mesa_update_valid_to_render_state(ctx);
+      return;
+   }
+
+
+
+   arb_text = res.arb;
+   arb_len = strlen(arb_text);
+
+
+    /* nvlegacy (FEATURE): text correction in the translated ARB program. The case that came
+         * first is the threshold of Timbury's "bite", which in the demo's source is byte-exact
+         * (255/256) and in our chain does not trigger for the texels of the bitten region. There is no
+         * specific knob any more: the substitution is the generic one described above. */
+    nv_apply_arb_replacements(&res, target, id, &arb_text, &arb_len);
+
+
+   /* Also writes the generated ARB translation, so the attribute mapping can be
+    * checked without guessing what the translator did.
+    */
+   {
+      const char *dir = getenv("MESA_NV_DUMP");
+      if (dir && dir[0]) {
+         char path[PATH_MAX];
+         snprintf(path, sizeof(path), "%s/%s_%u_arb.asm", dir,
+                  is_nv_fragment_target(target) ? "fp" : "vp", id);
+         FILE *f = fopen(path, "wb");
+         if (f) {
+            fwrite(arb_text, 1, arb_len, f);
+            fclose(f);
+         }
+      }
+   }
+
+
+
+
+
+   if (is_nv_fragment_target(target))
+      _mesa_parse_arb_fragment_program(ctx, GL_FRAGMENT_PROGRAM_ARB,
+                                       (const GLubyte *) arb_text,
+                                       (GLsizei) arb_len, prog);
+   else
+      _mesa_parse_arb_vertex_program(ctx, GL_VERTEX_PROGRAM_ARB,
+                                     (const GLubyte *) arb_text,
+                                     (GLsizei) arb_len, prog);
+
+   if (arb_parse_failed(ctx)) {
+      /* The generated text is also dumped on success, but a later load of the same id
+       * overwrites that file; this copy keeps the exact text the ARB parser rejected.
+       */
+      {
+         const char *dir = getenv("MESA_NV_DUMP");
+         if (dir && dir[0]) {
+            char path[PATH_MAX];
+            snprintf(path, sizeof(path), "%s/rejected_%s_%u.arb", dir,
+                     is_nv_fragment_target(target) ? "fp" : "vp", id);
+            FILE *f = fopen(path, "wb");
+            if (f) {
+               fwrite(arb_text, 1, arb_len, f);
+               fclose(f);
+            }
+         }
+      }
+      _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glLoadProgramNV(ARB translation rejected by the parser)");
+      _mesa_free_nv_asm_result(&res);
+      _mesa_update_valid_to_render_state(ctx);
+      return;
+   }
+
+   /* See struct gl_program::nv_saturate_clip_position: the clip position produced by an NV
+       * vertex program goes through the fixed-point conversion with saturation that the hardware of the
+       * time did. */
+   if (!is_nv_fragment_target(target))
+      prog->nv_saturate_clip_position = true;
+
+   /* Hand the program to the driver, as glProgramStringARB does. */
+   if (!st_program_string_notify(ctx, arb, prog)) {
+      _mesa_set_program_error(ctx, len, "program rejected by the driver");
+      _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glLoadProgramNV(rejected by driver)");
+      _mesa_free_nv_asm_result(&res);
+      _mesa_update_vertex_processing_mode(ctx);
+      _mesa_update_valid_to_render_state(ctx);
+      return;
+   }
+
+   /* Drop the previous NV record, if any, and install the new one. */
+   if (info)
+      _mesa_nv_delete_program_data(ctx, id);
+
+   info = new_nv_program_data(ctx, id, target, len, (const char *) program,
+                              &res);
+   if (!info) {
+      _mesa_error(ctx, GL_OUT_OF_MEMORY, "glLoadProgramNV");
+      _mesa_free_nv_asm_result(&res);
+      return;
+   }
+
+   /* Apply the default values the Cg compiler left in the program text. */
+   for (unsigned i = 0; i < res.num_inits; i++) {
+      const struct nv_local_init *init = &res.inits[i];
+      GLfloat *param;
+
+      if (is_nv_fragment_target(target)) {
+         if (nv_local_param_pointer(ctx, prog, init->slot, 1, &param,
+                                    "glLoadProgramNV"))
+            COPY_4V(param, init->value);
+      } else if (init->slot < NV_MAX_PROGRAM_PARAMS(ctx)) {
+         COPY_4V(ctx->VertexProgram.Parameters[init->slot], init->value);
+      }
+   }
+
+   /* And the initial values of the fragment program named parameters. */
+   for (GLuint i = 0; i < info->NumNamedParams; i++) {
+      struct gl_nv_named_param *p = &info->NamedParams[i];
+      GLfloat *param;
+
+      if (!p->HasDefault)
+         continue;
+
+      if (nv_local_param_pointer(ctx, prog, p->Slot, 1, &param,
+                                 "glLoadProgramNV"))
+         COPY_4V(param, p->Value);
+   }
+
+   _mesa_free_nv_asm_result(&res);
+
+   _mesa_update_vertex_processing_mode(ctx);
+   _mesa_update_valid_to_render_state(ctx);
+}
+
+void GLAPIENTRY
+_mesa_RequestResidentProgramsNV(GLsizei n, const GLuint *ids)
+{
+   GET_CURRENT_CONTEXT(ctx);
+
+   if (!nv_has_vp(ctx, "glRequestResidentProgramsNV"))
+      return;
+
+   if (n < 0) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glRequestResidentProgramsNV(n)");
+      return;
+   }
+
+   /* Nothing to do: NV programs are plain ARB assembly programs and are
+    * therefore always resident.  Only mark the ones that exist.
+    */
+   for (GLint i = 0; i < n; i++) {
+      struct gl_nv_program *info = _mesa_nv_lookup_program(ctx, ids[i]);
+
+      if (info)
+         info->Resident = GL_TRUE;
+   }
+}
+
+GLboolean GLAPIENTRY
+_mesa_AreProgramsResidentNV(GLsizei n, const GLuint *ids,
+                            GLboolean *residences)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   GLboolean all = GL_TRUE;
+
+   if (!nv_has_vp(ctx, "glAreProgramsResidentNV"))
+      return GL_FALSE;
+
+   if (n < 0) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glAreProgramsResidentNV(n)");
+      return GL_FALSE;
+   }
+
+   for (GLint i = 0; i < n; i++) {
+      struct gl_nv_program *info = _mesa_nv_lookup_program(ctx, ids[i]);
+
+      if (residences)
+         residences[i] = info ? info->Resident : GL_FALSE;
+      if (!info) {
+         all = GL_FALSE;
+         _mesa_error(ctx, GL_INVALID_VALUE,
+                     "glAreProgramsResidentNV(nonexistent program)");
+      }
+   }
+
+   return all;
+}
+
+void GLAPIENTRY
+_mesa_ExecuteProgramNV(GLenum target, GLuint id, const GLfloat *params)
+{
+   GET_CURRENT_CONTEXT(ctx);
+
+   if (!nv_has_vp(ctx, "glExecuteProgramNV"))
+      return;
+
+   /* Vertex state programs are not implemented: they need the NV "write
+    * back a vertex attribute" behaviour, which Mesa's ARB programs cannot
+    * express.
+    */
+   if (target != GL_VERTEX_STATE_PROGRAM_NV) {
+      _mesa_error(ctx, GL_INVALID_ENUM, "glExecuteProgramNV(target)");
+      return;
+   }
+
+   (void) id;
+   (void) params;
+   _mesa_warning(ctx, "glExecuteProgramNV: vertex state programs are not "
+                      "implemented");
+}
