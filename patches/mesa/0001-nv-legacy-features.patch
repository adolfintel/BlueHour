+            c[3][ch] = (v0 + 2.0f * v1) / 3.0f;
+         } else {
+            c[2][ch] = ((float) v0 + v1) / 2.0f;
+            c[3][ch] = 0.0f;
+         }
+      }
+      for (unsigned k = 0; k < 16; k++) {
+         const unsigned code = (bits >> (2 * k)) & 3;
+         lum[k] = 0.3f * c[code][0] + 0.6f * c[code][1] + 0.1f * c[code][2];
+      }
+   }
+}
+
+/** Mean of the differences between adjacent texels (inside the blocks and across the
+ *  boundaries), along the x axis and the y axis of a few slices.  `tr' = reads the texels with
+ *  the axes swapped inside the block.  Lower = correct order. */
+static double
+nv_tex3d_inblock_score(const unsigned char *p, unsigned nbx, unsigned nby,
+                       unsigned nbz, unsigned bs, bool a5, bool tr,
+                       bool inside_only)
+{
+   const unsigned nslice = nbz <= 8 ? nbz : 8;
+   const unsigned nblk = nbx * nby;
+   float *lum = malloc((size_t) nblk * 16 * sizeof *lum);
+   double sum = 0.0;
+   unsigned npairs = 0;
+
+   if (lum == NULL)
+      return 1e30;
+
+   for (unsigned i = 0; i < nslice; i++) {
+      const unsigned z = (unsigned) ((uint64_t) i * nbz / nslice);
+      const unsigned char *sb = p + (size_t) z * nblk * bs;
+
+      for (unsigned k = 0; k < nblk; k++)
+         nv_dxt_block_lum(sb + (size_t) k * bs, a5, &lum[k * 16]);
+
+      for (unsigned by = 0; by < nby; by++) {
+         for (unsigned bx = 0; bx < nbx; bx++) {
+            const unsigned blk = by * nbx + bx;
+            const float *L = &lum[blk * 16];
+            /* position (rx,cx) inside the block: when transposed the slot read is the swapped one, so
+                         * lum[4*cx+rx] instead of lum[4*rx+cx] */
+#define TEXL(rx, cx) L[tr ? (4 * ((cx) & 3) + ((rx) & 3)) : (4 * ((rx) & 3) + ((cx) & 3))]
+            for (unsigned rx = 0; rx < 4; rx++) {
+               for (unsigned cx = 0; cx < 4; cx++) {
+                  if (cx + 1 < 4) {
+                     sum += fabsf(TEXL(rx, cx) - TEXL(rx, cx + 1));
+                     npairs++;
+                  } else if (bx + 1 < nbx && !inside_only) {
+                     const float *R = &lum[(blk + 1) * 16];
+                     sum += fabsf(TEXL(rx, cx) - R[tr ? rx : 0 * 4 + rx]);
+                     npairs++;
+                  }
+                  if (rx + 1 < 4) {
+                     sum += fabsf(TEXL(rx, cx) - TEXL(rx + 1, cx));
+                     npairs++;
+                  } else if (by + 1 < nby && !inside_only) {
+                     const float *D = &lum[(blk + nbx) * 16];
+                     sum += fabsf(TEXL(rx, cx) - D[tr ? 4 * cx : cx]);
+                     npairs++;
+                  }
+               }
+            }
+#undef TEXL
+         }
+      }
+   }
+   free(lum);
+   return npairs ? sum / npairs : 1e30;
+}
+
+/** Swaps the indices inside each block: new[k] = old[4*(k%4) + k/4]
+ *  (an involutive permutation). DXT5 alpha = 3 bits x 16 in bytes 2..7, colours =
+ *  2 bits x 16 in the last 4 bytes (DXT5) or in bytes 4..7 (DXT1). */
+static void
+nv_tex3d_inblock_transpose(unsigned char *p, unsigned nblk, unsigned bs, bool a5)
+{
+   for (unsigned i = 0; i < nblk; i++) {
+      unsigned char *blk = p + (size_t) i * bs;
+
+      if (a5) {
+         uint64_t old = 0, nw = 0;
+         for (unsigned j = 0; j < 6; j++)
+            old |= (uint64_t) blk[2 + j] << (8 * j);
+         for (unsigned k = 0; k < 16; k++) {
+            const unsigned s = 4 * (k & 3) + (k >> 2);
+            nw |= ((old >> (3 * s)) & 7ull) << (3 * k);
+         }
+         for (unsigned j = 0; j < 6; j++)
+            blk[2 + j] = (unsigned char) (nw >> (8 * j));
+      }
+
+      const unsigned coffs = a5 ? 12 : 4;
+      uint32_t oldc = 0, nwc = 0;
+      for (unsigned j = 0; j < 4; j++)
+         oldc |= (uint32_t) blk[coffs + j] << (8 * j);
+      for (unsigned k = 0; k < 16; k++) {
+         const unsigned s = 4 * (k & 3) + (k >> 2);
+         nwc |= ((oldc >> (2 * s)) & 3u) << (2 * k);
+      }
+      for (unsigned j = 0; j < 4; j++)
+         blk[coffs + j] = (unsigned char) (nwc >> (8 * j));
+   }
+}
+
+/** -1 = never, 0 = measure (default), 1 = always transposed */
+static int
+nv_tex3d_inblock_mode(void)
+{
+   const char *e = getenv("MESA_NV_TEX3D_INBLOCK");
+   if (e == NULL || *e == 0 || strcmp(e, "auto") == 0)
+      return 0;
+   if (strcmp(e, "0") == 0 || strcmp(e, "off") == 0)
+      return -1;
+   if (strcmp(e, "1") == 0 || strcmp(e, "tr") == 0)
+      return 1;
+   return 0;
+}
+
+static const void *
+nv_legacy_tex3d_fixup(struct gl_context *ctx, GLenum target, GLint level,
+                      mesa_format format, GLsizei width, GLsizei height,
+                      GLsizei depth, GLsizei imageSize, const void *data,
+                      void **tmp)
+{
+   unsigned bw, bh, bd, bs, nbx, nby, nbz, nblk;
+   enum nv_tex3d_mode mode;
+   const char *ids = NULL;
+   unsigned char *out = NULL;
+   float *pv = NULL;
+   const struct nv_tex3d_layout *chosen = NULL;
+   double best = 1e30, nat = 1e30;
+
+   *tmp = NULL;
+
+
+   if (target != GL_TEXTURE_3D || level != 0 || depth < 2 || data == NULL)
+      return data;
+   if (!_mesa_is_format_compressed(format))
+      return data;
+
+   mode = nv_tex3d_mode_from_env(&ids);
+   if (mode == NV_TEX3D_OFF)
+      return data;
+
+   _mesa_get_format_block_size_3d(format, &bw, &bh, &bd);
+   bs = (unsigned) _mesa_get_format_bytes(format);
+   if (bd != 1 || bs < 2 || bw == 0 || bh == 0)
+      return data;
+
+   nbx = (unsigned) ((width + bw - 1) / bw);
+   nby = (unsigned) ((height + bh - 1) / bh);
+   nbz = (unsigned) ((depth + bd - 1) / bd);
+   nblk = nbx * nby * nbz;
+   if ((uint64_t) nblk * bs != (uint64_t) imageSize) {
+      return data;
+   }
+
+   if (mode == NV_TEX3D_IDS) {
+      const struct gl_texture_object *t =
+         _mesa_get_current_tex_object(ctx, target);
+      if (!(t != NULL && nv_tex3d_id_in_list(ids, t->Name)))
+         return data;
+   }
+
+   /* Layout choice: the candidates are measured on the real continuity of the blocks. With
+       * MESA_NV_TEX3D_LAYOUT one candidate is forced for A/B. */
+   pv = nv_tex3d_block_proxy((const unsigned char *) data, nblk, bs);
+   if (pv == NULL)
+      return data;
+
+   const char *want_env = getenv("MESA_NV_TEX3D_LAYOUT");
+   const char *want = "vtc";
+   bool force_layout = true;
+
+   if (want_env != NULL && *want_env != 0) {
+      if (strcmp(want_env, "auto") == 0) {
+         want = NULL;
+         force_layout = false;
+      } else {
+         want = want_env;
+      }
+   }
+
+   for (unsigned i = 0; i < ARRAY_SIZE(nv_tex3d_layouts); i++) {
+      const struct nv_tex3d_layout *L = &nv_tex3d_layouts[i];
+      if (!nv_tex3d_layout_fits(L, nbx, nby, nbz))
+         continue;
+      const double sc = nv_tex3d_layout_score(L, pv, nbx, nby, nbz);
+      if (strcmp(L->name, "identity") == 0)
+         nat = sc;
+      if (want != NULL && strcmp(want, L->name) == 0) {
+         chosen = L;
+         best = sc;
+         break;
+      }
+      if (sc < best) {
+         best = sc;
+         chosen = L;
+      }
+   }
+
+   const bool reorder = chosen != NULL && strcmp(chosen->name, "identity") != 0 &&
+                        (force_layout || mode != NV_TEX3D_AUTO ||
+                         best * 1.25 < nat);
+
+   if (chosen != NULL && strcmp(chosen->name, "identity") != 0 && !reorder) {
+   }
+
+   if (reorder) {
+      out = malloc(imageSize);
+      if (out == NULL) {
+         free(pv);
+         pv = NULL;
+         return data;
+      }
+   }
+
+   if (reorder && out != NULL) {
+   for (unsigned z = 0; z < nbz; z++) {
+      for (unsigned by = 0; by < nby; by++) {
+         for (unsigned bx = 0; bx < nbx; bx++) {
+            const unsigned src = nv_tex3d_src(chosen, nbx, nby, nbz, bx, by, z);
+            const unsigned dst = (z * nby + by) * nbx + bx;
+            memcpy(&out[(size_t) dst * bs],
+                   &((const unsigned char *) data)[(size_t) src * bs], bs);
+         }
+      }
+   }
+
+   }
+
+   /* Second step: texel order inside the 4x4 block, decided by MEASUREMENT. It also applies when
+       * the block layout was already correct; in that case, though, only the adjacencies internal to the
+       * block are evaluated, because the ones across the boundaries make no sense if the blocks are not in
+       * order. */
+   {
+      const bool a5 = (format == MESA_FORMAT_RGBA_DXT5 ||
+                       format == MESA_FORMAT_SRGBA_DXT5);
+      const bool dxt1 = (format == MESA_FORMAT_RGB_DXT1 ||
+                         format == MESA_FORMAT_RGBA_DXT1 ||
+                         format == MESA_FORMAT_SRGB_DXT1 ||
+                         format == MESA_FORMAT_SRGBA_DXT1);
+      const int inb = nv_tex3d_inblock_mode();
+
+      if (inb != -1 && !a5 && !dxt1) {
+      }
+      if (inb != -1 && (a5 || dxt1)) {
+         const unsigned char *srcp = out != NULL ? out
+                                        : (const unsigned char *) data;
+         const double s_std = nv_tex3d_inblock_score(srcp, nbx, nby, nbz, bs, a5,
+                                                     false, !reorder);
+         const double s_tr = nv_tex3d_inblock_score(srcp, nbx, nby, nbz, bs, a5,
+                                                    true, !reorder);
+         const bool tr = (inb == 1) || (inb == 0 && s_tr < s_std * 0.85);
+         if (tr) {
+            if (out == NULL) {
+               out = malloc(imageSize);
+               if (out == NULL) {
+                  free(pv);
+                  pv = NULL;
+                  *tmp = NULL;
+                  return data;
+               }
+               memcpy(out, data, (size_t) imageSize);
+            }
+            nv_tex3d_inblock_transpose(out, nblk, bs, a5);
+         }
+      }
+   }
+
+   free(pv);
+   *tmp = out;
+   return out != NULL ? (const void *) out : data;
+}
