diff --git a/src/mesa/glapi/glapi/gen/NV_framebuffer_object_draft.xml b/src/mesa/glapi/glapi/gen/NV_framebuffer_object_draft.xml
new file mode 100644
index 0000000..ca0662f
--- /dev/null
+++ b/src/mesa/glapi/glapi/gen/NV_framebuffer_object_draft.xml
@@ -0,0 +1,62 @@
+<?xml version="1.0"?>
+<!DOCTYPE OpenGLAPI SYSTEM "gl_API.dtd">
+
+<!-- Entry points of the 2004-2005 NVIDIA draft of GL_EXT_framebuffer_object, as
+     requested by the NV tech-demo engine family.  These names are NOT in the final
+     extension, so they do not go into upstream's EXT_framebuffer_object.xml
+     category: they get their own file, exactly like the other legacy NV extensions
+     in this directory.  The measurement, the reason for each argument list and the
+     mapping onto the final objects are written over the implementations, in
+     src/mesa/main/fbobject.c. -->
+
+<OpenGLAPI>
+
+<category name="GL_EXT_framebuffer_object (NVIDIA 2004 draft names)" number="32765">
+
+    <!-- Draft allocation of the framebuffer's own depth/stencil buffer.  The final
+         API's equivalent is RenderbufferStorageEXT, which acts on a bound
+         renderbuffer object; the application of this era never creates one (it has
+         no glGenRenderbuffersEXT at all, measured), so this one creates and attaches
+         the renderbuffer itself. -->
+    <function name="FramebufferStorageEXT">
+        <param name="target" type="GLenum"/>
+        <param name="internalformat" type="GLenum"/>
+        <param name="width" type="GLsizei"/>
+        <param name="height" type="GLsizei"/>
+    </function>
+
+    <!-- Draft completeness test: same argument and result as the final
+         CheckFramebufferStatusEXT. -->
+    <function name="ValidateFramebufferEXT">
+        <param name="target" type="GLenum"/>
+        <return type="GLenum"/>
+    </function>
+
+    <!-- Draft query of the framebuffer's own buffer: no attachment argument, because
+         in the draft there was exactly one such buffer per framebuffer. -->
+    <function name="GetFramebufferBufferParameterivEXT">
+        <param name="target" type="GLenum"/>
+        <param name="pname" type="GLenum"/>
+        <param name="params" type="GLint *"/>
+    </function>
+
+    <function name="GetFramebufferBufferParameterfvEXT">
+        <param name="target" type="GLenum"/>
+        <param name="pname" type="GLenum"/>
+        <param name="params" type="GLfloat *"/>
+    </function>
+
+    <!-- FramebufferTextureEXT is deliberately not declared here.  The name already
+         exists in Mesa as an alias of the final FramebufferTexture (see
+         es_EXT.xml), and the ABI generator rejects a duplicated API name.  The
+         final ARB FramebufferTexture takes exactly the draft's four arguments
+         (target, attachment, texture, level), which is the one place where the
+         draft's design was adopted unchanged.  A desktop application asking for
+         glFramebufferTextureEXT gets null, because Mesa's alias is only in the ES
+         profile (measured with tools/nv_proc_wgl.c), so Wine hands out the pointer
+         to FramebufferTexture under WINE_NV_ADVERTISE_NV_DRAFT_NAMES: see
+         patches/wine/doc.md. -->
+
+</category>
+
+</OpenGLAPI>
