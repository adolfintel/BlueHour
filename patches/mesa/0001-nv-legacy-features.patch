+/**
+ * GL_NV_vertex_program numbers its v[] registers after the fixed-function
+ * attributes (v[0] position, v[1] normal, v[2]..v[3] colours, v[4] fog
+ * coordinate, v[6]..v[13] texture coordinates), and applications written
+ * against it feed immediate-mode vertices with glVertex, glNormal,
+ * glMultiTexCoord and friends while the translated program reads generic
+ * attributes.  Alias every generic slot the program reads onto the
+ * immediate-mode data of the legacy register that stands for it, which is
+ * what NV hardware would have fed into v[].
+ */
+static GLbitfield
+vbo_exec_nv_attrib_alias(struct gl_context *ctx,
+                         const struct vbo_exec_context *exec,
+                         uint8_t map[16])
+{
+   const struct gl_program *vp = ctx->VertexProgram._Current;
+   GLbitfield alias = 0;
+
+   for (unsigned i = 0; i < 16; i++)
+      map[i] = 0xff;
+
+   if (!_mesa_nv_legacy_attrs() || !vp ||
+       !_mesa_nv_lookup_program(ctx, vp->Id))
+      return 0;
+
+   for (unsigned i = 0; i < 16; i++) {
+      const unsigned gen = VERT_ATTRIB_GENERIC0 + i;
+      const unsigned conv = _mesa_nv_alias_slot(i);
+      unsigned src;
