+
+   if (!nv_has_vp(ctx, "glProgramParameter4dvNV"))
+      return;
+
+   if (!v)
+      return;
+
+   for (int i = 0; i < 4; i++)
+      f[i] = (GLfloat) v[i];
+
+   set_program_param(ctx, target, index, f, "glProgramParameter4dvNV");
+}
+
+void GLAPIENTRY
+_mesa_ProgramParameters4fvNV(GLenum target, GLuint index, GLsizei count,
+                             const GLfloat *v)
+{
+ 
+   GET_CURRENT_CONTEXT(ctx);
+
+   const GLuint max = NV_MAX_PROGRAM_PARAMS(ctx);
+
+   if (!nv_has_vp(ctx, "glProgramParameters4fvNV"))
+      return;
+
+   if (nvARB_target(target) == GL_NONE) {
+      _mesa_error(ctx, GL_INVALID_ENUM, "glProgramParameters4fvNV(target)");
+      return;
+   }
+
+   if (count < 0 || v == NULL) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glProgramParameters4fvNV(count)");
+      return;
+   }
+
+   if (index + (GLuint) count > max) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glProgramParameters4fvNV(index)");
+      return;
+   }
+
+   nv_flush_program_constants(ctx, target);
+
+   GLfloat (*params)[4] = nv_env_params(ctx, target);
+   for (GLsizei i = 0; i < count; i++)
+      COPY_4V(params[index + i], v + i * 4);
+
+}
+
+void GLAPIENTRY
+_mesa_ProgramParameters4dvNV(GLenum target, GLuint index, GLsizei count,
+                             const GLdouble *v)
+{
+   GET_CURRENT_CONTEXT(ctx);
+
+   const GLuint max = NV_MAX_PROGRAM_PARAMS(ctx);
+
+   if (!nv_has_vp(ctx, "glProgramParameters4dvNV"))
+      return;
+
+   if (nvARB_target(target) == GL_NONE) {
+      _mesa_error(ctx, GL_INVALID_ENUM, "glProgramParameters4dvNV(target)");
+      return;
+   }
+
+   if (count < 0 || v == NULL) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glProgramParameters4dvNV(count)");
+      return;
+   }
+
+   if (index + (GLuint) count > max) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glProgramParameters4dvNV(index)");
+      return;
+   }
+
+   nv_flush_program_constants(ctx, target);
+
+   GLfloat (*params)[4] = nv_env_params(ctx, target);
+   for (GLsizei i = 0; i < count; i++)
+      for (int c = 0; c < 4; c++)
+         params[index + i][c] = (GLfloat) v[i * 4 + c];
+}
