+         GLsizei num = k + (GLsizei) sizeof(texunit) - 1;
+
+         while (num < line_end && (s[num] == ' ' || s[num] == '\t'))
+            num++;
+
+         unsigned value = 0;
+         bool any = false;
+
+         while (num < line_end && s[num] >= '0' && s[num] <= '9') {
+            value = value * 10u + (unsigned) (s[num] - '0');
+            any = true;
+            num++;
+         }
+
+         if (any && value < MAX_TEXTURE_IMAGE_UNITS)
+            units |= BITFIELD_BIT(value);
+
+         break;
+      }
+   }
+
+   return units;
+}
