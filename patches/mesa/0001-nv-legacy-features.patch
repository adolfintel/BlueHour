+/* ------------------------------------------------------------------ */
+/* fragment program named parameters                                   */
+/* ------------------------------------------------------------------ */
+
+/* From NV_fragment_program: a named parameter is looked up in the program
+ * object named by id; the program does not need to be bound.
+ */
+static GLboolean
+get_named_param(struct gl_context *ctx, GLuint id, GLsizei len,
+                const GLubyte *name, struct gl_program **progp,
+                struct gl_nv_named_param **paramp, const char *caller)
+{
+   struct gl_nv_program *info;
+   struct gl_nv_named_param *p;
+   struct gl_program *prog;
+
+   if (!nv_has_fp(ctx, caller))
+      return GL_FALSE;
+
+   if (len <= 0 || name == NULL) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "%s(name)", caller);
+      return GL_FALSE;
+   }
+
+   info = _mesa_nv_lookup_program(ctx, id);
+   if (!info) {
+      _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "%s(id %u not an NV program in ctx %p shared %p)", caller, id,
+                  (void *) ctx, (void *) ctx->Shared);
+      return GL_FALSE;
+   }
+
+   p = nv_find_named_param(info, len, name);
+   if (!p) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "%s(no such named parameter)", caller);
+      return GL_FALSE;
+   }
+
+   prog = _mesa_lookup_program(ctx, id);
+   if (!prog || prog == &_mesa_DummyProgram) {
+      _mesa_error(ctx, GL_INVALID_OPERATION, "%s(id %u has no object)",
+                  caller, id);
+      return GL_FALSE;
+   }
+
+   if (info->Target != GL_FRAGMENT_PROGRAM_NV) {
+      _mesa_error(ctx, GL_INVALID_OPERATION, "%s(id %u is not a fragment "
+                  "program)", caller, id);
+      return GL_FALSE;
+   }
+
+   *progp = prog;
+   *paramp = p;
+   return GL_TRUE;
+}
+
+
+
+
+void GLAPIENTRY
+_mesa_ProgramNamedParameter4fNV(GLuint id, GLsizei len, const GLubyte *name,
+                                GLfloat x, GLfloat y, GLfloat z, GLfloat w)
+{
+ 
+
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_program *prog;
+   struct gl_nv_named_param *p;
+   GLfloat *param;
+   GLfloat vflip[4];
+
+   if (!get_named_param(ctx, id, len, name, &prog, &p,
+                        "glProgramNamedParameter4fNV"))
+      return;
+
+   nv_flush_program_constants(ctx, GL_FRAGMENT_PROGRAM_NV);
+
+
+   if (nv_local_param_pointer(ctx, prog, p->Slot, 1, &param,
+                              "glProgramNamedParameter4fNV")) {
+      ASSIGN_4V(param, x, y, z, w);
+      if (_mesa_nv_debug())
+         NV_TRACE("id=%u name=%.*s slot=%u v=(%g, %g, %g, %g)", id, (int) len,
+                  (const char *) name, p->Slot, x, y, z, w);
+   }
+}
