+/* Creates/extends our dedicated resource to cover [start,start+size). The current draw still
+ * uses the normal upload: here we prepare the future. */
+static void
+nv_vb_remember(struct u_vbuf *mgr, unsigned index, const uint8_t *ptr,
+               unsigned start, unsigned size)
+{
+   struct nv_vb_entry *e;
+   unsigned nstart, nend, span;
+
+   if (index >= PIPE_MAX_ATTRIBS || !nv_array_once_enabled())
+      return;
+
+   e = nv_vb_find(ptr, true);
+   if (e->dead)
+      return;
+   nstart = 0;                 /* we cover from offset 0 of the binding */
+   nend = start + size;
+   if (e->res != NULL && e->user == ptr && nend <= e->cend && e->res_size >= e->cend)
+      return; /* already covered by our resource */
+
+   span = nend;
+   if (e->user == ptr && e->cend > span)
+      span = e->cend;          /* coverage grows monotonically */
+   if (span > NV_ARRAY_UNION_MAX) {
+      nv_vb_drop(e);
+      return;
+   }
+
+   nv_vb_drop(e);
+   e->user = ptr;
+   e->cstart = nstart;
+   e->cend = span;
+   e->res_size = MAX2(span, 4096u);
+   e->res = nv_vb_alloc(mgr, e->res_size);
+   if (e->res == NULL || !nv_vb_upload_span(mgr, e, ptr)) {
+      nv_vb_drop(e);
+      return;
+   }
+   if (span <= NV_ARRAY_SHADOW_MAX && nv_shadow_bytes + span <= NV_ARRAY_SHADOW_BUDGET) {
+      e->shadow = malloc(span);
+      if (e->shadow != NULL) {
+         memcpy(e->shadow, ptr + nstart, span);
+         nv_shadow_bytes += span;
+      }
+   }
+}
