+/*****************************************************************************
+ * GL_NV_pixel_data_range
+ */
+
+/* These entry points are referenced by Mesa's dispatch (api_exec_init.c) or by
+ * functional code: they must stay in the features patch, hence the keep marker. */
+void GLAPIENTRY
+_mesa_PixelDataRangeNV(GLenum target, GLsizei length, const GLvoid *pointer)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   int index;
+
+   switch (target) {
+   case GL_WRITE_PIXEL_DATA_RANGE_NV:
+      index = NV_WRITE_PIXEL_DATA_RANGE;
+      break;
+   case GL_READ_PIXEL_DATA_RANGE_NV:
+      index = NV_READ_PIXEL_DATA_RANGE;
+      break;
+   default:
+      _mesa_error(ctx, GL_INVALID_ENUM, "glPixelDataRangeNV(target)");
+      return;
+   }
+
+   if (pointer == NULL) {
+      if (length != 0) {
+         _mesa_error(ctx, GL_INVALID_VALUE, "glPixelDataRangeNV(length != 0)");
+         return;
+      }
+      ctx->NV.PixelDataRange[index].Length = 0;
+      ctx->NV.PixelDataRange[index].Pointer = NULL;
+      return;
+   }
+
+   if (length <= 0) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glPixelDataRangeNV(length <= 0)");
+      return;
+   }
+
+   /* The ranges are ordinary client memory for us: pixel transfers read it
+    * directly, so there is nothing to prefetch or to flush.
+    */
+   ctx->NV.PixelDataRange[index].Length = length;
+   ctx->NV.PixelDataRange[index].Pointer = pointer;
+}
+
+
+/* These entry points are referenced by Mesa's dispatch (api_exec_init.c) or by
+ * functional code: they must stay in the features patch, hence the keep marker. */
+void GLAPIENTRY
+_mesa_FlushPixelDataRangeNV(GLenum target)
+{
+   GET_CURRENT_CONTEXT(ctx);
+
+   switch (target) {
+   case GL_WRITE_PIXEL_DATA_RANGE_NV:
+   case GL_READ_PIXEL_DATA_RANGE_NV:
+      /* Nothing to do: we never keep a copy of the range. */
+      return;
+   default:
+      _mesa_error(ctx, GL_INVALID_ENUM, "glFlushPixelDataRangeNV(target)");
+      return;
+   }
+}
+
+
+/*****************************************************************************
+ * GL_NV_vertex_array_range
+ */
+
+/* These entry points are referenced by Mesa's dispatch (api_exec_init.c) or by
+ * functional code: they must stay in the features patch, hence the keep marker. */
+void GLAPIENTRY
+_mesa_VertexArrayRangeNV(GLsizei length, const GLvoid *pointer)
+{
+   GET_CURRENT_CONTEXT(ctx);
+
+   FLUSH_VERTICES(ctx, 0, 0);
+
+   if (pointer == NULL || length == 0) {
+      /* Release the range. */
+      ctx->NV.VertexArrayRange.Valid = GL_FALSE;
+      ctx->NV.VertexArrayRange.Length = 0;
+      ctx->NV.VertexArrayRange.Pointer = NULL;
+      if (getenv("MESA_NV_TRACE_VARANGE")) {
+         static unsigned nva;
+         if (nva++ < 100)
+            fprintf(stderr, "MESA-NV VARANGE release frame=%u\n", _mesa_nv_frame());
+      }
+      return;
+   }
+
+   if (length < 0) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glVertexArrayRangeNV(length < 0)");
+      return;
+   }
+
+   /* Any pointer is acceptable: the vertex arrays the client points into the
+    * range are ordinary host memory as far as Mesa is concerned.
+    */
+   ctx->NV.VertexArrayRange.Valid = GL_TRUE;
+   ctx->NV.VertexArrayRange.Length = length;
+   ctx->NV.VertexArrayRange.Pointer = pointer;
+
+   if (getenv("MESA_NV_TRACE_VARANGE")) {
+      static unsigned nva;
+      if (nva++ < 100)
+         fprintf(stderr, "MESA-NV VARANGE len=%u ptr=%p frame=%u\n", (unsigned) length, pointer, _mesa_nv_frame());
+   }
+}
+
+
+/* These entry points are referenced by Mesa's dispatch (api_exec_init.c) or by
+ * functional code: they must stay in the features patch, hence the keep marker. */
+void GLAPIENTRY
+_mesa_FlushVertexArrayRangeNV(void)
+{
+   GET_CURRENT_CONTEXT(ctx);
+
+   (void) ctx;
+
+   /* Nothing to flush: Mesa reads the client arrays when the draw call is
+    * recorded, so the data is never stale.
+    */
+}
