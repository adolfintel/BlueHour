+/** Signature of the state the aliasing depends on: if it did not change there is
+ * nothing to redo (the aliasing already applied is still valid).
+ */
+static uint64_t
+nv_alias_mix(uint64_t h, uint64_t v)
+{
+   h ^= v;
+   return h * 1099511628211ull;
+}
+
+
+static uint64_t
+nv_alias_signature(const struct gl_vertex_array_object *vao,
+                   const struct gl_program *vp, GLbitfield64 added)
+{
+   uint64_t h = 1469598103934665603ull;
+
+   h = nv_alias_mix(h, (uint64_t) vp->Id);
+   h = nv_alias_mix(h, (uint64_t) vp->info.inputs_read);
+   h = nv_alias_mix(h, (uint64_t) vao->Enabled);
+   h = nv_alias_mix(h, (uint64_t) added);
+
+   for (unsigned i = 0; i < 16; i++) {
+      const unsigned conv = _mesa_nv_alias_slot(i);
+
+      if (conv == ~0u || !(vao->Enabled & VERT_BIT(conv)))
+         continue;
+
+      const struct gl_array_attributes *a = &vao->VertexAttrib[conv];
+      const struct gl_vertex_buffer_binding *b = &vao->BufferBinding[a->BufferBindingIndex];
+
+      h = nv_alias_mix(h, i);
+      h = nv_alias_mix(h, a->Stride);
+      h = nv_alias_mix(h, a->RelativeOffset);
+      h = nv_alias_mix(h, a->Format._PipeFormat);
+      h = nv_alias_mix(h, (uintptr_t) a->Ptr);
+      h = nv_alias_mix(h, a->BufferBindingIndex);
+      h = nv_alias_mix(h, (uintptr_t) b->BufferObj);
+      h = nv_alias_mix(h, (uint64_t) b->Offset);
+      h = nv_alias_mix(h, b->Stride);
+      h = nv_alias_mix(h, b->InstanceDivisor);
+   }
+
+   return h;
+}
