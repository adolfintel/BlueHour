+/**
+ * GL_NV_vertex_program (table X.2): while an NV vertex program is active,
+ * register v[n] uses generic array n if that one is enabled; if it is disabled and
+ * the aliased conventional array is enabled, the latter is used ("a particular
+ * vertex attribute array will be used if enabled, but if disabled, and the
+ * corresponding aliased conventional vertex array is enabled, the conventional
+ * vertex array will be used").
+ *
+ * This is a property of state, not a per-draw transformation: it is applied here
+ * (and removed/redone when the relevant state changes) so that the driver's array
+ * atoms see the right data.  The record lives on the VAO, so switching VAOs cannot
+ * corrupt the aliasing of another object.
+ */
+void
+_mesa_nv_alias_update(struct gl_context *ctx)
+{
+   struct gl_vertex_array_object *vao = ctx->Array._DrawVAO;
+   const struct gl_program *vp = ctx->VertexProgram._Current;
+   struct nv_alias_state *state;
+   struct nv_alias_state plan;
+   GLbitfield64 added = 0;
+   uint64_t sig;
+
+   if (vao == NULL || !vao->EverBound || vao->SharedAndImmutable)
+      return;
+
+   if (!_mesa_nv_legacy_attrs() || !ctx->VertexProgram.Enabled || vp == NULL ||
+       _mesa_nv_lookup_program(ctx, vp->Id) == NULL) {
+      /* No NV aliasing: remove one if it happens to be active. */
+      state = vao->_NvAlias;
+      if (state != NULL && state->added) {
+         _mesa_disable_vertex_array_attribs(ctx, vao, state->added);
+         for (unsigned i = 0; i < state->n; i++)
+            vao->VertexAttrib[state->saved[i].attrib] = state->saved[i].attr;
+         state->added = 0;
+         state->n = 0;
+         if (!ctx->Const.UseVAOFastPath)
+            _mesa_update_vao_derived_arrays(ctx, vao, false);
+      }
+      return;
+   }
+
+   /* Computes the aliasing plan without touching state. */
+   plan.added = 0;
+   plan.n = 0;
+   plan.sig = 0;
+
+   for (unsigned i = 0; i < 16; i++) {
+      const unsigned gen = VERT_ATTRIB_GENERIC0 + i;
+      const unsigned conv = _mesa_nv_alias_slot(i);
+
+      if (!(vp->info.inputs_read & VERT_BIT(gen)))
+         continue;
+
+      /* The generic array itself has priority (spec 2.14.1). */
+      if (vao->Enabled & VERT_BIT(gen))
+         continue;
+
+      if (conv == ~0u || !(vao->Enabled & VERT_BIT(conv)))
+         continue;
+
+      if (plan.n < ARRAY_SIZE(plan.saved)) {
+         plan.saved[plan.n].attrib = gen;
+         plan.saved[plan.n].attr = vao->VertexAttrib[gen];
+         plan.n++;
+      }
+      added |= VERT_BIT(gen);
+
+   }
+
+   sig = nv_alias_signature(vao, vp, added);
+
+   state = vao->_NvAlias;
+   if (state != NULL && state->added && state->sig == sig)
+      return;   /* Nothing to do: the aliasing in effect is still the correct one */
+
+   /* Remove the aliasing that was in effect. */
+   if (state != NULL && state->added) {
+      _mesa_disable_vertex_array_attribs(ctx, vao, state->added);
+      for (unsigned i = 0; i < state->n; i++)
+         vao->VertexAttrib[state->saved[i].attrib] = state->saved[i].attr;
+      state->added = 0;
+      state->n = 0;
+   }
+
+   if (!added) {
+      if (!ctx->Const.UseVAOFastPath)
+         _mesa_update_vao_derived_arrays(ctx, vao, false);
+      return;
+   }
+
+   if (state == NULL) {
+      state = calloc(1, sizeof(*state));
+      if (!state)
+         return;
+      vao->_NvAlias = state;
+   }
+
+   for (unsigned i = 0; i < plan.n; i++)
+      state->saved[i] = plan.saved[i];
+   state->n = plan.n;
+   state->added = added;
+   state->sig = sig;
+
+   /* Apply: the conventional array ends up in the generic slot of the matching
+    * register v[n].
+    */
+   for (unsigned i = 0; i < 16; i++) {
+      const unsigned gen = VERT_ATTRIB_GENERIC0 + i;
+      const unsigned conv = _mesa_nv_alias_slot(i);
+
+      if (!(added & VERT_BIT(gen)) || conv == ~0u)
+         continue;
+      vao->VertexAttrib[gen] = vao->VertexAttrib[conv];
+   }
+
+   _mesa_enable_vertex_array_attribs(ctx, vao, added);
+   if (!ctx->Const.UseVAOFastPath)
+      _mesa_update_vao_derived_arrays(ctx, vao, false);
+}
