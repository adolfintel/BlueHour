+/* ------------------------------------------------------------------ */
+/* NV instruction representation                                       */
+/* ------------------------------------------------------------------ */
+
+enum nv_reg_kind {
+   OP_NONE = 0,
+   OP_SCRATCH,
+   OP_IMM,          /* {1, 2, 3, 4}        */
+   OP_LOCAL,        /* c[N]                  */
+   OP_LOCAL_REL,    /* c[A0.x + N]           */
+   OP_ATTRIB,       /* v[N]      (VP)        */
+   OP_OUTPUT,       /* o[HPOS]               */
+   OP_SHADOWOUT,    /* copy of an output, see shadow_out in translate_state */
+   OP_TEMP,         /* R5 / H5               */
+   OP_ADDR,         /* A0                    */
+   OP_UNIT,         /* TEX2      (texture)   */
+   OP_NAMED,        /* g_bumpScale (FP)      */
+   OP_FRAGIN,       /* f[TEX0]   (FP)        */
+   OP_CC,           /* CC / HC  (condition-code register, fp30)  */
+   OP_CCTEMP,       /* ARB temporary reserved for predication */
+   OP_BRANCH,       /* pseudo-instruction: BRA/BRAZ/... before lowering */
+   OP_FLAGTMP,      /* pseudo-instruction written by lower_nv_branches: materialize
+                    * one branch predicate into a 0/1 temporary (and its complement),
+                    * so the arms no longer read the condition-code register */
+};
+
+struct nv_operand {
+   enum nv_reg_kind kind;
+   GLuint index;
+   GLint addr_off;
+   GLubyte addr_reg;        /* A<n> register number for OP_LOCAL_REL */
+   GLboolean neg;
+   GLboolean abs;           /**< the |src| source modifier */
+   int swz_len;
+   char swz[5];
+   char addr_comp;      /* A0.<comp> selector for OP_LOCAL_REL */
+   char sym[96];          /* printed form of output/fragment input */
+   char name[64];         /* named parameter name                  */
+   char target[16];       /* texture target keyword                */
+   GLfloat imm[4];
+};
+
+static int is_projective_texop(const char *name);
+static unsigned tex_coord_count(const char *target);
+static const char *projective_base(const char *name);
+static void scratch_operand_at(struct nv_operand *s, unsigned index);
+
+struct nv_inst {
+   const struct nv_opcode *op;
+   int sat;
+   int nsrc;
+   struct nv_operand dst;
+   /* src[3]: for the lookup instructions, the slot holding the texture unit and the
+       * target. TEX/TXP/TXB put it in src[1]; TXD has three vector sources (coord, ddx, ddy)
+       * so it ends up in src[3]. */
+   struct nv_operand src[4];
+   /* Predicate on the condition codes (NV_fragment_program2, sect. 3.11.4.4):
+    * "MOVR R1.w(GT.x), {0}.x" writes R1.w only if the GT code of component x of
+    * the condition-code register is true.  cc_test = LT/EQ/GT/UN,
+    * cc_swz = which CC components to test. */
+   char cc_test[8];
+   char cc_swz[8];
+   /* Name of the 0/1 temporary that predicates this instruction, when the predicate
+      comes from a lowered NV branch instead of from the condition codes at this point.
+      Set by predicate_block(); empty means the cc_test path above is used.
+      When both are set the two predicates are combined with a product. */
+   char cc_flag[24];
+   /* The instruction's "C" suffix (DP3XC, SUBC, TEXC,...): the result also updates the
+       * condition codes, so it has to be copied into the cc registers.
+       */
+   int writes_cc;
+};
