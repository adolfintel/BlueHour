+ * final specification still names them in its issue log: issue 19 talks about
+ * "the texture argument given to FramebufferTextureEXT", and the revision note
+ * "#24, August 23, 2004" adds "description of
+ * GetFramebufferBufferParametervEXT"; the same note records "removal of
+ * FramebufferBuf", which is how the draft's own depth buffer became the
+ * renderbuffer objects of the final API.
+ *
+ * The draft model, from that log and from the vendor extension: there were no
+ * renderbuffer objects.  A framebuffer owned one depth/stencil buffer, allocated
+ * by FramebufferStorageEXT.  Colour came from textures attached by
+ * FramebufferTextureEXT, which takes no texture target because the target came
+ * from the texture object.  The completeness test was ValidateFramebufferEXT.
+ * The framebuffer's own buffer was queried by GetFramebufferBufferParameterivEXT
+ * and ...fvEXT, which take no attachment for the same reason.  So the draft's
+ * "framebuffer buffer" is implemented here as a renderbuffer that we create and
+ * attach ourselves, which is what the final objects are for.
+ *
+ * MESA_NV_TRACE_DRAFT_FBO (diagnostic series) prints the arguments of every call
+ * below.  That is deliberate: the argument shapes above are a reading of a draft
+ * that no longer exists, so the first run of a new demo of this family should
+ * confirm the reading instead of trusting it.
+ */
+
+/** Which attachment the draft's own depth/stencil buffer uses for a format. */
+static GLenum
+nv_draft_storage_attachment(GLenum baseFormat)
+{
+   if (_mesa_is_depthstencil_format(baseFormat))
+      return GL_DEPTH_STENCIL_ATTACHMENT;
+   if (baseFormat == GL_STENCIL_INDEX)
+      return GL_STENCIL_ATTACHMENT;
+   return GL_DEPTH_ATTACHMENT;
+}
+
+
+/**
+ * The attachment that already holds this framebuffer's draft buffer, if any.
+ * Returns the attachment enum through *attachment_out when it finds one.
+ */
+static struct gl_renderbuffer_attachment *
+nv_draft_find_attachment(struct gl_context *ctx, struct gl_framebuffer *fb,
+                         GLenum *attachment_out)
+{
+   static const GLenum possible[] = {
+      GL_DEPTH_STENCIL_ATTACHMENT, GL_DEPTH_ATTACHMENT, GL_STENCIL_ATTACHMENT
+   };
+   unsigned i;
+
+   for (i = 0; i < ARRAY_SIZE(possible); i++) {
+      struct gl_renderbuffer_attachment *att =
+         get_attachment(ctx, fb, possible[i], NULL);
+      if (att && att->Renderbuffer) {
+         if (attachment_out)
+            *attachment_out = possible[i];
+         return att;
+      }
+   }
+   if (attachment_out)
+      *attachment_out = GL_NONE;
+   return NULL;
+}
+
+
+
+
+
+/**
+ * Draft: allocate (or re-specify) the framebuffer's own depth/stencil buffer.
+ * The final API's equivalent is glRenderbufferStorageEXT, but that one acts on a
+ * bound renderbuffer object, and the application of this era never created one:
+ * it has no glGenRenderbuffersEXT in its executable at all (measured with the
+ * probe above).  So the renderbuffer is created here on first use and kept in the
+ * attachment, which is also how a later call finds it again.
+ */
+void GLAPIENTRY
+_mesa_FramebufferStorageEXT(GLenum target, GLenum internalFormat,
+                            GLsizei width, GLsizei height)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_framebuffer *fb = get_framebuffer_target(ctx, target);
+   struct gl_renderbuffer_attachment *att;
+   struct gl_renderbuffer *rb;
+   GLenum baseFormat = fb ? _mesa_base_fbo_format(ctx, internalFormat) : 0;
+
+
+   if (!fb) {
+      _mesa_error(ctx, GL_INVALID_ENUM, "glFramebufferStorageEXT(invalid target %s)",
+                  _mesa_enum_to_string(target));
+      return;
+   }
+   if (!_mesa_is_user_fbo(fb)) {
+      _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glFramebufferStorageEXT(no framebuffer object bound)");
+      return;
+   }
+   if (width <= 0 || height <= 0) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glFramebufferStorageEXT(width or height <= 0)");
+      return;
+   }
+   if (baseFormat == 0) {
+      _mesa_error(ctx, GL_INVALID_ENUM,
+                  "glFramebufferStorageEXT(invalid internalformat)");
+      return;
+   }
+   if (!_mesa_is_depth_or_stencil_format(baseFormat) &&
+       !_mesa_is_depthstencil_format(baseFormat)) {
+      /* The draft's own buffer is a depth/stencil buffer: colour storage came from
+       * textures through FramebufferTextureEXT.
+       */
+      _mesa_error(ctx, GL_INVALID_ENUM,
+                  "glFramebufferStorageEXT(internalformat is not depth or stencil)");
+      return;
+   }
+
+   att = get_attachment(ctx, fb, nv_draft_storage_attachment(baseFormat), NULL);
+   assert(att);
+   rb = att->Renderbuffer;
+
+   if (!rb) {
+      GLuint rb_name = 0;
+      GLenum old_attachment = GL_NONE;
+      struct gl_renderbuffer_attachment *elsewhere =
+         nv_draft_find_attachment(ctx, fb, &old_attachment);
+
+      if (elsewhere && elsewhere != att) {
+         /* One buffer per framebuffer in the draft: a call with a different format
+          * moves it instead of leaving two depth buffers attached.
+          */
+         _mesa_FramebufferRenderbuffer(target, old_attachment, GL_RENDERBUFFER, 0);
+      }
+
+      /* The objects are created through the final entry points, not by hand: that
+       * is what keeps the renderbuffer hash and the framebuffer visual consistent.
+       */
+      _mesa_GenRenderbuffers(1, &rb_name);
+      if (!rb_name)
+         return;
+      _mesa_BindRenderbuffer(GL_RENDERBUFFER, rb_name);
+      _mesa_RenderbufferStorage(GL_RENDERBUFFER, internalFormat, width, height);
+      _mesa_FramebufferRenderbuffer(target, nv_draft_storage_attachment(baseFormat),
+                                    GL_RENDERBUFFER, rb_name);
+      _mesa_BindRenderbuffer(GL_RENDERBUFFER, 0);
+
+      rb = att->Renderbuffer;
+      if (!rb) {
+         /* One of the calls above reported the error already. */
+         return;
+      }
+   }
+   else {
+      _mesa_renderbuffer_storage(ctx, rb, internalFormat, width, height,
+                                 NO_SAMPLES, NO_SAMPLES);
+   }
+}
+
+
+/** Draft name of the completeness test. */
+GLenum GLAPIENTRY
+_mesa_ValidateFramebufferEXT(GLenum target)
+{
+   return _mesa_CheckFramebufferStatus(target);
+}
+
+
+/** Draft query of the framebuffer's own buffer: it takes no attachment. */
+void GLAPIENTRY
+_mesa_GetFramebufferBufferParameterivEXT(GLenum target, GLenum pname, GLint *params)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_framebuffer *fb = get_framebuffer_target(ctx, target);
+   GLenum attachment = GL_NONE;
+
+
+   if (!fb) {
+      _mesa_error(ctx, GL_INVALID_ENUM,
+                  "glGetFramebufferBufferParameterivEXT(invalid target %s)",
+                  _mesa_enum_to_string(target));
+      return;
+   }
+   if (!_mesa_is_user_fbo(fb)) {
+      _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glGetFramebufferBufferParameterivEXT(no framebuffer object bound)");
+      return;
+   }
+   if (!params) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glGetFramebufferBufferParameterivEXT(params)");
+      return;
+   }
+   if (!nv_draft_find_attachment(ctx, fb, &attachment)) {
+      _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glGetFramebufferBufferParameterivEXT(no draft buffer attached)");
+      return;
+   }
+   get_framebuffer_attachment_parameter(ctx, fb, attachment, pname, params,
+                                        "glGetFramebufferBufferParameterivEXT");
+}
+
+
+/** Same query, float flavour: the parameters are integers, so convert them. */
+void GLAPIENTRY
+_mesa_GetFramebufferBufferParameterfvEXT(GLenum target, GLenum pname, GLfloat *params)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   struct gl_framebuffer *fb = get_framebuffer_target(ctx, target);
+   GLenum attachment = GL_NONE;
+   GLint ivalues[4] = { 0, 0, 0, 0 };
+
+
+   if (!fb) {
+      _mesa_error(ctx, GL_INVALID_ENUM,
+                  "glGetFramebufferBufferParameterfvEXT(invalid target %s)",
+                  _mesa_enum_to_string(target));
+      return;
+   }
+   if (!_mesa_is_user_fbo(fb)) {
+      _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glGetFramebufferBufferParameterfvEXT(no framebuffer object bound)");
+      return;
+   }
+   if (!params) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "glGetFramebufferBufferParameterfvEXT(params)");
+      return;
+   }
+   if (!nv_draft_find_attachment(ctx, fb, &attachment)) {
+      _mesa_error(ctx, GL_INVALID_OPERATION,
+                  "glGetFramebufferBufferParameterfvEXT(no draft buffer attached)");
+      return;
+   }
+   get_framebuffer_attachment_parameter(ctx, fb, attachment, pname, ivalues,
+                                        "glGetFramebufferBufferParameterfvEXT");
+   params[0] = (GLfloat) ivalues[0];
+}
