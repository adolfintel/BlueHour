+
+/*
+ * Translation of NVIDIA NV_vertex_program / NV_fragment_program assembly
+ * (!!VP1.1,!!VP2.0,!!FP1.0) into Mesa's ARB assembly dialect.
+ *
+ * The point of this file is to reuse everything Mesa already has for ARB
+ * assembly programs (the bison parser, prog_to_nir, and every driver back
+ * end) instead of writing a second shader back end: we parse the NV text into
+ * a small structured form, then print ARB source text which is fed to
+ * _mesa_parse_arb_{vertex,fragment}_program().
+ *
+ * The translation is intentionally lossy where NV and ARB differ:
+ *
+ *   - NV fragment program precision qualifiers (H/X/R) are dropped; ARB
+ *     fragment programs are single precision anyway.
+ *   - The NV fragment program "named parameters" (DECLARE name = {...})
+ *     become ARB local parameters (program.local[]) and get a numbered ARB
+ *     symbol; the loader keeps the name -> slot mapping.
+ *   - NV2 has a four component address register whose lanes are all live at
+ *     the same time; Mesa's ARB address register is a single scalar (writing
+ *     any lane but x is a no-op there).  The lanes are kept in float
+ *     temporaries and every relative access is re-loaded through the scalar
+ *     address register into its own scratch temporary (see
+ *     materialize_rels()); the value is clamped so that a bad vertex attribute
+ *     cannot index outside the program parameter array.
+ *   - Mesa evaluates some operations in scalar form (from lane x); those get
+ *     unrolled into one instruction per destination component so that they
+ *     keep NV's per-component behaviour.
+ *
+ * Anything that cannot be expressed is reported as a parse error, so the
+ * caller fails the program load instead of silently rendering garbage.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+#include <ctype.h>
+#include <math.h>
+#include "nv_to_arb.h"
+#include "main/nv_extensions.h"
+
+#define NV_FP_TEMPS_BASE 64     /* H file temporaries get index + 64 */
+#ifndef ARRAY_SIZE
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#endif
+
+/* ------------------------------------------------------------------ */
+/* growable text buffer                                               */
+/* ------------------------------------------------------------------ */
+
+struct sbuf {
+   char *buf;
+   size_t len, cap;
+};
+
+static void
+sb_init(struct sbuf *b)
+{
+   b->cap = 8192;
+   b->buf = malloc(b->cap);
+   b->len = 0;
+   if (b->buf)
+      b->buf[0] = 0;
+}
+
+static void
+sb_free(struct sbuf *b)
+{
+   free(b->buf);
+   b->buf = NULL;
+   b->len = b->cap = 0;
+}
+
+static int
+sb_room(struct sbuf *b, size_t extra)
+{
+   if (!b->buf)
+      return 0;
+   if (b->len + extra + 1 > b->cap) {
+      size_t ncap = b->cap ? b->cap : 1024;
+      while (b->len + extra + 1 > ncap)
+         ncap *= 2;
+      char *n = realloc(b->buf, ncap);
+      if (!n) {
+         free(b->buf);
+         b->buf = NULL;
+         return 0;
+      }
+      b->buf = n;
+      b->cap = ncap;
+   }
+   return 1;
+}
+
+static void
+sb_appendf(struct sbuf *b, const char *fmt, ...)
+{
+   va_list ap;
+   int need;
+
+   if (!sb_room(b, 0))
+      return;
+   va_start(ap, fmt);
+   need = vsnprintf(NULL, 0, fmt, ap);
+   va_end(ap);
+   if (need < 0 || !sb_room(b, (size_t) need))
+      return;
+   va_start(ap, fmt);
+   vsnprintf(b->buf + b->len, b->cap - b->len, fmt, ap);
+   va_end(ap);
+   b->len += (size_t) need;
+}
