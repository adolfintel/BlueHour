+      if (conv != ~0u && (exec->vtx.enabled & BITFIELD_BIT(conv)))
+         src = conv;
+      else if (exec->vtx.enabled & BITFIELD_BIT(i))
+         src = i;
+      else
+         continue;
+
+      map[i] = src;
+      alias |= BITFIELD_BIT(gen);
+   }
