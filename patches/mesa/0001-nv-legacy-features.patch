+struct gl_texture_object *
+_mesa_nv_rt_depth_alias_tex(uintptr_t drawable)
+{
+   unsigned i;
+
+   for (i = 0; i < ARRAY_SIZE(nv_rt_depth); i++)
+      if (nv_rt_depth[i].drawable == drawable)
+         return nv_rt_depth[i].tex;
+   return NULL;
+}
+
+/* nvlegacy (fork): iteration of the small table, needed by the dri front-end which at end of
+ * frame must copy every pbuffer store's zs into the application's texture. Functional (not
+ * diagnostics), so it belongs in the features-only patch. */
+unsigned
+_mesa_nv_rt_depth_alias_count(void)
+{
+   unsigned i, n = 0;
+
+   for (i = 0; i < ARRAY_SIZE(nv_rt_depth); i++)
+      if (nv_rt_depth[i].drawable && nv_rt_depth[i].tex)
+         n++;
+   return n;
+}
+
+void
+_mesa_nv_rt_depth_alias_at(unsigned index, uintptr_t *drawable,
+                           struct gl_texture_object **texObj)
+{
+   unsigned i, n = 0;
+
+   for (i = 0; i < ARRAY_SIZE(nv_rt_depth); i++) {
+      if (!nv_rt_depth[i].drawable || !nv_rt_depth[i].tex)
+         continue;
+      if (n == index) {
+         *drawable = nv_rt_depth[i].drawable;
+         *texObj = nv_rt_depth[i].tex;
