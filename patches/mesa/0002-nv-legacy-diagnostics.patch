+/* nvdbg:begin */
+/* MESA_NV_TRACE_ARRBUF=1: census of "where the vertices come from".
+ * It answers the question: does the app bind real VBOs (Names != 0) or use client arrays?
+ * It prints a summary every 300 draws. */
+/* nvdbg:begin */
+/* Only needed by the probe that samples the depth of the draw buffer itself. */
+#include "readpix.h"
+
+/* MESA_NV_SAMPLE_TARGET=<max>: samples the depth OF THE DRAW BUFFER ITSELF (not the
+ * Wine-side pbuffer) and computes its coverage under 0.999. It separates two diagnoses that
+ * were indistinguishable until now:
+ *   - the draws hit a surface different from the one Wine samples/copies
+ *   - the right surface receives nothing at all
+ * Filters by size and prints BOTH 1024x1024 (the broken pass) and 512x512 (the pass that
+ * works) = built-in positive control. It gives one sample per target every 'max' draws
+ * because the sampling is expensive (w*h floats). */
+static void
+nv_sample_drawbuffer(struct gl_context *ctx)
+{
+   static int iniz = -1, n1k = 0, n512 = 0, line_limit;
+
+   if (iniz < 0) {
+      const char *e = getenv("MESA_NV_SAMPLE_TARGET");
+      line_limit = e ? (int) strtol(e, NULL, 0) : 0;
+      iniz = 1;
+   }
+   if (!line_limit || !ctx->DrawBuffer)
+      return;
+
+   const unsigned w = (unsigned) ctx->DrawBuffer->Width;
+   const unsigned h = (unsigned) ctx->DrawBuffer->Height;
+   int *cnt = NULL;
+   if (w == 1024 && h == 1024) cnt = &n1k;
+   else if (w == 512 && h == 512) cnt = &n512;
+   if (cnt == NULL || *cnt >= line_limit)
+      return;
+   (*cnt)++;
+
+   /* samples with step 8: one row every 8, one pixel every 8 */
+   const unsigned sw = w / 8u, sh = h / 8u;
+   if (sw == 0 || sh == 0)
+      return;
+   /* nvdbg: GUARD. Without a real depth attachment, ReadPixels of GL_DEPTH_COMPONENT returns
+       * uninitialised memory: measured on a 512^2 fb without depth (depthbits=0 type=0 rb=(nil)) the
+       * probe printed `min=-3.2e36 max=1.1e37 average=-nan coverage_under_0.999=85.938%` - IMPOSSIBLE
+       * numbers (0.49 > deepest max): that was FALSE data, not a result. An instrument that produces
+       * values outside the domain must be turned off, not read. Bonus: it also avoids the GL error
+       * ReadPixels generates on a framebuffer with no depth. */
+   if (ctx->DrawBuffer->Visual.depthBits == 0 ||
+       ctx->DrawBuffer->Attachment[BUFFER_DEPTH].Renderbuffer == NULL) {
+      fprintf(stderr, "MESA-NV SAMPLE-TARGET frame=%u fb=%ux%u: NO attachment of "
+                      "nv_depth (depthbits=%d) -> nv_sample skipped: not a float value \n",
+              _mesa_nv_frame(), w, h, (int) ctx->DrawBuffer->Visual.depthBits);
+      return;
+   }
+   GLfloat *line = malloc((size_t) w * sizeof *line);
+   if (line == NULL)
+      return;
+   float mn = 1e30f, mx = -1e30f, tot = 0.0f;
+   unsigned below = 0, n = 0;
+   for (unsigned y = 0; y < h; y += 8u) {
+      _mesa_ReadPixels(0, (GLint) y, (GLsizei) w, 1, GL_DEPTH_COMPONENT, GL_FLOAT, line);
+      for (unsigned x = 0; x < w; x += 8u) {
+         const float v = line[x];
+         if (v < mn) mn = v;
+         if (v > mx) mx = v;
+         tot += v;
+         n++;
+         if (v < 0.999f) below++;
+      }
+   }
+   free(line);
+   fprintf(stderr, "MESA-NV SAMPLE-TARGET frame=%u fb=%ux%u buf=%p name=%u status=%#x natt=%d "
+                   "depthattach: type=%#x rb=%p tex=%p lvl=%d | depthbits=%d stencilbits=%d rgba=%d/%d/%d/%d "
+                   "readbuf=%p readname=%u | samples=%u min=%.6f max=%.6f average=%.6f coverage_below_0.999=%.3f%%\n",
+           _mesa_nv_frame(), w, h, (void *) ctx->DrawBuffer,
+           (unsigned) ctx->DrawBuffer->Name,
+           (unsigned) ctx->DrawBuffer->_Status,
+           (int) ctx->DrawBuffer->_HasAttachments,
+           (unsigned) ctx->DrawBuffer->Attachment[BUFFER_DEPTH].Type,
+           (void *) ctx->DrawBuffer->Attachment[BUFFER_DEPTH].Renderbuffer,
+           (void *) ctx->DrawBuffer->Attachment[BUFFER_DEPTH].Texture,
+           (int) ctx->DrawBuffer->Attachment[BUFFER_DEPTH].TextureLevel,
+           (int) ctx->DrawBuffer->Visual.depthBits,
+           (int) ctx->DrawBuffer->Visual.stencilBits,
+           (int) ctx->DrawBuffer->Visual.redBits, (int) ctx->DrawBuffer->Visual.greenBits,
+           (int) ctx->DrawBuffer->Visual.blueBits, (int) ctx->DrawBuffer->Visual.alphaBits,
+           (void *) ctx->ReadBuffer, (unsigned) ctx->ReadBuffer->Name,
+           n, (double) mn, (double) mx,
+           n ? (double) (tot / (float) n) : 0.0,
+           n ? (100.0 * (double) below / (double) n) : 0.0);
+}
+/* nvdbg:end */
+
+/* nvdbg:begin */
+/* MESA_NV_TRACE_ENVPARAM=<max>: prints the content of the per-CONTEXT file of vertex
+ * program parameters (ctx->VertexProgram.Parameters) at draw time, because the translated
+ * VPs read there (c[] -> program.env[], see nv_to_arb.c:3565). Filters by target size and
+ * prints BOTH the broken target (1024x1024) and the working one (512x512 = built-in
+ * positive control). It sits at the head of the draw function, so it does not depend on the
+ * census' per-program tracing (which discards programs outside the set, and that is why the
+ * previous version printed nothing). */
+static void
+nv_trace_envparam(struct gl_context *ctx)
+{
+   static int iniz = -1, n1k = 0, n512 = 0, line_limit;
+
+   if (iniz < 0) {
+      const char *e = getenv("MESA_NV_TRACE_ENVPARAM");
+      line_limit = e ? (int) strtol(e, NULL, 0) : 0;
+      iniz = 1;
+   }
+   if (!line_limit || !ctx->DrawBuffer)
+      return;
+
+   const unsigned w = (unsigned) ctx->DrawBuffer->Width;
+   const unsigned h = (unsigned) ctx->DrawBuffer->Height;
+   int *cnt = NULL;
+   if (w == 1024 && h == 1024) cnt = &n1k;
+   else if (w == 512 && h == 512) cnt = &n512;
+   if (cnt == NULL || *cnt >= line_limit)
+      return;
+   (*cnt)++;
+
+   const GLfloat (*env)[4] = ctx->VertexProgram.Parameters;
+   fprintf(stderr, "MESA-NV ENVPARAM frame=%u fb=%ux%u vp=%u env:",
+           _mesa_nv_frame(), w, h,
+           (unsigned) (ctx->VertexProgram._Current ? ctx->VertexProgram._Current->Id : 0));
+   for (unsigned i = 0; i < 12; i++)
+      fprintf(stderr, " [%g,%g,%g,%g]", env[i][0], env[i][1], env[i][2], env[i][3]);
+   fprintf(stderr, "\n");
+}
+/* nvdbg:end */
+
+static void
+nv_arrbuf_census(struct gl_context *ctx)
+{
+   nv_trace_envparam(ctx);
+   nv_sample_drawbuffer(ctx);
+
+   static int cached = -1;
+   static unsigned n = 0, idx_vbo = 0, idx_client = 0, attr_vbo = 0, attr_client = 0;
+   static unsigned names[24]; static int nn;
+
+   if (cached < 0)
+      cached = getenv("MESA_NV_TRACE_ARRBUF") != NULL;
+   if (!cached)
+      return;
+
+   const struct gl_vertex_array_object *vao = ctx->Array.VAO;
+   if (vao->IndexBufferObj && vao->IndexBufferObj->Name)
+      idx_vbo++;
+   else
+      idx_client++;
+
+   GLbitfield en = vao->Enabled;
+   for (unsigned a = 0; a < VERT_ATTRIB_MAX && (en >> a); a++) {
+
+      if (!(en & (1u << a)))
+         continue;
+      const struct gl_buffer_object *b = vao->BufferBinding[a].BufferObj;
+      if (b && b->Name) {
+         attr_vbo++;
+         int seen = 0;
+         for (int k = 0; k < nn; k++) if (names[k] == b->Name) seen = 1;
+         if (!seen && nn < 24) names[nn++] = b->Name;
+      } else {
+         attr_client++;
+      }
+   }
+
+   if (++n % 300 == 0) {
+      fprintf(stderr, "MESA-NV ARRBUF draw=%u EL(vbo=%u client=%u) ATTR(vbo=%u client=%u) VBO seen_cnt:",
+              n, idx_vbo, idx_client, attr_vbo, attr_client);
+      for (int k = 0; k < nn; k++) fprintf(stderr, " %u", names[k]);
+      fprintf(stderr, "\n");
+      fflush(stderr);
+   }
+}
+/* nvdbg:end */
