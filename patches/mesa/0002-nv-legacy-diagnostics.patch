+               }
+               vmean /= (double) (w * h);
+               if (vmin > vmax) {
+                  vmin = 0.0;
+                  vmax = 0.0;
+               }
+               if (dir != NULL && *dir != 0 && nv_dtx_dface_files < 720u &&
+                   nv_dtx_dface_next >= 0 &&
+                   (long) nv_dtx_ticks >= nv_dtx_dface_from &&
+                   (long) nv_dtx_ticks >= nv_dtx_dface_next) {
+                  char img_path[512];
+                  FILE *fh;
+                  snprintf(img_path, sizeof(img_path),
+                           "%s/depth-o%lx-t%u-%ux%u-%x.pgm",
+                           dir, (unsigned long) (uintptr_t) dtobj, dname, w, h,
+                           (unsigned) nv_dfaces[qf]);
+                  fh = fopen(img_path, "wb");
+                  if (fh != NULL) {
+                     fprintf(fh, "P5\n%u %u\n255\n", w, h);
+                     for (unsigned qe = 0; qe < w * h; qe++)
+                        fputc(px[4u * qe], fh);
+                     fclose(fh);
+                     nv_dtx_dface_files++;
+                      if (nv_dtx_dface_slot < nv_dtx_dface_last_n)
+                         nv_dtx_dface_last[nv_dtx_dface_slot].tick =
+                            (long) nv_dtx_ticks;
+                  }
+               }
+            } else {
+               _mesa_GetError();
+            }
+            fprintf(stderr,
+                    "MESA-NV DTX-DFACE frame=%u obj=%p tex=%u %ux%u face=#x%x status=#x%x err=#x%x"
+                    " min=%.4f max=%.4f mean=%.4f nonZero%%=%.1f\n",
+                    nv_dtx_ticks, (void *) dtobj, dname, w, h, (unsigned) nv_dfaces[qf],
+                    stf, erf, vmin, vmax, vmean,
+                    100.0 * (double) nzc / (double) (w * h));
+            fflush(stderr);
+         }
+      }
+      if (is_color) {
+         _mesa_BindFramebuffer(GL_READ_FRAMEBUFFER, fb[1]);
+         _mesa_ReadPixels(0, 0, (GLsizei) w, (GLsizei) h, GL_RGBA, GL_UNSIGNED_BYTE, px);
+      if (is_color) {
+         if (is_color && dtgt == GL_TEXTURE_CUBE_MAP) {
+            /* MESA_NV_DUMP_COLTEX_FACE_FROM=<n>: the six face IMAGES are written only from the
+             * n-th census read onward. The cap of files per run is spent by the earliest frames,
+             * which on Mad Mod Mike are the frames where the render-texture store has not been
+             * associated with an application texture yet, so an unwindowed dump shows the stale
+             * faces of the initialisation and not the state under test. */
+            static long nv_dtx_face_from = -1;
+            static long nv_dtx_face_every = -1;
+            if (nv_dtx_face_from < 0)
+            {
+               const char *e = getenv( "MESA_NV_DUMP_COLTEX_FACE_FROM" );
+               nv_dtx_face_from = (e != NULL && *e != 0) ? atol( e ) : 0;
+               e = getenv( "MESA_NV_DUMP_COLTEX_FACE_EVERY" );
+               nv_dtx_face_every = (e != NULL && *e != 0) ? atol( e ) : 0;
+            }
