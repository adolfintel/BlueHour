+/* ------------------------------------------------------------------ */
+/* Deterministic A/B of a named parameter.
+ *
+ *   MESA_NV_FLIP="name@id:block:vA|vB"
+ *
+ * Parameter "name" of OpenGL program "id" takes value vA in the even blocks of
+ * <block> frames and vB in the odd ones; if vA is empty the game's value is left
+ * as it is.  The frames compared this way are adjacent, so they have exactly the
+ * same geometry: the difference in the image is only the effect of the parameter.
+ */
+struct nv_flip
+{
+   char name[64];
+   unsigned id;
+   unsigned block;
+   float va[4], vb[4];
+   bool has_va;
+};
+
+static struct nv_flip g_flips[8];
+static int g_num_flips;
+
+static int
+nv_flip_parse(char *p, struct nv_flip *f)
+{
+   char *at = strchr(p, '@');
+   char *c1, *c2, *v;
+   int i;
+
+   if (!at)
+      return 0;
+   *at = 0;
+   if (!*p || strlen(p) >= sizeof f->name)
+      return 0;
+   strcpy(f->name, p);
+   f->id = (unsigned) strtoul(at + 1, &c1, 10);
+   if (*c1 != ':')
+      return 0;
+   f->block = MAX2((unsigned) strtoul(c1 + 1, &c2, 10), 1u);
+   if (*c2 != ':')
+      return 0;
+   v = c2 + 1;
+   c1 = strchr(v, '|');
+   if (!c1)
+      return 0;
+   *c1 = 0;
+   f->has_va = (*v != 0);
+   if (f->has_va)
+      sscanf(v, "%f,%f,%f,%f", &f->va[0], &f->va[1], &f->va[2], &f->va[3]);
+   v = c1 + 1;
+   sscanf(v, "%f,%f,%f,%f", &f->vb[0], &f->vb[1], &f->vb[2], &f->vb[3]);
+   for (i = 0; i < g_num_flips; i++)
+      if (!strcmp(g_flips[i].name, f->name) && g_flips[i].id == f->id)
+         return 0;
+   return 1;
+}
+
+/* Exposes the flip table to the NV programmer, which applies it at the start of
+ * each frame (see _mesa_nv_flip_apply_frame): the forced value then holds even if
+ * the game sets that parameter only once.
+ */
+int
+_mesa_nv_flip_count(void)
+{
+   if (!g_num_flips && !getenv("MESA_NV_FLIP"))
+      return 0;
+   if (!g_num_flips && !g_flips[0].name[0])
+      (void) _mesa_nv_param_flip(0, "", 0, NULL);
+   return g_num_flips;
+}
+
+/* nvdbg:begin */
+bool
+_mesa_nv_flip_for_frame(int index, unsigned *id, const char **name,
+                        const float **v)
+{
+   const struct nv_flip *f;
+
+   if (index < 0 || index >= _mesa_nv_flip_count())
+      return false;
+   f = &g_flips[index];
+   if (!((nv_frame_count / f->block) & 1) && !f->has_va)
+      return false;
+   *id = f->id;
+   *name = f->name;
+   *v = ((nv_frame_count / f->block) & 1) ? f->vb : f->va;
+   return true;
+}
+/* nvdbg:end */
+
+bool
+_mesa_nv_param_flip(unsigned id, const char *name, int len, GLfloat *v)
+{
+   static int inited;
+   int i;
+
+   if (!inited) {
+      char buf[512], *save = NULL, *tok;
+      const char *e;
+
+      inited = 1;
+      if ((e = getenv("MESA_NV_FLIP")) && *e) {
+         snprintf(buf, sizeof buf, "%s", e);
+      }
+      if (buf[0]) {
+         for (tok = strtok_r(buf, ";", &save); tok && g_num_flips < 8;
+              tok = strtok_r(NULL, ";", &save)) {
+            if (nv_flip_parse(tok, &g_flips[g_num_flips])) {
+               const struct nv_flip *f = &g_flips[g_num_flips];
+
+               fprintf(stderr, "MESA_NV_FLIP: %s on GL id %u, blocks of %u: "
+                               "%s | (%g, %g, %g, %g)\n", f->name, f->id,
+                       f->block, f->has_va ? "on" : "the value in use",
+                       f->vb[0], f->vb[1], f->vb[2], f->vb[3]);
+               g_num_flips++;
+            }
+         }
+      }
+   }
+
+   for (i = 0; i < g_num_flips; i++) {
+      const struct nv_flip *f = &g_flips[i];
+      const float *src;
+
+      if (f->id != id || (int) strlen(f->name) != len ||
+          strncmp(f->name, name, (size_t) len))
+         continue;
+      if (!v)
+         return true;
+      if ((nv_frame_count / f->block) & 1)
+         src = f->vb;
+      else if (f->has_va)
+         src = f->va;
+      else
+         return false;
+      COPY_4V(v, src);
+      NV_TRACE("override %s su GL id %u -> (%g, %g, %g, %g) frame=%u",
+               f->name, id, src[0], src[1], src[2], src[3], nv_frame_count);
+      return true;
+   }
+   return false;
+}
+
+/* nvdbg:begin */
+/* ------------------------------------------------------------------ */
+/* This is what makes results comparable objectively: from a shell without a
+ * session DBus the screen cannot be captured (x11grab on the Xwayland root gives
+ * black, XGetImage on a GLX window gives BadMatch, spectacle does not start).
+ *
+ * The sampling point is glClear, read BEFORE it clears: at that moment the back
+ * buffer still holds a complete frame.
+ *
+ *   MESA_NV_SHOT=<dir>: enables it (destination directory)
+ *   MESA_NV_SHOT_EVERY=<n>: one frame every n clears (default 60)
+ *   MESA_NV_SHOT_SKIP=<n>: initial clears to ignore (default 120)
+ *   MESA_NV_SHOT_MAX=<k>: maximum number of frames (default 8)
+ */
+void
+_mesa_nv_shot_at(struct gl_context *ctx, bool at_swap)
+{
+   static int inited;
+   static char dir[PATH_MAX];
+   static int every = 60, skip = 120, max_frames = 8, saved;
+   static int t_every_ms, t_skip_ms;
+   static int64_t t_start;
+   const struct gl_framebuffer *fb = ctx->DrawBuffer;
+   unsigned char *buf;
+   FILE *f;
+   char path[PATH_MAX];
+   GLint w, h;
+
+   {
+      const int diag = _mesa_nv_diag_at_swap();   /* 0 clear, 1 swap, 2 both */
+
+      if (at_swap ? diag == 0 : diag == 1)
+         return;
+   }
+
+   if (!inited) {
+      const char *d = getenv("MESA_NV_SHOT");
+      const char *v;
+
+      inited = 1;
+      if (d && *d) {
+         snprintf(dir, sizeof(dir), "%s", d);
+         /* The directory has to be created HERE, not taken for granted. The opposite was measured: a
+                   * perfectly healthy run (zero GL errors, live frames) produced zero screenshots only
+                   * because the screenshot directory had been deleted before launching: the fopen calls
+                   * failed silently, and an A/B would have been left without data, mistakable for a
+                   * regression. */
+         mkdir(dir, 0777); /* already there? not an error, we ignore it */
+      }
+      if ((v = getenv("MESA_NV_SHOT_EVERY")) && *v)
+         every = MAX2(atoi(v), 1);
+      if ((v = getenv("MESA_NV_SHOT_SKIP")) && *v)
+         skip = atoi(v);
+      if ((v = getenv("MESA_NV_SHOT_MAX")) && *v)
+         max_frames = atoi(v);
+      /* MESA_NV_SHOT_TSKIP / MESA_NV_SHOT_TEVERY, in milliseconds: they use time
+       * instead of frame numbers.  Dusk's pace varies a lot (with vsync ~20 fps,
+       * without it up to 144), so frame indices are not portable; time is.
+       */
+      if ((v = getenv("MESA_NV_SHOT_TSKIP")) && *v)
+         t_skip_ms = atoi(v);
+      if ((v = getenv("MESA_NV_SHOT_TEVERY")) && *v)
+         t_every_ms = MAX2(atoi(v), 50);
+   }
+
+   if (!dir[0])
+      return;
+
+   /* Only the visible window is captured: Dusk also renders into a 2048x2048
+    * single-buffered offscreen buffer, which would otherwise be sampled instead of
+    * the right frames.
+    */
+   if (!fb || !fb->Visual.doubleBufferMode)
+      return;
+   if (t_every_ms) {
+      struct timespec ts;
+      int64_t now, then;
+
+      clock_gettime(CLOCK_MONOTONIC, &ts);
+      now = (int64_t) ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+      if (saved >= max_frames)
+         return;
+      if (!t_start)
+         t_start = now;
+      then = t_start + t_skip_ms + (int64_t) saved * t_every_ms;
+      if (now < then)
+         return;
+   } else if (nv_frame_count < skip || saved >= max_frames ||
+              (nv_frame_count - skip) % every) {
+      return;
+   }
+
+   w = fb ? (GLint) fb->Width : 0;
+   h = fb ? (GLint) fb->Height : 0;
+   if (w <= 0 || h <= 0 || w > 8192 || h > 8192)
+      return;
+
+   buf = malloc((size_t) w * h * 4);
+   if (!buf)
+      return;
+
+   {
+      static int reported;
+
+      if (!reported++)
+         fprintf(stderr, "MESA_NV_SHOT: fb=%u %dx%d readFmt=%#x doubleBuf=%d\n",
+                 fb->Name, (int) fb->Width, (int) fb->Height,
+                 (unsigned) (fb->_ColorReadBuffer ? fb->_ColorReadBuffer->Format
+                                                  : 0),
+                 (int) fb->Visual.doubleBufferMode);
+   }
+
+   /* After the swap the back buffer has been reassigned: the complete frame is in
+    * the front (the presented one).
+    *
+    * NOTE about captures: asking for every frame (MESA_NV_SHOT_EVERY=1) about one in
+    * three comes back black from the readback, with a sequence like
+    * "0 16 16 0 16 16 0 17 17 0...".  It is not scene flicker: the exact same
+    * sequence also appears on the proxy path (which uses no combiners at all), so it
+    * is the window system buffer rotation that sometimes makes us read an already
+    * cleared surface.  Compare only the non-black captures.
+    */
+   _mesa_ReadBuffer(nv_diag_readbuffer());
+   _mesa_ReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, buf);
+   _mesa_ReadBuffer(GL_BACK);
+
+   snprintf(path, sizeof(path), "%s/frame_%02d_%dx%d.ppm", dir, saved, (int) w,
+            (int) h);
+   f = fopen(path, "wb");
+   if (f) {
+      GLint y;
+
+      fprintf(f, "P6\n%d %d\n255\n", (int) w, (int) h);
+      /* The readback is RGBA, the PPM wants RGB: the alpha is dropped. */
+      for (y = h; y-- > 0; ) {
+         const unsigned char *src = buf + (size_t) y * w * 4;
+         GLint x;
+
+         for (x = 0; x < w; x++)
+            fwrite(src + (size_t) x * 4, 1, 3, f);
+      }
+      fclose(f);
+      {
+         /* Mean luminance of the capture: correlates the captures with the COMBDRAW
+          * lines (frame N) without re-reading the files.
+          */
+         double sum = 0.0;
+         unsigned n = 0;
+         for (size_t i = 0; i + 3 < (size_t) w * h * 4; i += 4 * 997) {
+            sum += 0.299 * buf[i] + 0.587 * buf[i + 1] + 0.114 * buf[i + 2];
+            n++;
+         }
+         fprintf(stderr, "MESA_NV_SHOT: %s (clear %d mframe=%u fb=%u winsys=%d %dx%d lum=%.1f "
+                         "comb=%d combfail=%d ncomb=%d fp=%u)\n",
+                 path, nv_frame_count, _mesa_nv_frame(), fb->Name,
+                 (int) (fb == ctx->WinSysDrawBuffer), (int) w, (int) h,
+                 n ? sum / n : 0.0, (int) ctx->NV.RegisterCombiners,
+                 (int) ctx->NV.Combiner.GenerationFailed,
+                 ctx->NV.NumGeneralCombiners,
+                 ctx->FragmentProgram._Current ? ctx->FragmentProgram._Current->Id : 0);
+      }
+      fflush(stderr);
+      saved++;
+   }
+   free(buf);
+
+   /* Do not leave errors behind: the game calls glGetError. */
+   while (_mesa_GetError())
+      ;
+}
+/* nvdbg:end */
+
+/* nvdbg:begin */
+/* True if the current fragment program is one of those to trace. */
+bool
+_mesa_nv_trace_selected(struct gl_context *ctx)
+{
+   GLuint id;
+   return nv_trace_program_selected(ctx, &id);
+}
+/* nvdbg:end */
+
+void
+_mesa_nv_trace_attr_type(struct gl_context *ctx, unsigned attr, unsigned type)
+{
+   /* nvdbg:begin */
+   static unsigned long mask;
+   static GLuint last_id = 0xffffffff;
+   GLuint id;
+
+   if (!nv_trace_program_selected(ctx, &id))
+      return;
+
+   if (last_id != id) {
+      last_id = id;
+      mask = 0;
+   }
+   if (attr >= 8 * sizeof(mask))
+      return;
+   if (mask & (1ul << attr))
+      return;
+   mask |= 1ul << attr;
+   fprintf(stderr, "MESA-ATTRTYPE fp=%u attr=%u type=%#x\n", id, attr, type);
+   fflush(stderr);
+   /* nvdbg:end */
+}
+
+void
+_mesa_nv_trace_attr_values(struct gl_context *ctx, unsigned attr, unsigned n,
+                           const double *v)
+{
+   /* nvdbg:begin */
+   static struct {
+      GLuint id;
+      unsigned attr;
+      unsigned long n;
+   } seen[64];
+   static int n_seen;
+   GLuint id;
+
+   if (!nv_trace_program_selected(ctx, &id))
+      return;
+
+   int i;
+   for (i = 0; i < n_seen; i++) {
+      if (seen[i].id == id && seen[i].attr == attr) {
+         if (seen[i].n >= 12)
+            return;
+         seen[i].n++;
+         goto print;
+      }
+   }
+   if (n_seen == (int) (sizeof(seen) / sizeof(seen[0])))
+      return;
+   seen[n_seen].id = id;
+   seen[n_seen].attr = attr;
+   seen[n_seen].n = 1;
+   n_seen++;
+
+print:
+   fprintf(stderr, "MESA-ATTR fp=%u attr=%u n=%u v=(%g, %g, %g, %g)\n", id,
+           attr, n, v[0], v[1], v[2], v[3]);
+   fflush(stderr);
+   /* nvdbg:end */
+}
+
+/* nvdbg:begin */
+/* nvdbg:begin */
+/* Diagnostics: the "once only" dump of the original version always landed on the FIRST
+ * sighting of the texture. For tex77 (the god-ray wrap result) the first sighting coincides
+ * with the composite's first draw, which also happens with the rays OFF: the dump showed an
+ * empty texture and the measurement was useless. SKIP skips the first N sightings, EVERY
+ * dumps one per EVERY (the file name carries the sighting number). */
+static unsigned nv_dump_skip = 0, nv_dump_each = 1;
+static unsigned nv_dump_view = 0;
+/* nvdbg:end */
+
+/* MESA_NV_DUMP_TEX="29,57" (texture names, or "all"): writes level 0 of the
+ * textures seen in the traced draws as PPM.  Separates "what the texture contains
+ * in the GPU" from "what the program reads".
+ */
+static void
+nv_dump_tex_image(struct gl_context *ctx, struct gl_texture_object *t)
+{
+   static int inited;
+   static unsigned want[16];
+   static int n_want, dumped[16], n_dumped;
+   static char dir[PATH_MAX];
+   struct gl_texture_image *ti;
+   GLubyte *src = NULL;
+   GLfloat *fbuf = NULL;
+   GLint rowstride = 0, w, h, i;
+   mesa_format srcf;
+   char path[PATH_MAX];
+   FILE *f;
+
+   if (!inited) {
+      const char *e = getenv("MESA_NV_DUMP_TEX");
+      const char *d = getenv("MESA_NV_SHOT");
+      char buf[256], *save = NULL, *tok;
+
+      inited = 1;
+      if (!e || !*e || !d || !*d)
+         return;
+      snprintf(dir, sizeof dir, "%s", d);
+      snprintf(buf, sizeof buf, "%s", e);
+      const char *sk = getenv("MESA_NV_DUMP_TEX_SKIP");
+      const char *ev = getenv("MESA_NV_DUMP_TEX_EVERY");
+      nv_dump_skip = sk ? (unsigned) strtoul(sk, NULL, 0) : 0;
+      nv_dump_each = ev ? (unsigned) strtoul(ev, NULL, 0) : 1;
+      if (nv_dump_each == 0) nv_dump_each = 1;
+      for (tok = strtok_r(buf, ", ", &save); tok && n_want < 16;
+           tok = strtok_r(NULL, ", ", &save)) {
+         if (!strcmp(tok, "all")) {
+            want[n_want++] = 0;
+            continue;
+         }
+         want[n_want++] = (unsigned) strtoul(tok, NULL, 10);
+      }
+   }
+   if (!n_want)
+      return;
+
+   {
+      int match = 0;
+      for (i = 0; i < n_want; i++) {
+         if (!want[i] || want[i] == t->Name) {
+            match = 1;
+            break;
+         }
+      }
+      if (!match)
+         return;
+   }
+   {
+      static struct { int obj_name; unsigned seen_cnt; } seen_tbl[16];
+      static int seen_n = 0;
+      int idx = -1;
+      for (i = 0; i < seen_n; i++)
+         if (seen_tbl[i].obj_name == (int) t->Name) { idx = i; break; }
+      if (idx < 0 && seen_n < 16) {
+         idx = seen_n;
+         seen_tbl[seen_n++].obj_name = (int) t->Name;
+      }
+      if (idx < 0)
+         return;
+      seen_tbl[idx].seen_cnt++;
+      if (seen_tbl[idx].seen_cnt <= nv_dump_skip)
+         return;
+      if (nv_dump_each > 1 && (seen_tbl[idx].seen_cnt % nv_dump_each) != 0)
+         return;
+      if (n_dumped == 16)
+         return;
+      dumped[n_dumped++] = (int) t->Name;
+      nv_dump_view = seen_tbl[idx].seen_cnt;
+   }
+
+   ti = t->Image[0][0];
+   if (!ti)
+      return;
+   w = ti->Width, h = ti->Height;
+   if (w <= 0 || h <= 0 || w > 4096 || h > 4096)
+      return;
+
+   st_MapTextureImage(ctx, ti, 0, 0, 0, w, h, GL_MAP_READ_BIT, &src, &rowstride);
+   if (!src) {
+      fprintf(stderr, "MESA-NV dump tex %u: map failed\n", t->Name);
+      return;
+   }
+   srcf = ti->TexFormat;
+   fbuf = malloc((size_t) w * h * 4 * sizeof *fbuf);
+   if (fbuf) {
+      if (_mesa_is_format_compressed(srcf)) {
+         _mesa_decompress_image(srcf, w, h, src, rowstride, fbuf);
+      } else {
+         _mesa_format_convert(fbuf, MESA_FORMAT_RGBA_FLOAT32, w * 4 * sizeof(GLfloat),
+                              src, srcf, rowstride, w, h, NULL);
+      }
+   }
+   st_UnmapTextureImage(ctx, ti, 0);
+
+   if (!fbuf)
+      return;
+
+   {
+      const bool sgn = _mesa_is_format_signed(srcf);
+      double sum[3] = { 0, 0, 0 }, sq[3] = { 0, 0, 0 };
+
+      for (int j = 0; j < w * h; j++) {
+         for (int c = 0; c < 3; c++) {
+            double v = fbuf[j * 4 + c];
+
+            sum[c] += v;
+            sq[c] += v * v;
+         }
+      }
+      fprintf(stderr, "MESA-NV dump tex %u fmt=%s signed=%d "
+                      "first texel R: %.4f %.4f %.4f\n",
+              t->Name, _mesa_get_format_name(srcf), (int) sgn,
+              fbuf[0], fbuf[4], fbuf[8]);
+      fprintf(stderr, "MESA-NV dump tex %u fmt=%#x signed=%d: "
+                      "R %.4f+-%.4f G %.4f+-%.4f B %.4f+-%.4f\n", t->Name,
+              (unsigned) srcf, (int) sgn,
+              sum[0] / (w * h), sqrt(sq[0] / (w * h) - (sum[0] / (w * h)) * (sum[0] / (w * h))),
+              sum[1] / (w * h), sqrt(sq[1] / (w * h) - (sum[1] / (w * h)) * (sum[1] / (w * h))),
+              sum[2] / (w * h), sqrt(sq[2] / (w * h) - (sum[2] / (w * h)) * (sum[2] / (w * h))));
+
+      snprintf(path, sizeof path, "%s/tex_%u_v%u_%dx%d.ppm", dir, t->Name, nv_dump_view, w, h);
+      f = fopen(path, "wb");
+      if (f) {
+         fprintf(f, "P6\n%d %d\n255\n", w, h);
+         for (int y = 0; y < h; y++) {
+            for (int x = 0; x < w; x++) {
+               const float *px = fbuf + ((size_t) y * w + x) * 4;
+
+               for (int c = 0; c < 3; c++) {
+                  double v = px[c];
+
+                  if (sgn)
+                     v = v * 0.5 + 0.5;   /* remaps [-1,1] to [0,1] for the comparison with the original files */
+                  fputc(v <= 0.0 ? 0 : (v >= 1.0 ? 255 : (int) (v * 255.0 + 0.5)), f);
+               }
+            }
+         }
+         fclose(f);
+         fprintf(stderr, "MESA-NV dump tex %u (fmt %#x, %dx%d) -> %s\n", t->Name,
+                 (unsigned) srcf, w, h, path);
+      }
+   }
+
+}
+/* nvdbg:end */
+
