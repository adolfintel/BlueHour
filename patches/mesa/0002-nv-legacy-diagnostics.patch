+
+/* Monotonic trace of fixed-function state changes: no state writing, printing only. Used to
+ * see WHAT the demo and the reference set before the passes that produce no fragments. */
+void
+_mesa_nv_state(const char *fmt, ...)
+{
+   static int is_active = -1;
+   static unsigned shown_n = 0, line_limit = 0;
+   va_list ap;
+
+   if (is_active < 0) {
+      const char *v = getenv("MESA_NV_TRACE_STATE_MAX");
+      is_active = getenv("MESA_NV_TRACE_STATE") != NULL;
+      line_limit = v ? (unsigned) strtoul(v, NULL, 0) : 8000;
+   }
+   if (!is_active || shown_n >= line_limit)
+      return;
+   shown_n++;
+   fprintf(stderr, "MESA-NV STATE frame=%u ", _mesa_nv_frame());
+   va_start(ap, fmt);
+   vfprintf(stderr, fmt, ap);
+   va_end(ap);
+   fprintf(stderr, "\n");
+}
