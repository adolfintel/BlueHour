+static void
+nv_texwatch(struct gl_context *ctx)
+{
+/* MESA_NV_TEXWATCH=<name>[,<name>...]: at the start of each frame reads the level 0 of the
+     * given textures and prints the average luminance. Done here because it is a safe point: the
+     * same readback inside a draw confuses the application (the Time Machine demo stopped on the
+     * first frame).
+     */
+    {
+       const char *w = getenv("MESA_NV_TEXWATCH");
+
+       if (w != NULL && *w != 0) {
+          char wbuf[128];
+          snprintf(wbuf, sizeof(wbuf), "%s", w);
+          for (char *tok = strtok(wbuf, ","); tok; tok = strtok(NULL, ",")) {
+             const GLuint nw = (GLuint) atoi(tok);
+             struct gl_texture_object *wt = _mesa_lookup_texture(ctx, nw);
+             struct gl_texture_image *wi = wt ? wt->Image[0][0] : NULL;
+             const int every = getenv("MESA_NV_TEXWATCH_EVERY") != NULL ?
+                atoi(getenv("MESA_NV_TEXWATCH_EVERY")) : 1;
+
+             if (wi == NULL || (int) nv_frame_count % (every < 1 ? 1 : every) != 0)
+                continue;
+             const unsigned long nn =
+                (unsigned long) wi->Width * (unsigned long) wi->Height;
+             if (nn == 0 || nn > nv_readback_maxpx(4u * 1024u * 1024u))
+                continue;
+             const GLenum wbase = _mesa_get_format_base_format(wi->TexFormat);
+             const bool wdepth = wbase == GL_DEPTH_COMPONENT ||
+                                 wbase == GL_DEPTH_STENCIL;
+             const GLenum wfmt = wdepth ? GL_DEPTH_COMPONENT : GL_RGBA;
+             unsigned char *wp = calloc(nn * (wdepth ? 4 : 4), 1);
+             if (wp == NULL)
+                continue;
+             /* GL_FLOAT is only valid for depth: colour needs UNSIGNED_BYTE, otherwise the readback
+                           * writes 16 bytes per texel into a 4-byte buffer and the averages read here
+                           * are garbage.
+                           */
+             const GLenum wtype = wdepth ? GL_FLOAT : GL_UNSIGNED_BYTE;
+             /* Cube maps are read face by face (MESA_NV_TEXWATCH_FACE=0..5, default 0):
+                           * GL_TEXTURE_CUBE_MAP by itself is not a valid target for glGetTexImage.
+                           */
+             GLenum wtgt = wt->Target;
+             if (wtgt == GL_TEXTURE_CUBE_MAP) {
+                static int wface = -1;
+                if (wface < 0) {
+                   const char *e = getenv("MESA_NV_TEXWATCH_FACE");
+                   wface = e ? CLAMP(atoi(e), 0, 5) : 0;
+                }
+                wtgt = (GLenum) (GL_TEXTURE_CUBE_MAP_POSITIVE_X + wface);
+             }
+             const int wti = _mesa_tex_target_to_index(ctx, wt->Target);
+             struct gl_texture_object *wsave = wti >= 0 ?
+                ctx->Texture.Unit[0].CurrentTex[wti] : NULL;
+             if (wti >= 0)
+                ctx->Texture.Unit[0].CurrentTex[wti] = wt;
+             _mesa_GetTexImage(wtgt, 0, wfmt, wtype, wp);
+             if (wti >= 0)
+                ctx->Texture.Unit[0].CurrentTex[wti] = wsave;
+
+             unsigned long wsum = 0, wbright = 0;
+             double wmin = 1e30, wmax = -1e30;
+             if (wdepth) {
+                const float *fp0 = (const float *) (const void *) wp;
+                double acc = 0.0;
+                for (unsigned long q = 0; q < nn; q++) {
+                   const float v = fp0[q];
+                   acc += v;
+                   if (v < wmin) wmin = v;
+                   if (v > wmax) wmax = v;
+                   if (v > 0.999)
+                      wbright++;
+                }
+                /* 32-bin histogram over the real range: tells us whether the shadow map holds a constant
+                                 * depth (a single surface, so no silhouette possible) or a varied
+                                 * distribution.
+                                 */
+                {
+                   unsigned hb[32];
+                   const double rng = wmax > wmin ? wmax - wmin : 1.0;
+                   memset(hb, 0, sizeof(hb));
+                   for (unsigned long q = 0; q < nn; q++) {
+                      int b = (int) ((fp0[q] - wmin) / rng * 31.0);
+                      if (b < 0) b = 0;
+                      if (b > 31) b = 31;
+                      hb[b]++;
+                   }
+                   fprintf(stderr, "MESA-NV TEXWATCH-IST frame=%u tex=%u bin:",
+                           nv_frame_count - 1, nw);
+                   for (unsigned b = 0; b < 32; b++) {
+                      if (hb[b])
+                         fprintf(stderr, " %.1f%%", 100.0 * (double) hb[b] / (double) nn);
+                      else
+                         fprintf(stderr, " .");
+                   }
+                   fprintf(stderr, "\n");
+                }
+                fprintf(stderr,
+                        "MESA-NV TEXWATCH frame=%u tex=%u obj=%p DEPTH %dx%d "
+                        "min=%.5f max=%.5f average=%.5f above-0.999=%.1f%% err=%#x\n",
+                        nv_frame_count - 1, nw, (void *) wt, wi->Width, wi->Height,
+                        wmin, wmax, acc / (double) nn,
+                        100.0 * (double) wbright / (double) nn,
+                        (unsigned) ctx->ErrorValue);
+                /* Depth textures are exported in greyscale normalised over the real range: without this
+                                 * the shadow map (0.967..1.0) would look like a uniform white and we
+                                 * could not tell whether the prepass really holds the scene's
+                                 * silhouette.
+                                 */
+                {
+                   const char *sv = getenv("MESA_NV_TEXWATCH_SAVE");
+                   if (sv != NULL && *sv != 0) {
+                      char sp[512];
+                      snprintf(sp, sizeof(sp), "%s/texwatch_%u_f%u_%dx%d_depth.pgm",
+                               sv, nw, nv_frame_count - 1, wi->Width, wi->Height);
+                      FILE *sf = fopen(sp, "wb");
+                      if (sf != NULL) {
+                         const double rng = wmax > wmin ? wmax - wmin : 1.0;
+                         unsigned char *g = malloc(nn);
+                         if (g != NULL) {
+                            const float *fq = (const float *) (const void *) wp;
+                            for (unsigned long q = 0; q < nn; q++) {
+                               double t = (fq[q] - wmin) / rng;
+                               g[q] = (unsigned char) (t < 0 ? 0 : (t > 1 ? 255 : t * 255.0));
+                            }
+                            fprintf(sf, "P5\n%d %d\n255\n", wi->Width, wi->Height);
+                            fwrite(g, 1, nn, sf);
+                            free(g);
+                         }
+                         fclose(sf);
+                      }
+                   }
+                }
+                free(wp);
+                continue;
+             }
+             for (unsigned long q = 0; q < nn; q++) {
+                const unsigned l = (wp[4 * q] + wp[4 * q + 1] + wp[4 * q + 2]) / 3;
+                wsum += l;
+                if (l > 128)
+                   wbright++;
+             }
+             {
+                const char *sv = getenv("MESA_NV_TEXWATCH_SAVE");
+                if (sv != NULL && *sv != 0) {
+                   char sp[512];
+                   snprintf(sp, sizeof(sp), "%s/texwatch_%u_f%u_%dx%d.ppm", sv, nw,
+                            nv_frame_count - 1, wi->Width, wi->Height);
+                   FILE *sf = fopen(sp, "wb");
+                   if (sf != NULL) {
+                      fprintf(sf, "P6\n%d %d\n255\n", wi->Width, wi->Height);
+                      for (unsigned yy = 0; yy < wi->Height; yy++)
+                         fwrite(wp + 4 * (size_t) yy * wi->Width, 3, wi->Width, sf);
+                      fclose(sf);
+                   }
+                }
+             }
+             fprintf(stderr,
+                     "MESA-NV TEXWATCH frame=%u tex=%u obj=%p %dx%d fmt=#x%x pt=%p "
+                     "average=%.1f bright=%.1f%% err=%#x\n",
+                     nv_frame_count - 1, nw, (void *) wt, wi->Width, wi->Height,
+                     (unsigned) wi->TexFormat, (void *) wi->pt,
+                     (double) wsum / (double) nn,
+                     100.0 * (double) wbright / (double) nn,
+                     (unsigned) ctx->ErrorValue);
+             fflush(stderr);
+             free(wp);
+          }
+       }
+    }
+
+    /* MESA_NV_TEXWATCH_FLOAT=<id[,id...]>: floating-point statistics of level 0 of the given
+         * textures. Needed for RTT textures: values above 1.0 (or below 0.0) explain the saturations
+         * of the composite pass, and they tell an empty texture from a full one outside scale.
+         */
+    {
+       const char *w = getenv("MESA_NV_TEXWATCH_FLOAT");
+
+       if (w != NULL && *w != 0) {
+          char wbuf[128];
+          snprintf(wbuf, sizeof(wbuf), "%s", w);
+          for (char *tok = strtok(wbuf, ","); tok; tok = strtok(NULL, ",")) {
+             const GLuint nw = (GLuint) atoi(tok);
+             struct gl_texture_object *wt = _mesa_lookup_texture(ctx, nw);
+             struct gl_texture_image *wi = wt ? wt->Image[0][0] : NULL;
+
+             if (wi == NULL)
+                continue;
+             const unsigned long nn =
+                (unsigned long) wi->Width * (unsigned long) wi->Height;
+             if (nn == 0 || nn > nv_readback_maxpx(8u * 1024u * 1024u))
+                continue;
+
+             float *fp = calloc(nn * 4, sizeof(float));
+             if (fp == NULL)
+                continue;
+
+             const GLenum wtarget = wt->Target == GL_TEXTURE_CUBE_MAP ?
+                                       GL_TEXTURE_CUBE_MAP_POSITIVE_X : wt->Target;
+            _mesa_error(ctx, GL_NO_ERROR, "nv texwatch float");
+            _mesa_GetTexImage(wtarget, 0, GL_RGBA, GL_FLOAT, fp);
+
+            double sum = 0.0, mn = 1e30, mx = -1e30;
+            unsigned long n1 = 0, nhalf = 0, nzero = 0, nneg = 0;
+            double p[8] = {0};
+
+            for (unsigned long q = 0; q < nn; q++) {
+               const float *c = fp + 4 * q;
+
+               for (int k = 0; k < 3; k++) {
+                  const float v = c[k];
+
+                  if (v < mn) mn = v;
+                  if (v > mx) mx = v;
+                  sum += v;
+                  if (v <= 0.0f) nzero++;
+                  if (v < 0.0f) nneg++;
+                  if (v > 1.0f) n1++;
+                  if (v > 0.5f) nhalf++;
+                  if (v > 0.0f) p[MIN2((int)(v * 4.0f), 3)] += 1.0;
+               }
+            }
+
+            fprintf(stderr,
+                    "MESA_NV_TEXWATCH_FLOAT frame=%u tex=%u %dx%d fmt=#x%x "
+                    "min=%.4g max=%.4g average=%.4g | px channel: <=0 %.1f%%  >0.5 %.1f%%  >1 %.1f%% "
+                    "| bands (0-.25 .25-.5 .5-1 >1): %.1f %.1f %.1f %.1f%%\n",
+                    nv_frame_count - 1, nw, wi->Width, wi->Height,
+                    (unsigned) wi->TexFormat, mn, mx, sum / (3.0 * (double) nn),
+                    100.0 * (double) nzero / (3.0 * (double) nn),
+                    100.0 * (double) nhalf / (3.0 * (double) nn),
+                    100.0 * (double) n1 / (3.0 * (double) nn),
+                    100.0 * p[0] / (3.0 * (double) nn),
+                    100.0 * p[1] / (3.0 * (double) nn),
+                    100.0 * p[2] / (3.0 * (double) nn),
+                    100.0 * p[3] / (3.0 * (double) nn));
+            fflush(stderr);
+            free(fp);
+          }
+       }
+    }
+}
+/* nvdbg:end */
