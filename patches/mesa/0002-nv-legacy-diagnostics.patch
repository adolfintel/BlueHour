+                     ctx->ErrorValue = pre;
+                     for (unsigned qe = 0; qe < w * h; qe++) {
+                        for (unsigned qc = 0; qc < 4u; qc++) {
+                           const unsigned char v = pxface[4u * qe + qc];
+                           media[qc] += (double) v / 255.0;
+                           if (v != 0u)
+                              nz[qc]++;
+                        }
+                     }
+                     for (unsigned qc = 0; qc < 4u; qc++)
+                        media[qc] /= (double) (w * h);
+                     if (dircol != NULL && *dircol != 0 && nv_dtx_face_files < 720u &&
+                         nv_dtx_face_next >= 0 &&
+                         (long) nv_dtx_ticks >= nv_dtx_face_from &&
+                         (long) nv_dtx_ticks >= nv_dtx_face_next) {
+                        char img_path[512];
+                        FILE *fh;
+                        snprintf(img_path, sizeof(img_path), "%s/face-o%lx-t%u-%ux%u-%x.pam",
+                                 dircol, (unsigned long) (uintptr_t) tobj, dname, w, h,
+                                 (unsigned) nv_faces[qf]);
+                        fh = fopen(img_path, "wb");
+                        if (fh != NULL) {
+                           fprintf(fh, "P7\nWIDTH %u\nHEIGHT %u\nDEPTH 4\nMAXVAL 255\n"
+                                       "TUPLTYPE RGB_ALPHA\nENDHDR\n", w, h);
+                           for (unsigned qe = 0; qe < w * h; qe++)
+                              for (unsigned qc = 0; qc < 4u; qc++)
+                                 fputc(pxface[4u * qe + qc], fh);
+                           fclose(fh);
+                           nv_dtx_face_files++;
+                           if (nv_dtx_face_slot < nv_dtx_face_last_n)
+                              nv_dtx_face_last[nv_dtx_face_slot].tick =
+                                 (long) nv_dtx_ticks;
+                        }
+                     }
+                  }
+                  fprintf(stderr,
+                          "MESA-NV DTX-FACE frame=%u obj=%p tex=%u %ux%u face=#x%x status=#x%x err=#x%x"
+                          " mean=%.4f/%.4f/%.4f/%.4f nonzero%%=%.1f/%.1f/%.1f/%.1f\n",
