+/* MESA_NV_TRACE_CLIENCALL=1: does the app use glLockArraysEXT / touch the
+ * array pointers at every draw? kind: 0=Lock 1=Unlock 2=VertexPointer 3=EnableCS 4=DisableCS */
+void
+_mesa_nv_note_clientcall(int kind)
+{
+   static int cached = -1;
+   static unsigned c[5];
+   static const char *nm[5] = { "lock", "unlock", "vptr", "enableCS", "disableCS" };
+
+   if (cached < 0)
+      cached = getenv("MESA_NV_TRACE_CLIENCALL") != NULL;
+   if (!cached)
+      return;
+
+   c[kind]++;
+   unsigned tot = c[0]+c[1]+c[2]+c[3]+c[4];
+   if (tot % 500 == 0) {
+      fprintf(stderr, "MESA-NV CLIENCALL");
+      for (int i = 0; i < 5; i++) fprintf(stderr, " %s=%u", nm[i], c[i]);
+      fprintf(stderr, "\n");
+      fflush(stderr);
+   }
+}
