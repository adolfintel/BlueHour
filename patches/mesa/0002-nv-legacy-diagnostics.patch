+ * allocate hundreds of megabytes by accident. It also silently discarded the one object that
+ * mattered on Mad Mod Mike: the hard-shadow store is a 3072x2048 depth render-texture
+ * (6291456 pixels), and the old 4 Mi-pixel limit skipped it, so the store could never be
+ * measured. Raising the ceiling is a deliberate act by whoever runs the diagnostic. */
+static unsigned long
+nv_readback_maxpx(unsigned long def)
+{
+   const char *e = getenv("MESA_NV_READBACK_MAXPX");
+
+   return (e != NULL && *e != 0) ? (unsigned long) strtoul(e, NULL, 0) : def;
+}
