+          * ReadPixels with format GL_DEPTH_COMPONENT from the read FBO is the valid path. The
+          * values land in a float buffer, and the byte buffer used by the statistics is filled
+          * from them, so the census keeps its meaning (and gets a new "via" label). */
+         static float *depth_floats;
+         static unsigned depth_floats_cap;
+
+         if (depth_floats_cap < (unsigned) w * h) {
+            free(depth_floats);
+            depth_floats = malloc((size_t) w * h * sizeof(float));
+            depth_floats_cap = depth_floats ? (unsigned) w * h : 0;
+         } else
