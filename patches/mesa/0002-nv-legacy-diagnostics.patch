+                                           0, 0, (GLsizei) w, (GLsizei) h,
+                                           GL_COLOR_BUFFER_BIT, GL_NEAREST);
+                     _mesa_BindFramebuffer(GL_READ_FRAMEBUFFER, fb[1]);
+                     _mesa_ReadPixels(0, 0, (GLsizei) w, (GLsizei) h, GL_RGBA,
