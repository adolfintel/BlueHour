+/* nvdbg:begin */
+/* MESA_NV_TRACE_FBSIZE=<frames>: every N frames prints the census of the buffers the draws
+ * are issued on (size, FBO name, depth bits). In the reference the 512x512 render targets
+ * appear in the draws ONLY when the effect is active (measured on the traces: draws with a
+ * 512x512 viewport 17 vs 0 between ON and OFF, for both soft shadows and god rays): if such
+ * a size never shows up on our side, that pass does not render into the pbuffer.
+ * MESA_NV_TRACE_FBSIZE_RESET=1 zeroes the counter after each print (useful to compare
+ * before/after a toggle in the same run). */
+#define NV_FB_KEYS 192
+static struct nv_fb_key {
+   char key[128];
+   unsigned n;
+} nv_fb_tab[NV_FB_KEYS];
+static unsigned nv_fb_n;
+static unsigned nv_fb_reported_frame;
+
+/* nvdbg:begin */
+/* Per framebuffer: stable index, last fragment program that drew into it, draw count and
+ * dimensions. Used to read the buffers content at glClear (see MESA_NV_DUMP_FB): reading
+ * inside the draw would break the state tracker's invariants, a lesson already learned with
+ * MESA_NV_DUMP_DEPTHTEX. */
+struct nv_fb_of_rec {
+   const void *fb;
+   unsigned idx;
+   GLuint last_fp;
+   unsigned drawn;
+   unsigned w, h;
+   unsigned dumped_frame;
+};
+static struct nv_fb_of_rec nv_fb_of[NV_FB_KEYS];
+static unsigned nv_fb_of_n;
+
+/* Given a framebuffer pointer, the same small number the CONTENT-FB lines print as fb#=. The
+ * census of the draws labels framebuffers by their object name instead, and that name is 0 for
+ * every pbuffer and for the window: Mad Mod Mike has 15 of its 17 framebuffers all named 0, so
+ * the two censuses could not be matched and a pass writing into one object was read as if it
+ * wrote into another. Returns 0 for a framebuffer the registry has not seen yet. */
+static unsigned
+nv_fb_slot_of(const struct gl_framebuffer *fb)
+{
+   unsigned k;
+
+   for (k = 0; k < nv_fb_of_n; k++)
+      if (nv_fb_of[k].fb == (const void *) fb)
+         return nv_fb_of[k].idx;
+   return 0;
+}
+
+/* MESA_NV_DUMP_FB_IMAGES_SIZES=<LargexAltezza[,...]|all>: asks whether a framebuffer
+ * size should get an image dump.  A helper because the colour pass and the depth pass
+ * of one and the same framebuffer have to agree on the answer.  The word "all" still
+ * refuses more than 4096x4096, so a stray huge surface cannot freeze the run. */
+static bool
+nv_fb_image_size_asked(const char *items, unsigned w, unsigned h)
+{
+   if (items == NULL || *items == 0)
+      return false;
+   if (!strcmp(items, "all"))
+      return (unsigned long long) w * h <= 4096ull * 4096ull;
+   while (*items != 0) {
+      unsigned sw = 0, sh = 0;
+      const char *p = items;
+
+      while (*p >= '0' && *p <= '9')
+         sw = sw * 10u + (unsigned) (*p++ - '0');
+      if (*p != 'x')
+         break;
+      ++p;
+      while (*p >= '0' && *p <= '9')
+         sh = sh * 10u + (unsigned) (*p++ - '0');
+      if (sw == w && sh == h)
+         return true;
+      if (*p != ',')
+         break;
+      items = p + 1;
+   }
+   return false;
+}
+/* nvdbg:end */
+
+void
+_mesa_nv_note_fb(struct gl_context *ctx)
+{
+   /* the redirect must happen before any printing gate, because it is not diagnostics: without
+       * it here the luminance chain's draws land on RGBA8 and the scales are truncated to 1.0. */
+   nv_shadow_enable_draw(ctx);
+
+   static int on = -1;
+   static int every = -1, reset = -1;
+   unsigned frame;
+   char key[128];
+   unsigned i;
+   const struct gl_framebuffer *fb = ctx->DrawBuffer;
+   GLuint fpid = ctx->FragmentProgram._Current ? ctx->FragmentProgram._Current->Id : 0;
+   GLuint vpid = ctx->VertexProgram._Current ? ctx->VertexProgram._Current->Id : 0;
+
+   if (on < 0) {
+      const char *e = getenv("MESA_NV_TRACE_FBSIZE");
+      on = (e != NULL);
+      every = (on && atoi(e) > 0) ? (unsigned) atoi(e) : 60;
+      reset = (getenv("MESA_NV_TRACE_FBSIZE_RESET") != NULL);
+   }
+   if (!on || fb == NULL)
+      return;
+
+   /* The framebuffer name is useless: for GLX drawables (Wine's pbuffers) it is always 0. We
+       * use the POINTER of the gl_framebuffer object: every GLX drawable has its own, so we tell apart
+       * different pbuffers of the SAME size (in the reference the six 512x512 colour pbuffers all
+       * receive draws, while on our side two come out empty on re-reading). The bound programs are
+       * printed too, so the shader writing into that buffer is visible. */
+   /* A running index for distinct framebuffers, in the order we first see them. It connects
+       * the two sides: Wine numbers the pbuffers in wglCreatePbufferARB order and knows which texture
+       * it binds them to, here we know which programs draw into each drawable. The framebuffer name
+       * cannot be the key because for GLX drawables it is always 0. */
+   static unsigned fb_seq;
+   static const void *fb_ptr[NV_FB_KEYS];
+   static unsigned fb_idx[NV_FB_KEYS];
+   unsigned slot_idx = 0;
+   for (i = 0; i < nv_fb_n; i++) {
+      if (fb_ptr[i] == (const void *) fb) { slot_idx = fb_idx[i]; break; }
+      if (i == nv_fb_n - 1 && nv_fb_n < NV_FB_KEYS) { }
+   }
+   if (slot_idx == 0) {
+      unsigned k;
+      for (k = 0; k < nv_fb_n; k++)
+         if (fb_ptr[k] == (const void *) fb) break;
+      if (k == nv_fb_n && nv_fb_n < NV_FB_KEYS) {
+         fb_ptr[nv_fb_n] = (const void *) fb;
+         fb_idx[nv_fb_n] = ++fb_seq;
+         slot_idx = fb_seq;
+      }
+   }
+   snprintf(key, sizeof(key),
+            "fb=%p fb#%u obj_name=%u %ux%u rgb=%u%u%u%u depth=%u fp=%u vp=%u "
+            "port=(%.0f,%.0f %.0fx%.0f) scissor=%d(%.0f,%.0f %.0fx%.0f)",
+            (void *) fb, slot_idx, (unsigned) fb->Name,
+            (unsigned) fb->Width, (unsigned) fb->Height,
+            (unsigned) fb->Visual.redBits, (unsigned) fb->Visual.greenBits,
+            (unsigned) fb->Visual.blueBits, (unsigned) fb->Visual.alphaBits,
+            (unsigned) fb->Visual.depthBits, fpid, vpid,
+            (double) ctx->ViewportArray[0].X, (double) ctx->ViewportArray[0].Y,
+            (double) ctx->ViewportArray[0].Width, (double) ctx->ViewportArray[0].Height,
+            (int) ((ctx->Scissor.EnableFlags & 1u) != 0),
+            (double) ctx->Scissor.ScissorArray[0].X, (double) ctx->Scissor.ScissorArray[0].Y,
+            (double) ctx->Scissor.ScissorArray[0].Width,
+            (double) ctx->Scissor.ScissorArray[0].Height);
+
+   /* nvdbg:begin */
+   {
+      unsigned k2;
+      for (k2 = 0; k2 < nv_fb_of_n; k2++)
+         if (nv_fb_of[k2].fb == (const void *) fb)
+            break;
+      if (k2 == nv_fb_of_n && nv_fb_of_n < NV_FB_KEYS) {
+         nv_fb_of[nv_fb_of_n].fb = (const void *) fb;
+         nv_fb_of[nv_fb_of_n].idx = slot_idx;
+         nv_fb_of_n++;
+      }
+      if (k2 < nv_fb_of_n) {
+         nv_fb_of[k2].last_fp = fpid;
+         nv_fb_of[k2].drawn++;
+         nv_fb_of[k2].w = (unsigned) fb->Width;
+         nv_fb_of[k2].h = (unsigned) fb->Height;
+      }
+   }
+   /* nvdbg:end */
+
+   for (i = 0; i < nv_fb_n; i++) {
+      if (strcmp(nv_fb_tab[i].key, key) == 0) {
+         nv_fb_tab[i].n++;
+         break;
+      }
+   }
+   if (i == NV_FB_KEYS)
+      return;
+   if (i == nv_fb_n) {
+      strncpy(nv_fb_tab[i].key, key, sizeof(key) - 1);
+      nv_fb_tab[i].key[sizeof(key) - 1] = 0;
+      nv_fb_tab[i].n = 1;
+      nv_fb_n++;
+   }
+
+   frame = _mesa_nv_frame();
+   if (frame == 0 || frame - nv_fb_reported_frame < every)
+      return;
+   nv_fb_reported_frame = frame;
+
+   fprintf(stderr, "MESA-NV CENSUS-FB frame=%u keys=%u\n", frame, nv_fb_n);
+   for (i = 0; i < nv_fb_n; i++)
+      fprintf(stderr, "   %-100s draws=%u\n", nv_fb_tab[i].key, nv_fb_tab[i].n);
+   fflush(stderr);
+   if (reset)
+      nv_fb_n = 0;
+}
+/* nvdbg:end */
