+/* nvdbg:begin */
+/**< Buffer to read for the per-frame diagnostics: at swapbuffers the finished
+ * frame is in the back buffer (the DRI front is a separate surface, sometimes
+ * already invalidated); on clear the front can be used. */
+static GLenum
+nv_diag_readbuffer(void)
+{
+   const char *rb = getenv("MESA_NV_SHOT_READBACK");
+
+   if (rb && !strcmp(rb, "front"))
+      return GL_FRONT;
+   /* nvdbg:begin */
+   if (_mesa_nv_diag_at_swap() == 1)
+      return GL_BACK;
+      /* nvdbg:end */
+   if (rb && !strcmp(rb, "back"))
+      return GL_BACK;
