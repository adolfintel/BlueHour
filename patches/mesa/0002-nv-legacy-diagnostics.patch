+             struct nv_dtx_cface_written { const void *obj; long tick; };
+             static struct nv_dtx_cface_written nv_dtx_face_last[16];
+             static unsigned nv_dtx_face_last_n;
+             unsigned nv_dtx_face_slot = 0;
+             long nv_dtx_face_next = 0;
+            /* Identity, not just the name: texture names are recycled, so a census line with
