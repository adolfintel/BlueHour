+   /* The queue of attachments holds the render textures of the pbuffers - on Mad Mod
+    * Mike the two 428x268 stores of the bright copy. Forcing the sampling swizzle here
+    * is what makes those objects readable as an experiment: reading them back is not
+    * evidence, because a texture whose content arrived through a copy reads as zero in
+    * this driver (see the depth-upload note in st_cb_texture.c). */
+   {
+      unsigned k;
+      for (k = 0; k < nv_dtx_n; k++) {
+         if (nv_dtx_tab[k].owner == ctx && nv_dtx_tab[k].obj != NULL)
+            _mesa_nv_swizzle_apply(ctx, (struct gl_texture_object *) nv_dtx_tab[k].obj,
+                                   "queue-attachment");
+      }
+   }
+
+   /* A probe that has gone mute must not be mistaken for a measurement. When dump directories
+    * were asked for but no file has ever been written, and plenty of ticks have gone by, the
+    * tool says so once and out loud. Measured on Mad Mod Mike: the very invocation of
+    * MESA_NV_DUMP_DEPTHTEX that produced sixty files at 13:10 produced none later in the same
+    * day, while the run itself stayed healthy (524 swaps, zero falls). The silence of the tool
+    * cost an hour of reading absent data, so the silence now announces itself. */
+   {
+      static bool nv_dtx_silence_announced;
+      if (!nv_dtx_silence_announced && nv_dtx_files == 0 && nv_dtx_ticks >= 400u) {
+         nv_dtx_silence_announced = true;
+         fprintf(stderr,
+                 "MESA-NV SILENT-PROBE: MESA_NV_DUMP_DEPTHTEX=%s MESA_NV_DUMP_COLTEX=%s requested, "
+                 "but no file has been written after %u ticks: the probe is producing nothing\n",
+                 dir ? dir : "-", dircol ? dircol : "-", nv_dtx_ticks);
+         fflush(stderr);
+      }
+   }
+
+   /* MESA_NV_TEXFLOAT: global census of the float textures. This call sits BEFORE the
+       * 'if (nv_dtx_n == 0)' return: the census does not depend on the draw queue, so it must run even
+       * when that is empty. */
+   nv_census_float_textures(ctx);
+
+   if (nv_dtx_n == 0) {
+      in_flush = false;
+      return;
+   }
+   if ((nv_dtx_ticks % every) != 0) {
+      /* NO clearing: depth textures are sampled only in a small part of a frames draws; if the
+             * queue were thrown away on the skip ticks the read would succeed almost only by chance
+             * (measured: 2 reads over 1600 ticks). We accumulate and read on the right tick. */
+      in_flush = false;
+      return;
+   }
+
+   for (i = 0; i < nv_dtx_n; i++) {
+      const GLuint dname = nv_dtx_tab[i].name;
+      const GLenum dtgt = nv_dtx_tab[i].target;
+      if (nv_dtx_tab[i].owner != NULL && nv_dtx_tab[i].owner != ctx) {
+         /* Same number, another context: reading it here would show us the pixels of
+          * an object this draw never sampled, and we would build conclusions on it. */
+         static unsigned nv_dtx_skipped_foreign;
+         if (nv_dtx_skipped_foreign < 400) {
+            nv_dtx_skipped_foreign++;
+            fprintf(stderr, "MESA-NV DTX-FOREIGN-CONTEXT frame=%u tex=%u %ux%u owner=%p current=%p skipped=%u\n",
+                    _mesa_nv_frame(), dname, nv_dtx_tab[i].w, nv_dtx_tab[i].h,
+                    (void *) nv_dtx_tab[i].owner, (void *) ctx, nv_dtx_skipped_foreign);
+            fflush(stderr);
+         }
+         continue;
+      }
+      const unsigned w = nv_dtx_tab[i].w, h = nv_dtx_tab[i].h;
+      const GLuint old_read = ctx->ReadBuffer->Name;
+      const GLuint old_draw = ctx->DrawBuffer->Name;
+      const GLenum pre_err = ctx->ErrorValue;
+      GLuint fb[2] = { 0, 0 }, ctex = 0;
+      unsigned char *px = NULL;
+      GLenum blit_err = GL_NO_ERROR, rd_err = GL_NO_ERROR, st_read = 0, st_draw = 0;
+      char branch_name[64];
+
+      const bool is_color = nv_dtx_tab[i].color;
+
+      /* No destination for this kind: skip the survey, do not write into a non-existent
+             * directory. */
+      if (((is_color && dircol == NULL) || (!is_color && dir == NULL)) &&
+          getenv("MESA_NV_FLOATTEX") == NULL)
+         continue;
+
+      snprintf(branch_name, sizeof(branch_name), is_color ? "BLIT-C2C" : "BLIT-D2C");
+
+      if ((uint64_t) w * h * 4 > (uint64_t) lim || w == 0 || h == 0) {
+         fprintf(stderr, "MESA-NV DTX frame=%u tex=%u %ux%u SKIPPED: too large\n",
+                 nv_dtx_ticks, dname, w, h);
+         continue;
+      }
+
+      px = malloc((size_t) w * h * 4);
+      if (px == NULL)
+         continue;
+
+      /* Direct readback of depth textures is not available here (glGetTextureImage answers
+             * GL_INVALID_OPERATION, on zink, even for Dusk whose shadows work). We go the other way:
+             * the depth texture is attached to the read FBO, a colour texture to the draw FBO, and a
+             * COPY blit with mask COLOR_BUFFER_BIT is done (depth -> colour, with NEAREST: it is an
+             * allowed copy per the specifications). What arrives in the colour texture can be read with
+             * the usual ReadPixels path, which works under zink. */
+      _mesa_CreateFramebuffers(2, fb);
+      _mesa_CreateTextures(GL_TEXTURE_2D, 1, &ctex);
+      {
+         /* TexImage2D works on the texture BOUND in the target: without bind/restore we ended up
+                   * resizing the application's texture instead of ours (and the new texture stayed
+                   * without an image: draw FBO INCOMPLETE_DRAW_BUFFER). */
+         GLuint old2d = 0;
+
+         _mesa_GetIntegerv(GL_TEXTURE_BINDING_2D, (GLint *) &old2d);
+         _mesa_BindTexture(GL_TEXTURE_2D, ctex);
+         _mesa_TexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, (GLsizei) w, (GLsizei) h, 0,
+                          GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+         _mesa_BindTexture(GL_TEXTURE_2D, old2d);
+      }
+
+      _mesa_BindFramebuffer(GL_READ_FRAMEBUFFER, fb[0]);
+      /* For depth textures the attachment is GL_DEPTH_ATTACHMENT; for the
+        * colour ones it is GL_COLOR_ATTACHMENT0. The blit is always COLOR_BUFFER_BIT. */
+      /* Cube maps are attached per FACE: glFramebufferTexture2D does not accept
+            * GL_TEXTURE_CUBE_MAP and leaves the FBO without an attachment, i.e.
+            * FRAMEBUFFER_INCOMPLETE_MISSING_ATTACHMENT (#x8cd7). That is why Timbury's cube map looked
+            * black with min=max=0: it was not the content, it was the inspector. Here the POSITIVE_X
+            * side is re-read (enough to establish whether the environment map is empty); for a
+            * face-by-face comparison it is enough to iterate the six faces with the same scheme. */
+      {
+         const GLenum attach_tgt = (dtgt == GL_TEXTURE_CUBE_MAP) ?
+            (GLenum) GL_TEXTURE_CUBE_MAP_POSITIVE_X : dtgt;
