+/* nvdbg:begin */
+/* Saves the complete frame (still in the back buffer) into a RECT texture owned by the
+ * core. To be called before the present.
+ */
+void
+_mesa_nv_shadow_capture_tex(GLsizei w, GLsizei h)
+{
+   GLint prev_rect = 0;
+
+   if (!_mesa_nv_preserve_back_enabled() || nv_pb_guard)
+      return;
+   if (w <= 0 || h <= 0 || w > 8192 || h > 8192)
+      return;
+
+   if (nv_pb_tex == 0) {
+      _mesa_GenTextures(1, &nv_pb_tex);
+      _mesa_GenFramebuffers(1, &nv_pb_fbo);
+   }
+
+   nv_pb_guard = 1;
+   _mesa_GetIntegerv(GL_TEXTURE_BINDING_RECTANGLE, &prev_rect);
+   _mesa_BindTexture(GL_TEXTURE_RECTANGLE, nv_pb_tex);
+   if (nv_pb_w != w || nv_pb_h != h)
+      _mesa_TexImage2D(GL_TEXTURE_RECTANGLE, 0, GL_RGBA8, w, h, 0,
+                       GL_RGBA, GL_UNSIGNED_BYTE, NULL);
