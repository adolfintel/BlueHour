+            }
+         }
+      }
+      } else {
+         /* nvlegacy: readback of a DEPTH texture. The blit depth -> colour path used to be the
+          * only one here, and it is a trap: with the depth texture attached to GL_DEPTH_ATTACHMENT
+          * the read FBO is COMPLETE (#x8cd5), the blit answers GL_NO_ERROR, and the colour texture
+          * it should fill stays untouched - so the survey prints min=0 max=0 mean=0 for maps that
