+/* nvdbg:begin */
+/* MESA_NV_PARAM_OVERRIDE=<programId>/<index>:<x>,<y>,<z>,<w>[;...] applied at draw time.
+ * The write-side form of this knob patched the same array the application writes, but it only
+ * fired when the program bound at that moment matched the id in the token.  With the default
+ * MESA_NV_PARAM_SCOPE=ctx the register file belongs to the context and not to a program, so a
+ * write made while another program is bound changes the very same cell and the override is
+ * undone before the draw.  Measured on Mad Mod Mike: with MESA_NV_PARAM_OVERRIDE=116/5:0,0,0,0
+ * the OVERRIDE-PARAM witness fired (frames 11, 15, 19 and 23) while the MESA_NV_PARAM_AT_DRAW
+ * census of the same run still read the application value in that same cell, v5=[0.325 ...] in
+ * 114 of the 240 draws it sampled.  This variant applies the identical syntax to the store the
+ * census reads, at every draw, so nothing the application writes in between can undo it.
+ * Diagnostic only, and it obeys the same variable: no extra switch to remember. */
+static void
+nv_override_env_at_draw(struct gl_context *ctx)
+{
+   static const char *spec;
+   static int ready = -1;
+   static unsigned shown;
+   const struct gl_program *vp = ctx->VertexProgram._Current;
+   const struct gl_program *fp = ctx->FragmentProgram._Current;
+   GLfloat (*env_v)[4] = NULL;
+   GLfloat (*env_f)[4] = NULL;
+   unsigned applied = 0;
+
+   if (ready < 0) {
+      const char *w = getenv("MESA_NV_PARAM_OVERRIDE");
+
+      spec = (w != NULL && *w != 0) ? w : NULL;
+      ready = spec != NULL ? 1 : 0;
+   }
+   if (spec == NULL)
+      return;
+
+   for (const char *p = spec; *p != 0; ) {
+      const char *semi = strchr(p, ';');
+      char tok[96];
+      const int n = semi != NULL ? (int) (semi - p) : (int) strlen(p);
+      unsigned want_id, idx;
+      float x, y, z, w;
+
+      if (n <= 0 || n >= (int) sizeof(tok))
+         break;
+      memcpy(tok, p, n);
+      tok[n] = 0;
+      if (sscanf(tok, "%u/%u:%g,%g,%g,%g", &want_id, &idx, &x, &y, &z, &w) == 6 && idx < 64) {
+         if (vp != NULL && vp->Id == want_id) {
+            if (env_v == NULL)
+               env_v = _mesa_nv_env_array(ctx, false);
+            env_v[idx][0] = x;
+            env_v[idx][1] = y;
+            env_v[idx][2] = z;
+            env_v[idx][3] = w;
+            applied++;
+         }
+         if (fp != NULL && fp->Id == want_id) {
+            if (env_f == NULL)
+               env_f = _mesa_nv_env_array(ctx, true);
+            env_f[idx][0] = x;
+            env_f[idx][1] = y;
+            env_f[idx][2] = z;
+            env_f[idx][3] = w;
+            applied++;
+         }
+      }
+      if (semi == NULL)
+         break;
+      p = semi + 1;
+   }
+   if (applied != 0 && shown < 8) {
+      shown++;
+      fprintf(stderr, "MESA-NV OVERRIDE-AT-DRAW frame=%u vp=%u fp=%u cells=%u\n",
+              _mesa_nv_frame(), vp ? (unsigned) vp->Id : 0u, fp ? (unsigned) fp->Id : 0u,
+              applied);
+      fflush(stderr);
+   }
+}
+/* nvdbg:end */
+
+void
+_mesa_nv_trace_draw(struct gl_context *ctx, const char *what, GLint a, GLint b)
+{
+   /* nvlegacy: this is the per-draw entry point that really fires: the two calls put in main/draw.c
+    * in front of _mesa_nv_skip_draw never ran on Luna (measured: zero SHADOW-MARK lines), because
+    * those two sites belong to functions the application does not reach. The mark below is
+    * independent of the diagnostics knobs, it only obeys its own MESA_NV_SHADOW_MARK. */
+   _mesa_nv_mark_shadow_store(ctx);
+
+   /* nvdbg:begin */
+   nv_arrbuf_census(ctx);
+   nv_override_env_at_draw(ctx);
+   /* nvdbg:end */
+   struct prog_slot {
+      GLuint id;
+      unsigned long n;
+   };
+   static struct prog_slot seen[40];
+   static int n_seen;
+   const struct gl_program *vp = ctx->VertexProgram._Current;
+   GLuint fp_name;
+   struct prog_slot *slot = NULL;
+   int i;
+
+   if (getenv("MESA_NV_TRACE_PROGS"))
+      nv_prog_note(ctx, what, b);
+
+         /* MESA_NV_FORCE_POLYMODE=<line|point|fill>: forces the polygon rasterisation mode on all
+                   * draws. Needed for GasStation's wireframe (W key ->
+                   * glPolygonMode(GL_FRONT_AND_BACK, GL_LINE)): that way it can be A/B'ed without
+                   * depending on the key timing, and we can also prevent the app from going to GL_LINE
+                   * (fill) to see whether the darkness comes from there. As with alpha test: the change
+                   * is NOT restored after the draw, so here it is applied always and only when the knob
+                   * is active.
+                   *
+                   * CAREFUL (measurement of 21/10): =line is NOT a valid reproduction of the wireframe.
+                   * It also hits the composite/HDR quads (full-screen blits): reduced to lines they
+                   * transfer nothing and the frame becomes black BY CONSTRUCTION, with no rasterisation
+                   * bug involved. For the wireframe use the real key + MESA_NV_KILL_FP (see
+                   * docs/gasstation-wireframe.md). =fill instead is a useful control: it cancels the
+                   * effect of the W key. */
+         {
+            static int fpm = -2;
+            if (fpm == -2) {
+               const char *v = getenv("MESA_NV_FORCE_POLYMODE");
+               fpm = 0;
+               if (v != NULL && *v != 0) {
+                  if (strcmp(v, "line") == 0)        fpm = GL_LINE;
+                  else if (strcmp(v, "point") == 0)  fpm = GL_POINT;
+                  else                               fpm = GL_FILL;
+               }
+            }
+            if (fpm != 0 &&
+                (ctx->Polygon.FrontMode != (GLenum) fpm || ctx->Polygon.BackMode != (GLenum) fpm)) {
+               ctx->Polygon.FrontMode = ctx->Polygon.BackMode = (GLenum) fpm;
+               ctx->NewState |= _NEW_POLYGON;
+               extern void _mesa_update_state_locked(struct gl_context *ctx);
+               _mesa_update_state_locked(ctx);
+            }
+
+            /* MESA_NV_FORCE_NO_DEPTH_FP=<id[,id...]>: turns the DEPTH TEST off only for the draws
+             * that use one of these program ids (the id printed by the surveys). Diagnostic only:
+             * it is the A/B probe for "the pass really runs and covers the target, but its
+             * fragments lose the depth comparison".
+             *
+             * Why this is a live suspect on Mad Mod Mike (measured 2026-11-12): the pass that
+             * composes the frame (fragment program 117 with vertex program 115 for the demo's own
+             * materials, and 117 with 113 for the rewire ones) draws with depth_test=1 and
+             * depth_mask=0, and the text of program 115 takes the depth out of the vertex
+             * attribute: "o[HPOS].z, v[0]" with a constant 0.5 in the fourth coordinate. The same
+             * target also receives fixed-function draws (fragment program 2, vertex program 1,
+             * about 3000 in a 200-swap run), so the depth buffer of that target is not all 1.0
+             * when the composite quad arrives at z=0.5. The native probe, fed with the same
+             * parameter cells the census recorded, shows the program covering 100 percent of the
+             * viewport with the four correct corners, yet on screen the pass paints only a
+             * rectangle and the frame stays 63 to 78 percent black: a depth comparison over a
+             * rectangle is exactly the shape of what remains. */
+            {
+               const char *ndsel = getenv("MESA_NV_FORCE_NO_DEPTH_FP");
+               if (ndsel != NULL && *ndsel != 0) {
+                  const struct gl_program *ndfpc = ctx->FragmentProgram._Current;
+                  const struct gl_program *ndvpc = ctx->VertexProgram._Current;
+                  const char *ndp = ndsel;
+                  int ndhit = 0;
+                  while (*ndp != 0 && !ndhit) {
+                     const long ndid = strtol(ndp, (char **) &ndp, 0);
+                     if ((ndfpc != NULL && (long) ndfpc->Id == ndid) ||
+                         (ndvpc != NULL && (long) ndvpc->Id == ndid))
+                        ndhit = 1;
+                     while (*ndp == ',' || *ndp == ' ')
+                        ndp++;
+                  }
+                  if (ndhit && ctx->Depth.Test) {
+                     static unsigned ndn;
+                     ctx->Depth.Test = GL_FALSE;
+                     ctx->NewState |= _NEW_DEPTH;
+                     extern void _mesa_update_state_locked(struct gl_context *ctx);
+                     _mesa_update_state_locked(ctx);
+                     if (ndn < 8u) {
+                        ndn++;
+                        fprintf(stderr, "MESA-NV NO-DEPTH-FP frame=%u fp=%u vp=%u\n",
+                                _mesa_nv_frame(),
+                                (unsigned) (ndfpc ? ndfpc->Id : 0u),
+                                (unsigned) (ndvpc ? ndvpc->Id : 0u));
+                     }
+                  }
+               }
+            }
+
+            /* MESA_NV_FORCE_NO_CULL=1: turns face culling off on all draws. In GL culling concerns ONLY
+                         * full polygons; if a driver applies it to LINE/POINT as well, with
+                         * cull=FRONT_AND_BACK nothing survives -> black. Measured: it is not the cause
+                         * of the wireframe problem (the lines already look endptr2). */
+            if (getenv("MESA_NV_FORCE_NO_CULL") != NULL && ctx->Polygon.CullFlag) {
+               ctx->Polygon.CullFlag = GL_FALSE;
+               ctx->NewState |= _NEW_POLYGON;
+               extern void _mesa_update_state_locked(struct gl_context *ctx);
+               _mesa_update_state_locked(ctx);
+            }
+         }
+
+         /* MESA_NV_ALPHA_TEST=off | ref=<v>  with MESA_NV_ALPHA_TEST_FP=<id[,id...]>::
+                   * Changes the alpha test only for the draws using one of those programs (the id from
+                   * the MESA_NV_DUMP). Used to measure how much the alpha test really carves the
+                   * silhouette: on Vulcan the fire fills a good part of the bbox even though the DXT5
+                   * volume has 71.6 percent of texels with alpha <= 10/255 and the app tests GREATER
+                   * 10/255. NOTE: the change to the application is not restored after the draw, so for
+                   * that reason the per-program filter is required; in the FBDRAW logs we check that the
+                   * other passes do not end up with at=(en=0).
+                   */
+         {
+            const struct gl_program *atfpc = ctx->FragmentProgram._Current;
+            const struct gl_program *atvpc = ctx->VertexProgram.Current;
+            const char *atk = getenv("MESA_NV_ALPHA_TEST");
+            if (atk != NULL && *atk != 0) {
+               const char *atsel = getenv("MESA_NV_ALPHA_TEST_FP");
+               int hit = (atsel == NULL);
+               if (atsel != NULL) {
+                  while (atsel[0] != 0 && !hit) {
+                     const long id = strtol(atsel, (char **) &atsel, 0);
+                     if ((atfpc && (long) atfpc->Id == id) ||
+                         (atvpc && (long) atvpc->Id == id))
+                        hit = 1;
+                     while (atsel[0] == ',' || atsel[0] == ' ')
+                        atsel++;
+                  }
+               }
+               if (hit) {
+                  /* Minimal, non-reentrant change: no public setters (which, mid-validate, could trigger
+                                     * state updates or errors), only the state and the dirty bit. The
+                                     * state must also be updated immediately: if we leave NewState dirty,
+                                     * st_prepare_draw() asserts "ctx->NewState == 0x0" and the demo dies
+                                     * there (assert + SEH in Wine).
+                                     */
+                  extern void _mesa_update_state_locked(struct gl_context *ctx);
+                  bool changed = false;
+                  if (strstr(atk, "off") != NULL) {
+                     if (ctx->Color.AlphaEnabled) {
+                        ctx->Color.AlphaEnabled = GL_FALSE;
+                        changed = true;
+                     }
+                  } else if (strncmp(atk, "ref=", 4) == 0) {
+                     const GLclampf r = (GLclampf) strtod(atk + 4, NULL);
+                     if (ctx->Color.AlphaRef != r) {
+                        ctx->Color.AlphaRef = r;
+                        changed = true;
+                     }
+                  }
+                  /* func=<name>: changes the alpha tests COMPARISON, not just its reference. Needed for
+                                     * Timbury's bite: the fp=49 pass opens a dark grid on the shell; if
+                                     * the reference keeps the texels with alpha==0 and we discard them (or
+                                     * the other way round) that shows up here immediately.
+                                     * Example: MESA_NV_ALPHA_TEST=func=equal with MESA_NV_ALPHA_TEST_FP=49 */
+                  {
+                     static const struct { const char *obj_name; GLenum func; } nv_af[] = {
+                        { "notequal", GL_NOTEQUAL }, { "equal",   GL_EQUAL    },
+                        { "less",     GL_LESS       }, { "lequal",  GL_LEQUAL   },
+                        { "gequal",   GL_GEQUAL     }, { "greater", GL_GREATER  },
+                        { "always",   GL_ALWAYS     }, { "never",   GL_NEVER    },
+                     };
+                     unsigned af_index;
+                     for (af_index = 0; af_index < sizeof(nv_af) / sizeof(nv_af[0]); af_index++) {
+                        if (ctx->Color.AlphaEnabled &&
+                            strstr(atk, nv_af[af_index].obj_name) != NULL &&
+                            ctx->Color.AlphaFunc != nv_af[af_index].func) {
+                           ctx->Color.AlphaFunc = nv_af[af_index].func;
+                           /* the alpha tests func is part of the shader VARIANT key (st_atom_shader.c
+                                                       * lower_alpha_func, NIR st_nir_lower_alpha_test.c)
+                                                       * but, on this stack, the real alpha test lives in the
+                                                       * depth/stencil/alpha CSO (st_atom_depth.c:
+                                                       * dsa->alpha_enabled/alpha_func/alpha_ref_value +
+                                                       * cso_set_depth_stencil_alpha), because
+                                                       * Vulkan/zink exposes caps.alpha_test and therefore the
+                                                       * lowering in the shader is NOT used. _NEW_DEPTH is
+                                                       * therefore also required: measured that with only
+                                                       * _NEW_PROGRAM the change stayed inert (0 pixels over
+                                                       * 588800). */
+                           ctx->NewState |= _NEW_PROGRAM | _NEW_DEPTH;
+                           changed = true;
+                           break;
+                        }
+                     }
+                  }
+                  if (changed) {
+                     static unsigned at_once;
+                     ctx->NewState |= _NEW_COLOR;
+                     _mesa_update_state_locked(ctx);
+                     if ((at_once++ % 100) == 0)
+                        fprintf(stderr,
+                                "MESA-NV ALPHA_TEST: applied (frame %d, fp id %d, en=%u ref=%g)\n",
+                                _mesa_nv_frame(), (int) (atfpc ? atfpc->Id : 0),
+                                (unsigned) ctx->Color.AlphaEnabled,
+                                (double) ctx->Color.AlphaRef);
+                  }
+               }
+            }
+         }
+
+   if (nv_tex_queue_enabled())
+      nv_dump_tex_units(ctx);
+
+   /* MESA_NV_TRACE_ARRAYS=1: on the first draw of the frame it lists the active
+    * vertex arrays (format, size, stride, offset, buffer).  If geometry does not
+    * reach the screen with no obvious errors, the difference must be in the
+    * attribute data.
+    */
+   if (getenv("MESA_NV_TRACE_VERTS") && nv_progs_n <= 1)
+      nv_dump_verts(ctx, false);
+
+   {
+      const struct gl_program *fpc = ctx->FragmentProgram._Current;
+      const GLuint fpid = fpc != NULL ? fpc->Id : 0;
+      const GLuint vpid = vp != NULL ? vp->Id : 0;
+      /* Bound vs CURRENT program: if the binding is there but the current one is 0,
+       * the target is not enabled (or the program never became current).
+       */
+      const struct gl_program *bfp = ctx->FragmentProgram.Current;
+      const struct gl_program *bvp = ctx->VertexProgram.Current;
+      const GLuint bfpid = bfp != NULL ? bfp->Id : 0;
+      const GLuint bvpid = bvp != NULL ? bvp->Id : 0;
+
+      /* MESA_NV_TRACE_PROGS=1: histogram (fragment program, vertex program,
+       * primitive, count) of the draws.  The count identifies the object: Blobby
+       * Dancer's character has 2955 vertices, the background is a quad.
+       * Note: the names reported here are the real ids of the current programs, not
+       * the aggregated ones in the MESA-NV PROGS line.
+       */
+      if (getenv("MESA_NV_TRACE_PROGS") != NULL) {
+         static unsigned once;
+
+         if (once++ < 20000)
+            fprintf(stderr, "MESA-NV PDRAW frame=%u fpid=%u vpid=%u a=%d b=%d\n",
+                    _mesa_nv_frame(), fpid, vpid, a, b);
+      }
+
+   /* MESA_NV_TRACE_TEXSTORAGE=<fragment program id, -1 = any>: LIGHT line (no readback) with
+       * the identity of the storage of every bound texture, once per frame. Shows whether the
+       * textures storage gets replaced between frames: if the pipe_resource pointer changes, the
+       * content loaded by the upload ended up in another allocation.
+       */
+   {
+      const char *sw = getenv("MESA_NV_TRACE_TEXSTORAGE");
+
+      if (sw != NULL && *sw != 0) {
+         const int wantfp = atoi(sw);
+         const struct gl_program *sfp = ctx->FragmentProgram._Current;
+         const char *every = getenv("MESA_NV_TRACE_TEXSTORAGE_EVERY");
+         const bool perdraw = every != NULL && *every != 0;
+         static unsigned lastf = 0xffffffffu;
+         static unsigned ndraw;
+         const unsigned f = _mesa_nv_frame();
+
+         if ((wantfp < 0 || (sfp != NULL && (int) sfp->Id == wantfp)) &&
+             ((!perdraw && f != lastf) || (perdraw && ndraw++ < 400))) {
+            lastf = f;
+            fprintf(stderr, "MESA-NV TEXSTOR frame=%u fp=%u draw=%u(%d..%d)", f,
+                    sfp ? sfp->Id : 0u, a, a, b);
+            for (int u = 0; u <= ctx->Texture._MaxEnabledTexImageUnit && u < 12; u++) {
+               const struct gl_texture_object *t = ctx->Texture.Unit[u]._Current;
+               const struct gl_texture_image *ti = t ? t->Image[0][0] : NULL;
+               if (t == NULL || ti == NULL)
+                  continue;
+               fprintf(stderr, " | u%d=tex%u obj=%p img=%p %dx%d fmt=#x%x pt=%p cdata=%d",
+                       u, t->Name, (void *) t, (void *) ti, ti->Width, ti->Height,
+                       (unsigned) ti->TexFormat, (void *) ti->pt, ti->compressed_data != NULL);
+            }
+            fprintf(stderr, "\n");
+            fflush(stderr);
+         }
+      }
+   }
+
+   /* MESA_NV_DUMP_TEX=<fragment program id, -1 = any> and MESA_NV_DUMP_TEX_DIR=<dir>: saves to
+       * files the content of the 2D textures bound to the texture units when that fragment program is
+       * active, with the statistics on stdout. Shows what the textures read by the NV programs really
+       * hold: in Time Machine the projector mask comes out black at every coordinate, and the only hard
+       * proof is the textures content. The readback goes through glGetTexImage, so there is an
+       * anti-recursion guard.
+       */
+   {
+      const char *want = getenv("MESA_NV_DUMP_TEX");
+      const char *dird = getenv("MESA_NV_DUMP_TEX_DIR");
+
+      if (want != NULL && *want != 0 && dird != NULL && *dird != 0) {
+         static bool busy;
+         static GLuint done[24];
+         static unsigned ndone;
+         const struct gl_program *dfp = ctx->FragmentProgram._Current;
+         const int wantfp = atoi(want);
+
+         const char *minv = getenv("MESA_NV_DUMP_TEX_MINVERTS");
+         const int wantverts = minv != NULL && *minv != 0 ? atoi(minv) : 0;
+         /* MESA_NV_DUMP_TEX_NAME=<texture name>: repeats the readback at every draw for a single
+                   * texture, without writing files. Shows at which moment its content goes from good to
+                   * black. MESA_NV_DUMP_TEX_SKIP=<n> skips n draws.
+                   */
+         const char *namp = getenv("MESA_NV_DUMP_TEX_NAME");
+         const int wantname = namp != NULL && *namp != 0 ? atoi(namp) : -1;
+         const char *skipp = getenv("MESA_NV_DUMP_TEX_SKIP");
+         const int skipdraw = skipp != NULL && *skipp != 0 ? atoi(skipp) : 0;
+
+         if (!busy && (wantfp < 0 || (dfp != NULL && (int) dfp->Id == wantfp)) &&
+             (int) (b - a) >= wantverts) {
+            for (int u = 0; u <= ctx->Texture._MaxEnabledTexImageUnit &&
+                         u < (int) ctx->Const.MaxCombinedTextureImageUnits; u++) {
+               struct gl_texture_object *t = ctx->Texture.Unit[u]._Current;
+               struct gl_texture_image *img;
+               unsigned k;
+
+               if (t == NULL || t->Name == 0)
+                  continue;
+               if (wantname >= 0 && (int) t->Name != wantname)
+                  continue;
+               static unsigned ndraw_dump;
+               if (wantname >= 0) {
+                  if (skipdraw > 0 && (int) (ndraw_dump++ % (unsigned) skipdraw) != 0)
+                     continue;
+               } else {
+                  for (k = 0; k < ndone && k < ARRAY_SIZE(done); k++)
+                     if (done[k] == t->Name)
+                        break;
+                  if (k < ndone)
+                     continue;
+               }
+
+               img = t->Image[0][0];
+               if (img == NULL || img->Width <= 0 || img->Height <= 0 ||
+                   (unsigned) img->Width * img->Height > 16u * 1024u * 1024u)
+                  continue;
+
+               const int w = img->Width, h = img->Height;
+               /* on a compressed texture glGetTexImage with GL_RGBA is unsupported and returns zero: the
+                               * projector mask looked black, when it was the readback. For compressed
+                               * textures we ask for their own internal format and the block is written
+                               * exactly as it is.
+                               */
+               /* glGetTexImage in the compressed format is unsupported (GL_INVALID_OPERATION), but in RGBA
+                               * it is: Mesa decompresses by itself and the readback is reliable (verified
+                               * with the native test nvdxt.c).
+                               */
+               /* COMPRESSED textures (DXT/S3TC, the case of these demos) are not read as GL_RGBA: Mesa
+                               * answers GL_INVALID_OPERATION and the buffer stays as calloc left it, so the
+                               * statistics came out with alpha 0 everywhere (measured: alpha0=1048576 on a
+                               * 1024x1024 DXT5, with average=0.0). We ask for the internal format and write
+                               * the block: alpha is decoded outside, with the same decoder used for the
+                               * assets on disk. */
+               const bool comp = util_format_is_compressed(img->TexFormat);
+               if (img->NumSamples > 1)
+                  continue; /* the readback buffer is for a single sample */
+               /* 3D levels are dumped as raw binary: the logical order the sampler sees is
+                * exactly what we want to examine, and a PPM cannot carry the depth. */
+               const bool nv_3d = img->Depth > 1;
+               const size_t nv_d = nv_3d ? (size_t) img->Depth : 1;
+               const size_t nbytes = comp
+                  ? (size_t) _mesa_format_image_size(img->TexFormat, w, h, nv_d)
+                  : (size_t) w * h * nv_d * 4;
+               unsigned char *px = malloc(nbytes);
+               /* Sentinel 0xEE: distinguishes "the driver wrote zero" from "it wrote nothing because the
+                               * read was illegal" (see the err= field). With DXT we were reading alpha=0
+                               * everywhere and passing it off as content. */
+               if (px != NULL)
+                  memset(px, 0xEE, nbytes);
+               const GLenum rfmt = comp ? img->InternalFormat : GL_RGBA;
+               if (px == NULL || nbytes == 0) {
+                  free(px);
+                  continue;
+               }
+
+               busy = true;
+               const int ti = _mesa_tex_target_to_index(ctx, t->Target);
+               struct gl_texture_object *save = ti >= 0 ?
+                  ctx->Texture.Unit[0].CurrentTex[ti] : NULL;
+               struct gl_pixelstore_attrib savepack = ctx->Pack;
+               if (ti >= 0)
+                  ctx->Texture.Unit[0].CurrentTex[ti] = t;
+               /* tight packing: see nv_dump_tex_once, otherwise a GL_PACK_ROW_LENGTH/SKIP_* left by the
+                               * app makes us write past px */
+               ctx->Pack.Alignment = 4; ctx->Pack.RowLength = 0;
+               ctx->Pack.SkipPixels = 0; ctx->Pack.SkipRows = 0;
+               ctx->Pack.ImageHeight = 0; ctx->Pack.SkipImages = 0;
+               ctx->Pack.SwapBytes = 0; ctx->Pack.LsbFirst = 0; ctx->Pack.Invert = 0;
+               ctx->Pack.BufferObj = NULL;
+               _mesa_GetTexImage(t->Target, 0, rfmt, GL_UNSIGNED_BYTE, px);
+               const GLenum rd_err = _mesa_GetError();
+               ctx->Pack = savepack;
+               if (ti >= 0)
+                  ctx->Texture.Unit[0].CurrentTex[ti] = save;
+
+               unsigned long sum = 0, bright = 0;
+               unsigned long a255 = 0, a0 = 0, asum = 0;
+               if (!comp) {
+                  for (int yy = 0; yy < h; yy++) {
+                     for (int xx = 0; xx < w; xx++) {
+                        const unsigned o = 4 * ((size_t) yy * w + xx);
+                        const unsigned l = (px[o] + px[o + 1] + px[o + 2]) / 3;
+                        sum += l;
+                        if (l > 128)
+                           bright++;
+                        /* Timbury's bite mask: alpha exactly 255 is required (the shaders threshold is 255/256),
+                                                 * so we count 255 and 0. */
+                        if (px[o + 3] == 255)
+                           a255++;
+                        else if (px[o + 3] == 0)
+                           a0++;
+                        asum += px[o + 3];
+                     }
+                  }
+               }
+
+               char path[512] = "";
+               FILE *f = NULL;
+               /* 3D uncompressed: one PPM per depth slice, so the volume can be looked at
+                * axis by axis. This is how the non standard block order of the fire volume
+                * in Time Machine was settled: numbers do not decide which axis is which, a
+                * human eye looking at slices does. */
+               if (nv_3d && !comp) {
+                  for (unsigned zz = 0; zz < img->Depth; zz++) {
+                     snprintf(path, sizeof(path), "%s/tex_%u_z%02u_%dx%d.ppm", dird,
+                              t->Name, zz, w, h);
+                     FILE *fs = fopen(path, "wb");
+                     if (fs != NULL) {
+                        fprintf(fs, "P6\n%d %d\n255\n", w, h);
+                        for (int yy = 0; yy < h; yy++) {
+                           const unsigned char *src = px + (size_t) 4 * ((size_t) zz * h + yy) * w;
+                           for (int xx = 0; xx < w; xx++) {
+                              const unsigned char g = src[4 * xx];
+                              fputc(g, fs); fputc(g, fs); fputc(g, fs);
+                           }
+                        }
+                        fclose(fs);
+                        fprintf(stderr, "MESA-NV TEX3D-SLICE tex=%u z=%u %s\n", t->Name, zz, path);
+                     }
+                  }
+               }
+
+               if (comp || nv_3d) {
+                  if (nv_3d) {
+                     snprintf(path, sizeof(path), "%s/tex_%u_u%u_fp%u_%dx%dx%d_if%x_comp.bin", dird,
+                                       t->Name, u, dfp ? dfp->Id : 0u, w, h, img->Depth,
+                                       (unsigned) img->InternalFormat);
+                  } else {
+                  snprintf(path, sizeof(path), "%s/tex_%u_u%u_fp%u_%dx%d_if%x_comp.bin", dird,
+                           t->Name, u, dfp ? dfp->Id : 0u, w, h,
+                           (unsigned) img->InternalFormat);
+                  }
+                  f = fopen(path, "wb");
+                  if (f != NULL)
+                     fwrite(px, 1, nbytes, f);
+               } else if (wantname < 0) {
+                  snprintf(path, sizeof(path), "%s/tex_%u_u%u_fp%u_%dx%d.ppm", dird,
+                           t->Name, u, dfp ? dfp->Id : 0u, w, h);
+                  f = fopen(path, "wb");
+                  if (f != NULL) {
+                     fprintf(f, "P6\n%d %d\n255\n", w, h);
+                     for (int yy = 0; yy < h; yy++)
+                        fwrite(px + 4 * (size_t) yy * w, 3, w, f);
+                  }
+               }
+               if (f != NULL)
+                  fclose(f);
+               if (wantname >= 0)
+                  snprintf(path, sizeof(path), "(stats only)");
+               /* levels 0..3: if only level 0 is black and the others have content, the upload wrote the
+                               * wrong offset.
+                               */
+               char lvtxt[96] = "";
+               {
+                  double m[4] = { -1, -1, -1, -1 };
+                  for (int lv = 0; lv < 4; lv++) {
+                     const struct gl_texture_image *im = t->Image[0][lv];
+                     unsigned long nn, sm = 0;
+                     unsigned char *pp;
+                     struct gl_texture_object *sv;
+
+                     if (im == NULL)
+                        continue;
+                     nn = (unsigned long) im->Width * (unsigned long) im->Height;
+                     if (nn == 0 || nn > 4u * 1024u * 1024u)
+                        continue;
+                     pp = calloc(nn * 4, 1);
+                     if (pp == NULL)
+                        continue;
+                     sv = ctx->Texture.Unit[0].CurrentTex[TEXTURE_2D_INDEX];
+                     ctx->Texture.Unit[0].CurrentTex[TEXTURE_2D_INDEX] = t;
+                     _mesa_GetTexImage(t->Target, lv, GL_RGBA, GL_UNSIGNED_BYTE, pp);
+                     ctx->Texture.Unit[0].CurrentTex[TEXTURE_2D_INDEX] = sv;
+                     if (_mesa_GetError()) {
+                        /* illegal read (e.g. GL_RGBA on a compressed image): do NOT print 0 as if it were a black
+                                                 * level */
+                        free(pp);
+                        continue;
+                     }
+                     for (unsigned long q = 0; q < nn; q++)
+                        sm += (pp[4 * q] + pp[4 * q + 1] + pp[4 * q + 2]) / 3;
+                     m[lv] = (double) sm / (double) nn;
+                     free(pp);
+                  }
+                  snprintf(lvtxt, sizeof(lvtxt), " levels[%.1f %.1f %.1f %.1f]",
+                           m[0], m[1], m[2], m[3]);
+               }
+
+               unsigned nl = 0;
+               for (int l = 0; l < MAX_TEXTURE_LEVELS; l++)
+                  if (t->Image[0][l])
+                     nl++;
+
+               fprintf(stderr,
+                       "MESA-NV DUMPTEX frame=%u tex=%u obj=%p unit=%u fp=%u %dx%d fmt=#x%x if=#x%x %s%zu "
+                       "complete=%d nlevels=%u minfilter=#x%x maxlod=%g minlod=%g cmp=#x%x "
+                       "average=%.1f bright=%.1f%% alpha255=%lu alpha0=%lu alpha_mean=%.1f "
+                       "err=#x%x%s%s -> %s%s\n",
+                       _mesa_nv_frame(), t->Name, (void *) t, u, dfp ? dfp->Id : 0u, w, h,
+                       (unsigned) img->TexFormat,
+                       (unsigned) img->InternalFormat, comp ? "block=" : "byte=", nbytes,
+                       (int) t->_BaseComplete, nl,
+                       (unsigned) t->Sampler.Attrib.MinFilter,
+                       (double) t->Sampler.Attrib.MaxLod,
+                       (double) t->Sampler.Attrib.MinLod,
+                       (unsigned) t->Sampler.Attrib.CompareMode,
+                       (double) sum / ((double) w * h),
+                       100.0 * (double) bright / ((double) w * h), a255, a0,
+                       (double) asum / ((double) w * h),
+                       (unsigned) rd_err,
+                       (rd_err == 0 && !comp) ? "" : " (STATISTICS NOT VALIDATED)",
+                       lvtxt, path,
+                       f ? "" : " (write failed)");
+               fflush(stderr);
+
+               if (ndone < ARRAY_SIZE(done))
+                  done[ndone++] = t->Name;
+               free(px);
+               busy = false;
+            }
+         }
+      }
+   }
+
+   /* MESA_NV_TRACE_FBDRAW=<FBO name, -1 = all>: one compact line per draw, with the draw
+       * framebuffer and the state that can explain why an object does not land in an FBO - the shadow
+       * map for instance: viewport, depth range, polygon offset, colour/depth mask, stencil, culling
+       * and the programs used. The FBO name comes from the MESA_NV_TRACE_BLIT trace (read fb=N), so we
+       * see who really draws into the shadow map and who does not.
+       */
+   {
+      const char *fbw = getenv("MESA_NV_TRACE_FBDRAW");
+
+      if (fbw != NULL && *fbw != 0) {
+         const int want = atoi(fbw);
+         /* MESA_NV_TRACE_FBDRAW_FP=<id[,id...]>: shows only the draws using one of these fragment
+                   * programs (the id is the one from the MESA_NV_DUMP, e.g. 573 for Vulcan's flames).
+                   * Keeps us from drowning in the line cap. */
+         const char *fpw = getenv("MESA_NV_TRACE_FBDRAW_FP");
+         /* MESA_NV_TRACE_FBDRAW_SKIP=<n>: ignores the first n frames. Used to survey the passes of a
+                   * mature scene (in Vulcan the sparks appear later) without overshooting the trace's
+                   * line cap. */
+         const char *skw = getenv("MESA_NV_TRACE_FBDRAW_SKIP");
+         const unsigned fskip = (skw != NULL && *skw != 0) ? (unsigned) atoi(skw) : 0u;
+         int fp_ok = 1;
+         const struct gl_framebuffer *dfb = ctx->DrawBuffer;
+         const GLuint fbn = dfb->Name;
+         const struct gl_program *avp = ctx->VertexProgram._Current;
+         const struct gl_program *bvp = ctx->VertexProgram.Current;
+         const struct gl_program *afp = ctx->FragmentProgram._Current;
+         static unsigned once_fb;
+
+
+         if (fpw) {
+            fp_ok = 0;
+            while (fpw[0] && !fp_ok) {
+               const long id = strtol(fpw, (char **) &fpw, 0);
+               if ((afp && (long) afp->Id == id) || (bvp && (long) bvp->Id == id))
+                  fp_ok = 1;
+               while (fpw[0] == ',' || fpw[0] == ' ')
+                  fpw++;
+            }
+         }
+         if ((want < 0 || (int) fbn == want) && fp_ok &&
+             _mesa_nv_frame() >= fskip && once_fb++ < 2000000) {
+            const struct gl_viewport_attrib *vp = &ctx->ViewportArray[0];
+            const struct gl_scissor_rect *sc = &ctx->Scissor.ScissorArray[0];
+            const struct gl_polygon_attrib *po = &ctx->Polygon;
+
+            char texs[1024];
+            texs[0] = 0;
+            if (getenv("MESA_NV_TRACE_TEXFILT")) {
+               char *p = texs;
+               int left = (int) sizeof(texs);
+               for (unsigned u = 0; u < 8 && left > 40; u++) {
+                  const struct gl_texture_unit *tu = &ctx->Texture.Unit[u];
+                  const struct gl_texture_object *t = tu->_Current;
+                  int nlev = 0;
+                  if (t)
+                     for (unsigned l = 0; l < MAX_TEXTURE_LEVELS; l++)
+                        if (t->Image[0][l])
+                           nlev++;
+                  if (!t)
+                     continue;
+                  char sztxt[64];
+                  {
+                     const struct gl_texture_image *bi = t->Image[0][0];
+                     if (bi)
+                        snprintf(sztxt, sizeof(sztxt), " sz=%ux%ux%u fmt=#x%x",
+                                 (unsigned) bi->Width, (unsigned) bi->Height,
+                                 (unsigned) bi->Depth, (unsigned) bi->TexFormat);
+                     else
+                        snprintf(sztxt, sizeof(sztxt), " sz=none");
+                  }
+                  const struct gl_sampler_object *s = tu->Sampler;
+                  const struct gl_sampler_attrib *sa =
+                     (s && s->Name != 0) ? &s->Attrib : &t->Sampler.Attrib;
+                  int n = snprintf(p, left,
+                                   " T%u{t=#%x id=%u%s min=#%x mag=#%x an=%g ws=%x wt=%x wr=%x lod=%g..%g bias=%g nlev=%d baseok=%d mipok=%d maxlv=%d genmip=%d%s}",
+                                   u, (unsigned) t->Target, t->Name, sztxt,
+                                   (unsigned) sa->MinFilter, (unsigned) sa->MagFilter,
+                                   (double) sa->MaxAnisotropy,
+                                   (unsigned) sa->WrapS, (unsigned) sa->WrapT,
+                                   (unsigned) sa->WrapR,
+                                   (double) sa->MinLod, (double) sa->MaxLod,
+                                   (double) sa->LodBias,
+                                   nlev, (int) t->_BaseComplete, (int) t->_MipmapComplete,
+                                   (int) t->_MaxLevel, (int) t->Attrib.GenerateMipmap,
+                                   ((s && s->Name != 0) ? " smp" : ""));
+                  if (n < 0 || n >= left)
+                     break;
+                  p += n;
+                  left -= n;
+               }
+            }
+
+            /* Which object is the colour target of this draw? The framebuffer
+             * name alone does not say whether a draw lands on a cube face of an
+             * application texture or on a renderbuffer. On Mad Mod Mike the soft
+             * omni-shadow term samples a 96x96 colour cube, and whether anything
+             * renders into it decides where the fix belongs. Two slots are
+             * described: in this Mesa the colour attachment of an offscreen
+             * framebuffer lives at BUFFER_BACK_LEFT, and BUFFER_COLOR0 stays empty. */
+            char cattxt[420];
+            cattxt[0] = 0;
+            {
+               static const GLuint nv_slots[2] = { BUFFER_BACK_LEFT, BUFFER_COLOR0 };
+               char *cp = cattxt;
+               int left = (int) sizeof(cattxt);
+               unsigned q2;
+               for (q2 = 0; q2 < 2u && left > 100; q2++) {
+                  const struct gl_renderbuffer_attachment *ca = &dfb->Attachment[nv_slots[q2]];
+                  const struct gl_texture_object *ct = ca->Texture;
+                  const struct gl_renderbuffer *cb = ca->Renderbuffer;
+                  const unsigned face = (ca->CubeMapFace < MAX_FACES) ? ca->CubeMapFace : 0u;
+                  const struct gl_texture_image *ci =
+                     ((ct != NULL) && (ct->Image[face][ca->TextureLevel] != NULL))
+                        ? ct->Image[face][ca->TextureLevel] : NULL;
+                  const unsigned w2 = (ci != NULL) ? (unsigned) ci->Width
+                                                   : ((cb != NULL) ? (unsigned) cb->Width : 0u);
+                  const unsigned h2 = (ci != NULL) ? (unsigned) ci->Height
+                                                   : ((cb != NULL) ? (unsigned) cb->Height : 0u);
+                  const unsigned f2 = (ci != NULL) ? (unsigned) ci->TexFormat
+                                                   : ((cb != NULL) ? (unsigned) cb->Format : 0u);
+                  int n = snprintf(cp, left,
+                                   "%s%s=%u type=%u tgt=#x%x face=%u lvl=%u %ux%u fmt=#x%x)",
+                                   (q2 == 0u) ? "bl=(" : " c0=(",
+                                   (ct != NULL) ? "tex" : ((cb != NULL) ? "rb" : "none"),
+                                   (ct != NULL) ? (unsigned) ct->Name
+                                                : ((cb != NULL) ? (unsigned) cb->Name : 0u),
+                                   (unsigned) ca->Type,
+                                   (ct != NULL) ? (unsigned) ct->Target : 0u,
+                                   (unsigned) ca->CubeMapFace, (unsigned) ca->TextureLevel,
+                                   w2, h2, f2);
+                  if (n < 0 || n >= left) {
+                     break;
+                  }
+                  cp += n;
+                  left -= n;
+               }
+            }
+            fprintf(stderr,
+                    "MESA-NV FBDRAW frame=%u path=%s fb=%u(%ux%u) fb#=%u fp=%u vp=%u bvp=%u mode=%d n=%d "
+                    "ms=(en=%u smp=%u rb=%u a2c=%u shade=%u cov=%u covv=%g minsh=%g smask=%#x) "
+                    "zb=(rb=%u %ux%u smp=%u test=%u wr=%u cmp=%u) "
+                    "vprec=(%d %d %d %d) dr=(%g %g) scis=(%d %d %d %d) "
+                    "po=(f=%g u=%g clamp=%g pt=%d line=%d fill=%d) "
+                    "poly=(fm=%#x bm=%#x lw=%g lsm=%u lstip=%u lpat=%#x lfac=%d psm=%u pstip=%u cfl=%u) "
+                    "fpa=(en=%u usesFF=%u act=%u bound=%u) "
+                    "scen=%#x cmask=%#x dmask=%u dtest=%u dfunc=%#x cull=%#x front=%#x st=%u "
+                    "sfunc=%#x sref=%d svmask=%#x swmask=%#x "
+                    "bl=(en=%#x srgb=%#x drgb=%#x sa=%#x da=%#x eq=%#x) bc=(%g %g %g %g) "
+                    "at=(en=%u func=%#x ref=%g) ca=%s%s\n",
+                    _mesa_nv_frame(), what, fbn, dfb->Width, dfb->Height,
+                    nv_fb_slot_of(dfb),
+                    afp ? afp->Id : 0u, avp ? avp->Id : 0u, bvp ? bvp->Id : 0u, a, b,
+                    (unsigned) ctx->Multisample.Enabled,
+                    (unsigned) dfb->Visual.samples,
+                    (unsigned) (dfb->_ColorDrawBuffers[0] ?
+                                dfb->_ColorDrawBuffers[0]->NumSamples : 0),
+                    /* MESA-NV: it was once suspected that the black wireframe came from sample shading /
+                                         * alpha-to-coverage (in Vulkan polygonMode=LINE +
+                                         * sampleShadingEnable is illegal). HYPOTHESIS DISPROVED: these
+                                         * fields are all 0 in the draws concerned and the lines rasterize
+                                         * anyway (see docs/gasstation-wireframe.md). Kept because they
+                                         * let that track be ruled out quickly. */
+                    (unsigned) ctx->Multisample.SampleAlphaToCoverage,
+                    (unsigned) ctx->Multisample.SampleShading,
+                    (unsigned) ctx->Multisample.SampleCoverage,
+                    (double) ctx->Multisample.SampleCoverageValue,
+                    (double) ctx->Multisample.MinSampleShadingValue,
+                    /* MESA-NV: smask= is the SAMPLE mask (glSampleMaski, SAMPLE_MASK_VALUE).
+                     * The colour write mask is the separate cmask= field. Confusing the two made a Mad
+                     * Mod Mike note claim that a pass kept the colour mask full, when the number printed
+                     * was the sample mask (measured 2026-11-14). */
+                    (unsigned) ctx->Multisample.SampleMaskValue,
+                    (unsigned) (dfb->Attachment[BUFFER_DEPTH].Renderbuffer ? 1 : 0),
+                    (unsigned) (dfb->Attachment[BUFFER_DEPTH].Renderbuffer ?
+                                dfb->Attachment[BUFFER_DEPTH].Renderbuffer->Width : 0),
+                    (unsigned) (dfb->Attachment[BUFFER_DEPTH].Renderbuffer ?
+                                dfb->Attachment[BUFFER_DEPTH].Renderbuffer->Height : 0),
+                    (unsigned) (dfb->Attachment[BUFFER_DEPTH].Renderbuffer ?
+                                dfb->Attachment[BUFFER_DEPTH].Renderbuffer->NumSamples : 0),
+                    (unsigned) ctx->Depth.Test,
+                    (unsigned) ctx->Depth.Mask,
+                    (unsigned) ctx->Depth.Func,
+                    (int) vp->X, (int) vp->Y, (int) vp->Width, (int) vp->Height,
+                    (double) vp->Near, (double) vp->Far,
+                    (int) sc->X, (int) sc->Y, (int) sc->Width, (int) sc->Height,
+                    (double) po->OffsetFactor, (double) po->OffsetUnits,
+                    (double) po->OffsetClamp,
+                    (int) po->OffsetPoint, (int) po->OffsetLine, (int) po->OffsetFill,
+                    /* MESA-NV: GasStation's wireframe (W key) is polygon mode, not line draws: without
+                                         * these fields we cannot even tell whether the key reaches the
+                                         * application. GL_LINE=0x1b01, GL_FILL=0x1b02. */
+                    (unsigned) ctx->Polygon.FrontMode, (unsigned) ctx->Polygon.BackMode,
+                    (double) ctx->Line.Width, (unsigned) ctx->Line.SmoothFlag,
+                    (unsigned) ctx->Line.StippleFlag, (unsigned) ctx->Line.StipplePattern,
+                    (int) ctx->Line.StippleFactor,
+                    (unsigned) ctx->Polygon.SmoothFlag, (unsigned) ctx->Polygon.StippleFlag,
+                    (unsigned) ctx->Polygon.CullFlag,
+                    /* MESA-NV: "fp=" is the BOUND program (FragmentProgram.Current), not the ACTIVE one.
+                                         * GasStation's wireframe binds fp=9 everywhere but may turn the
+                                         * fragment programs off: without these fields we read an fp that is
+                                         * not the one really used. act= is _Current (the one rasterizing). */
+                    (unsigned) ctx->FragmentProgram.Enabled,
+                    (unsigned) ctx->FragmentProgram._UsesTexEnvProgram,
+                    (unsigned) (ctx->FragmentProgram._Current ?
+                                ctx->FragmentProgram._Current->Id : 0u),
+                    (unsigned) (ctx->FragmentProgram.Current ?
+                                ctx->FragmentProgram.Current->Id : 0u),
+                    (unsigned) ctx->Scissor.EnableFlags,
+                    (unsigned) ctx->Color.ColorMask,
+                    (unsigned) ctx->Depth.Mask, (unsigned) ctx->Depth.Test,
+                    (unsigned) ctx->Depth.Func,
+                    (unsigned) ctx->Polygon.CullFaceMode, (unsigned) ctx->Polygon.FrontFace,
+                    (unsigned) ctx->Stencil.Enabled,
+                    (unsigned) ctx->Stencil.Function[0], (int) ctx->Stencil.Ref[0],
+                    (unsigned) ctx->Stencil.ValueMask[0],
+                    (unsigned) ctx->Stencil.WriteMask[0],
+                    (unsigned) ctx->Color.BlendEnabled,
+                    (unsigned) ctx->Color.Blend[0].SrcRGB,
+                    (unsigned) ctx->Color.Blend[0].DstRGB,
+                    (unsigned) ctx->Color.Blend[0].SrcA,
+                    (unsigned) ctx->Color.Blend[0].DstA,
+                    (unsigned) ctx->Color.Blend[0].EquationRGB,
+                    (double) ctx->Color.BlendColor[0], (double) ctx->Color.BlendColor[1],
+                    (double) ctx->Color.BlendColor[2], (double) ctx->Color.BlendColor[3],
+                    (unsigned) ctx->Color.AlphaEnabled,
+                    (unsigned) ctx->Color.AlphaFunc,
+                    (double) ctx->Color.AlphaRef, cattxt, texs);
+
+            /* nvdbg:begin */
+            {
+               const char *cp = getenv("MESA_NV_DUMP_CPARAMS");
+               if (cp != NULL && avp != NULL &&
+                   (*cp == '*' || avp->Id == (GLuint) strtoul(cp, NULL, 0))) {
+                  const GLfloat (*vpe)[4] = ctx->VertexProgram.Parameters;
+                  const GLfloat (*fpe)[4] = ctx->FragmentProgram.Parameters;
+
+                  fprintf(stderr, "MESA-NV CPARAMS frame=%u fb=%ux%u fp=%u vp=%u (c[] = env[%d] shared)\n",
+                          _mesa_nv_frame(), dfb->Width, dfb->Height,
+                          afp ? afp->Id : 0u, avp->Id, MAX_PROGRAM_ENV_PARAMS);
+                  for (unsigned i = 0; i < 8u; i++)
+                     fprintf(stderr, "   VP c[%u] = %.9g %.9g %.9g %.9g\n", i,
+                             (double) vpe[i][0], (double) vpe[i][1],
+                             (double) vpe[i][2], (double) vpe[i][3]);
+                  for (unsigned i = 0; i < 8u && afp != NULL; i++)
+                     fprintf(stderr, "   FP c[%u] = %.9g %.9g %.9g %.9g\n", i,
+                             (double) fpe[i][0], (double) fpe[i][1],
+                             (double) fpe[i][2], (double) fpe[i][3]);
+               }
+            }
+            /* nvdbg:end */
+
+            /* nvdbg:begin */
+            {
+               /* MESA_NV_DUMP_LPARAMS=<id[,id...]|*>: prints the LOCAL parameters of the programs in use
+                               * at draw time, filtered by vertex program id (like CPARAMS). These are the
+                               * ones the application really writes: Timbury (BugLooker.exe) calls
+                               * glProgramParameter4dNV 3,931,204 times, all on GL_VERTEX_PROGRAM_ARB, i.e.
+                               * the rows of float4x4 matrices and the light vectors of the vertex programs.
+                               * The pre-existing MESA_NV_DUMP_CPARAMS prints only the ENVIRONMENT
+                               * parameters (ctx->VertexProgram.Parameters), so the local parameters were
+                               * invisible and one could only hypothesise.
+                               * MESA_NV_DUMP_LPARAMS_MAX=<n> blocks printed (default 400).
+                               * If LocalParams is NULL we say so: absence of local parameters while the app
+                               * writes millions of them is itself the verdict.
+                               */
+               const char *lp = getenv("MESA_NV_DUMP_LPARAMS");
+
+               if (lp != NULL && *lp != 0 && avp != NULL) {
+                  bool found_match = (*lp == '*');
+
+                  if (!found_match) {
+                     const char *p = lp;
+                     while (*p != 0 && !found_match) {
+                        char *endptr2 = NULL;
+                        const unsigned wanted_id = (unsigned) strtoul(p, &endptr2, 10);
+
+                        if (endptr2 == p)
+                           break;
+                        if (wanted_id == avp->Id)
+                           found_match = true;
+                        p = endptr2;
+                        while (*p == ',' || *p == ' ')
+                           p++;
+                     }
+                  }
+                  if (found_match) {
+                     static unsigned nlpm;
+                     const char *mx = getenv("MESA_NV_DUMP_LPARAMS_MAX");
+                     const unsigned nvmax = (mx != NULL && *mx != 0) ? (unsigned) strtoul(mx, NULL, 0) : 400u;
+
+                     if (nlpm++ < nvmax) {
+                        fprintf(stderr, "MESA-NV LPARAMS frame=%u fb=%ux%u fp=%u vp=%u maxvp=%u maxfp=%u "
+                                        "localvp=%s localfp=%s\n",
+                                _mesa_nv_frame(), dfb->Width, dfb->Height,
+                                afp ? afp->Id : 0u, avp->Id,
+                                (unsigned) avp->arb.MaxLocalParams,
+                                (unsigned) (afp ? afp->arb.MaxLocalParams : 0u),
+                                avp->arb.LocalParams != NULL ? "si" : "NULL",
+                                (afp != NULL && afp->arb.LocalParams != NULL) ? "si" : "NULL");
+                        if (avp->arb.LocalParams != NULL) {
+                           for (unsigned k = 0; k < avp->arb.MaxLocalParams && k < 40u; k++)
+                              fprintf(stderr, "   VP L[%2u] = %.6f %.6f %.6f %.6f\n", k,
+                                      (double) avp->arb.LocalParams[k][0], (double) avp->arb.LocalParams[k][1],
+                                      (double) avp->arb.LocalParams[k][2], (double) avp->arb.LocalParams[k][3]);
+                        }
+                        if (afp != NULL && afp->arb.LocalParams != NULL) {
+                           for (unsigned k = 0; k < afp->arb.MaxLocalParams && k < 40u; k++)
+                              fprintf(stderr, "   FP L[%2u] = %.6f %.6f %.6f %.6f\n", k,
+                                      (double) afp->arb.LocalParams[k][0], (double) afp->arb.LocalParams[k][1],
+                                      (double) afp->arb.LocalParams[k][2], (double) afp->arb.LocalParams[k][3]);
+                        }
+                        fflush(stderr);
+                     }
+                  }
+               }
+            }
+            /* nvdbg:end */
+
+            /* nvdbg:begin */
+            {
+               const char *vd = getenv("MESA_NV_DUMP_VATTRIB");
+               if (vd != NULL && afp != NULL && afp->Id == (GLuint) strtoul(vd, NULL, 0)) {
+                  static unsigned ndv;
+                  if (ndv++ < 24) {
+                     fprintf(stderr, "MESA-NV VATTRIB frame=%u fb=%ux%u fp=%u vp=%u mode=%d n=%d\n",
+                             _mesa_nv_frame(), dfb->Width, dfb->Height,
+                             afp->Id, avp ? avp->Id : 0u, a, b);
+                     for (unsigned k = 0; k < 4; k++) {
+                        GLint en = 0, sz = 0, ty = 0, st = 0, buf = 0;
+                        GLvoid *ptr = NULL;
+                        _mesa_GetVertexAttribiv(k, GL_VERTEX_ATTRIB_ARRAY_ENABLED, &en);
+                        _mesa_GetVertexAttribiv(k, GL_VERTEX_ATTRIB_ARRAY_SIZE, &sz);
+                        _mesa_GetVertexAttribiv(k, GL_VERTEX_ATTRIB_ARRAY_TYPE, &ty);
+                        _mesa_GetVertexAttribiv(k, GL_VERTEX_ATTRIB_ARRAY_STRIDE, &st);
+                        _mesa_GetVertexAttribiv(k, GL_VERTEX_ATTRIB_ARRAY_BUFFER_BINDING, &buf);
+                        ptr = (GLvoid *) ctx->Array.VAO->VertexAttrib[VERT_ATTRIB_GENERIC(k)].Ptr;
+                        fprintf(stderr, "   a%u en=%d size=%d type=%#x stride=%d vbo=%d ptr=%p\n",
+                                k, en, sz, (unsigned) ty, st, buf, ptr);
+                        if (!en || ptr == NULL || buf != 0 || sz <= 0)
+                           continue;
+                        const unsigned nb = ty == GL_DOUBLE ? 8u : ty == GL_FLOAT ? 4u : 2u;
+                        const unsigned step = st > 0 ? (unsigned) st : nb * (unsigned) sz;
+                        const unsigned show = ((unsigned) b < 16u) ? (unsigned) b : 16u;
+                        for (unsigned i = 0; i < show; i++) {
+                           const unsigned char *p =
+                              (const unsigned char *) ptr + (size_t) i * step;
+                           fprintf(stderr, "      [%3u]", i);
+                           for (int c = 0; c < sz; c++) {
+                              const unsigned char *q = p + (unsigned) c * nb;
+                              if (ty == GL_DOUBLE)
+                                 fprintf(stderr, " %.6f", *(const double *) q);
+                              else if (ty == GL_FLOAT)
+                                 fprintf(stderr, " %.6f", (double) *(const float *) q);
+                              else
+                                 fprintf(stderr, " %02x%02x", q[0], q[1]);
+                           }
+                           fprintf(stderr, "\n");
+                        }
+                     }
+                  }
+               }
+            }
+            /* nvdbg:end */
+
+            /* nvdbg:begin */
+            fprintf(stderr,
+                    "MESA-NV FBINFO frame=%u fb=%u ctx=%p double=%d ndraw=%u read=%p draw0=%p readpt=%p draw0pt=%p "
+                    "front=%p back=%p drawisfront=%d drawisback=%d readfront=%d readback=%d\n",
+                    _mesa_nv_frame(), fbn, (void *) ctx, (int) dfb->Visual.doubleBufferMode,
+                    (unsigned) dfb->_NumColorDrawBuffers,
+                    (const void *) dfb->_ColorReadBuffer,
+                    (const void *) (dfb->_NumColorDrawBuffers ? dfb->_ColorDrawBuffers[0] : NULL),
+                    (const void *) (dfb->_ColorReadBuffer && dfb->_ColorReadBuffer->texture ? dfb->_ColorReadBuffer->texture : NULL),
+                    (const void *) (dfb->_NumColorDrawBuffers && dfb->_ColorDrawBuffers[0] ? dfb->_ColorDrawBuffers[0]->texture : NULL),
+                    (const void *) dfb->Attachment[BUFFER_FRONT_LEFT].Renderbuffer,
+                    (const void *) dfb->Attachment[BUFFER_BACK_LEFT].Renderbuffer,
+                    (int) (dfb->_NumColorDrawBuffers > 0 && dfb->_ColorDrawBuffers[0] == dfb->Attachment[BUFFER_FRONT_LEFT].Renderbuffer),
+                    (int) (dfb->_NumColorDrawBuffers > 0 && dfb->_ColorDrawBuffers[0] == dfb->Attachment[BUFFER_BACK_LEFT].Renderbuffer),
+                    (int) (dfb->_ColorReadBuffer == dfb->Attachment[BUFFER_FRONT_LEFT].Renderbuffer),
+                    (int) (dfb->_ColorReadBuffer == dfb->Attachment[BUFFER_BACK_LEFT].Renderbuffer));
+            /* nvdbg:end */
+
+            /* MESA_NV_TRACE_FBDRAW_TEX=<unit[,unit...]>: filters, wrap and LOD of the samplers used by
+                         * the draw. A LINEAR arriving as NEAREST on a compressed texture produces exactly
+                         * regular stripes (the steps of the 4x4 blocks), so for Vulcan's flames this is
+                         * the first state to read together with FBDRAW. */
+            const char *tnw = getenv("MESA_NV_TRACE_FBDRAW_TEX");
+
+            if (tnw != NULL && *tnw != 0) {
+               const char *tp = tnw;
+
+               while (tp[0] != 0) {
+                  const long unit = strtol(tp, (char **) &tp, 0);
+
+                  if (unit >= 0 && unit < 32) {
+                     const struct gl_texture_unit *tu = &ctx->Texture.Unit[unit];
+                     const struct gl_sampler_object *so = tu->Sampler;
+                     int ti;
+
+                     /* An NV_TEX does not ask for glEnable(GL_TEXTURE_<target>), so do not trust _Current:
+                                           * we print every target bound to the texture unit. */
+                     for (ti = 0; ti < NUM_TEXTURE_TARGETS; ti++) {
+                        const struct gl_texture_object *t = tu->CurrentTex[ti];
+                        const struct gl_sampler_object *s = so != NULL ?
+                           so : (t != NULL ? &t->Sampler : NULL);
+
+                        if (t == NULL || s == NULL)
+                           continue;
+
+                        {
+                           const struct gl_texture_image *img = _mesa_base_tex_image(t);
+
+                           fprintf(stderr,
+                                   "MESA-NV FBDTEX frame=%u unit=%ld tex=%u target=%#x fmt=%s "
+                                   "%dx%dx%d levels=%d base=%d minF=%#x magF=%#x "
+                                   "wrap=(%#x %#x %#x) lod=(%g %g bias=%g) cmp=%#x genMip=%u\n",
+                                   _mesa_nv_frame(), unit, t->Name, (unsigned) t->Target,
+                                   img ? (const char *) util_format_description(img->TexFormat) : "?",
+                                   img ? img->Width : 0, img ? img->Height : 0,
+                                   img ? img->Depth : 0, (int) t->_MaxLevel + 1,
+                                   (int) t->Attrib.BaseLevel,
+                                   (unsigned) s->Attrib.MinFilter,
+                                   (unsigned) s->Attrib.MagFilter,
+                                   (unsigned) s->Attrib.WrapS, (unsigned) s->Attrib.WrapT,
+                                   (unsigned) s->Attrib.WrapR,
+                                   (double) s->Attrib.MinLod, (double) s->Attrib.MaxLod,
+                                   (double) s->Attrib.LodBias,
+                                   (unsigned) s->Attrib.CompareMode,
+                                   (unsigned) t->Attrib.GenerateMipmap);
+                        }
+                     }
+                  }
+                  while (tp[0] == ',' || tp[0] == ' ')
+                     tp++;
+               }
+               fflush(stderr);
+            }
+
+            fflush(stderr);
+         }
+      }
+   }
+
+   /* MESA_NV_TEX_FORCE_LOD0=<texid[,texid...]|all>: pins the level of detail at 0 on the given
+    * textures. Shows whether the light difference with respect to the hardware comes from mipmap
+    * filtering of the projective fetches (TXP): a projection cookie sampled on a higher mipmap
+    * loses its peak.
+    *
+    * Repaired today, and here is the measurement that exposed the hole. With the old scan the probe
+    * printed only lines for tex1 and never reached tex4, the 3072x2048 shadow atlas, even though the
+    * sampler census in this same file shows tex4 bound on units 1 and 2 through thousands of draws
+    * (13353 reads on unit 2, 7637 on unit 1, all with cmp=GL_COMPARE_REF_TO_TEXTURE and LINEAR
+    * filtering, 12 mipmap levels). So the level-of-detail A/B on the atlas had been a silent no-op.
+    * The reason is the scan: it looked at ctx->Texture.Unit[i]._Current, and _Current is NOT the
+    * texture an NV-era application samples when it binds through a sampler object; the census probe
+    * in this file carries exactly that warning. The scan now walks the bindings per target, like the
+    * census does, and clamps the level of detail on the unit's sampler object as well, because
+    * min_lod and max_lod are sampler state: clamping the texture object alone leaves the sampler in
+    * charge of what the driver really uses.
+    */
+   {
+      const char *fl = getenv("MESA_NV_TEX_FORCE_LOD0");
+
+      if (fl != NULL && *fl != 0) {
+         char fbuf[128];
+         static unsigned once_fl;
+         static unsigned already_seen[64];
+         static unsigned tot_fl;
+         bool take_all = false;
+
+         snprintf(fbuf, sizeof(fbuf), "%s", fl);
+         for (char *tk = strtok(fbuf, ","); tk; tk = strtok(NULL, ",")) {
+            const GLuint id = (GLuint) atoi(tk);
+
+            if (strcmp(tk, "all") == 0)
+               take_all = true;
+
+            /* The old bound was ctx->Texture._MaxEnabledTexImageUnit, which a demo of the NV
+             * era never raises because it does not call glEnable(GL_TEXTURE_2D): the census of
+             * the samplers in this file says the same thing about _Current. Scan the units the
+             * context can actually hold, so a texture bound through a sampler object is seen. */
+            for (unsigned i = 0; i < ARRAY_SIZE(ctx->Texture.Unit); i++) {
+               struct gl_texture_unit *tu = &ctx->Texture.Unit[i];
+
+               for (int ti = 0; ti < NUM_TEXTURE_TARGETS; ti++) {
+                  struct gl_texture_object *t = tu->CurrentTex[ti];
+
+                  if (t == NULL || (!take_all && t->Name != id))
+                     continue;
+
+                  t->Sampler.Attrib.MinLod = 0.0F;
+                  t->Sampler.Attrib.state.min_lod = 0.0F;
+                  t->Sampler.Attrib.MaxLod = 0.0F;
+                  t->Sampler.Attrib.state.max_lod = 0.0F;
+                  t->Sampler.Attrib.LodBias = 0.0F;
+
+                  if (tu->Sampler != NULL) {
+                     tu->Sampler->Attrib.MinLod = 0.0F;
+                     tu->Sampler->Attrib.state.min_lod = 0.0F;
+                     tu->Sampler->Attrib.MaxLod = 0.0F;
+                     tu->Sampler->Attrib.state.max_lod = 0.0F;
+                     tu->Sampler->Attrib.LodBias = 0.0F;
+                  }
+
+                  /* Writing the fields is not enough: the driver takes the sampler state from the
+                   * object's update path. So we go through the same internal setter the proven
+                   * lever MESA_NV_FORCE_MAXLVL already uses (it calls _mesa_texture_parameteri and
+                   * that both flushes and invalidates), and we clamp the highest level the object
+                   * exposes: only level 0 exists for the sampler, which is the effect we want to
+                   * measure, and it works even when the LOD range alone would be ignored. */
+                  _mesa_texture_parameteri(ctx, t, GL_TEXTURE_MAX_LEVEL, 0, true);
+
+                  /* One line per (unit, texture): the old global counter was saturated by the
+                   * first texture that matched, and the atlas never got a line even when it was
+                   * clamped, which is exactly the kind of silence that has misled me three times
+                   * today. The counter stays, but as a total of applications. */
+                  if (once_fl < 64 && !(already_seen[once_fl] == (t->Name * 64u + i))) {
+                     bool gia = false;
+                     for (unsigned k = 0; k < once_fl; k++)
+                        if (already_seen[k] == (t->Name * 64u + i))
+                           gia = true;
+                     if (!gia) {
+                        already_seen[once_fl++] = t->Name * 64u + i;
+                        fprintf(stderr,
+                                "MESA-NV FORCELOD0 u%u tex%u target=%#x sampler_object=%d "
+                                "minlod=%.2f maxlod=%.2f\n",
+                                i, t->Name, (unsigned) t->Target, tu->Sampler != NULL ? 1 : 0,
+                                (double) t->Sampler.Attrib.MinLod,
+                                (double) t->Sampler.Attrib.MaxLod);
+                     }
+                  }
+                  tot_fl++;
+               }
+            }
+         }
+      }
+   }
+
+   /* MESA_NV_TRACE_TEXBIND=<FBO name, -1 = all>: what is really bound to the texture units at
+       * draw time. Links a NV programs TEXn target (e.g. the "depthtarget" sampler) to the real
+       * texture: if the program samples a unit other than the shadow maps, the depth comparison cannot
+       * work even when map and blit are correct.
+       */
+   {
+      const char *tbw = getenv("MESA_NV_TRACE_TEXBIND");
+
+      if (tbw != NULL && *tbw != 0) {
+         static int nv_tb_nmax;
+         const int want = atoi(tbw);
+         const GLuint fbn = ctx->DrawBuffer->Name;
+         const struct gl_program *afp = ctx->FragmentProgram._Current;
+         static unsigned once_tb;
+
+         /* MESA_NV_TRACE_TEXBIND_FP=<fp[,fp...]>: only the draws using one of these fragment
+                   * programs; MESA_NV_TRACE_TEXBIND_MINUNITS=<n> discards draws with fewer than n active
+                   * texture units (otherwise the cap is used up on the first fixed draws, which have no
+                   * units at all). */
+         const char *tfp = getenv("MESA_NV_TRACE_TEXBIND_FP");
+         const int minunits = getenv("MESA_NV_TRACE_TEXBIND_MINUNITS") != NULL ?
+                                 atoi(getenv("MESA_NV_TRACE_TEXBIND_MINUNITS")) : 1;
+         bool fp_ok = true;
+
+         if (tfp != NULL && *tfp != 0) {
+            char fbuf[128];
+            snprintf(fbuf, sizeof(fbuf), "%s", tfp);
+            fp_ok = false;
+            for (char *tk = strtok(fbuf, ","); tk; tk = strtok(NULL, ",")) {
+               if (afp != NULL && afp->Id == (GLuint) atoi(tk)) {
+                  fp_ok = true;
+                  break;
+               }
+            }
+         }
+
+         if (fp_ok && ctx->Texture._MaxEnabledTexImageUnit + 1 < minunits)
+            fp_ok = false;
+
+         if (fp_ok && (want < 0 || (int) fbn == want) && once_tb++ < 400000) {
+            /* MESA_NV_DUMP_DEPTHTEX=<dir>: at the end of the texture-unit loop, for every depth texture
+                         * SAMPLED by the draw in progress it re-reads the pixels and writes a normalised
+                         * PGM plus one statistics line (min/max/mean/fraction of non-zero pixels). Needed
+                         * for Nalu: the soft shadow goes through a 1024x1024 depth pbuffer that Wine
+                         * emulates by copying the depth buffer into the texture, and if that copy does not
+                         * bring the rendered content the shadows stay "hard" and the toggle changes
+                         * nothing; the numbers also say whether the map is stale, because the two passes
+                         * (primary and proxy) have different texture names.
+                         * MESA_NV_DUMP_DEPTHTEX_EVERY=<frames, default 60>  = every how many frames
+                         * MESA_NV_DUMP_DEPTHTEX_MINW=<minimum width, default 64>  = gates both the
+                         * sampled path and the framebuffer-attachment path (helper
+                         * nv_dtx_depth_minw).
+                         * Careful: here the draw ONLY REGISTERS the texture; the real readback happens in
+                         * the swap hook (nv_dtx_flush), because glGetTextureImage inside a draw dirties
+                         * ctx->NewState and makes the st_prepare_draw assertion `ctx->NewState == 0x0'
+                         * fail. */
+            const char *dtx_dir = getenv("MESA_NV_DUMP_DEPTHTEX");
+            const unsigned dtx_minw = getenv("MESA_NV_DUMP_DEPTHTEX_MINW") ?
+                                      (unsigned) atoi(getenv("MESA_NV_DUMP_DEPTHTEX_MINW")) : 64;
+            /* MESA_NV_DUMP_COLTEX=<dir>: also registers the COLOUR textures sampled in the draws (and
+                         * writes them at the usual safe point). Needed for the blur targets: Nalu draws
+                         * into small pbuffers (256x256, 12 in the reference) and then re-samples with
+                         * GL_LINEAR: that is how the blur is born. MESA_NV_DUMP_COLTEX_MAXW (default 512)
+                         * and _MINW (default 16) limit the size. Note: the registration sits in the
+                         * TEXBIND block, so MESA_NV_TRACE_TEXBIND=1 is needed too. */
+            const char *col_dir = getenv("MESA_NV_DUMP_COLTEX");
+            const unsigned col_maxw = getenv("MESA_NV_DUMP_COLTEX_MAXW") ?
+                                      (unsigned) atoi(getenv("MESA_NV_DUMP_COLTEX_MAXW")) : 512;
+            const unsigned col_minw = getenv("MESA_NV_DUMP_COLTEX_MINW") ?
+                                      (unsigned) atoi(getenv("MESA_NV_DUMP_COLTEX_MINW")) : 16;
+            /* The two limits above were compared against BOTH axes, so a 1280x720 colour target
+             * cannot be selected without also selecting 1024x1024 ones (measured 2026-11-13 while
+             * replaying the Mad Mod Mike trace from period hardware: with MINW=1200 nothing was
+             * registered, and with MINW=700 the 60 queue slots filled with 1024x1024 shadow
+             * atlases). Separate height limits keep the old behaviour when unset. */
+            const unsigned col_minh = getenv("MESA_NV_DUMP_COLTEX_MINH") ?
+                                      (unsigned) atoi(getenv("MESA_NV_DUMP_COLTEX_MINH")) : col_minw;
+            const unsigned col_maxh = getenv("MESA_NV_DUMP_COLTEX_MAXH") ?
+                                      (unsigned) atoi(getenv("MESA_NV_DUMP_COLTEX_MAXH")) : col_maxw;
+            /* MESA_NV_FLOATTEX=<id[,id...]|*>: queue for the floating-point read as well (see
+                         * _mesa_nv_dtx_flush). Requires MESA_NV_TRACE_TEXBIND because the registration
+                         * lives in the census of the texture bindings at draw time. */
+            const char *flt_dir = getenv("MESA_NV_FLOATTEX");
+
+            /* MESA_NV_PARAM_AT_DRAW=<vp id[,id...]|all|*>: at draw time, print the parameter
+             * cells that the bound NV programs ACTUALLY read. For an NV program the c[] registers
+             * are NOT stored in the program object: with the default scope they live in the
+             * per-context array returned by _mesa_nv_env_array (see MESA_NV_PARAM_SCOPE), so the
+             * older census (MESA_NV_TRACE_VP_IDS, which looks at vprog->Parameters) was reading
+             * another place, and its per-program numbers were not comparable with the stream the
+             * application produces. v<n> cells come from the vertex array, f<n> from the fragment
+             * one. This block sits inside the census of texture bindings at draw time, so
+             * MESA_NV_TRACE_TEXBIND is required as well. MESA_NV_PARAM_AT_DRAW_MAX=<n, default
+             * 400> caps the lines, MESA_NV_PARAM_AT_DRAW_CELLS=<n, default 8, max 24> says how
+             * many cells of each array to print. */
+            {
+               static int pad_ready = -1;
+               static unsigned pad_n, pad_max, pad_cells;
+               static char pad_sel[256];
+
+               if (pad_ready < 0) {
+                  const char *w = getenv("MESA_NV_PARAM_AT_DRAW");
+
+                  pad_ready = (w != NULL && *w != 0) ? 1 : 0;
+                  if (pad_ready) {
+                     snprintf(pad_sel, sizeof(pad_sel), "%s", w);
+                     pad_max = getenv("MESA_NV_PARAM_AT_DRAW_MAX") ?
+                               (unsigned) strtoul(getenv("MESA_NV_PARAM_AT_DRAW_MAX"), NULL, 0) : 400;
+                     pad_cells = getenv("MESA_NV_PARAM_AT_DRAW_CELLS") ?
+                                 (unsigned) strtoul(getenv("MESA_NV_PARAM_AT_DRAW_CELLS"), NULL, 0) : 8;
+                     if (pad_cells == 0)
+                        pad_cells = 8;
+                     if (pad_cells > 24)
+                        pad_cells = 24;
+                  }
+               }
+
+               if (pad_ready && pad_n < pad_max) {
+                  const struct gl_program *pad_vp = ctx->VertexProgram._Current;
+                  const struct gl_program *pad_fp = ctx->FragmentProgram._Current;
+                  const GLuint pad_vid = pad_vp ? pad_vp->Id : 0;
+                  bool pad_hit = false;
+
+                  if (pad_sel[0] == '*' || strcmp(pad_sel, "all") == 0) {
+                     pad_hit = true;
+                  } else {
+                     /* NV-legacy: the list used to match only the vertex program id. Mad Mod
+                      * Mike's blur pass is identified by its fragment program (the one holding
+                      * the g_alpha_blur uniform), so the fragment id has to be matchable too:
+                      * without that there is no way to look at that pass without dumping every
+                      * draw of the frame. */
+                     const char *q = pad_sel;
+
+                     while (*q != 0) {
+                        char *end = NULL;
+                        const unsigned long want = strtoul(q, &end, 0);
+
+                        if (end != q && ((GLuint) want == pad_vid ||
+                            (pad_fp && (GLuint) want == pad_fp->Id))) {
+                           pad_hit = true;
+                           break;
+                        }
+                        if (end == NULL || *end == 0)
+                           break;
+                        q = (*end == ',') ? end + 1 : end;
+                     }
+                  }
+
+                  if (pad_hit) {
+                     const GLfloat (*padv)[4] = _mesa_nv_env_array(ctx, false);
+                     const GLfloat (*padf)[4] = _mesa_nv_env_array(ctx, true);
+
+                     pad_n++;
+                     fprintf(stderr, "MESA-NV PARAM-AT-DRAW frame=%u ctx=%p vp=%u fp=%u",
+                             _mesa_nv_frame(), (const void *) ctx, pad_vid,
+                             pad_fp ? pad_fp->Id : 0u);
+                     for (unsigned k = 0; k < pad_cells; k++)
+                        fprintf(stderr, " v%u=[%.9g %.9g %.9g %.9g]", k,
+                                padv[k][0], padv[k][1], padv[k][2], padv[k][3]);
+                     for (unsigned k = 0; k < pad_cells; k++)
+                        fprintf(stderr, " f%u=[%.9g %.9g %.9g %.9g]", k,
+                                padf[k][0], padf[k][1], padf[k][2], padf[k][3]);
+                     /* NV-legacy: the env arrays above are NOT where the named parameters of an NV
+                      * fragment program live. blur_2D_10pix.fp30 declares two uniforms, take_max and
+                      * g_alpha_blur, and the period capture sets them with
+                      * glProgramNamedParameter4dvNV on program id 107: the values seen there are
+                      * take_max {0,0,0,0} and then g_alpha_blur {0,0,0,0}, 0.1200000047683716,
+                      * 0.4739997088909149, 0.473675936460495, 0.6200303435325623,
+                      * 0.8817312717437744 and 1. The demo's own comment on that uniform reads
+                      * "0 = don't blur alpha channel, 1 = full blur" and "[this will drive the heat
+                      * effect]": the alpha of the bloom store is what the heat gate reads, so whether
+                      * that value animates in our run decides whether the heated region has soft or
+                      * hard edges. Named parameters are stored as the program's local parameters, so
+                      * print those too (L for the fragment program, V for the vertex program). */
+                     if (pad_fp != NULL && pad_fp->arb.LocalParams != NULL) {
+                        for (unsigned k = 0; k < pad_cells; k++)
+                           fprintf(stderr, " L%u=[%.9g %.9g %.9g %.9g]", k,
+                                   pad_fp->arb.LocalParams[k][0], pad_fp->arb.LocalParams[k][1],
+                                   pad_fp->arb.LocalParams[k][2], pad_fp->arb.LocalParams[k][3]);
+                     } else if (pad_fp != NULL) {
+                        fprintf(stderr, " L=assenti");
+                     }
+                     if (pad_vp != NULL && pad_vp->arb.LocalParams != NULL) {
+                        for (unsigned k = 0; k < pad_cells; k++)
+                           fprintf(stderr, " V%u=[%.9g %.9g %.9g %.9g]", k,
+                                   pad_vp->arb.LocalParams[k][0], pad_vp->arb.LocalParams[k][1],
+                                   pad_vp->arb.LocalParams[k][2], pad_vp->arb.LocalParams[k][3]);
+                     }
+                     fprintf(stderr, "\n");
+                  }
+               }
+            }
+
+            /* MESA_NV_TRACE_SMOKE3D=<lines>: which depth and blend state the draws that carry a
+             * 3D volume on a texture unit have.  In the Mad Mod Mike reference trace those draws
+             * are 208 (the volumes are the names 384..387, bound 1281 times each) and every one of
+             * them has glDepthMask FALSE with GL_DEPTH_TEST enabled; if our chain wrote depth, or
+             * drew far fewer of them, the grid seen on the smoke veil would be a state problem and
+             * not a data problem.  One line per distinct state seen, and a summary with the counts
+             * every 200 such draws.  <lines> caps the number of distinct-state lines: 0 or empty
+             * prints them all.
+             */
+            const char *sm3 = getenv("MESA_NV_TRACE_SMOKE3D");
+
+            if (sm3 != NULL && *sm3 != 0) {
+               const unsigned nvmax = (unsigned) strtoul(sm3, NULL, 0);
+               GLuint sm3_tex = 0;
+               unsigned sm3_unit = 0;
+
+               for (unsigned u = 0;
+                    u <= ctx->Texture._MaxEnabledTexImageUnit && u < MAX_TEXTURE_UNITS; u++) {
+                  const struct gl_texture_object *o = ctx->Texture.Unit[u]._Current;
+
+                  if (o != NULL && o->Target == GL_TEXTURE_3D) {
+                     sm3_tex = o->Name;
+                     sm3_unit = u;
+                     break;
+                  }
+               }
+
+               if (sm3_tex != 0) {
+                  struct sm3_state {
+                     GLuint fp;
+                     GLuint tex;
+                     unsigned unit;
+                     unsigned mask;
+                     unsigned test;
+                     unsigned blend;
+                     GLenum src;
+                     GLenum dst;
+                     GLenum eq;
+                     unsigned count;
+                  };
+                  static struct sm3_state sm3_tab[32];
+                  static unsigned sm3_n, sm3_seen, sm3_last, sm3_printed;
+                  struct sm3_state cur;
+                  unsigned k = 0;
+
+                  cur.fp = afp != NULL ? afp->Id : 0u;
+                  cur.tex = sm3_tex;
