+   struct pipe_transfer *t = NULL;
+   struct pipe_box box;
+   uint8_t *client_data;
+   const struct util_format_description *desc = util_format_description(pt->format);
+   unsigned x, y, w = pt->width0, h = pt->height0;
+   unsigned below = 0, reads = 0;
+   float min_val = 1.0f;
+
+   if (!util_format_has_depth(desc))
+      return;
+   box.x = 0; box.y = 0; box.z = 0;
+   box.width = w; box.height = h; box.depth = 1;
+   if (!pipe->texture_map)
+      return;
+   client_data = pipe->texture_map(pipe, pt, 0, PIPE_MAP_READ, &box, &t);
+   if (!client_data || !t) {
+      if (pipe->texture_unmap && t) pipe->texture_unmap(pipe, t);
+      return;
+   }
+   {
+      unsigned gx = w > 128 ? 128 : w, gy = h > 128 ? 128 : h;
+      for (y = 0; y < gy; y++) {
+         const uint8_t *line = client_data + (size_t) y * (h / gy) * t->stride;
+         for (x = 0; x < gx; x++) {
+            const uint8_t *px = line + (size_t) x * (w / gx) * 4;
