+                               GL_COLOR_BUFFER_BIT, GL_NEAREST);
+      }
+      blit_err = ctx->ErrorValue;
+
+      ctx->ErrorValue = GL_NO_ERROR;
+      if (!is_color && dtgt == GL_TEXTURE_CUBE_MAP) {
