+/* nvdbg:begin */
+/*
+ * MESA_NV_DUMP_ATTRIBS=<id[,id...]|all>  (+ MESA_NV_DUMP_ATTRIBS_MAX, default 40,
+ *                                        + MESA_NV_DUMP_ATTRIBS_DIR for the raw bytes)
+ * At the NV attribute entry points (glVertexAttribPointerNV) it surveys the bytes of the
+ * array pointed to by the client, read as 32-bit floats. The filter by id is the id of the
+ * NV vertex program **associated at that moment**: the application associates the program,
+ * then points the attributes, then draws (order established in the reference), so the
+ * filter isolates the pass we care about.
+ *
+ * Why here: under Wine the pointers reaching Mesa are already host pointers into the
+ * application's memory, so this is the only direct read of the real vertex values. The
+ * other attempts came out negative: the broken pass's "VBOs" appear neither at load time
+ * nor at buffer maps, and they do not go through u_vbuf (chapters 31 and 32 of
+ * docs/nalu-geforce6.md).
+ */
+void
+_mesa_nv_dump_attrib(struct gl_context *ctx, GLuint index, GLint size, GLenum type,
+                     GLsizei stride, const void *pointer)
+{
+   static int env_cached = -1;
+   static GLuint ids[16];
+   static int n_ids;
+   static bool is_all;
+   static unsigned shown_n, line_limit;
+   static unsigned char *region;
+   unsigned nfloats, i, inside_unit = 0, out_of_range = 0;
+   float min_val_f, max_val_f;
+   const float *f;
+   const GLuint vp_id = ctx->VertexProgram.Current ? ctx->VertexProgram.Current->Id : 0;
+   const struct gl_vertex_array_object *vao = ctx->Array.VAO;
+   const unsigned gen = VERT_ATTRIB_GENERIC(index);
+   const char *e;
+
+   if (env_cached < 0) {
+      const char *p = getenv("MESA_NV_DUMP_ATTRIBS");
+      const char *m = getenv("MESA_NV_DUMP_ATTRIBS_MAX");
+
+      env_cached = 1;
+      is_all = (p != NULL && p[0] == 'a' && p[1] == 'l' && p[2] == 'l');
+      while (p != NULL && *p != 0 && n_ids < (int) ARRAY_SIZE(ids)) {
+         char *endptr2;
+         const unsigned long v = strtoul(p, &endptr2, 0);
+
+         if (endptr2 != p)
+            ids[n_ids++] = (GLuint) v;
+         p = *endptr2 ? endptr2 + 1 : endptr2;
+      }
+      line_limit = m ? (unsigned) strtoul(m, NULL, 0) : 40;
+      if (line_limit == 0)
+         line_limit = 40;
+   }
+
+   if (shown_n >= line_limit)
+      return;
+   if (!is_all) {
+      bool matches = false;
+
+      for (i = 0; i < (unsigned) n_ids; i++)
+         if (ids[i] == vp_id)
+            matches = true;
+      if (!matches)
+         return;
+   }
+
+   /* Only arrays pointed to by the client: if the attribute sits on a VBO, the "pointer" is an
+       * offset inside the buffer and must not be read as an address. */
+   if (gen >= VERT_ATTRIB_MAX)
+      return;
+
+   /* Registry: which buffer, with which name/size/offset the pass really uses. It also holds
+       * when 'pointer' is an offset inside a VBO, so it is printed BEFORE the pointer filter. */
+   {
+      const struct gl_vertex_array_object *vao = ctx->Array.VAO;
+      const struct gl_vertex_buffer_binding *bb = &vao->BufferBinding[gen];
+
+      fprintf(stderr,
+              "MESA-NV ATTRIB-NAME frame=%u vp=%u index=%u size=%d type=#x%x "
+              "stride=%d pointer=#x%zx buffer=%u bufsize=%u offsetbinding=#x%x "
