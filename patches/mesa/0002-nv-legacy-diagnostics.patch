+            nv_dtx_dface_next = 0;
+         else if (nv_dtx_dface_last[nv_dtx_dface_slot].tick < 0)
+            nv_dtx_dface_next = nv_dtx_dface_from;
+         else
+            nv_dtx_dface_next =
+               nv_dtx_dface_last[nv_dtx_dface_slot].tick + nv_dtx_dface_every;
+         if (nv_dtx_dface_from < 0) {
+            const char *e = getenv( "MESA_NV_DUMP_DEPTHTEX_FACE_FROM" );
+            nv_dtx_dface_from = (e != NULL && *e != 0) ? atol( e ) : 0;
+            e = getenv( "MESA_NV_DUMP_DEPTHTEX_FACE_EVERY" );
+            nv_dtx_dface_every = (e != NULL && *e != 0) ? atol( e ) : 0;
+         }
+         for (unsigned qf = 0; qf < 6u; qf++) {
+            double vmin = 1e30, vmax = -1e30, vmean = 0.0;
+            unsigned nzc = 0u, stf = 0, erf = 0;
+            _mesa_BindFramebuffer(GL_READ_FRAMEBUFFER, fb[0]);
+            _mesa_FramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_DEPTH_ATTACHMENT,
+                                       nv_dfaces[qf], dname, 0);
+            stf = _mesa_CheckFramebufferStatus(GL_READ_FRAMEBUFFER);
+            if (stf == GL_FRAMEBUFFER_COMPLETE_EXT) {
+               const GLenum pre = ctx->ErrorValue;
+               ctx->ErrorValue = GL_NO_ERROR;
+               _mesa_BlitFramebuffer(0, 0, (GLsizei) w, (GLsizei) h,
+                                     0, 0, (GLsizei) w, (GLsizei) h,
+                                     GL_COLOR_BUFFER_BIT, GL_NEAREST);
