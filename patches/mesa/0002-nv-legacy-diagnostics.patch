+/* nvdbg:begin */
+/* True when the render-texture readback probes are armed: they queue a GPU blit (a depth or
+ * colour store copied into a temporary colour texture) and then read it back. Measured on Mad
+ * Mod Mike on 2026-11-12: with those probes armed, the swap-time frame diagnostics running from
+ * inside the gallium flush_swapbuffers callback freeze the process at the very first swap. Each
+ * half on its own is healthy - frame diagnostics alone reach 3449 swaps, the probes alone reach
+ * 975 swaps with 800 render-texture copies - the pair is not: the readback inside the callback
+ * waits for GPU work that only the swap, which is this same call, can release, and the process
+ * sits there with 22 threads asleep, zero swap witnesses and zero exceptions. The helper says
+ * out loud which of the two was seen, so a skipped measurement is never mistaken for a measured
+ * absence. */
+static bool
+nv_dtx_probe_armed(void)
+{
+   const char *a = getenv("MESA_NV_DUMP_DEPTHTEX");
+   const char *b = getenv("MESA_NV_DUMP_COLTEX");
+
+   return (a != NULL && *a != 0) || (b != NULL && *b != 0);
+}
+/* nvdbg:end */
+
+
+    /* nvdbg:begin */
+    /**
+ * Frame diagnostics on swapbuffers (MESA_NV_SHOT_AT=swap|both): capture and probe a
+ * frame for applications that never call glClear because they accumulate trails.
+ * Purely diagnostic: the whole function goes into the diagnostics patch.
+ */
+/**
+ * Witness of every polygon-offset write (MESA_NV_TRACE_POLYOFFSET, bounded by
+ * MESA_NV_TRACE_POLYOFFSET_MAX=<lines, default 40000>).  Mad Mod Mike's own
+ * depth-bias policy depends on whether the application's draw target reports
+ * multisampling: with the shipped args.txt (3 and 4 samples) our runs leave
+ * the offsets at zero on the main surface (747238 draws), while the period
+ * trace leaves values of 3 and 3 there, and our single-sample run does the
+ * same as the period trace.  This prints the values the application asked
+ * for, together with the size and real sample count of the draw target, so
+ * the branch in the demo can be found instead of guessed.  Diagnostic only.
+ */
+void
+_mesa_nv_note_polygon_offset(struct gl_context *ctx, const GLfloat factor,
+                             const GLfloat units, const GLfloat clamp)
+{
+   static int enabled = -1;
+   static int cap = -1;
+   static unsigned invocati = 0;
+   static unsigned nv_dump_written = 0;
+   const struct gl_framebuffer *fb = ctx->DrawBuffer;
+
+   if (enabled < 0)
+      enabled = getenv("MESA_NV_TRACE_POLYOFFSET") != NULL;
+   if (!enabled)
+      return;
+   if (cap < 0) {
+      const char *e = getenv("MESA_NV_TRACE_POLYOFFSET_MAX");
+      cap = (e != NULL && *e != 0 && atoi(e) > 0) ? atoi(e) : 40000;
+   }
+   ++invocati;
+   if ((int) nv_dump_written >= cap)
+      return;
+   ++nv_dump_written;
+   fprintf(stderr,
+           "MESA-NV POLYOFFSET tick=%u frame=%u call=%u fb=%dx%d smp=%u "
+           "f=%g u=%g clamp=%g\n",
+           invocati, _mesa_nv_frame(), invocati,
+           fb ? (int) fb->Width : 0, fb ? (int) fb->Height : 0,
+           fb ? fb->Visual.samples : 0, (double) factor, (double) units,
+           (double) clamp);
+}
+
+/* MESA-NV SWAPMARK n=<swap> frame=<Mesa frame> skipped=<0|1>: the frame counter at every swap of
+ * the application drawable.  The swap-time capture files written from src/glx/glxcmds.c carry only
+ * their own counter, so without this witness a run cannot say which draws belong to which captured
+ * frame, and a rect measured on a capture cannot be checked against the constants recorded at draw
+ * time (measured 2026-11-13 on the Mad Mod Mike heat pass).  It now prints even while the rest of
+ * the swap-time diagnostics is skipped: the frame counter is kept by the application's own glClear
+ * calls, so the number is valid there, and a paired run (swap-time captures plus render-texture
+ * readbacks) is the only way to compare a captured frame with the surfaces of that same frame. */
+static void
+nv_swapmark(const bool during_skip)
+{
+   static unsigned sm_n;
+
+   sm_n++;
+   fprintf(stderr, "MESA-NV SWAPMARK n=%u frame=%u skipped=%u\n",
+           sm_n, _mesa_nv_frame(), during_skip ? 1u : 0u);
+   fflush(stderr);
+}
+
+void
+_mesa_nv_diag_swap_hook(struct gl_context *ctx)
+{
+   const int diag = _mesa_nv_diag_at_swap();   /* 0 clear, 1 swap, 2 both */
+
+   if (diag == 0 || ctx == NULL)
+      return;
+   if (diag == 1 && nv_dtx_probe_armed()) {
+      const char *force = getenv("MESA_NV_SHOT_SWAP_FORCE");
+      if (force == NULL || *force == 0) {
+         static bool nv_diag_swap_said;
+
+         if (!nv_diag_swap_said) {
+            nv_diag_swap_said = true;
+            fprintf(stderr,
+                    "MESA-NV DIAG-SKIP: swap-time frame diagnostics skipped while the render-texture\n"
+                    "                    probes (MESA_NV_DUMP_COLTEX / MESA_NV_DUMP_DEPTHTEX) are armed:\n"
+                    "                    their GPU blits make the readback inside the flush_swapbuffers\n"
+                    "                    callback wait forever (measured: frozen at the first swap, zero\n"
+                    "                    swap witnesses, zero exceptions). Leave MESA_NV_SHOT_AT unset to\n"
+                    "                    run the diagnostics on glClear, or set MESA_NV_SHOT_SWAP_FORCE=1\n"
+                    "                    to run them here anyway and watch the freeze. While skipped, the\n"
+                    "                    frame counters TSKIP/TEVERY of the swap-time path do not advance.\n");
+            fflush(stderr);
+         }
+         /* NOT calling _mesa_nv_note_clear here, even though it would keep TSKIP/TEVERY
+          * moving: measured on 2026-11-12, that is precisely the call that freezes the
+          * process. note_clear samples the window framebuffer, and while
+          * MESA_NV_SHOT_AT=swap it does so through _mesa_ReadBuffer(GL_BACK), which cannot
+          * be resolved from inside the flush_swapbuffers callback - the swap that would
+          * resolve it is the call we are standing in. The counters stop, and the witness
+          * below says so, instead of the process stopping.
+          */
+         nv_swapmark(true);
+         return;
+      }
+   }
+   nv_swapmark(false);
+   _mesa_nv_shot_at(ctx, true);
+   /* The frame counter normally advances in glClear; if the application never
+    * calls it, this has to do it, or TSKIP/TEVERY never move.
+    */
+   if (diag == 1)
+      _mesa_nv_note_clear(ctx);
+}
