+          * block above can only ever see POSITIVE_X of a cube, which is what made the depth
+          * cube of Mad Mod Mike (the one the hard omni shadows sample, created by the
+          * application with six glTexImage2D of GL_DEPTH_COMPONENT16) look flat: six readings
+          * of the same face, not six faces. The readback uses the same depth to colour COPY
+          * blit as the single-face path, because a direct depth readback answers
+          * GL_INVALID_OPERATION on zink. */
+         static const GLenum nv_dfaces[6] = { 0x8515, 0x8516, 0x8517, 0x8518, 0x8519, 0x851a };
+         static unsigned nv_dtx_dface_files;
+         static long nv_dtx_dface_from = -1, nv_dtx_dface_every = -1;
+         const struct gl_texture_object *dtobj = _mesa_lookup_texture(ctx, dname);
