+void
+_mesa_nv_shadow_restore(GLsizei w, GLsizei h)
+{
+   if (!_mesa_nv_preserve_back_enabled() || nv_pb_guard || nv_pb_tex == 0)
+      return;
+   if (w <= 0 || h <= 0 || nv_pb_w <= 0 || nv_pb_h <= 0)
+      return;
+
+   nv_pb_guard = 1;
+   GLint saved_read = 0, saved_draw = 0;
+
+   _mesa_GetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &saved_read);
+   _mesa_GetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &saved_draw);
+
+   _mesa_BindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+   _mesa_BindFramebuffer(GL_READ_FRAMEBUFFER, nv_pb_fbo);
+   _mesa_FramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                              GL_TEXTURE_RECTANGLE, nv_pb_tex, 0);
+   if (_mesa_CheckFramebufferStatus(GL_READ_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE) {
+      _mesa_BlitFramebuffer(0, 0, nv_pb_w, nv_pb_h, 0, 0, w, h,
+                            GL_COLOR_BUFFER_BIT, GL_NEAREST);
+   } else if (nv_pb_notes < 4) {
+      fprintf(stderr, "MESA_NV_PRESERVE_BACK: shadow FBO incomplete\n");
+   }
+   _mesa_BindFramebuffer(GL_READ_FRAMEBUFFER, saved_read);
+   _mesa_BindFramebuffer(GL_DRAW_FRAMEBUFFER, saved_draw);
+   nv_pb_guard = 0;
+}
+/* nvdbg:end */
