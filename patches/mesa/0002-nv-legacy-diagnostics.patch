+            static const GLenum nv_faces[6] = { 0x8515, 0x8516, 0x8517, 0x8518, 0x8519, 0x851a };
+            static unsigned nv_dtx_face_files;
+             /* Rule: write the six face images of THIS object when at least <every> census
+              * ticks have passed since its last set, instead of testing a modulo on a
+              * counter that advances on every flush while reads happen only when the queue
+              * holds something (measured 2026-11-12: 4500+ face reads, images only by
