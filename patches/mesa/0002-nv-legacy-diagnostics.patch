+             for (nv_dtx_face_slot = 0; nv_dtx_face_slot < nv_dtx_face_last_n;
+                  nv_dtx_face_slot++)
+               if (nv_dtx_face_last[nv_dtx_face_slot].obj == (const void *) tobj)
