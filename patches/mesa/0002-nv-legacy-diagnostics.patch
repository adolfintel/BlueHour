+         if (e != NULL && *e != 0) {
+            snprintf(fbuf, sizeof(fbuf), "%s", e);
+            for (char *tk = strtok(fbuf, " "); tk != NULL && fcc_n < 8; tk = strtok(NULL, " ")) {
+               int ww = 0, hh = 0;
+               float r = 0.0f, g = 0.0f, b = 0.0f, al = 1.0f;
+
+               if (sscanf(tk, "%dx%d=%f,%f,%f,%f", &ww, &hh, &r, &g, &b, &al) == 6 ||
+                   sscanf(tk, "%dx%d=%f,%f,%f", &ww, &hh, &r, &g, &b) == 5) {
+                  if (ww > 0 && hh > 0) {
+                     fcc[fcc_n].w = ww;
+                     fcc[fcc_n].h = hh;
+                     fcc[fcc_n].c[0] = r;
+                     fcc[fcc_n].c[1] = g;
+                     fcc[fcc_n].c[2] = b;
+                     fcc[fcc_n].c[3] = al;
+                     fcc_n++;
+                  }
+               }
+            }
+         }
+      }
+      if (fcc_n > 0 && ctx->DrawBuffer != NULL) {
+         for (q = 0; q < (unsigned) fcc_n; q++) {
+            if ((int) ctx->DrawBuffer->Width != fcc[q].w ||
+                (int) ctx->DrawBuffer->Height != fcc[q].h)
+               continue;
+            ctx->Color.ClearColor.f[0] = fcc[q].c[0];
+            ctx->Color.ClearColor.f[1] = fcc[q].c[1];
+            ctx->Color.ClearColor.f[2] = fcc[q].c[2];
+            ctx->Color.ClearColor.f[3] = fcc[q].c[3];
+            if (fcc_done < 200) {
+               fprintf(stderr, "MESA-NV FORCE-CLEAR frame=%u fb#=%u %ux%u rgb=(%.3f %.3f %.3f)\n",
+                       _mesa_nv_frame(), nv_fb_slot_of(ctx->DrawBuffer),
+                       (unsigned) fcc[q].w, (unsigned) fcc[q].h,
+                       fcc[q].c[0], fcc[q].c[1], fcc[q].c[2]);
+               if (fcc_done == 0)
+                  fprintf(stderr, "MESA-NV FORCE-CLEAR: %d size rules active\n", fcc_n);
+            }
+            fcc_done++;
+            break;
+         }
+      }
+   }
+
+   /* The filter hypothesis (MESA_NV_FORCE_TFILTER) is applied when the texture
+     * queue is flushed: there the textures are the ones seen during the draws. */
+
+   /* MESA_NV_DUMP_FB=<frames>: reads a central tile of the buffer THAT IS ABOUT TO BE CLEARED
+       * - so right after the pass that filled it - and reports whether it holds anything, together with
+       * the last fragment program that drew into it. It separates "that pass produces black" from
+       * "that pass produces something but the composition never brings it to the screen". At most one
+       * survey per framebuffer for the frame window given. */
+   {
+      const char *ed = getenv("MESA_NV_DUMP_FB");
+      const unsigned every_n = (ed != NULL && atoi(ed) > 0) ? (unsigned) atoi(ed) : 0;
+
+      if (every_n > 0 && ctx->DrawBuffer != NULL) {
+         const struct gl_framebuffer *fb = ctx->DrawBuffer;
+         unsigned k2;
+
+         for (k2 = 0; k2 < nv_fb_of_n; k2++)
+            if (nv_fb_of[k2].fb == (const void *) fb)
+               break;
+
+         if (k2 < nv_fb_of_n &&
+             nv_fb_of[k2].drawn > 0 &&
+             nv_frame_count >= nv_fb_of[k2].dumped_frame + every_n) {
+            /* A single central tile is NOT enough: a pass that fills only a strip or a corner would have
+                         * looked empty. If the buffer is small it is read entirely, otherwise a 3x3 grid
+                         * of tiles spread over the buffer is sampled. */
+            const bool is_small = ((unsigned) fb->Width * (unsigned) fb->Height) <= (256u * 256u);
+            GLsizei w, h;
+            GLint x, y;
+            unsigned char *px;
+            static unsigned char px_all[256 * 256 * 4];
+            static unsigned char px_grid[3 * 3 * 32 * 32 * 4];
+            unsigned tiles = 1;
+
+            if (is_small) {
+               w = (GLsizei) fb->Width;
+               h = (GLsizei) fb->Height;
+               x = 0;
+               y = 0;
+               px = px_all;
+            } else {
+               w = h = 32;
+               x = ((GLint) fb->Width - 32) / 2;
+               y = ((GLint) fb->Height - 32) / 2;
+               px = px_grid;
+               tiles = 9;
+            }
+            static unsigned char px_unused_dummy[1];
+            (void) px_unused_dummy;
+            unsigned minv = 255, maxv = 0, nz = 0, som = 0, np;
+            unsigned aminv = 255, amaxv = 0, asom = 0, anz = 0;
+
+            np = (unsigned) w * (unsigned) h;
+            if (w > 0 && h > 0) {
+               unsigned t2;
+               minv = 255; aminv = 255;
+               for (t2 = 0; t2 < tiles; t2++) {
+                  if (tiles > 1) {
+                     /* 3x3 grid spread over the buffer */
+                     const unsigned cx = (t2 % 3) * ((unsigned) fb->Width - 32) / 2;
+                     const unsigned cy = (t2 / 3) * ((unsigned) fb->Height - 32) / 2;
+                     _mesa_ReadPixels((GLint) cx, (GLint) cy, w, h, GL_RGBA,
+                                      GL_UNSIGNED_BYTE,
+                                      px + t2 * (unsigned) w * (unsigned) h * 4u);
+                  } else {
+                     _mesa_ReadPixels(x, y, w, h, GL_RGBA, GL_UNSIGNED_BYTE, px);
+                  }
+               }
+               np = (unsigned) w * (unsigned) h * tiles;
+               for (unsigned i = 0; i < np; i++) {
+                  unsigned char r = px[i * 4], g = px[i * 4 + 1], b = px[i * 4 + 2];
+                  unsigned char alpha_v = px[i * 4 + 3];
+                  unsigned v = (r + g + b) / 3;
+                  if (v < minv) minv = v;
+                  if (v > maxv) maxv = v;
+                  som += v;
+                  if (r || g || b) nz++;
+                  if (alpha_v < aminv) aminv = alpha_v;
+                  if (alpha_v > amaxv) amaxv = alpha_v;
+                  asom += alpha_v;
+                  if (alpha_v) anz++;
+               }
+               /* The alpha channel must be measured because some of the demo's passes write their data
+                               * THERE (the occluder-density program writes RGB = 0 on purpose and puts
+                               * occluderDensity in o[COLR].w: looking only at RGB that buffer seemed
+                               * empty). */
+               fprintf(stderr,
+                       "MESA-NV CONTENT-FB frame=%u fb#=%u %ux%u alpha_bit=%u "
+                       "fp_last=%u draws=%u tile=%ux%u rgb_min=%u rgb_max=%u "
+                       "rgb_mean=%.2f rgb_nonzero=%.3f a_min=%u a_max=%u a_mean=%.2f "
+                       "a_nonzero=%.3f pixel=%u\n",
+                       nv_frame_count, nv_fb_of[k2].idx,
+                       nv_fb_of[k2].w, nv_fb_of[k2].h,
+                       (unsigned) fb->Visual.alphaBits,
+                       (unsigned) nv_fb_of[k2].last_fp, nv_fb_of[k2].drawn,
+                       (unsigned) w, (unsigned) h, minv, maxv,
+                       np ? (double) som / np : 0.0,
+                       np ? (double) nz / np : 0.0,
+                       np ? aminv : 0, amaxv,
+                       np ? (double) asom / np : 0.0,
+                       np ? (double) anz / np : 0.0, np);
+               fflush(stderr);
+
+               /* The colour attachment is not enough for the stores that the demos keep in
+                * pbuffers created with WGL_DEPTH_TEXTURE_FORMAT_NV: there the pass writes the
+                * DEPTH attachment and the colour one stays at its clear value. Measured on Mad
+                * Mod Mike: the shadow atlas 3072x2048 reported rgb_mean=255.00 after 13435
+                * draws, which tells nothing about the shadow content and made the store look
+                * empty when it was not. So the same tile window is read a second time as
+                * depth, and the fraction of texels still at the far value is printed.
+                */
+               if (fb->Attachment[BUFFER_DEPTH].Renderbuffer != NULL) {
+                  static GLfloat dep[3 * 3 * 32 * 32];
+                  GLfloat dmin = 1.0f, dmax = 0.0f, dsom = 0.0f;
+                  unsigned dfar = 0, dn;
+
+                  for (t2 = 0; t2 < tiles; t2++) {
+                     if (tiles > 1) {
+                        const unsigned cx = (t2 % 3) * ((unsigned) fb->Width - 32) / 2;
+                        const unsigned cy = (t2 / 3) * ((unsigned) fb->Height - 32) / 2;
+                        _mesa_ReadPixels((GLint) cx, (GLint) cy, w, h, GL_DEPTH_COMPONENT,
+                                         GL_FLOAT,
+                                         dep + (unsigned) t2 * (unsigned) w * (unsigned) h);
+                     } else {
+                        _mesa_ReadPixels(x, y, w, h, GL_DEPTH_COMPONENT, GL_FLOAT, dep);
+                     }
+                  }
+                  dn = (unsigned) w * (unsigned) h * tiles;
+                  for (unsigned i2 = 0; i2 < dn; i2++) {
+                     const GLfloat dval = dep[i2];
+                     if (dval < dmin)
+                        dmin = dval;
+                     if (dval > dmax)
+                        dmax = dval;
+                     dsom += dval;
+                     if (dval >= 0.9999f)
+                        dfar++;
+                  }
+                  fprintf(stderr,
+                          "MESA-NV CONTENT-FB frame=%u fb#=%u %ux%u depth=1 "
+                          "depth_min=%.5f depth_max=%.5f depth_mean=%.5f depth_far=%.3f "
+                          "depth_rb_internalfmt=#x%x depth_rb_format=%s samples=%u\n",
+                          nv_frame_count, nv_fb_of[k2].idx,
+                          nv_fb_of[k2].w, nv_fb_of[k2].h,
+                          dn ? dmin : 0.0f, dn ? dmax : 0.0f,
+                          dn ? dsom / (GLfloat) dn : 0.0f,
+                          dn ? (GLfloat) dfar / (GLfloat) dn : 0.0f,
+                          (unsigned) fb->Attachment[BUFFER_DEPTH].Renderbuffer->InternalFormat,
+                          _mesa_get_format_name(fb->Attachment[BUFFER_DEPTH].Renderbuffer->Format),
+                          dn);
+                  fflush(stderr);
+               }
+
+               /* MESA_NV_DUMP_FB_IMAGES=<dir>: writes the whole attachment of the framebuffer being
+                * inspected as an image, colour as PPM and depth as a PGM normalised between the minimum
+                * and the maximum actually read, so that a person can see the SHAPE of what a store holds
+                * instead of only its statistics.  Which sizes are written comes from
+                * MESA_NV_DUMP_FB_IMAGES_SIZES (comma separated WxH, or "all"), and at most
+                * MESA_NV_DUMP_FB_IMAGES_MAX images per framebuffer go out (default 3).  With
+                * MESA_NV_DUMP_FB_IMAGES_FROM and MESA_NV_DUMP_FB_IMAGES_UNTIL the dump is restricted
+                * to a window of frame counters: this is what lets a person look at the atlas exactly
+                * when a rare event happens, instead of only at the first clears.  On Mad Mod Mike the
+                * event to catch is the atlas depth dropping to 0.01436 (the near plane of the omni
+                * shadow camera): it appears at frame counters 4168, 9864, 15560, 21256 in a 104 second
+                * run, spaced 5696 apart, which matches the demo's own showcase cycle (the presented
+                * frames carry its labels: Indirect Lighting, Omni Soft Shadows, Complex Shadows).  Why this exists:
+                * on Mad Mod Mike the shadow atlas 3072x2048 reports depth mean 0.9462 with geometry in
+                * 537 of 577 readings, so the store is not empty, yet the demo's point-light shadows come
+                * out as stripes.  The demo builds the comparison itself (shaders
+                * /ReceiveHardOmniShadow_inc.fp30: four h1texcompare2D taps 1.5 texels apart, averaged,
+                * over a 3x2 unfolded cube, with OMNICAM_NEAR=7.0, OMNICAM_FAR=392.0, xybias_const=4.8,
+                * zbias_const=0.001), and injecting a known pattern into the delivered 2048x2048 and
+                * 3072x2048 depth maps changed nothing on screen.  An image answers the only question
+                * that matters here: are the stripes already inside the map, or do they appear only when
+                * the program samples it. */
+               {
+                  const char *img_dir = getenv("MESA_NV_DUMP_FB_IMAGES");
+                  const char *img_sizes = getenv("MESA_NV_DUMP_FB_IMAGES_SIZES");
+                  const char *img_max_s = getenv("MESA_NV_DUMP_FB_IMAGES_MAX");
+                  const char *img_from_s = getenv("MESA_NV_DUMP_FB_IMAGES_FROM");
+                  const char *img_until_s = getenv("MESA_NV_DUMP_FB_IMAGES_UNTIL");
+                  static unsigned img_done[NV_FB_KEYS];
+                  const unsigned img_max = (img_max_s != NULL && atoi(img_max_s) > 0)
+                                           ? (unsigned) atoi(img_max_s) : 3u;
+                  const unsigned WW = (unsigned) fb->Width;
+                  const unsigned HH = (unsigned) fb->Height;
+                     const long from_frame = (img_from_s != NULL && *img_from_s != 0)
+                                           ? (long) atol(img_from_s) : -1;
+                     const long until_frame = (img_until_s != NULL && *img_until_s != 0)
+                                            ? (long) atol(img_until_s) : -1;
+                     const int in_window = (from_frame < 0 || (long) nv_frame_count >= from_frame) &&
+                                           (until_frame < 0 || (long) nv_frame_count <= until_frame);
+                     if (img_dir != NULL && *img_dir != 0 && k2 < NV_FB_KEYS &&
+                         img_done[k2] < img_max && in_window &&
+                         nv_fb_image_size_asked(img_sizes, WW, HH)) {
+                     const unsigned img_index = img_done[k2]++;
+                     char img_path[512];
+                     FILE *fh;
+
+                     if (fb->Attachment[BUFFER_DEPTH].Renderbuffer != NULL) {
+                        GLfloat *dp = malloc((size_t) WW * HH * sizeof(GLfloat));
+
+                        if (dp != NULL) {
+                           unsigned char *img_bytes = malloc((size_t) WW * HH);
+                           GLfloat lo = 1.0f, hi = 0.0f;
+                           size_t q;
+
+                           _mesa_ReadPixels(0, 0, (GLsizei) WW, (GLsizei) HH, GL_DEPTH_COMPONENT,
+                                            GL_FLOAT, dp);
+                           for (q = 0; q < (size_t) WW * HH; q++) {
+                              if (dp[q] < lo)
+                                 lo = dp[q];
+                              if (dp[q] > hi)
+                                 hi = dp[q];
+                           }
+                           if (img_bytes != NULL) {
+                              const GLfloat dn_gain = (hi > lo) ? (GLfloat) 255.0 / (hi - lo) : 0.0f;
+
+                              for (q = 0; q < (size_t) WW * HH; q++)
+                                 img_bytes[q] = (dn_gain > 0.0f)
+                                              ? (unsigned char) ((dp[q] - lo) * dn_gain) : (unsigned char) 0;
+                              snprintf(img_path, sizeof(img_path), "%s/fb%03u_%ux%u_depth_%02u.pgm",
+                                       img_dir, nv_fb_of[k2].idx, WW, HH, img_index);
+                              if ((fh = fopen(img_path, "wb")) != NULL) {
+                                 fprintf(fh, "P5\n%u %u\n255\n", WW, HH);
+                                 fwrite(img_bytes, 1, (size_t) WW * HH, fh);
+                                 fclose(fh);
+                                 fprintf(stderr, "MESA-NV FB-IMAGES frame=%u fb#=%u %ux%u depth=%s min=%.5f max=%.5f\n",
+                                         nv_frame_count, nv_fb_of[k2].idx, WW, HH, img_path, lo, hi);
+                                 fflush(stderr);
+                              }
+                              free(img_bytes);
+                           }
+                           free(dp);
+                        }
+                     }
+
+                     /* No attachment guard here, on purpose: the census above reads GL_RGBA from
+                      * these same framebuffers with only a size check, and that read is proven safe on
+                      * Wine pbuffers.  Mesa leaves Attachment[...].Type at GL_NONE for driver-created
+                      * pbuffers, which is why a type test hid every colour image in the first version
+                      * of this probe (measured: only depth files appeared). */
+                     if (WW > 0 && HH > 0) {
+                        unsigned char *cp = malloc((size_t) WW * HH * 4u);
+
+                        if (cp != NULL) {
+                           _mesa_ReadPixels(0, 0, (GLsizei) WW, (GLsizei) HH, GL_RGBA,
+                                            GL_UNSIGNED_BYTE, cp);
+                           snprintf(img_path, sizeof(img_path), "%s/fb%03u_%ux%u_color_%02u.ppm",
+                                    img_dir, nv_fb_of[k2].idx, WW, HH, img_index);
+                           if ((fh = fopen(img_path, "wb")) != NULL) {
+                              size_t q;
+
+                              fprintf(fh, "P6\n%u %u\n255\n", WW, HH);
+                              for (q = 0; q < (size_t) WW * HH; q++)
+                                 fwrite(cp + q * 4u, 1, 3, fh);
+                              fclose(fh);
+                              fprintf(stderr, "MESA-NV FB-IMAGES frame=%u fb#=%u %ux%u color=%s\n",
+                                      nv_frame_count, nv_fb_of[k2].idx, WW, HH, img_path);
+                              fflush(stderr);
+                           }
+                           free(cp);
+                        }
+                     }
+                  }
+               }
+
+               nv_fb_of[k2].dumped_frame = nv_frame_count;
+               nv_fb_of[k2].drawn = 0;
+            }
+         }
+      }
+   }
+   /* nvdbg:end */
+
+   if (ctx->DrawBuffer == ctx->WinSysDrawBuffer &&
+       ctx->DrawBuffer->Visual.doubleBufferMode) {
+      nv_frame_count++;
+
+      /* nvdbg:begin */
+      nv_texwatch(ctx);
+      /* nvdbg:end */
+
+      /* nvdbg:begin */
+      /* MESA_NV_TRACE_PROGS=1: summary of the frame just finished, with draws
+       * grouped by the fragment program in use.  Shows who draws what (wireframe
+       * mode) without printing 500 draws per frame.
+       */
+      if (nv_progs_n && getenv("MESA_NV_TRACE_PROGS")) {
+         fprintf(stderr, "MESA-NV PROGS frame=%u:", nv_frame_count - 1);
+         for (unsigned i = 0; i < nv_progs_n; i++)
+            fprintf(stderr, " fp=%u vp=%u fb=%ux%u#%u draw=%p al=%u cs=%08x fpar=%u fpv=%08x smpl=%x t0=%u ttgt=%#x env=%#x t2d=%u trec=%u tcub=%u tcomp=%u tlvl=%u/%u n=%u cnt=%u vph=%08x vpm=%.3g npar=%u [%s]",
+                    nv_progs[i].id, nv_progs[i].vp, nv_progs[i].fbw,
+                    nv_progs[i].fbh, nv_progs[i].fbname,
+                     (void *) nv_progs[i].drawb, nv_progs[i].aliastex, nv_progs[i].csig,
+                    nv_progs[i].fpar, nv_progs[i].fpvh, nv_progs[i].fpsm,
+                    nv_progs[i].t0name, nv_progs[i].t0tgt, nv_progs[i].t0env,
+                    nv_progs[i].t0_2d, nv_progs[i].t0rect, nv_progs[i].t0cube,
+                    nv_progs[i].t0comp, nv_progs[i].t0min, nv_progs[i].t0max,
+                    nv_progs[i].draws,
+                    nv_progs[i].count, nv_progs[i].vphash, nv_progs[i].vpmax,
+                    nv_progs[i].npar, nv_progs[i].prim);
+         fprintf(stderr, " | rd=%d at=%d af=%#x st=%d zt=%d zf=%#x clip=%x fog=%d",
+                 (int) ctx->RasterDiscard,
+                 (int) _mesa_is_alpha_test_enabled(ctx),
+                 (unsigned) ctx->Color.AlphaFunc, (int) ctx->Stencil.Enabled,
+                 (int) ctx->Depth.Test, (unsigned) ctx->Depth.Func,
+                 (unsigned) ctx->Transform.ClipPlanesEnabled,
+                 (int) ctx->Fog.Enabled);
+      /* Counters for the aliased depth channel. Printed WHOLE (not split from the call above:
+             * breaking a statement between the two trees made the nv_rt_* names land in the
+             * features-only patch). I add no markers: this area is ALREADY inside an nvdbg region, and
+             * a `begin` inside a `begin` breaks the marker parity (the reason for the leak that lasted
+             * until now). */
+      fprintf(stderr, "nvlegacy RT-COUNTERS ali=%u fbk=%u stn=%u\n",
+              nv_rt_ali, nv_rt_fbk, nv_rt_stn);
+
+         fprintf(stderr, "\n");
+      }
+      /* nvdbg:end */
+      nv_progs_n = 0;
+
+      /* nvdbg:begin */
+      /* MESA_NV_PROBE=x:y:width:height (default 384:288:32:32): for every
+       * presented frame it reads a small rectangle from the front buffer and prints
+       * its mean luminance.  It costs far less than capturing the whole frame, so it
+       * barely changes the pace: it shows the per-frame luminance drops (the
+       * "flicker") without having to eyeball them.  Values near 0 are the known read
+       * artefact: to be discarded.
+       */
+      /* MESA_NV_PROBE_ALL=1: same probe on every clear, including the
+       * non-presented buffers (Dusk's offscreen RT is 2048x2048): this shows whether
+       * the 3D scene exists mid-frame and gets overwritten afterwards.
+       */
+      if (getenv("MESA_NV_PROBE_ALL")) {
+         static unsigned char pa[32 * 32 * 4];
+         struct gl_framebuffer *fb2 = ctx->DrawBuffer;
+         unsigned long sum2 = 0;
+         unsigned n2 = 0;
+
+         _mesa_ReadBuffer(nv_diag_readbuffer());
+         _mesa_ReadPixels(0, 0, 32, 32, GL_RGBA, GL_UNSIGNED_BYTE, pa);
+         _mesa_ReadBuffer(GL_BACK);
+         for (unsigned i = 0; i < 32 * 32 * 4; i += 4 * 7) {
+            sum2 += 0.299 * pa[i] + 0.587 * pa[i + 1] + 0.114 * pa[i + 2];
+            n2++;
+         }
+         fprintf(stderr, "MESA_NVPROBE_ALL n=%u fb=%u %dx%d winsys=%d lum=%.1f\n",
+                 nv_frame_count, fb2->Name, fb2->Width, fb2->Height,
+                 (int) (fb2 == ctx->WinSysDrawBuffer), n2 ? (double) sum2 / n2 : 0.0);
+         while (_mesa_GetError())
+            ;
+      }
+      /* nvdbg:end */
+
+      /* nvdbg:begin */
+      if (getenv("MESA_NV_PROBE")) {
+         static unsigned char px[64 * 64 * 4];
+         static double last_probe;
+         static unsigned probe_seq;
+         struct timespec ts;
+         int x = 384, y = 288, w = 32, h = 32;
+         unsigned long sum = 0;
+         double now, lum;
+
+         sscanf(getenv("MESA_NV_PROBE"), "%d:%d:%d:%d", &x, &y, &w, &h);
+         w = CLAMP(w, 1, 64);
+         h = CLAMP(h, 1, 64);
+         x = CLAMP(x, 0, 4095);
+         y = CLAMP(y, 0, 4095);
+
+         _mesa_ReadBuffer(nv_diag_readbuffer());
+         _mesa_ReadPixels(x, y, w, h, GL_RGBA, GL_UNSIGNED_BYTE, px);
+         _mesa_ReadBuffer(GL_BACK);
+
+         for (unsigned i = 0; i < (unsigned) w * h * 4; i++)
+            sum += px[i];
+         lum = (double) sum / ((double) w * h * 4.0);
+
+         clock_gettime(CLOCK_MONOTONIC, &ts);
+         now = ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+         fprintf(stderr, "MESA_NVPROBE n=%u f=%u t=%.1f dt=%.1f lum=%.2f\n",
+                 probe_seq++, nv_frame_count, now,
+                 last_probe ? now - last_probe : 0.0, lum);
+         last_probe = now;
+
+         while (_mesa_GetError())
+            ;
+      }
+      /* nvdbg:end */
+
+      /* nvdbg:begin */
+      /* Pace of the frames presented on screen: useful to see the "gaps"
+       * (compilations blocking the frame).
+       */
+      if (getenv("MESA_NV_TRACE_FRAMES")) {
+         struct timespec ts;
+         clock_gettime(CLOCK_MONOTONIC, &ts);
+         const double now = ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+         static double last;
+         fprintf(stderr, "MESA_NVFRAME f=%u t=%.1f dt=%.1f\n", nv_frame_count,
+                 now, last ? now - last : 0.0);
+         last = now;
+      }
+      /* nvdbg:end */
+   }
+
+   /* nvdbg:begin */
+   /* Periodic state print, only with MESA_NV_DEBUG: it stays diagnostics. */
+   if (_mesa_nv_debug() && (nv_frame_count % 50) == 0)
+      fprintf(stderr, "MESA_NV frame=%u win=%d %dx%d dbl=%d shot=%d\n",
+              nv_frame_count, ctx->DrawBuffer == ctx->WinSysDrawBuffer,
+              (int) ctx->DrawBuffer->Width, (int) ctx->DrawBuffer->Height,
+              (int) ctx->DrawBuffer->Visual.doubleBufferMode,
+              (int) (getenv("MESA_NV_SHOT") != NULL));
+   /* nvdbg:end */
+}
