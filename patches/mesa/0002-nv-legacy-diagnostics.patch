+               break;
+         if (nv_dtx_dface_slot == nv_dtx_dface_last_n && nv_dtx_dface_last_n < 16u) {
+            nv_dtx_dface_last[nv_dtx_dface_last_n].obj = (const void *) dtobj;
+            nv_dtx_dface_last[nv_dtx_dface_last_n].tick = -1;
+            nv_dtx_dface_slot = nv_dtx_dface_last_n++;
+         }
+         if (nv_dtx_dface_slot >= nv_dtx_dface_last_n)
+            nv_dtx_dface_next = -1;   /* table full: this object gets no images */
