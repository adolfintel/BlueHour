+                                GL_UNSIGNED_BYTE, px);
+               erf = ctx->ErrorValue;
+               ctx->ErrorValue = pre;
+               for (unsigned qe = 0; qe < w * h; qe++) {
+                  const double v = (double) px[4u * qe] / 255.0;
+                  if (v < vmin) vmin = v;
+                  if (v > vmax) vmax = v;
+                  if (px[4u * qe] != 0u) nzc++;
