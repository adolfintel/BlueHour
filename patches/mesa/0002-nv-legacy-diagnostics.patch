+          * survey and 0 in another, while both did more than 3000 per-face reads. The rule is
+          * now at least <every> ticks since the last images of THIS object, remembered in a
+          * small table keyed by object identity because texture names are recycled. */
+         struct nv_dtx_dface_written { const void *obj; long tick; };
+         static struct nv_dtx_dface_written nv_dtx_dface_last[16];
+         static unsigned nv_dtx_dface_last_n;
+         unsigned nv_dtx_dface_slot = 0;
+         long nv_dtx_dface_next = 0;
