+/* nvdbg:begin */
+/* MESA_NV_DUMP_DEPTHTEX_MINW=<minimum width, default 64>: the smallest depth texture the probe
+ * will queue. It used to be honoured only by the path that registers depth textures a draw SAMPLES,
+ * so asking for the 3072x2048 shadow atlas with MINW=3000 still filled the queue with the 96x96 cube
+ * faces (measured on Mad Mod Mike, 2026-11-13 late: 12 dumped images, all 96x96 faces, no atlas).
+ * One cached reader so both registration paths use the same rule. */
+static unsigned
+nv_dtx_depth_minw(void)
+{
+   static int cached = -1;
+   if (cached < 0) {
+      const char *v = getenv("MESA_NV_DUMP_DEPTHTEX_MINW");
+      cached = (v != NULL && *v != 0) ? (unsigned) atoi(v) : 64u;
+   }
+   return (unsigned) cached;
+}
+
+/**
+ * Register a texture that has just become a framebuffer's DEPTH (or DEPTH_STENCIL) attachment, so
+ * that the depth readback probe can look at it. MESA_NV_DUMP_DEPTHTEX used to be fed only by depth
+ * textures that a draw SAMPLES. A store the application only renders into was therefore invisible:
+ * Mad Mod Mike's hard-shadow store is a 96x96 cube of GL_DEPTH_COMPONENT16 created by the
+ * application with six glTexImage2D and used as the depth attachment of its own cube framebuffer;
+ * it is never sampled, so it was never registered, and the survey produced 0 depth images in 4
+ * runs while the colour stores produced 24 face images each. The depth-to-colour blit and the
+ * six-face loop already existed, only the registration was missing. Called with the framebuffer
+ * mutex held, so this helper must not take any lock and must not call GL.
+ */
+void
+_mesa_nv_dtx_note_depth_attachment(struct gl_context *ctx, struct gl_texture_object *t,
+                                   GLenum target, GLint level)
+{
+   const char *dir = getenv("MESA_NV_DUMP_DEPTHTEX");
+   const struct gl_texture_image *ti;
+   unsigned face = 0;
+
+   if (dir == NULL || *dir == 0 || ctx == NULL || t == NULL || t->Name == 0)
+      return;
+   if (level < 0)
+      level = 0;
+   if (t->Target == GL_TEXTURE_CUBE_MAP && target >= 0x8516 && target <= 0x851b) {
+      /* GL_TEXTURE_CUBE_MAP_POSITIVE_X is 0x8516 in the face enum used by the attachment target. */
+      face = target - 0x8516;
+   }
+   ti = t->Image[face][level];
+   if (ti == NULL)
+      ti = t->Image[face][0];
+   if (ti == NULL)
+      return;
+   if (ti->_BaseFormat != GL_DEPTH_COMPONENT && ti->_BaseFormat != GL_DEPTH_STENCIL &&
+       ti->_BaseFormat != GL_STENCIL_INDEX)
+      return;
+   if (ti->Width == 0 || ti->Height == 0 || ti->Width > 4096 || ti->Height > 4096)
+      return;
+   /* Same size rule the sampled path already applies: without it a queue asked for the shadow
+    * atlas fills up with the six cube faces, and the atlas never gets read. */
+   if (ti->Width < nv_dtx_depth_minw())
+      return;
+   if (nv_dtx_n >= NV_DTX_MAX || nv_dtx_seen[t->Name % 512])
+      return;
+   nv_dtx_seen[t->Name % 512] = 1;
+   nv_dtx_tab[nv_dtx_n].name = t->Name;
+   /* The object target, not the face: the probe already walks the six faces of a cube on its own,
+    * and with the face as target it would read the same face six times under one name. */
+   nv_dtx_tab[nv_dtx_n].target = t->Target;
+   nv_dtx_tab[nv_dtx_n].w = ti->Width;
+   nv_dtx_tab[nv_dtx_n].h = ti->Height;
+   nv_dtx_tab[nv_dtx_n].color = false;
+   nv_dtx_n++;
+}
+/* nvdbg:end */
