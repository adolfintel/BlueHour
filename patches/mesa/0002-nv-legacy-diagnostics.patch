+/* nvdbg:begin */
+#include <stdlib.h>
+
+/* MESA_NV_TRACE_MATRIX=1: prints the matrix on top of the stack after every change, plus the
+ * viewport. It lets us tell a geometric collapse wanted by the matrices (scale ~0 on one axis, wrong
+ * clipping plane) from one coming from the vertices: in Nalu the mermaid comes out as a vertical sheet a
+ * few pixels high in both variants, while the environment is drawn well.
+ */
+static const char *
+nv_stack_name(struct gl_context *ctx, const struct gl_matrix_stack *stack)
+{
+   if (stack == &ctx->ModelviewMatrixStack)
+      return "modelview";
+   if (stack == &ctx->ProjectionMatrixStack)
+      return "projection";
+   if (stack == &ctx->TextureMatrixStack[0])
+      return "texture0";
+   if (stack == &ctx->TextureMatrixStack[1])
+      return "texture1";
+   return "other";
+}
+
+static void
+nv_trace_matrix(struct gl_context *ctx, const char *what,
+                const struct gl_matrix_stack *stack)
+{
+   static unsigned nvm;
+   const GLfloat *m;
+
+   if (getenv("MESA_NV_TRACE_MATRIX") == NULL || nvm >= 400)
+      return;
+   if (!stack || stack->Depth == 0)
+      return;
+   m = stack->Top->m;
+   fprintf(stderr,
+           "MESA_NV_MATRIX n=%u %s stack=%s nv_depth=%u\n      [ %.4f %.4f "
+           "%.4f %.4f ]\n      [ %.4f %.4f %.4f %.4f ]\n      [ %.4f %.4f %.4f "
+           "%.4f ]\n      [ %.4f %.4f %.4f %.4f ]\n",
+           nvm, what, nv_stack_name(ctx, stack), stack->Depth,
+           m[0], m[4], m[8], m[12], m[1], m[5], m[9], m[13],
+           m[2], m[6], m[10], m[14], m[3], m[7], m[11], m[15]);
+   nvm++;
+   fflush(stderr);
+}
+/* nvdbg:end */
 
