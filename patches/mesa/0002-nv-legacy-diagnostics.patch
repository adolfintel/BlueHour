+int
+_mesa_nv_diag_at_swap(void)
+{
+   static int cached = -1;
+
+   if (cached < 0) {
+      const char *v = getenv("MESA_NV_SHOT_AT");
+      cached = 0;
+      if (v != NULL) {
+         if (!strcmp(v, "swap"))
+            cached = 1;
+         else if (!strcmp(v, "both"))
+            cached = 2;
+      }
