+static void nv_dump_i386_state( const EXCEPTION_RECORD *rec, const I386_CONTEXT *ctx )
+{
+    static int done;
+    unsigned int word;
+    int i, k;
+    static const char *labels[] = { "eax", "ecx", "edx", "ebx", "esi", "edi", "ebp", "eip" };
+    const unsigned int values[] = { ctx->Eax, ctx->Ecx, ctx->Edx, ctx->Ebx,
+                                    ctx->Esi, ctx->Edi, ctx->Ebp, ctx->Eip };
+
+    if (rec->ExceptionCode != EXCEPTION_ACCESS_VIOLATION) return;
+    /* Skip the Wine-side faults: measured, 90 of the 230 access violations of one Mike
+     * run are Wine's own probes at 7BCD2B60 and 46 are inside this translation layer, and
+     * with a budget of twelve those ate the whole dump before the demo's own fault at
+     * 004A03AF was reached. Wine's i386 modules map at or above 0x70000000, the
+     * application and cg.dll below that, so the filter keeps what the demos do. */
+    if ((ULONG64)rec->ExceptionAddress >= 0x60000000) return;
+    if (done++ >= 40) return;
+
+    FIXME( "nvlegacy EXC32 #%d code=%08lx flags=%lx addr=%08x access=%s target=%08x\n",
+           done - 1, rec->ExceptionCode, rec->ExceptionFlags,
+           (unsigned int)rec->ExceptionAddress,
+           rec->ExceptionInformation[0] ? "write" : "read",
+           (unsigned int)rec->ExceptionInformation[1] );
+    FIXME( "nvlegacy EXC32   eax=%08x ebx=%08x ecx=%08x edx=%08x\n",
+           ctx->Eax, ctx->Ebx, ctx->Ecx, ctx->Edx );
+    FIXME( "nvlegacy EXC32   esi=%08x edi=%08x ebp=%08x eip=%08x esp=%08x eflags=%08x cs=%04x ss=%04x\n",
+           ctx->Esi, ctx->Edi, ctx->Ebp, ctx->Eip, ctx->Esp, ctx->EFlags,
+           (unsigned short)ctx->SegCs, (unsigned short)ctx->SegSs );
+
+    /* the guest stack, word by word from the guest stack pointer */
+    FIXME( "nvlegacy EXC32   guest_stack from esp=%08x:\n", ctx->Esp );
+    for (i = 0; i < 48; i += 4)
+    {
+        if (!nv_read_word( (const char *)(ULONG_PTR)ctx->Esp + i, &word ))
+        {
+            FIXME( "nvlegacy EXC32     +%02x: unreadable at %08x\n", i,
+                   (unsigned int)(ctx->Esp + i) );
+            break;
+        }
+        FIXME( "nvlegacy EXC32     +%02x: %08x\n", i, word );
+        nv_print_if_string( word );
+    }
+
+    /* a window around every register value that could be the object the fault is about */
+    for (i = 0; i < (int)(sizeof(labels) / sizeof(labels[0])); i++)
+    {
+        if (values[i] < 0x10000) continue;
+        FIXME( "nvlegacy EXC32   window around %s=%08x:\n", labels[i], values[i] );
+        for (k = -8; k < 21; k++)
+        {
+            if (!nv_read_word( (const char *)(ULONG_PTR)values[i] + 4 * k, &word ))
+            {
+                FIXME( "nvlegacy EXC32     %s%02x: unreadable\n", k < 0 ? "-" : "+",
+                       (unsigned int)(k < 0 ? -4 * k : 4 * k) );
+                break;
+            }
+            FIXME( "nvlegacy EXC32     %s%02x: %08x\n", k < 0 ? "-" : "+",
+                   (unsigned int)(k < 0 ? -4 * k : 4 * k), word );
+            nv_print_if_string( word );
+        }
+    }
+}
