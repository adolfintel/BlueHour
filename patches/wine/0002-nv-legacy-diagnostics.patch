+/* nvdbg:begin */
+/* nvlegacy EXCDUMP (WINEDEBUG=+seh): print the exception record, the guest registers and raw memory
+ * windows at FIRST-CHANCE time, before any handler runs, so what is printed is the state
+ * the faulting code actually saw.
+ *
+ * Why this exists instead of a debugger: on Luna an attached winedbg changes which failure
+ * happens first. Measured twice: with the debugger attached the process dies at 0x438125
+ * reading 0xfeeefeee (the MSVC fill for freed memory) right after the extension inventory,
+ * while a plain run reaches the 178 program creations and dies at 0x4a1e4f on a null
+ * member. Anything learned about the shader path from an attached run is therefore
+ * invalid, and the only way to see the real crash context is to watch a process that is
+ * not being debugged.
+ *
+ * Gate: the debug channel, because ntdll does not link the host C library and cannot read an
+ * environment variable. WINEDEBUG=+seh enables it; only access violations are dumped, and at
+ * most forty of them, because these demos raise hundreds of DBG_PRINTEXCEPTION_C exceptions
+ * and the noise would bury the signal.
+ *
+ * Memory is dumped as raw 32-bit hex words on purpose: the demo executables have no ASLR
+ * (base 0x400000), so a word that happens to be an address can be resolved back to a
+ * string in the binary afterwards, offline, with certainty. The reads go through __TRY so
+ * that a bogus pointer (0xfeeefeee, 0xbaadf00d, null) is reported instead of killing the
+ * reporter.
+ */
+static void nv_dump_words( const char *label, const void *where, unsigned int words )
+{
+    unsigned int i;
+
+    __TRY
+    {
+        const DWORD *p = (const DWORD *)where;
+        for (i = 0; i < words; i += 4)
+        {
+            switch (words - i)
+            {
+            case 1:
+                FIXME( "nvlegacy EXCDUMP   %s +%02x: %08x\n", label, i * 4, (unsigned int)p[i] );
+                break;
+            case 2:
+                FIXME( "nvlegacy EXCDUMP   %s +%02x: %08x %08x\n", label, i * 4, (unsigned int)p[i], (unsigned int)p[i + 1] );
+                break;
+            case 3:
+                FIXME( "nvlegacy EXCDUMP   %s +%02x: %08x %08x %08x\n",
+                       label, i * 4, (unsigned int)p[i], (unsigned int)p[i + 1], (unsigned int)p[i + 2] );
+                break;
+            default:
+                FIXME( "nvlegacy EXCDUMP   %s +%02x: %08x %08x %08x %08x\n",
+                       label, i * 4, (unsigned int)p[i], (unsigned int)p[i + 1], (unsigned int)p[i + 2], (unsigned int)p[i + 3] );
+                break;
+            }
+        }
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        FIXME( "nvlegacy EXCDUMP   %s: unreadable at %p\n", label, where );
+    }
+    __ENDTRY
+}
+
+static void nv_dump_exception( EXCEPTION_RECORD *rec, CONTEXT *context )
+{
+    static int done, cxx, av;
+    char at[32], fault[32];
+
+    /* ntdll does not link the host C library, so a knob read through getenv is not
+     * available here. The gate is the debug channel instead: WINEDEBUG=+seh is already what
+     * makes the demos' OutputDebugString text visible, and it now also produces the
+     * register and memory dump below. Only access violations are dumped, because these
+     * demos raise hundreds of DBG_PRINTEXCEPTION_C exceptions and the noise would bury the
+     * signal. WINE_NV_EXC_DUMP_MAX cannot be used here either: the cap is fixed. */
+    if (!TRACE_ON(seh)) return;
+    if (rec->ExceptionCode == EXCEPTION_ACCESS_VIOLATION)
+    {
+        /* One compact line for every access violation, with the object registers, so the
+         * order of events is visible against the demo's own OutputDebugString text: measured
+         * on Luna, one run raises 672 violations but only three different addresses fault
+         * (two library probe sites, harmless, and the crash site), and the crash site faults
+         * SIX times before the process dies. Deciding what those six attempts are is what
+         * this line is for; the full register and memory dump below stays rare. */
+        snprintf( at, sizeof(at), "%p", rec->ExceptionAddress );
+        snprintf( fault, sizeof(fault), "%p", (void *)rec->ExceptionInformation[1] );
+        FIXME( "nvlegacy EXC #av%d addr=%s access=%s target=%s",
+               av++, at, rec->ExceptionInformation[0] ? "write" : "read", fault );
+#ifdef __i386__
+        FIXME( " ebx=%08x esi=%08x edi=%08x ecx=%08x\n",
+               (unsigned int)context->Ebx, (unsigned int)context->Esi,
+               (unsigned int)context->Edi, (unsigned int)context->Ecx );
+#else
+        FIXME( "\n" );
+#endif
+        if (done++ >= 12) return;
+    }
+    else if (rec->ExceptionCode == 0xe06d7363) /* the MSVC C++ throw code */
+    {
+        /* C++ throws are dumped too: when the demo cannot load a program it reports the
+         * failure through a C++ exception, and that exception carries pointers to the thrown
+         * object, to the type descriptor and to the site that raised it. Those are the places
+         * where the reason text lives, which no other instrument has shown yet. Separate
+         * budget, because these are more frequent than access violations in this program. */
+        if (cxx++ >= 120) return;
+    }
+    else return;
+
+    snprintf( at, sizeof(at), "%p", rec->ExceptionAddress );
+    snprintf( fault, sizeof(fault), "%p", (void *)rec->ExceptionInformation[1] );
+    FIXME( "nvlegacy EXCDUMP #%d code=%08lx (%s) flags=%lx addr=%s access=%s target=%s\n",
+           done - 1, (unsigned long)rec->ExceptionCode, debugstr_exception_code( rec->ExceptionCode ),
+           (unsigned long)rec->ExceptionFlags, at,
+           rec->ExceptionInformation[0] ? "write" : "read", fault );
+
+#ifdef __i386__
+    if (rec->ExceptionCode == 0xe06d7363)
+    {
+        /* ExceptionInformation: [0] the MSVC magic, [1] the thrown object, [2] the type
+         * descriptor, [3] the address that raised. Each target is dumped so the text inside
+         * can be recovered afterwards; raising_site starts a little before the address, so
+         * the instruction sequence that threw is visible too. */
+        nv_dump_words( "thrown_object", (const void *)rec->ExceptionInformation[1], 16 );
+        nv_dump_words( "type_descriptor", (const void *)rec->ExceptionInformation[2], 8 );
+        nv_dump_words( "raising_site", (const void *)(rec->ExceptionInformation[3] - 8), 10 );
+        nv_dump_words( "cxx_stack_at_esp", (const void *)context->Esp, 16 );
+    }
+#endif
+
+#ifdef __i386__
+    /* The demos are 32-bit processes, so in the new WoW64 mode this is the i386 ntdll and the
+     * context already holds the guest registers with their own names. This branch is what
+     * actually produced the useful dump for Luna: an earlier version carried only the
+     * __x86_64__ one and printed headers with no registers at all. */
+    FIXME( "nvlegacy EXCDUMP   eax=%08x ebx=%08x ecx=%08x edx=%08x\n",
+           (unsigned int)context->Eax, (unsigned int)context->Ebx,
+           (unsigned int)context->Ecx, (unsigned int)context->Edx );
+    FIXME( "nvlegacy EXCDUMP   esi=%08x edi=%08x ebp=%08x eip=%08x esp=%08x eflags=%08x\n",
+           (unsigned int)context->Esi, (unsigned int)context->Edi, (unsigned int)context->Ebp,
+           (unsigned int)context->Eip, (unsigned int)context->Esp, (unsigned int)context->EFlags );
+    nv_dump_words( "stack_at_esp", (const void *)context->Esp, 32 );
+    nv_dump_words( "eight_before_eip", (const void *)(context->Eip - 8), 8 );
+    nv_dump_words( "at_eax", (const void *)context->Eax, 8 );
+    nv_dump_words( "at_ebx", (const void *)context->Ebx, 8 );
+    /* The member that turns out to be null sits at +0xC0 of this object (the demo writes the
+     * result of its shader-program factory at 0x4dd938 into 0xc0(%esi), and the crash reads
+     * the same slot at 0x4a1e23). Eight words stopped at +0x1F, so the slot was never shown:
+     * these three windows cover the object up to +0xCF. */
+    nv_dump_words( "ebx_piu_0x40", (const void *)(context->Ebx + 0x40), 16 );
+    nv_dump_words( "ebx_piu_0x80", (const void *)(context->Ebx + 0x80), 16 );
+    nv_dump_words( "ebx_piu_0xc0", (const void *)(context->Ebx + 0xc0), 16 );
+    nv_dump_words( "at_ecx", (const void *)context->Ecx, 8 );
+    nv_dump_words( "at_esi", (const void *)context->Esi, 8 );
+    nv_dump_words( "at_edi", (const void *)context->Edi, 8 );
+    nv_dump_words( "twelve_after_ebp", (const void *)(context->Ebp + 8), 12 );
+#endif
+
+#ifdef __x86_64__
+    /* In the new WoW64 mode 32-bit guest code runs natively, so the guest registers are the
+     * low halves of this context: masking to 32 bits gives exactly what a 32-bit debugger
+     * would show at the same instruction. */
+    FIXME( "nvlegacy EXCDUMP   eax=%08x ebx=%08x ecx=%08x edx=%08x\n",
+           (unsigned int)context->Rax, (unsigned int)context->Rbx,
+           (unsigned int)context->Rcx, (unsigned int)context->Rdx );
+    FIXME( "nvlegacy EXCDUMP   esi=%08x edi=%08x ebp=%08x eip=%08x esp=%08x eflags=%08x\n",
+           (unsigned int)context->Rsi, (unsigned int)context->Rdi, (unsigned int)context->Rbp,
+           (unsigned int)context->Rip, (unsigned int)context->Rsp, (unsigned int)context->EFlags );
+    nv_dump_words( "stack_at_rsp", (const void *)context->Rsp, 24 );
+    nv_dump_words( "eight_before_eip", (const void *)(context->Rip - 8), 8 );
+    nv_dump_words( "at_eax", (const void *)context->Rax, 8 );
+    nv_dump_words( "at_ebx", (const void *)context->Rbx, 8 );
+    nv_dump_words( "at_ecx", (const void *)context->Rcx, 8 );
+    nv_dump_words( "at_esi", (const void *)context->Rsi, 8 );
+    nv_dump_words( "at_edi", (const void *)context->Rdi, 8 );
+    nv_dump_words( "twelve_after_ebp", (const void *)(context->Rbp + 8), 12 );
+#endif
+}
+
+/* nvdbg:end */
 
