+/* Reading another process-visible address must not fault our own module: wow64cpu.dll
+ * cannot use __TRY/__EXCEPT at all (measured the 8th of November 2026: the macros pull
+ * in libs/winecrt0/exception.o and the link of dlls/wow64cpu/x86_64-windows/wow64cpu.dll
+ * fails with an undefined reference), so the read goes through the same syscall the
+ * debuggers use, on our own process. */
+static BOOL nv_read_word( const void *where, unsigned int *out )
+{
+    ULONG_PTR got = 0;   /* the size argument of NtReadVirtualMemory is host-sized */
+    *out = 0;
+    if (NtReadVirtualMemory( NtCurrentProcess(), where, out, sizeof(*out), &got ))
+    {
+        *out = 0;
+        return FALSE;
+    }
+    return got == sizeof(*out);
+}
+
+/* Words in these objects are often pointers into the module's .rdata, where the engine
+ * keeps the names it works with: the parameter name, the shader file name, the technique
+ * name. Printing a word only (measured on Mad Mod Mike) made the one name that mattered
+ * ("const_bias") visible by accident, as four ASCII bytes inside a memory window. So a
+ * word that points at printable text is printed as text as well: it costs one extra
+ * read per word and it turns the dump into something readable instead of something you
+ * get lucky with. */
+static void nv_print_if_string( unsigned int word )
+{
+    static const ULONG sizes[] = { 64, 16, 4 };
+    char buffer[64];
+    ULONG_PTR got = 0;
+    ULONG wanted;
+    unsigned int i;
+    BOOL printable_ok = TRUE;
+    int attempt;
+
+    if (word < 0x10000) return;
+    /* A single read can straddle the end of a page, so shrink until one fits: measured
+     * with the fixed-size read, names that sat near a page boundary printed nothing. */
+    for (attempt = 0; attempt < (int)(sizeof(sizes)/sizeof(sizes[0])); attempt++)
+    {
+        wanted = sizes[attempt];
+        if (!NtReadVirtualMemory( NtCurrentProcess(), (const void *)(ULONG_PTR)word, buffer, wanted, &got ) && got)
+            break;
+    }
+    if (!got) return;
+    for (i = 0; i < got; i++)
+    {
+        if (!buffer[i]) break;
+        if (buffer[i] < 0x20 || buffer[i] > 0x7e) { printable_ok = FALSE; break; }
+    }
+    if (!printable_ok || i == 0) return;
+    buffer[i] = 0;
+    /* nvdbg:begin */
+    FIXME( "nvlegacy EXC32     text: %s\n", buffer );
+    /* nvdbg:end */
+}
