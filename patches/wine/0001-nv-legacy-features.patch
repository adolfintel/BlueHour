+          {
+              BOOL read_ok = FALSE;
+
+              if (make_internal_context_current( src_ctx ? src_ctx : context, pbuffer->drawable ))
+              {
+                  if (nvlegacy_pbuffer_depth_copy() >= 4)
+                  {
+                      /* nvlegacy (mode 4, injection): skip the readback entirely and write a known
+                       * pattern into the application texture: the top quarter at 0.6 (a closer
+                       * surface, so a LEQUAL shadow comparison there must say "occluded") and the
+                       * rest at 1.0 (far, "not occluded"). This is the shortest experiment that
+                       * separates the two remaining hypotheses: if the pattern reaches the sampler,
+                       * the picture must show a band across the shadowed objects; if nothing
+                       * changes, then a write performed here never reaches what the programs read,
+                       * and the problem is the identity of the storage, not the content.
+                       * The isolated reproducer tools/nv_upload_d16.c measured that our stack
+                       * uploads depth correctly in every combination we care about: 256x256,
+                       * DEPTH_COMPONENT16 and 24, GL_FLOAT and GL_UNSIGNED_SHORT, TexImage and
+                       * TexSubImage2D all gave media=0.900000 with texel_a_uno=49152 and
+                       * texel_zero=0, under zink and under llvmpipe. */
+                      int nv_i;
+                      read_ok = TRUE;
+                      /* nvlegacy: the constant pattern of mode 4 proved the write reaches what the
+                       * programs sample, and it moved the picture a lot (mean of the presented
+                       * frame at the eye beat went from 0.155 to 0.501). What is still unknown is
+                       * the orientation and the scale of the map relative to the object we write,
+                       * and orientation is exactly the thing this 2004-era WGL render-texture path
+                       * can get wrong. These modes inject ramps: 7 along x, 8 along y, 9 along y
+                       * flipped. The direction in which the ramp's shadow band travels over the
+                       * creatures and the dome tells us the mapping, straight from the picture. */
+                      for (nv_i = 0; nv_i < width * height; nv_i++)
+                      {
+                          int nv_y = nv_i / width, nv_x = nv_i % width;
+                          float v;
+                          if (nvlegacy_pbuffer_depth_copy() == 7)
+                              v = 0.55f + 0.4f * ((float)nv_x / (float)width);
+                          else if (nvlegacy_pbuffer_depth_copy() == 8)
+                              v = 0.55f + 0.4f * ((float)nv_y / (float)height);
+                          else if (nvlegacy_pbuffer_depth_copy() == 9)
+                              v = 0.95f - 0.4f * ((float)nv_y / (float)height);
+                          else if (nvlegacy_pbuffer_depth_copy() == 10)
+                          {
+                              /* nvlegacy: a single constant over the whole map, asked for with
+                               * WINE_NV_PBUFFER_DEPTH_COPY_LEVEL. Six runs of this, at levels
+                               * 0.05, 0.2, 0.4, 0.6, 0.8 and 0.97, read the distribution of the
+                               * reference depths straight from the picture: the surfaces that flip
+                               * from lit to shadowed between two levels are the ones whose
+                               * reference sits between those two values. If the picture does not
+                               * react at all, the comparison is not being done and the programs
+                               * simply sample a value. */
