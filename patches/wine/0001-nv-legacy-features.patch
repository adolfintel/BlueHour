+/* nv-legacy (fullscreen hack, window piece): the fullscreen hack needs the Windows-side
+ * rectangles to stay at the mode the application chose while the X geometry goes to the real
+ * size. Without this constraint the Windows-side client rect follows the resize the window
+ * manager forces on the X window: measured with the SURFRECT probe going from
+ * (0,0)-(1024,768) to (0,0)-(3840,2160) when the WM maximises. On-screen consequence, as the
+ * user saw it: content in the lower-left corner and the last pixel of every row and column
+ * stretched over the rest (CLAMP_TO_EDGE outside the viewport).
+ *
+ * We do not touch virtual_size: consistency has to be obtained here, as Valve does with the
+ * fs_hack flag on the window. A/B: WINE_NV_FSHACK_WIN=0 turns it off. */
+int nv_fshack_win_enabled( void )
+{
+    static int cached = -1;
+    const char *m, *v;
+
+    if (cached < 0)
+    {
+        m = getenv( "WINE_NV_FSHACK" );
+        v = getenv( "WINE_NV_FSHACK_WIN" );
+        cached = (m && *m && strcmp( m, "0" ) && (!v || strcmp( v, "0" ))) ? 1 : 0;
+    }
+    return cached;
+}
+
+/**
+ * nv-legacy (fullscreen hack, piece F): the X window is presented by scaling the app's mode, so
+ * the pin and the presentation rect have to trigger on GEOMETRY, not on the driver's
+ * is_fullscreen flag. Measured on GasStation: the flag was FALSE (probe: "window NOT marked
+ * fullscreen, not touching monitor_rect") and the presentation stayed 1920x1080, taken from
+ * Wine's per-adapter monitor list, on an X window of 3840x2160 sitting on the 4K panel: the user
+ * saw scaling computed for 1080p. Rule: if the X window is larger than the app's mode the present
+ * is scaling and the window must be aligned to the monitor; otherwise the presentation is 1:1 and
+ * there is nothing to align. The flag, when present, stays a hint.
+ */
+BOOL nv_fshack_window_scaled( struct x11drv_win_data *data )
+{
+    int mw, mh;
+    XWindowAttributes wa;
+
+    if (!data) return FALSE;
+    if (data->is_fullscreen) return TRUE;
+    if (!nv_fshack_mode_size( &mw, &mh )) return FALSE;
+    if (!data->whole_window) return FALSE;
+    if (!XGetWindowAttributes( data->display, data->whole_window, &wa )) return FALSE;
+    return (wa.width > mw && wa.height > mh);
+}
+
+/* size of the fake mode requested by the app (WINE_NV_FSHACK_MODE) */
+BOOL nv_fshack_mode_size( int *w, int *h )
+{
+    static int initial = 0, mw = 0, mh = 0;
+    const char *m;
+
+    if (!initial)
+    {
+        initial = 1;
+        m = getenv( "WINE_NV_FSHACK_MODE" );
+        if (m) sscanf( m, "%dx%d", &mw, &mh );
+    }
+    if (mw < 320 || mh < 200) return FALSE;
+    *w = mw; *h = mh;
+    return TRUE;
+}
+
+/* real rect of the monitor the window lives on, in root coordinates */
+static BOOL nv_fshack_x_real( struct x11drv_win_data *data, XWindowChanges *ch, UINT *mask )
+{
+    RECT mon = nv_fshack_monitor_current( data->display, data->whole_window );
+    int rw = mon.right - mon.left, rh = mon.bottom - mon.top;
+
+    if (!data->whole_window) return FALSE;
+    if (rw < 320 || rh < 200) return FALSE;
+    ch->x = mon.left;
+    ch->y = mon.top;
+    ch->width = rw;
+    ch->height = rh;
+    *mask |= CWX | CWY | CWWidth | CWHeight;
+    return TRUE;
+}
