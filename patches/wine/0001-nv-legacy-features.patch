+static unsigned nv_probe_log;   /* nvlegacy: print counter for the probe */
+
+/* nvlegacy: copy done in EXACTLY the way the probe reads the content (readback of fb 0
+ * of the probed context) and uploaded into the texture in the application's context.
+ * Returns TRUE if it transferred something plausible. */
+static BOOL nv_pbuffer_copy_in_line( struct pbuffer *pbuffer, struct opengl_context *ctx,
+                                      GLuint texture, const struct opengl_funcs *funcs,
+                                      float *min_out, int *cov_out, struct opengl_context *upload_ctx )
+{
+    struct opengl_drawable *d = pbuffer->drawable;
+    GLint w, h, alline;
+    float *client_data;
+    unsigned i, nz = 0;
+    float min = 1.0f;
+
+    *min_out = 1.0f; *cov_out = 0;
+    if (!d || !texture) return FALSE;
+    w = d->virtual_size.cx; h = d->virtual_size.cy;
+    if (w <= 0 || h <= 0 || pbuffer->texture_target != GL_TEXTURE_2D) return FALSE;
+    if (!(client_data = calloc( (size_t)w * h, sizeof(*client_data) ))) return FALSE;
+
+    if (!make_internal_context_current( ctx, d )) { free( client_data ); return FALSE; }
+    funcs->p_glBindFramebuffer( GL_READ_FRAMEBUFFER, 0 );
+    funcs->p_glPixelStorei( GL_PACK_ALIGNMENT, 1 );
+    funcs->p_glGetIntegerv( GL_PACK_ALIGNMENT, &alline );
+    funcs->p_glReadPixels( 0, 0, w, h, GL_DEPTH_COMPONENT, GL_FLOAT, client_data );
+    funcs->p_glPixelStorei( GL_PACK_ALIGNMENT, alline );
+    funcs->p_glGetError();
+    for (i = 0; i < (unsigned)w * (unsigned)h; i++)
+    {
+        if (client_data[i] < min) min = client_data[i];
+        if (client_data[i] < 0.999f) nz++;
+    }
+    *min_out = min;
+    *cov_out = (int)(nz * 1000 / ((unsigned)w * (unsigned)h));
+
+    if (upload_ctx && upload_ctx != ctx && make_internal_context_current( upload_ctx, d ))
+    {
+        /* nvlegacy: the texture lives in the context that bound it: uploading it in the swap's
+                 * context meant writing to a different namesake (GL names are per-context). */
+    }
+    else make_client_context_current();
+    funcs->p_glPixelStorei( GL_UNPACK_ALIGNMENT, 1 );
+    funcs->p_glBindTexture( pbuffer->texture_target, texture );
+    /* nvlegacy: the upload must use the textures REAL format/type. On 512^2 GL_FLOAT worked
+         * (true texture after upload = 0.5/0.7033/59.332 percent, identical to the source) but on
+         * 1024^2 the texture is DEPTH_COMPONENT24 (0x81A6, measured) and a GL_FLOAT upload did not
+         * take (texture still 1.0 although the readback had min 0.9285, coverage 2.46 percent):
+         * with an immutable format the type has to match. */
+    {
+        GLint inner = 0, pix_kind = GL_FLOAT;
+        unsigned i2;
+        funcs->p_glGetTexLevelParameteriv( pbuffer->texture_target, 0, GL_TEXTURE_INTERNAL_FORMAT, &inner );
+        /* nvlegacy: do NOT convert to integers: Mesa reads GL_UNSIGNED_INT on depth textures as
+                 * UNORM32 (measured: 0.9285 stored as 16777215 came back as 0.0039 =
+                 * 16777215/2^32), so the correct type stays GL_FLOAT, which on 512^2 does bring
+                 * the content through (true texture after upload = 0.5/0.7033/59.332 percent,
+                 * identical to the source). */
+        if (inner == 0x88F0 /* DEPTH24_STENCIL8 */) pix_kind = 0x8414;   /* only packed zs */
+        else if (inner == 0x88F0 /*DEPTH24_STENCIL8*/) pix_kind = 0x8414 /*UNSIGNED_INT_24_8*/;
+        funcs->p_glTexSubImage2D( nv_pbuffer_image_target( pbuffer ), 0, 0, 0, w, h, GL_DEPTH_COMPONENT, GL_FLOAT, client_data );
+        (void)i2;
+    }
+    free( client_data );
+    return min < 0.999f;
+}
+
+static struct opengl_context *nv_pbuffer_pick_full_context( struct pbuffer *pbuffer,
+                                                                const struct opengl_funcs *funcs )
+{
+    unsigned i;
+    float min;
+    int cov;
+
+    if (!pbuffer || !pbuffer->drawable) return NULL;
+    if (pbuffer->nv_context_full)
+    {
+        min = nv_fb0_depth_min( pbuffer->nv_context_full, pbuffer, funcs, &cov );
+        if (min < 0.999f && min > 0.01f && cov >= 1) return pbuffer->nv_context_full;
+        pbuffer->nv_context_full = NULL;
+    }
+    for (i = 0; i < pbuffer->nv_n_contexts; i++)
+    {
+        struct opengl_context *ctx = pbuffer->nv_contexts[i];
+        if (!ctx) continue;
+        min = nv_fb0_depth_min( ctx, pbuffer, funcs, &cov );
+        if (min < 0.999f && min > 0.01f && cov >= 1)
+        {
+            pbuffer->nv_context_full = ctx;
+            return ctx;
+        }
+    }
+    return NULL;
+}
