+static BOOL bind_depth_buffer_to_texture( struct pbuffer *pbuffer )
+{
+    static const GLenum framebuffer_complete = 0x8cd5; /* GL_FRAMEBUFFER_COMPLETE; 0x8cd9 is INCOMPLETE_DIMENSIONS */
+    const struct opengl_funcs *funcs = &display_funcs;
+    struct opengl_context *context = NtCurrentTeb()->glReserved2;
+    struct opengl_drawable *old_draw, *old_read;
+    BOOL activation_skipped = FALSE;   /* nvlegacy (0052) */
+    GLenum target = pbuffer->texture_target ? pbuffer->texture_target : GL_TEXTURE_2D;
+    /* nvlegacy (00xx): a cube render-texture pbuffer has no size on the cube target
+     * itself. Querying level 0 of GL_TEXTURE_CUBE_MAP answers 0x0, and every branch below
+     * that needs a size then refuses to do anything, so the bind returns FALSE. Measured on
+     * Mad Mod Mike: 193 of our 2515 wglBindTexImageARB calls returned FALSE, all of them on
+     * one pbuffer (0x10005, 96x96, created with WGL_DEPTH_TEXTURE_FORMAT_NV and bound with
+     * texture_target = GL_TEXTURE_CUBE_MAP), i.e. once per frame; the reference trace of the
+     * same demo has 0 FALSE in 8366 binds. That pbuffer is a 96x96 depth cube map - a point
+     * light's shadow map - so the demo logged "NRPbuffer::Bind: failed to bind depth" and
+     * sampled a texture we never filled. The dimensions of a cube live on its faces, and
+     * the face the application selected with WGL_CUBE_MAP_FACE_ARB is already tracked in
+     * pbuffer->cube_face: ask the face, and attach the face. */
+    GLenum attach_target = target;
+    if (target == GL_TEXTURE_CUBE_MAP /*0x8513*/)
+        attach_target = pbuffer->cube_face ? pbuffer->cube_face : GL_TEXTURE_CUBE_MAP_POSITIVE_X;
+    GLint prev_tex = 0, prev_read_fbo = 0, prev_draw_fbo = 0;
+    GLint prev_pack = 4, prev_unpack = 4, width = 0, height = 0;
+    BOOL nv_keep_restored = FALSE;   /* nvlegacy: we filled an empty binding slot, put it back */
+    GLuint fbo = 0;
+    float *buffer = NULL;
+    BOOL done = FALSE;
+
+    if (!context)
+    {
+        WARN( "no current context for a depth texture bind\n" );
+        RtlSetLastWin32Error( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+
+    /* ROOT CAUSE: the app binds the texture in the CLIENT context, but here display_funcs
+         * were used with the current host context: glGetIntegerv(TEXTURE_BINDING_2D) read 0 and the
+         * copy never STARTED (measured: 3 entries out of 3355 bindings). It also makes the fb 0 of
+         * the earlier step correct: fb 0 is the system framebuffer of the context where the app DID
+         * draw. The colour path already does this. */
+    make_client_context_current();
+    /* nvlegacy: if the current context does not have the draw in this pbuffer's system
+         * framebuffer, switch to the context that does. Without creating GL objects: the
+         * persistent FBO owned by Wine corrupted the image (steps 0035..0046). */
+
+    funcs->p_glGetIntegerv( binding_from_target( target ), &prev_tex );
+    /* nvlegacy: keep the (pbuffer,buffer) -> texture association while it is visible, and put it
+     * back when the application re-binds the pair with all its texture units reset to 0. The old
+     * fallback to GL_TEXTURE_BINDING_2D is kept only as a last resort: on Mad Mod Mike it picked a
+     * different object than the one the shaders sample, so the copies reported success and the
+     * sampled map stayed zero. */
+    if (nvlegacy_rt_keep_bind())
+    {
+        if (prev_tex)
+        {
+            pbuffer->nv_keep_depth_bind.tex = (GLuint) prev_tex;
+            pbuffer->nv_keep_depth_bind.target = target;
+        }
+        else if (pbuffer->nv_keep_depth_bind.tex)
+        {
+            prev_tex = (GLint) pbuffer->nv_keep_depth_bind.tex;
+            target = pbuffer->nv_keep_depth_bind.target;
+            /* attach_target was already computed from pbuffer->texture_target by the cube-face
+             * helper above, so it needs no recomputation here. */
+            funcs->p_glBindTexture( attach_target, prev_tex );
+            nv_keep_restored = TRUE;
+        }
+        else if (target != GL_TEXTURE_2D)
+            funcs->p_glGetIntegerv( GL_TEXTURE_BINDING_2D, &prev_tex );
+    }
+    else if (!prev_tex && target != GL_TEXTURE_2D)
+        funcs->p_glGetIntegerv( GL_TEXTURE_BINDING_2D, &prev_tex );
+    nv_prev_tex_name = (GLuint)prev_tex;   /* nvlegacy: the DEPTH-B trace_on exposes itIND */
+    /* nvlegacy (1b): remember the application's cube DEPTH texture object for this pbuffer, so
+     * the per-face store can attach the face the application selected. Without this the store
+     * never runs for a depth pbuffer, because nv_cube_tex is only filled by the colour bind. */
+    if (pbuffer->texture_target == GL_TEXTURE_CUBE_MAP && prev_tex)
+    {
+        if (!pbuffer->nv_cube_tex) pbuffer->nv_cube_tex = (GLuint) prev_tex;
+    }
+
+    nv_depth_bind_trace( "entry", pbuffer, target, 0, 0, FALSE, 0 );
+    /* nvlegacy (1b): if the per-face store is attached, the application's own draws already
+     * landed in this face; copying the pbuffer surface over it afterwards would put the last
+     * rendered face back into every face, which is the defect being measured. */
+    if (pbuffer->nv_cube_attached && pbuffer->nv_cube_attached == pbuffer->cube_face)
+    {
+        done = TRUE;
+    }
+    if (!prev_tex)
+    {
+        FIXME( "no texture bound for a depth texture bind\n" );
+        RtlSetLastWin32Error( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+
+    /* nvlegacy: UNCONDITIONAL print (it used to be inside the `!=` branch, so "zero prints"
+         * could not tell matching contexts from a missing registration - a print in a
+         * conditional branch only measures the cases where the condition holds). */
+    if (nvlegacy_depth_bind_ctx() && pbuffer->nv_last_context
+        && pbuffer->nv_last_context != context)
+    {
+        context = pbuffer->nv_last_context;
+    }
+
+    /* nvlegacy: if the pbuffer is ALREADY current in this context, do not activate it
+         * again: drawable_activate() restarts the drawable activation and the system
+         * framebuffer is created anew with fresh depth - the only way I found to explain
+         * that the probe reads content (min 0.9330) while the copy a few lines later reads
+         * 1.0 in the same context. */
+    activation_skipped = (nvlegacy_depth_keep_current() && get_target( context->draw ) == pbuffer->drawable);
+    if (activation_skipped)
+    {
+    }
+    else if (!drawable_activate( context, pbuffer->drawable, &old_draw, &old_read ))
+    {
+        ERR( "failed to make the pbuffer current for a depth bind\n" );
+        return FALSE;
+    }
+    /* nvlegacy: the helper that creates the per-context store refuses to act unless the
+     * drawable is marked as a render texture, and that mark was only set when the global
+     * WINE_NV_PBUFFER_RT_FBO path was on. On a depth render-texture bind the application IS
+     * using the pbuffer as a render texture, which is the fact the mark is meant to record:
