diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
index 0127a05..be2ce40 100644
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -2470,8 +2470,79 @@ NTSTATUS WINAPI NtDelayExecution( BOOLEAN alertable, const LARGE_INTEGER *timeou
  */
 NTSTATUS WINAPI NtQueryPerformanceCounter( LARGE_INTEGER *counter, LARGE_INTEGER *frequency )
 {
-    counter->QuadPart = monotonic_counter();
+    /* Deterministic clock support (nv-legacy-toolchain).
+     *
+     * WINE_QPC_STEP=<nanoseconds per read> replaces the host clock with a
+     * synthetic, strictly increasing one: the n-th read returns base + n*step.
+     * Applications that advance their animation from the elapsed time - the
+     * 2002..2005 era WGL/Cg tech demos do exactly that - then evolve in the
+     * same way in every execution, which is what frame exact A/B rendering
+     * comparisons need.  Without the variable the host clock is used and
+     * behaviour is unchanged.
+     */
+    static LONG64 det_mode; /* 0 = not resolved, 1 = host clock, 2 = per-read step, 3 = quantized */
+    static LONG64 det_step; /* counter ticks handed out per read */
+    static LONG64 det_base; /* ticks returned for the very first read */
+    static LONG64 det_reads;
+    static LONG64 det_quant; /* counter ticks of the quantisation grid */
+    static LONG64 det_report; /* report the read counter every N reads */
+
     if (frequency) frequency->QuadPart = TICKSPERSEC;
+
+    if (!det_mode)
+    {
+        const char *e = getenv( "WINE_QPC_STEP" );
+        const char *q = getenv( "WINE_QPC_QUANT" );
+        const char *r = getenv( "WINE_QPC_REPORT" );
+        LONG64 ns = (e && *e) ? strtoll( e, NULL, 0 ) : 0;
+        LONG64 qns = (q && *q) ? strtoll( q, NULL, 0 ) : 0;
+        det_report = (r && *r) ? strtoll( r, NULL, 0 ) : 0;
+        det_base = monotonic_counter();
+        if (qns > 0)
+        {
+            det_quant = qns * TICKSPERSEC / 1000000000;
+            if (!det_quant) det_quant = 1;
+            det_mode = 3;
+            MESSAGE( "WINE_QPC_QUANT: clock real rounded to %s ns\n", q );
+        }
+        else if (ns > 0)
+        {
+            det_step = ns * TICKSPERSEC / 1000000000;
+            if (!det_step) det_step = 1;
+            det_mode = 2;
+            MESSAGE( "WINE_QPC_STEP: synthetic clock, %s ns per nv_counter read\n", e );
+        }
+        else det_mode = 1;
+    }
+
+    if (det_mode == 2)
+    {
+        LONG64 n = __atomic_fetch_add( &det_reads, 1, __ATOMIC_RELAXED );
+        counter->QuadPart = det_base + n * det_step;
+
+        /* WINE_QPC_REPORT=<n>: print how many times the counter has been read.
+         * Demos that advance their animation from elapsed time read the counter
+         * a fixed number of times per rendered frame, so dividing this counter
+         * by the number of frames gives that per-frame read count - which is
+         * what converts a desired "16.7 ms per frame" into a WINE_QPC_STEP
+         * value (the step is nanoseconds per read, not per frame).
+         */
+        if (det_report > 0 && !(n % det_report))
+            MESSAGE( "WINE_QPC_REPORT: %lu nv_counter QPC reads\n", (unsigned long)n );
+    }
+    else if (det_mode == 3)
+    {
+        /* Real clock, but snapped to a grid: every read inside the same grid
+         * cell returns the same value.  Combined with an absolute swap cadence
+         * this makes the per-frame time delta exactly constant, so the
+         * application still evolves identically in every run while following
+         * real elapsed time (which is what a reference video uses). */
+        LONG64 now;
+        now = monotonic_counter() - det_base;
+        counter->QuadPart = det_base + (now / det_quant) * det_quant;
+    }
+    else counter->QuadPart = monotonic_counter();
+
     return STATUS_SUCCESS;
 }
 
