+/* nvlegacy: we are about to detach the context from its drawable: if it was a pbuffer
+ * used as a depth render texture, copy NOW. It is the only moment when this contexts
+ * SYSTEM framebuffer really holds the draw: at the binding (done by another context)
+ * and at the swap the current contexts store reads empty (depth 1.0, coverage 0.000
+ * percent) while Mesa measures real content in the one that drew. No new GL object: we
+ * read the system framebuffer (fb 0). */
+static void nv_pbuffer_detach_copy( struct opengl_context *context )
+{
+    unsigned i;
+    struct opengl_drawable *drawable;
+    const struct opengl_funcs *funcs = &display_funcs;
+
+    if (!nvlegacy_pbuffer_detach_copy() || !context) return;
+    if (!(drawable = get_target( context->draw ))) return;
+
+    for (i = 0; i < nv_late_n; i++)
+    {
+        struct pbuffer *p = nv_late[i].pbuffer;
+        if (!p || p->drawable != drawable) continue;
+        if (!nv_pbuffer_binds_depth( p )) continue;
+        funcs->p_glBindTexture( p->texture_target, nv_late[i].texture );
+        bind_depth_buffer_to_texture( p );
+    }
+}
