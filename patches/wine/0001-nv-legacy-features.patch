+    if (!dpy) dpy = gdi_display;
+
+    if (w)
+    {
+        Window child_ret;
+        int wx = 0, wy = 0;
+        XWindowAttributes wa;
+        if (XGetWindowAttributes( dpy, w, &wa ))
+        {
+            if (!XTranslateCoordinates( dpy, w, DefaultRootWindow( dpy ), 0, 0, &wx, &wy, &child_ret ))
+            {
+                wx = wa.x;
+                wy = wa.y;
+            }
+            nv_wnd.left = wx;
+            nv_wnd.top = wy;
+            nv_wnd.right = wx + wa.width;
+            nv_wnd.bottom = wy + wa.height;
+        }
+    }
+
+    /* Primary source of truth: Xinerama, which gives rectangles in root coordinates.
+         * The "host" list in this same function returns per-adapter rectangles with their
+         * own origins (measured) and cannot be used for overlap with the X window. */
+    if ((n = nv_xinerama_rects( candidates, 16, &primary_rect )) > 0)
+    {
+        RECT best_rect = {0, 0, 0, 0};
+        unsigned long area_best = 0;
+
+        for (i = 0; i < n; i++)
+        {
+            RECT r = candidates[i];
+            LONG l, t_, rr, b;
+            unsigned long area;
+
+            if (r.right <= r.left || r.bottom <= r.top) continue;
+
