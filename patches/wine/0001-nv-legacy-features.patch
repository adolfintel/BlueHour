+/* nvlegacy: CHEAP probe (64x64 in the middle) of the pbuffer drawable's SYSTEM
+ * framebuffer in our context: returns the minimum depth read and coverage in
+ * thousandths. A context that drew the shadow map has min<1; one that never drew is 1
+ * everywhere. */
+static float nv_fb0_depth_min( struct opengl_context *ctx, struct pbuffer *pbuffer,
+                           const struct opengl_funcs *funcs, int *milliseconds )
+{
+    static float probe_values[64 * 64];
+    struct opengl_drawable *d = pbuffer->drawable;
+    int i, below = 0;
+    float min = 1.0f;
+    int w, h, bw, bh, x0, y0, n_read;
+
+    *milliseconds = 0;
+    if (!ctx || !d) return 1.0f;
+    w = d->virtual_size.cx; h = d->virtual_size.cy;
+    if (w <= 0 || h <= 0) return 1.0f;
+    if (!make_internal_context_current( ctx, d )) return 1.0f;
+    bw = w > 64 ? 64 : w; bh = h > 64 ? 64 : h;
+    x0 = (w - bw) / 2; y0 = (h - bh) / 2;
+    funcs->p_glBindFramebuffer( GL_READ_FRAMEBUFFER, 0 );
+    funcs->p_glPixelStorei( GL_PACK_ALIGNMENT, 1 );
+    funcs->p_glReadPixels( x0, y0, bw, bh, GL_DEPTH_COMPONENT, GL_FLOAT, probe_values );
+    n_read = bw * bh;
+    for (i = 0; i < n_read; i++)
+    {
+        if (probe_values[i] < min) min = probe_values[i];
+        if (probe_values[i] < 0.999f) below++;
+    }
+    *milliseconds = n_read ? below * 1000 / n_read : 0;
+    funcs->p_glGetError();
+    return min;
+}
