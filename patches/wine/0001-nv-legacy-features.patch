+    funcs->p_glBindTexture( target, prev_tex );
+    funcs->p_glGetTexLevelParameteriv( attach_target, 0, GL_TEXTURE_WIDTH, &width );
+    funcs->p_glGetTexLevelParameteriv( attach_target, 0, GL_TEXTURE_HEIGHT, &height );
