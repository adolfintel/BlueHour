+            nv_select_read_buffer( funcs, pbuffer, "before the readback" );
+            funcs->p_glReadPixels( 0, 0, width, height, GL_DEPTH_COMPONENT, GL_FLOAT, buffer );
+            {
+                GLenum e = funcs->p_glGetError();
+                if (e) goto done;
+            }
+            funcs->p_glBindTexture( target, prev_tex );
+            funcs->p_glTexSubImage2D( target, 0, 0, 0, width, height, GL_DEPTH_COMPONENT, GL_FLOAT, buffer );
+            funcs->p_glGetError();
+            {
+                /* nvlegacy: direct verdict - what the texture REALLY holds after the upload. */
+                funcs->p_glBindFramebuffer( GL_READ_FRAMEBUFFER, fbo );
+            }
+            done = TRUE;
+        }
+    }
+
+done:
+    /* nvlegacy: the binding slot was empty when the application asked for this bind; leave it
+     * empty again instead of leaving our recalled texture bound in the application's context. */
+    if (nv_keep_restored) funcs->p_glBindTexture( attach_target, 0 );
+    funcs->p_glBindFramebuffer( GL_READ_FRAMEBUFFER, prev_read_fbo );
+    funcs->p_glBindFramebuffer( GL_DRAW_FRAMEBUFFER, prev_draw_fbo );
+    if (fbo) funcs->p_glDeleteFramebuffers( 1, &fbo );
+    funcs->p_glPixelStorei( GL_PACK_ALIGNMENT, prev_pack );
+    funcs->p_glPixelStorei( GL_UNPACK_ALIGNMENT, prev_unpack );
+    free( buffer );
+    if (!activation_skipped) drawable_restore( context, old_draw, old_read );   /* nvlegacy (0052) */
+
+    if (!done)
+    {
+        WARN( "could not bind the pbuffer depth buffer to a texture\n" );
+        RtlSetLastWin32Error( ERROR_INVALID_HANDLE );
+    }
+    return done;
+}
+
+/* WINE_NV_PBUFFER_READ_FBO=1: if the pbuffer drawable owns an FBO (our patches create
+ * one for float/RT pbuffers) the READ SOURCE must be that FBO, not default framebuffer
+ * 0. It was already measured that in the colour branch the pixels read from the pbuffer
+ * are always zero (1733 bindings 512x512, nonzero=0): if the app drew inside the
+ * drawable's FBO, reading from 0 means reading another, empty surface. The depth binding
+ * too - the one that carries content and fixed the shadows - goes through
+ * drawable_activate() on the application's context, not through 0. Off by default: the
+ * historical behaviour does not change until the knob is turned on (in the gate, per
+ * executable). */
+
+
+/* WINE_NV_PBUFFER_FLIP=1 (experiment, off by default): flips the row order of the pixels
+ * read from the pbuffer before loading them into the texture. The measurement that
+ * suggests it: in Nalu's god-ray texture (mermaid.exe) the sun disc is at the BOTTOM
+ * (tex_77 dump: centre toward the lower edge) while on screen the halo is at the TOP. If
+ * delivery flipped the content relative to the context sampling it, correct radial beams
+ * become a diffuse blotch - exactly the "all or nothing" symptom. */
+/* WINE_NV_PBUFFER_FLIP=1: flip the row order of the pixels read from a colour pbuffer before
+ * they are uploaded into the application's texture. WINE_NV_PBUFFER_FLIP_SIZES=<WxH[,WxH]>
+ * restricts it to the sizes named; without the list every colour pbuffer is flipped.
+ *
+ * This started as a guess for Nalu and is now measured on Mad Mod Mike (2026-11-16): the two
+ * 428x240 bloom stores, dumped exactly as they are handed to the application's texture, contain
+ * the scene turned upside down - Mike's helmet below his chin, the jetpack flames pointing up,
+ * the ceiling where the floor is. The composite heat pass then mixes a mirrored image into an
+ * upright frame, which is the shape of the defect that was being chased: a hard-edged rectangle
+ * with a stretched, duplicated figure inside it. The dump is written before any viewer-side
+ * flip, and the dump reader already flips once, so the inversion is in the delivered storage. */
+static int
+nvlegacy_pbuffer_flip( void )
+{
+    static int cached = -1;
+    if (cached < 0) cached = getenv( "WINE_NV_PBUFFER_FLIP" ) ? 1 : 0;
+    return cached;
+}
+
+static int
+nvlegacy_pbuffer_flip_size( int w, int h )
+{
+    const char *list = getenv( "WINE_NV_PBUFFER_FLIP_SIZES" );
+    char buf[512], *tok;
+    int sw = 0, sh = 0;
+
+    if (!list || !*list)
+        return 1;
+    snprintf( buf, sizeof(buf), "%s", list );
+    for (tok = strtok( buf, ",;" ); tok; tok = strtok( NULL, ",;" ))
+    {
+        sw = sh = 0;
+        if (sscanf( tok, "%dx%d", &sw, &sh ) == 2 && sw == w && sh == h)
+            return 1;
+    }
+    return 0;
+}
