+            nv_late[i].target = target;
+            nv_late[i].ctx = NtCurrentTeb()->glReserved2;   /* nvlegacy (0057) */
+            return;
+        }
+    }
+    if (nv_late_n < sizeof(nv_late) / sizeof(nv_late[0]))
+    {
+        nv_late[nv_late_n].pbuffer = pbuffer;
+        nv_late[nv_late_n].texture = texture;
+        nv_late[nv_late_n].target = target;
+        nv_late[nv_late_n].ctx = NtCurrentTeb()->glReserved2;   /* nvlegacy (0057) */
