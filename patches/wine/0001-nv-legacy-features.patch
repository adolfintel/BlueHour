+/* nvlegacy: cheap probe (64x64) of the drawable's persistent store in our context:
+ * returns the minimum depth read and the coverage in thousandths. A store something
+ * drew into has min < 1; a fresh one is 1 everywhere. */
+static float nv_rt_depth_min( struct opengl_context *ctx, struct opengl_drawable *drawable,
+                          const struct opengl_funcs *funcs, int *milliseconds )
+{
+    static float probe_values[64 * 64];
+    GLuint fbo;
+    float min = 1.0f;
+    int i, below = 0;
+
+    *milliseconds = 0;
+    if (!(fbo = nv_rt_fb_per_ctx( drawable, ctx ))) return 1.0f;
+    if (!make_internal_context_current( ctx, drawable )) return 1.0f;
+    funcs->p_glBindFramebuffer( GL_READ_FRAMEBUFFER, fbo );
+    {
+        int w = drawable->virtual_size.cx, h = drawable->virtual_size.cy;
+        int x0 = w > 64 ? (w - 64) / 2 : 0;      /* nvlegacy (0046): the probe sits at the CENTER */
+        int y0 = h > 64 ? (h - 64) / 2 : 0;      /* the corner misled us (0.399% vs 59.332%) */
+        if (w <= 0 || h <= 0) return 1.0f;
+        if (w < 64 || h < 64)
+        {
+            float *probe_small = calloc( (size_t)w * h, sizeof(*probe_small) );
+            if (!probe_small) return 1.0f;
+            funcs->p_glReadPixels( 0, 0, w, h, GL_DEPTH_COMPONENT, GL_FLOAT, probe_small );
+            for (i = 0; i < 64 * 64; i++) probe_values[i] = probe_small[i < w * h ? i : 0];
+            free( probe_small );
+        }
+        else funcs->p_glReadPixels( x0, y0, 64, 64, GL_DEPTH_COMPONENT, GL_FLOAT, probe_values );
+    }
+    for (i = 0; i < 64 * 64; i++)
+    {
+        if (probe_values[i] < min) min = probe_values[i];
+        if (probe_values[i] < 0.999f) below++;
+    }
+    *milliseconds = below * 1000 / (64 * 64);
+    funcs->p_glBindFramebuffer( GL_READ_FRAMEBUFFER, 0 );
+    funcs->p_glGetError();
+    return min;
+}
