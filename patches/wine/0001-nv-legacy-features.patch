+/* nv-legacy (fullscreen hack, piece E): monitor rectangles in ROOT
+ * coordinates, taken from the Xinerama list already built by query_screens().
+ * Needed because the "host" list in display.c (get_monitors) returns per-adapter
+ * rectangles with their own origins. Measured on this desk (DP-2 3840x2160+0+0 and
+ * HDMI-A-2 1920x1080+3840+0) the host list reported 1080p (0,0)-(1920,1080) and 4K
+ * (-3840,0)-(0,2160), so picking the monitor by overlap with the X window chose the
+ * 1080p while the X window was at (0,0) sized 3840x2160: presentation and input ended
+ * up on a rect other than the real one.
+ */
+int nv_xinerama_rects( RECT *rett, int max_val, RECT *primary_rect )
+{
+    int i, count;
+
+    pthread_mutex_lock( &xinerama_mutex );
+    count = query_screens();
+    if (count > 0)
+    {
+        for (i = 0; i < count && i < max_val; i++)
+            rett[i] = monitors[i].rcMonitor;
+        if (primary_rect) *primary_rect = get_primary()->rcMonitor;
+    }
+    pthread_mutex_unlock( &xinerama_mutex );
+    return count;
+}
