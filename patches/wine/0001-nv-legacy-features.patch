+              }
+
+          }
+          else
+          {
+          }
+          free( pixels );
+      }
+
+    if (width > 0 && height > 0)
+    {
+        funcs->p_glDisable( GL_SCISSOR_TEST );
+        funcs->p_glPixelStorei( GL_PACK_ALIGNMENT, 1 );
+        funcs->p_glPixelStorei( GL_UNPACK_ALIGNMENT, 1 );
+        funcs->p_glGenFramebuffers( 1, &fbo );
+        funcs->p_glBindFramebuffer( GL_DRAW_FRAMEBUFFER, fbo );
+        funcs->p_glFramebufferTexture2D( GL_DRAW_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, attach_target, prev_tex, 0 );
+
+        {
+            GLint nv_state = funcs->p_glCheckFramebufferStatus( GL_DRAW_FRAMEBUFFER );
+        }
+        if (nvlegacy_depth_force_readback())
+        {
+        }
+        else if (funcs->p_glCheckFramebufferStatus( GL_DRAW_FRAMEBUFFER ) == framebuffer_complete)
+        {
+            /* ROOT CAUSE: reading from nv_rt_fb(pbuffer) meant reading the PERSISTENT FBO created
+                         * by WINE, whose depth is its own renderbuffer (empty/cleared) and NOT the
+                         * pbuffer's zs where the app drew the shadows. Knob WINE_NV_RT_READ_FBO0=0
+                         * returns to the previous behaviour. */
+            {
+                unsigned fb_legg = nvlegacy_rt_read_fb0() ? 0 : nv_rt_fb( pbuffer );
+                funcs->p_glBindFramebuffer( GL_READ_FRAMEBUFFER, fb_legg );
+            }
+            funcs->p_glBindFramebuffer( GL_DRAW_FRAMEBUFFER, fbo );
+            nv_select_read_buffer( funcs, pbuffer, "before the blit" );
+    nv_sample_required++;   /* 0060  */
+            funcs->p_glBlitFramebuffer( 0, 0, width, height, 0, 0, width, height, GL_DEPTH_BUFFER_BIT, GL_NEAREST );
+            {
+                GLenum e = funcs->p_glGetError();
