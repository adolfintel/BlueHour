+static void drawable_restore( struct opengl_context *context, struct opengl_drawable *old_draw,
+                              struct opengl_drawable *old_read )
+{
+    struct opengl_drawable *d = context->draw, *r = context->read;
+
+    if (!old_draw || !old_read)
+    {
+        FIXME( "no previous drawables to restore to, leaving the pbuffer current\n" );
+        return;
+    }
+
+    if (!driver_funcs->p_context_activate( context, get_target( old_draw ), get_target( old_read ) ))
+        ERR( "Failed to restore context drawables, expect trouble\n" );
