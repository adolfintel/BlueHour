+            if (force && !strcmp( force, "primary" ))
+            {
+                if (primary_rect.right > primary_rect.left) best_rect = primary_rect;
+                break;
+            }
+            if (!(nv_wnd.right > nv_wnd.left))
+            {
+                if (!best_rect.right) best_rect = r;
+                continue;
+            }
+            l = max( r.left, nv_wnd.left );
+            t_ = max( r.top, nv_wnd.top );
+            rr = min( r.right, nv_wnd.right );
+            b = min( r.bottom, nv_wnd.bottom );
+            area = (rr > l && b > t_) ? (unsigned long)(rr - l) * (unsigned long)(b - t_) : 0;
+            if (area > area_best)
+            {
+                area_best = area;
+                best_rect = r;
+            }
+        }
+        /* No useful overlap (small or off-screen window): take the primary. */
+        if (!area_best && primary_rect.right > primary_rect.left) best_rect = primary_rect;
+        if (best_rect.right > best_rect.left && best_rect.bottom > best_rect.top)
+        {
+            chosen = best_rect;
+            return chosen;
+        }
+    }
+
+    /* Fallback: the last valid choice, then DisplayWidth/DisplayHeight (with two monitors
+         * that is the union: the worst behaviour, but better than nothing). */
+    if (chosen.right > chosen.left) return chosen;
+
+    {
+        RECT r = {0, 0, 0, 0};
+        r.right = XDisplayWidth( dpy, DefaultScreen( dpy ) );
+        r.bottom = XDisplayHeight( dpy, DefaultScreen( dpy ) );
+        chosen = r;
+        return chosen;
+    }
