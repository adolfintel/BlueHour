+                nv_sample_required++;   /* 0060  */
+                /* nvlegacy: the app binds the DEPTH render texture before rendering into the pbuffer
+                                 * (measured: the source at bind time is always empty, coverage 0.000
+                                 * percent on the 1024x1024). With the reference driver the texture WAS
+                                 * the pbuffer store (zero-copy aliasing), so later draws showed up
+                                 * anyway. Here we remember the pbuffer/texture pair and redo the copy at
+                                 * the end of the frame, when the pbuffer really holds the draw. Enabled
