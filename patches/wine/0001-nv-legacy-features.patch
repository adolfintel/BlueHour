+        if (!done)
+        {
+            /* Depth formats do not match (or the blit failed): read back and
+             * upload the depth values instead.  Slower, but format agnostic. */
+            if (!(buffer = malloc( (size_t)width * height * sizeof(*buffer) )))
+                goto done;
