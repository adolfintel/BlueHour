+            && inner != 0x81A5 /*DEPTH_COMPONENT16*/ && inner != 0x81A6 /*DEPTH_COMPONENT24*/
+            && inner != 0x81A7 /*DEPTH_COMPONENT32*/ && inner != 0x8CAC /*DEPTH_COMPONENT32F*/
+            && inner != 0x88F0 /*DEPTH24_STENCIL8*/ && inner != 0x8CAD /*DEPTH32F_STENCIL8*/
+            && inner != 0x1901 /*STENCIL_INDEX*/ && inner != 0x8D46 /*STENCIL_INDEX1*/
+            && inner != 0x8D47 /*STENCIL_INDEX4*/ && inner != 0x8D48 /*STENCIL_INDEX8*/)   /* nvlegacy: enums verified against glext.h/gl.h */
