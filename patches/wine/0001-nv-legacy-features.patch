+/* nvlegacy (0049): copy on detach, on/off for A/B. */
+static int nvlegacy_pbuffer_detach_copy( void )
+{
+    static int cached = -1;
+    if (cached < 0)
+    {
+        const char *e = getenv( "WINE_NV_PBUFFER_DETACH_COPY" );
+        cached = (e && atoi(e)) ? 1 : 0;
+    }
+    return cached;
+}
