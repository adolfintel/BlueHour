+/* nvlegacy (0050b): Knob A/B. */
+static int nvlegacy_depth_pick_ctx( void )
+{
+    static int cached = -1;
+    if (cached < 0)
+    {
+        const char *e = getenv( "WINE_NV_DEPTH_PICK_CTX" );
+        cached = (e && atoi(e)) ? 1 : 0;
+    }
+    return cached;
+}
