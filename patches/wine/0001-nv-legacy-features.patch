+        /* nvlegacy: registration for the late copy done ALWAYS, not only when the blit
+                 * succeeds: on Nalu the blit errored and the late copy never started (measured:
+                 * copies=0), which polluted the diagnosis "the late copy is useless". */
+        nv_late_remember( pbuffer, (GLuint)prev_tex, attach_target );
