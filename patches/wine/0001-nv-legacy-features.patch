+static GLuint nv_cube_face_store( struct opengl_context *context, struct pbuffer *pbuffer, BOOL may_create )
+{
+    static const GLenum complete_enum = 0x8cd5; /* GL_FRAMEBUFFER_COMPLETE. Checked against
+     * the value returned by glCheckFramebufferStatus; 0x8cd9 is
+     * FRAMEBUFFER_INCOMPLETE_DIMENSIONS, and an edit on 2026-11-16 which replaced 0x8cd5 by
+     * 0x8cd9 in these comparisons was a mistake, measured and reverted the same night. */
+    const struct opengl_funcs *funcs = &display_funcs;
+    struct opengl_drawable *drawable = pbuffer->drawable;
+    GLuint fbo, level;
+    GLenum face;
+
+    if (!may_create || !context || !drawable || !pbuffer->nv_cube_tex) return 0;
+    if (!nvlegacy_cube_face_fbo()) return 0;
+    if (pbuffer->texture_target != GL_TEXTURE_CUBE_MAP /*0x8513*/) return 0;
+    if (!drawable->virtual_size.cx || !drawable->virtual_size.cy) return 0;
+    if (get_target( context->draw ) != pbuffer->drawable) return 0;   /* not the surface we would draw into */
+    face = pbuffer->cube_face ? pbuffer->cube_face : GL_TEXTURE_CUBE_MAP_POSITIVE_X;
+    level = (GLuint)(pbuffer->mipmap_level > 0 ? pbuffer->mipmap_level : 0);
+    /* nvlegacy: a pbuffer created through WGL_NV_render_depth_texture and never bound as a
+     * colour render texture has no colour attachment at all: Mad Mod Mike's 96x96 depth cube
+     * (the point light's shadow cube, texture object 8 in our census) is exactly that, and the
+     * reference trace of the same demo selects faces on it 6013 times over 640 frames - six
+     * faces, plus the rejected WGL_CUBE_MAP_FACE probe, every frame - while our chain delivers
+     * it once per frame. Attaching the selected FACE of the application's depth cube is the
+     * same trick as the colour case, only on GL_DEPTH_ATTACHMENT. */
+    BOOL depth_only = (pbuffer->texture_format == GL_DEPTH_COMPONENT);
+
+    if (!pbuffer->nv_cube_attached_fbo)
+    {
+        funcs->p_glGenFramebuffers( 1, &pbuffer->nv_cube_attached_fbo );
+        if (!pbuffer->nv_cube_attached_fbo) return 0;
+        pbuffer->nv_cube_attached = 0;
+    }
+    fbo = pbuffer->nv_cube_attached_fbo;
+    if (pbuffer->nv_cube_attached != face)
+    {
+        GLint prev_draw = 0;
+        funcs->p_glGetIntegerv( GL_DRAW_FRAMEBUFFER_BINDING, &prev_draw );
+        funcs->p_glBindFramebuffer( GL_DRAW_FRAMEBUFFER, fbo );
+        if (depth_only)
+            funcs->p_glFramebufferTexture2D( GL_DRAW_FRAMEBUFFER, GL_DEPTH_ATTACHMENT /*0x8d00*/, face,
+                                             pbuffer->nv_cube_tex, level );
+        else
+            funcs->p_glFramebufferTexture2D( GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, face,
+                                             pbuffer->nv_cube_tex, level );
+        /* nvlegacy: the colour cube pbuffers of Mad Mod Mike were created with a depth
+         * attachment (the pixel format asks RGBA 8/8/8/8 and depth 24), so a store without any
+         * depth buffer would silently let every depth test pass inside the cube pass. Give the
+         * store its own depth renderbuffer, created once per pbuffer. */
+        if (!depth_only && !pbuffer->nv_cube_depth_rb)
+        {
+            funcs->p_glGenRenderbuffers( 1, &pbuffer->nv_cube_depth_rb );
+            if (pbuffer->nv_cube_depth_rb)
+            {
+                funcs->p_glBindRenderbuffer( GL_RENDERBUFFER, pbuffer->nv_cube_depth_rb );
+                funcs->p_glRenderbufferStorage( GL_RENDERBUFFER, GL_DEPTH_COMPONENT24 /*0x81a7*/,
+                                                drawable->virtual_size.cx, drawable->virtual_size.cy );
+                funcs->p_glFramebufferRenderbuffer( GL_DRAW_FRAMEBUFFER, GL_DEPTH_ATTACHMENT /*0x8d00*/,
+                                                    GL_RENDERBUFFER, pbuffer->nv_cube_depth_rb );
+                funcs->p_glBindRenderbuffer( GL_RENDERBUFFER, 0 );
+            }
+        }
+        if (depth_only)
+        {
+            funcs->p_glDrawBuffer( GL_NONE /*0x0*/ );
+            funcs->p_glReadBuffer( GL_NONE /*0x0*/ );
+        }
+        else funcs->p_glDrawBuffer( GL_COLOR_ATTACHMENT0 );
+        if (funcs->p_glCheckFramebufferStatus( GL_DRAW_FRAMEBUFFER ) != complete_enum)
+        {
+            const GLenum err = funcs->p_glGetError();
+            funcs->p_glBindFramebuffer( GL_DRAW_FRAMEBUFFER, (GLuint) prev_draw );
+            return 0;
+        }
+        funcs->p_glViewport( 0, 0, drawable->virtual_size.cx, drawable->virtual_size.cy );
+        context->draw_fbo = fbo;
+        pbuffer->nv_cube_attached = face;
+    }
+    return fbo;
+}
