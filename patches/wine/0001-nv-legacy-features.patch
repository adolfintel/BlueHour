+static GLuint nv_rt_fb( const struct pbuffer *pbuffer )
+{
+    if (!nvlegacy_pbuffer_rt_fbo()) return 0;
+    /* NV-legacy: this gate used to require nv_render_tex, and that marking is only set on the
+     * ordinary pbuffer creation path. Mad Mod Mike's two bloom pbuffers come from the
+     * duplicated float pixel format (the demo asks 16 bits per channel with
+     * WGL_FLOAT_COMPONENTS_NV, our choose answers one of those duplicates), so they carry the
+     * float marking and NOT the render-texture one: `PFB-RT-REASON: drawable ... 428x240
+     * render_tex=0 float=1 context=1 gate_rt=1`. The store was being built anyway, because the
+     * creation gate accepts that combination when WINE_NV_RT_COLOR_FLOAT_STORE is on, while this
+     * gate refused it: the demo kept drawing into the 8-bit drawable framebuffer, the wide store
+     * stayed unwritten and the copy read uninitialised memory (payload channels all negative or
+     * NaN, with no GL error). The two gates now agree. */
+    if (!pbuffer || !pbuffer->drawable ||
+        (!pbuffer->drawable->nv_render_tex &&
+         !(nvlegacy_rt_color_float_store() && pbuffer->drawable->nv_float_pbuffer)))
+        return 0;
+    /* GL NAME OF THE CURRENT CONTEXT: using drawable->draw_fbo blindly in a different
+         * context binds an object that does not exist there (measured: read_fbo=4 with a
+         * depth attachment of type=0 name=0, so the read is always 1.0). */
+    /* glReserved2 is the context WINE considers current (set both by the client path and
+         * by make_internal_context_current); NOT glContext: the internal path leaves it unchanged,
+         * so looking up the map by glContext almost always uses the wrong key (measured: a late copy
+         * reading the windows depth, always 1.0). */
+    return nv_rt_fb_per_ctx( pbuffer->drawable,
+                             NtCurrentTeb()->glReserved2 ? (struct opengl_context *)NtCurrentTeb()->glReserved2
+                                                         : NtCurrentTeb()->glContext );
+}
