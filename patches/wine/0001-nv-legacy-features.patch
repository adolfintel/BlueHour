+/* WGL_NV_render_depth_texture wants the depth buffer of a pbuffer to become the
+ * contents of a depth texture.  No GLX extension lets us alias a pbuffer depth
+ * buffer, so copy it: with glBlitFramebuffer when the depth formats match, and
+ * with a read-back upload otherwise.  This runs on the application context, so
+ * the texture it has bound is really the one we fill.  */
+
+/* nvlegacy: diagnostics for the pbuffer depth-to-texture binding
+ * (WGL_NV_render_depth_texture). Needed because on Nalu the shadow map arrives with the
+ * right format but EMPTY (measured with MESA_NV_TEXWATCH: tex=12 DEPTH 1024x1024
+ * min=0 max=0 average=0), and without content the depth comparison is constant: every
+ * later fix stays invisible. Enabled by WINE_NV_TRACE_DEPTHBIND=1, capped to a few lines
+ * because the calls are thousands (measured: 6436 depth bindings in 2146 frames). */
+static GLuint nv_prev_tex_name;   /* nvlegacy: name of the texture being bound (for the tracing) */
+
+static void
+nv_depth_bind_trace( const char *where, struct pbuffer *pbuffer, GLenum target,
+                     GLint tex_w, GLint tex_h, BOOL complete_enum, GLint err_code )
+{
+    static int is_active = -1, n = 0;
+    static const char *seen[8];
+    static int n_seen;
+    char key[96];
+    int i, new_val = 1;
+    const struct opengl_funcs *funcs = &display_funcs;
+    GLint depth_bits = -1, stencil_bits = -1;
+
+    if (is_active < 0)
+        is_active = getenv( "WINE_NV_TRACE_DEPTHBIND" ) ? 1 : 0;
+    if (!is_active || n >= 60)
+        return;
+
+    snprintf( key, sizeof(key), "%s|%p|%dx%d", where, pbuffer, tex_w, tex_h );
+    for (i = 0; i < n_seen; i++)
+        if (seen[i] && !strcmp( seen[i], key )) { new_val = 0; break; }
+    if (!new_val && (n % 400))
+        return;
+    if (new_val && n_seen < (int)ARRAY_SIZE( seen ))
+        seen[n_seen++] = strdup( key );
+    n++;
+
+    funcs->p_glGetIntegerv( GL_DEPTH_BITS, &depth_bits );
+    funcs->p_glGetIntegerv( GL_STENCIL_BITS, &stencil_bits );
+}
