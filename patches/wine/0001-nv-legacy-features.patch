+/* nvlegacy: picks (and keeps) the context whose store has content. Reusing the previous
+ * choice is worth it when the store is still valid: the probe is cheap but should run
+ * once per frame, not per context. */
+static struct opengl_context *nv_rt_pick_context( struct pbuffer *pbuffer,
+                                                     const struct opengl_funcs *funcs,
+                                                     float *min_out, int *cov_out )
+{
+    struct opengl_drawable *drawable = pbuffer->drawable;
+    unsigned i;
+    int cov = 0;
+    float min;
+
+    *min_out = 1.0f; *cov_out = 0;
+    if (!drawable || !drawable->nv_rt_map_n) return NULL;
+
+    if (pbuffer->nv_context_full)
+    {
+        min = nv_rt_depth_min( pbuffer->nv_context_full, drawable, funcs, &cov );
+        if (min < 0.999f && min > 0.001f && cov >= 1 && cov <= 600)   /* nvlegacy (0046): plausibilita' */ { *min_out = min; *cov_out = cov; return pbuffer->nv_context_full; }
+        pbuffer->nv_context_full = NULL;
+    }
+    for (i = 0; i < drawable->nv_rt_map_n; i++)
+    {
+        struct opengl_context *ctx = drawable->nv_rt_map[i].ctx;
+        min = nv_rt_depth_min( ctx, drawable, funcs, &cov );
+        if (min < 0.999f && min > 0.001f && cov >= 1 && cov <= 600)   /* nvlegacy (0046): plausibilita' */
+        {
+            pbuffer->nv_context_full = ctx;
+            *min_out = min; *cov_out = cov;
+            return ctx;
+        }
+    }
+    return NULL;
+}
