+static void nv_cube_face_latch( struct opengl_context *context, struct pbuffer *pbuffer, GLenum face )
+{
+    static const GLenum complete_enum = 0x8cd5; /* GL_FRAMEBUFFER_COMPLETE. Checked against
+     * the value returned by glCheckFramebufferStatus; 0x8cd9 is
+     * FRAMEBUFFER_INCOMPLETE_DIMENSIONS, and an edit on 2026-11-16 which replaced 0x8cd5 by
+     * 0x8cd9 in these comparisons was a mistake, measured and reverted the same night. */
+    const struct opengl_funcs *funcs = &display_funcs;
+    struct opengl_drawable *drawable = pbuffer->drawable;
+    GLint prev_draw = 0, prev_read = 0, prev_read_buf = 0;
+    GLuint level = (GLuint)(pbuffer->mipmap_level > 0 ? pbuffer->mipmap_level : 0);
+    BOOL done = FALSE, scissor_on = FALSE;
+
+    if (!context || !drawable || !pbuffer->nv_cube_tex || !face) return;
+    if (!drawable->virtual_size.cx || !drawable->virtual_size.cy) return;
+    /* The latch copies the pbuffer surface into a cube face through a COLOUR attachment: a
+     * depth-only pbuffer has no colour content to copy, and taking over its faces is what the
+     * store knob above also refuses. See the measurement written above nvlegacy_cube_store_depth. */
+    if (pbuffer->texture_format == GL_DEPTH_COMPONENT && !nvlegacy_cube_store_depth()) return;
+    /* The surface to copy is the one of THIS pbuffer. Reading whatever draw framebuffer
+     * happens to be bound is wrong: at wglSetPbufferAttribARB time the calling context may
+     * have a window current, and then the same window image lands in every face of the cube.
+     * Measured on Mad Mod Mike: one 96x96 cube had its six faces byte identical (L1 of 0.00 per
+     * channel between faces) showing a single wall view, while another cube in the same run had
+     * six genuinely different faces. The copy therefore only happens while this pbuffer is the
+     * drawable the calling context renders into. */
+    if (get_target( context->draw ) != pbuffer->drawable)
+    {
+        return;
+    }
+    funcs->p_glGetIntegerv( GL_DRAW_FRAMEBUFFER_BINDING, &prev_draw );
+    funcs->p_glGetIntegerv( GL_READ_FRAMEBUFFER_BINDING, &prev_read );
+    funcs->p_glGetIntegerv( GL_READ_BUFFER, &prev_read_buf );
+    if (!pbuffer->nv_cube_latch_fbo)
+    {
+        GLuint created = 0;
+        funcs->p_glGenFramebuffers( 1, &created );
+        if (!created) return;
+        pbuffer->nv_cube_latch_fbo = created;
+    }
+    funcs->p_glBindFramebuffer( GL_DRAW_FRAMEBUFFER, pbuffer->nv_cube_latch_fbo );
+    funcs->p_glFramebufferTexture2D( GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                     face, pbuffer->nv_cube_tex, level );
+    if (funcs->p_glCheckFramebufferStatus( GL_DRAW_FRAMEBUFFER ) == complete_enum)
+    {
+        funcs->p_glBindFramebuffer( GL_READ_FRAMEBUFFER, (GLuint) prev_draw );
+        funcs->p_glReadBuffer( prev_draw ? GL_COLOR_ATTACHMENT0 : GL_BACK );
+        /* A scissor test left on by the application crops the blit, and the blit must cover the
+         * whole face, so it is turned off here and put back below. */
+        if ((scissor_on = funcs->p_glIsEnabled( GL_SCISSOR_TEST )))
+            funcs->p_glDisable( GL_SCISSOR_TEST );
+        funcs->p_glBlitFramebuffer( 0, 0, drawable->virtual_size.cx, drawable->virtual_size.cy,
+                                    0, 0, drawable->virtual_size.cx, drawable->virtual_size.cy,
+                                    GL_COLOR_BUFFER_BIT, GL_NEAREST );
+        done = !funcs->p_glGetError();
+    }
+    else funcs->p_glGetError();
+    funcs->p_glBindFramebuffer( GL_DRAW_FRAMEBUFFER, (GLuint) prev_draw );
+    funcs->p_glBindFramebuffer( GL_READ_FRAMEBUFFER, (GLuint) prev_read );
+    funcs->p_glReadBuffer( prev_read_buf );   /* nvlegacy: the glReadBuffer above dirties the
+                                             * read buffer of the framebuffer we borrowed, and
+                                             * the application still expects its own next. */
+    if (scissor_on) funcs->p_glEnable( GL_SCISSOR_TEST );
+    if (!done) return;
+    pbuffer->nv_cube_latched++;
+    pbuffer->nv_cube_face_seen = face;
+}
+
+/* Mirror of nv_cube_face_latch for mode 2: copy the entering face of the application cube back
+ * into the single pbuffer surface. The latch alone makes the six faces of a single sweep
+ * different, but it does not give the application the per-face state that hardware render
+ * buffers have. Mad Mod Mike revisits the same cube faces in the same frame: the RGB
+ * environment pass writes RGB and preserves alpha, then the alpha-only pass writes alpha and
+ * preserves RGB. Without this reverse copy the second pass starts from the previous face's
+ * surface, so RGB and alpha from different faces mix inside the soft cube. */
+static void nv_cube_face_restore( struct opengl_context *context, struct pbuffer *pbuffer, GLenum face )
+{
+    static const GLenum complete_enum = 0x8cd5; /* GL_FRAMEBUFFER_COMPLETE, same note as above. */
+    const struct opengl_funcs *funcs = &display_funcs;
+    struct opengl_drawable *drawable = pbuffer->drawable;
+    GLint prev_draw = 0, prev_read = 0, prev_read_buf = 0;
+    GLuint level = (GLuint)(pbuffer->mipmap_level > 0 ? pbuffer->mipmap_level : 0);
+    BOOL done = FALSE, scissor_on = FALSE;
+
+    if (!context || !drawable || !pbuffer->nv_cube_tex || !face) return;
+    if (pbuffer->texture_target != GL_TEXTURE_CUBE_MAP /*0x8513*/) return;
+    if (!pbuffer->nv_cube_tex) return;
+    if (!drawable->virtual_size.cx || !drawable->virtual_size.cy) return;
+    if (get_target( context->draw ) != pbuffer->drawable)
+        return;
+
+    funcs->p_glGetIntegerv( GL_DRAW_FRAMEBUFFER_BINDING, &prev_draw );
+    funcs->p_glGetIntegerv( GL_READ_FRAMEBUFFER_BINDING, &prev_read );
+    funcs->p_glGetIntegerv( GL_READ_BUFFER, &prev_read_buf );
+    if (!pbuffer->nv_cube_latch_fbo)
+    {
+        GLuint created = 0;
+        funcs->p_glGenFramebuffers( 1, &created );
+        if (!created) return;
+        pbuffer->nv_cube_latch_fbo = created;
+    }
+
+    funcs->p_glBindFramebuffer( GL_DRAW_FRAMEBUFFER, pbuffer->nv_cube_latch_fbo );
+    funcs->p_glFramebufferTexture2D( GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                     face, pbuffer->nv_cube_tex, level );
+    if (funcs->p_glCheckFramebufferStatus( GL_DRAW_FRAMEBUFFER ) == complete_enum)
+    {
+        funcs->p_glBindFramebuffer( GL_READ_FRAMEBUFFER, pbuffer->nv_cube_latch_fbo );
+        funcs->p_glReadBuffer( GL_COLOR_ATTACHMENT0 );
+        funcs->p_glBindFramebuffer( GL_DRAW_FRAMEBUFFER, (GLuint) prev_draw );
+        if ((scissor_on = funcs->p_glIsEnabled( GL_SCISSOR_TEST )))
+            funcs->p_glDisable( GL_SCISSOR_TEST );
+        funcs->p_glBlitFramebuffer( 0, 0, drawable->virtual_size.cx, drawable->virtual_size.cy,
+                                    0, 0, drawable->virtual_size.cx, drawable->virtual_size.cy,
+                                    GL_COLOR_BUFFER_BIT, GL_NEAREST );
+        done = !funcs->p_glGetError();
+    }
+    else funcs->p_glGetError();
+
+    funcs->p_glBindFramebuffer( GL_DRAW_FRAMEBUFFER, (GLuint) prev_draw );
+    funcs->p_glBindFramebuffer( GL_READ_FRAMEBUFFER, (GLuint) prev_read );
+    funcs->p_glReadBuffer( prev_read_buf );
+    if (scissor_on) funcs->p_glEnable( GL_SCISSOR_TEST );
+
+    if (!done) return;
+    pbuffer->nv_cube_latched++;
+
+
+    pbuffer->nv_cube_face_seen = face;
+}
