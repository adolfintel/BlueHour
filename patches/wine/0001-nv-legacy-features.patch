+/* nvlegacy: reads a depth sample from the current read framebuffer and prints
+ * min/max/average. It separates the two hypotheses about why Nalu's shadow map is
+ * empty: (a) the shadow pass never rendered into the pbuffer (source already empty at
+ * bind time), (b) the blit does not carry the content into the texture (source full,
+ * destination empty). "blit without errors" on its own proves nothing: a successful
+ * blit from an empty source reports nothing. Enabled by WINE_NV_TRACE_DEPTHBIND=1,
+ * limited to a few samples because there are thousands of bindings. */
+/* nvlegacy: when the copy happens in the context picked by the probe, the sample must
+ * be taken ALWAYS, not every 200 calls: I had only 2 samples out of thousands of
+ * bindings, so the measurement concluded nothing. */
+static unsigned nv_sample_required;
+
+
+/* nvlegacy: state of the pbuffer's context at depth-to-texture bind time. Separates
+ * (a) the 1024x1024 shadow pass exists here too but does not write into the map
+ * (viewport 1024x1024 + depth mask on -> rendering/redirection defect) from (b) the pass
+ * never runs at all (viewport = the windows). In the reference, draws per viewport are
+ * 1024x768 -> 4380, 512x512 -> 2680, 1024x1024 -> 2530, 256x256 -> 368, 128x16 -> 322
+ * (total 10280). Note: the GL function table here is the global display_funcs of type
+ * struct opengl_funcs (NOT "opengl_display_functions": that type does not exist in this
+ * file and the first version of the patch did not compile). */
+
+
+
+/* nvlegacy: the pbuffer depth blit/read happened WITHOUT selecting a read buffer: on a
+ * DOUBLE BUFFERED drawable the context, at that point, reads GL_FRONT, which never got
+ * the draws (measured: coverage 0.000 percent on the 1024x1024 in every copy mode, while
+ * the SAME surface read in the client context at draw time reaches 4.767 percent; and the
+ * COLOUR branch, which does call glReadBuffer(GL_BACK), works). Here the buffer is
+ * selected with the same rule as 'context->read_buffer = doublebuffer? GL_BACK:
+ * GL_FRONT'. Knob: WINE_NV_DEPTH_READBUF=0 disables it (on by default, for A/B). */
+static int nvlegacy_depth_readbuf( void )
+{
+    static int cached = -1;
+    const char *v;
+    if (cached >= 0) return cached;
+    v = getenv( "WINE_NV_DEPTH_READBUF" );
+    cached = (v && *v == '0') ? 0 : 1;
+    return cached;
+}
+
+static void nv_select_read_buffer( const struct opengl_funcs *funcs, struct pbuffer *pbuffer, const char *where )
+{
+    GLenum buf;
+
+    if (!nvlegacy_depth_readbuf() || !pbuffer || !pbuffer->drawable) return;
+    buf = pbuffer->drawable->doublebuffer ? GL_BACK : GL_FRONT;
+    funcs->p_glReadBuffer( buf );
